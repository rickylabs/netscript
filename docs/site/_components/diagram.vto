{{# The hidden lazy source image feeds Markdown twins; inline SVG owns visual/accessibility output. #}}
<figure class="ns-diagram">
  <img src="{{ src }}" alt="{{ alt }}" hidden loading="lazy" />
  <div class="ns-diagram__viewport{{ if wide }} ns-diagram__viewport--wide{{ /if }}" tabindex="0">
    {{ src |> utilityDiagram(alt) }}
  </div>
  {{ if caption }}<figcaption class="ns-diagram__caption">{{ caption |> ic }}</figcaption>{{ /if }}
</figure>
