{{# A ruled card retains title/body/href/icon and accepts an optional eyebrow. #}}
{{ set tag = href ? "a" : "div" }}
<{{ tag }} class="ns-card" data-variant="rule"{{ if href }} href="{{ href |> url }}"{{ /if }}>
  {{ if eyebrow }}<span class="ns-eyebrow">{{ eyebrow }}</span>{{ /if }}
  <span class="ns-card__head">{{ if icon }}<span class="ns-card__icon" aria-hidden="true">{{ icon }}</span>{{ /if }}<span class="ns-card__title">{{ title |> ic }}</span>{{ if href }}<span class="ns-card__arrow" aria-hidden="true">↗</span>{{ /if }}</span>
  {{ if body }}<p class="ns-card__body">{{ body |> ic }}</p>{{ /if }}
  {{ if href && linkLabel }}<span class="ns-card__action"> {{ linkLabel }} →</span>{{ /if }}
</{{ tag }}>
