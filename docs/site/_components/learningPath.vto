{{# A real sequence; optional current URL marks a tutorial step without changing steps arguments. #}}
<ol class="ns-learning-path" aria-label="Learning path">
  {{ for index, step of steps || [] }}<li class="ns-learning-path__step"><a class="ns-learning-path__link" href="{{ step.href |> url }}"{{ if url === step.href }} aria-current="step"{{ /if }}><span class="ns-learning-path__index">{{ String(index + 1).padStart(2, "0") }}</span><span>{{ step.label }}</span></a></li>{{ /for }}
</ol>
