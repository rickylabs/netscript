{{# A copy-source path; copy is optional and progressively enhanced. #}}
<span class="ns-file-path" title="{{ path }}"><span class="ns-file-path__value">{{ path }}</span>{{ if copy !== false }}<button type="button" class="ns-chip-copy js-only" data-copy-path aria-label="Copy {{ path }}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="8" y="8" width="12" height="12" /><path d="M16 8V4H4v12h4" /></svg></button>{{ /if }}</span>
