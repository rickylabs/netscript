{{# Public type/title/content contract; error remains a destructive alias. #}}
{{ set requested = (type || "note").toLowerCase() }}
{{ set tones = { note: "info", tip: "success", important: "important", warning: "warning", caution: "destructive", error: "destructive" } }}
{{ set kind = tones[requested] ? requested : "note" }}
{{ set icons = { note: "ⓘ", tip: "✓", important: "ⓘ", warning: "△", caution: "ⓧ", error: "ⓧ" } }}
<aside class="ns-callout" data-variant="{{ kind }}" data-tone="{{ tones[kind] }}" role="note">
  <div class="ns-callout__head"><span class="ns-callout__icon" aria-hidden="true">{{ icons[kind] }}</span><span class="ns-eyebrow">{{ kind }}</span>{{ if title }}<span class="ns-callout__title">{{ title |> ic }}</span>{{ /if }}</div>
  <div class="ns-callout__body">{{ content }}</div>
</aside>
