{{# nextPrev.vto — prev/next pager rendered at the foot of the article.
   One mechanism per section:
   1. Start pages and tutorial chapters set `prev`/`next` front matter
      ({ label, href }); the tracks keep per-chapter editorial control this way.
   2. Pages under a `pagerRoots` section (Reference, Concepts, Comparisons)
      auto-derive neighbours from the sidebar order via
      nav.nextPage/previousPage(url, query, sort). The verified v2.5.4 signature
      has NO basePath argument; the `url^=<root>` query term scopes the walk.
   3. Build pages have no pager: the sidebar is the sequence.
   Labels use `title`, never `nav_title`, so a landing never reads "Overview".
   Hrefs are source urls, base-prefixed via the `url` filter. #}}
{{ set prevLink = null }}
{{ set nextLink = null }}
{{ if prev }}{{ set prevLink = { label: prev.label, href: prev.href } }}{{ /if }}
{{ if next }}{{ set nextLink = { label: next.label, href: next.href } }}{{ /if }}
{{ set pagerRoot = url ? pagerRoots.find((root) => url.startsWith(root)) : null }}
{{ if pagerRoot }}
  {{ set pagerQuery = "url^=" + pagerRoot + " " + navQuery }}
  {{ set pagerSort = getDocsLane(url).sort || navSort }}
  {{ if !prevLink }}
    {{ set autoPrev = nav.previousPage(url, pagerQuery, pagerSort) }}
    {{ if autoPrev && autoPrev.url }}{{ set prevLink = { label: autoPrev.title, href: autoPrev.url } }}{{ /if }}
  {{ /if }}
  {{ if !nextLink }}
    {{ set autoNext = nav.nextPage(url, pagerQuery, pagerSort) }}
    {{ if autoNext && autoNext.url }}{{ set nextLink = { label: autoNext.title, href: autoNext.url } }}{{ /if }}
  {{ /if }}
{{ /if }}
{{ if prevLink || nextLink }}
<nav class="ns-nextprev" aria-label="Pagination">
  {{ if prevLink }}
    <a class="ns-nextprev__link ns-nextprev__link--prev" href="{{ prevLink.href |> url }}" rel="prev">
      <span class="ns-nextprev__dir" aria-hidden="true">← Previous</span>
      <span class="ns-nextprev__label" data-part="label">{{ prevLink.label }}</span>
    </a>
  {{ /if }}
  {{ if nextLink }}
    <a class="ns-nextprev__link ns-nextprev__link--next" href="{{ nextLink.href |> url }}" rel="next">
      <span class="ns-nextprev__dir" aria-hidden="true">Next →</span>
      <span class="ns-nextprev__label" data-part="label">{{ nextLink.label }}</span>
    </a>
  {{ /if }}
</nav>
{{ /if }}
