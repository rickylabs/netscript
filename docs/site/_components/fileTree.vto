{{# Read-only nested list, with optional ownership tags. It is not an interactive ARIA tree. #}}
{{ set nodes = items || (tree ? [tree] : []) }}
<ul class="ns-file-tree{{ if !nested }} ns-file-tree--root{{ /if }}"{{ if !nested }} tabindex="0" aria-label="Project files"{{ /if }}>
  {{ for node of nodes }}
    {{ set isDir = node.children && node.children.length }}
    <li class="ns-file-tree__item"{{ if node.ownership }} data-ownership="{{ node.ownership }}"{{ /if }}>
      <span class="ns-file-tree__row"><svg class="ns-file-tree__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">{{ if isDir }}<path d="M3 6h7l2 3h9v11H3z" />{{ else }}<path d="M14 2H5v20h14V7zM14 2v6h6" />{{ /if }}</svg><span class="ns-file-tree__name">{{ node.name }}</span>{{ if node.comment }}<span class="ns-file-tree__comment"># {{ node.comment }}</span>{{ /if }}{{ if node.ownership }}<span class="ns-file-tree__ownership">[{{ node.ownership }}]</span>{{ /if }}</span>
      {{ if isDir }}{{ comp.fileTree({ items: node.children, nested: true }) }}{{ /if }}
    </li>
  {{ /for }}
</ul>
