{{# Existing rows/items and caption/title aliases; generic columns stay generic. #}}
{{ set data = rows || items || [] }}
{{ set cap = caption || title }}
{{ set generic = columns ? true : false }}
<div class="ns-api-table-wrap" tabindex="0"{{ if cap }} aria-label="{{ cap }}"{{ /if }}>
  <table class="ns-api-table" data-variant="{{ generic ? 'generic' : 'object' }}">
    {{ if cap }}<caption>{{ cap |> ic }}</caption>{{ /if }}
    <thead><tr>{{ for head of columns || ["Name · Type", "Description"] }}<th scope="col">{{ head }}</th>{{ /for }}</tr></thead>
    <tbody>{{ for row of data }}<tr>
      {{ if generic }}
        {{ set cells = Array.isArray(row) ? row : Object.values(row) }}
        {{ for entry of cells.entries() }}<td class="{{ entry[0] === 0 ? 'ns-api-table__name' : 'ns-api-table__desc' }}">{{ entry[1] |> ic }}</td>{{ /for }}
      {{ else }}
        <td class="ns-api-table__identity"{{ if row.name }} id="{{ row.name |> slugify }}"{{ /if }}>{{ if row.kind }}<span class="ns-api-kind" data-kind="{{ row.kind |> apiKind }}" data-syntax-role="{{ row.kind |> apiKindRole }}">{{ row.kind }}</span>{{ /if }}<code class="ns-api-table__name">{{ row.name }}</code><code class="ns-api-table__type">{{ row.type }}</code></td>
        <td class="ns-api-table__desc">{{ row.desc |> ic }}</td>
      {{ /if }}
    </tr>{{ /for }}</tbody>
  </table>
</div>
