{{# Stable/alpha/partial remain accepted; unsupported values use the neutral variant. #}}
{{ set variants = { stable: "success", alpha: "warning", partial: "muted" } }}
{{ set kind = status || "muted" }}
<span class="ns-badge" data-variant="{{ variants[kind] || 'muted' }}"><span class="ns-badge__dot" aria-hidden="true"></span>{{ label || kind }}</span>
