{{ set lane = getDocsLane(url) }}
{{ set kind = url === "/" ? "home" : (url === "/design-system/" ? "landing" : (url.startsWith("/reference/") || url === "/cli-reference/" ? "reference" : "article")) }}
<!doctype html>
<html lang="en" data-theme="studio" data-flavor="utility" data-gray="neutral" data-accent="ink" data-density="compact" data-scheme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }} · NetScript Docs</title>
    <meta name="description" content="{{ description || 'NetScript — the Deno meta-framework for typed, observable systems.' }}" />
    <link rel="icon" href="{{ '/favicon.svg' |> url }}" type="image/svg+xml" />
    <link rel="preload" href="{{ '/assets/fonts/host-grotesk-latin.woff2' |> url }}" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="{{ '/styles/fonts.css' |> url }}" />
    <link rel="stylesheet" href="{{ '/styles/docs.css' |> url }}" />
    <script>
      (() => {
        let scheme;
        try { scheme = localStorage.getItem("ns-theme"); } catch (_) {}
        if (scheme !== "light" && scheme !== "dark") {
          scheme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.scheme = scheme;
      })();
    </script>
  </head>
  <body data-docs-kind="{{ kind }}">
    <a href="#main-content" class="ns-skip-link">Skip to main content</a>
    <header class="docs-topbar">
      <button type="button" class="ns-icon-btn docs-menu-trigger js-only" data-sidebar-toggle aria-label="Open documentation navigation" aria-controls="navigation-dialog" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      </button>
      <a href="{{ '/' |> url }}" class="docs-brand" aria-label="NetScript documentation home">
        <span class="docs-logo" aria-hidden="true">N</span><span>NetScript</span><span class="docs-brand__suffix">docs</span>
      </a>
      <nav class="docs-lanes" aria-label="Documentation lanes">
        {{ for item of navLanes }}
          <a href="{{ item.href |> url }}"{{ if kind !== "home" && item.label === lane.label }} aria-current="page"{{ /if }}>{{ item.label }}</a>
        {{ /for }}
      </nav>
      <a href="#search-fallback" class="docs-search-trigger" data-search-trigger aria-label="Search documentation" aria-haspopup="dialog">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
        <span>Search docs</span><kbd>⌘K</kbd>
      </a>
      <span class="docs-version" title="NetScript release">v{{ releaseVersion }}</span>
      <button type="button" class="ns-icon-btn js-only" data-theme-toggle aria-label="Switch color scheme" title="Switch color scheme">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z" /></svg>
      </button>
    </header>

    <div class="docs-layout">
      <details class="docs-sidebar" data-sidebar open>
        <summary class="docs-sidebar__fallback">Browse documentation</summary>
        <nav class="docs-lanes docs-lanes--mobile" aria-label="Mobile documentation lanes">
          {{ for item of navLanes }}
            <a href="{{ item.href |> url }}"{{ if item.label === lane.label }} aria-current="page"{{ /if }}>{{ item.label }}</a>
          {{ /for }}
        </nav>
        <nav class="docs-sidebar__tree" aria-label="{{ lane.label }} navigation">
        <div class="docs-sidebar__heading"><p class="ns-eyebrow">{{ lane.label }}</p><p>{{ lane.subtitle }}</p></div>
          {{ if lane.kind === "flat" }}
            {{ for item of lane.items }}
              <a href="{{ item.href |> url }}" class="ns-dashboard__nav-item"{{ if url === item.href }} aria-current="page"{{ /if }}>{{ item.label }}</a>
            {{ /for }}
          {{ else }}
            {{ for root of lane.roots }}
              {{ set tree = nav.menu(root, navQuery, navSort) }}
              {{ if tree && tree.data }}
                {{ if lane.expandRoot }}
                  <a href="{{ tree.data.url |> url }}" class="ns-dashboard__nav-item"{{ if url === tree.data.url }} aria-current="page"{{ /if }}>{{ tree.data.nav_title || tree.data.title }}</a>
                  {{ for child of tree.children }}
                    {{ include "nav/menu-item.vto" { item: child, currentUrl: url } }}
                  {{ /for }}
                {{ else }}
                  {{ include "nav/menu-item.vto" { item: tree, currentUrl: url } }}
                {{ /if }}
              {{ /if }}
            {{ /for }}
          {{ /if }}
        </nav>
      </details>

      <main class="docs-main" id="main-content" tabindex="-1">
        <details class="ns-toc-mobile" data-mobile-toc hidden>
          <summary><span class="ns-eyebrow">On this page</span><span data-toc-current></span><span aria-hidden="true">⌄</span></summary>
          <nav aria-label="On this page, mobile"><ol data-mobile-toc-list></ol></nav>
        </details>
        {{ if kind !== "home" }}
          <div class="docs-page-toolbar">
            {{ comp.breadcrumb({ url, title }) }}
            <a class="ns-md-link" href="{{ (url + 'index.md') |> url }}" data-pagefind-ignore><span aria-hidden="true">▤</span> View as Markdown</a>
          </div>
          <p class="ns-eyebrow docs-page-eyebrow">{{ lane.label }}{{ if lane.label === "Build" }} · {{ (nav.breadcrumb(url, navQuery, navSort)[1]?.data?.nav_title || nav.breadcrumb(url, navQuery, navSort)[1]?.data?.title || "Capabilities") }}{{ /if }}</p>
        {{ /if }}
        <nav class="docs-anchor-nav" data-reference-nav aria-label="Reference sections" hidden></nav>
        <div class="docs-content-layout">
          <article class="ns-prose" data-pagefind-body data-pagefind-filter="lane:{{ lane.label }}">
            {{ content }}
          </article>
          <nav class="ns-toc" data-toc aria-label="On this page" hidden>
            <p class="ns-eyebrow">On this page</p>
            <ol class="ns-toc__list" data-toc-list></ol>
            <div class="ns-toc__actions"><a href="{{ (url + 'index.md') |> url }}">▤ View as Markdown</a><a href="#main-content">Back to top ↑</a></div>
          </nav>
        </div>
        {{ if !content.includes('<nav class="ns-nextprev"') }}{{ comp.nextPrev({ prev, next, url }) }}{{ /if }}
        {{ set editSourcePath = page.sourcePath }}
        {{ if kind !== "home" && editSourcePath && editSourcePath !== "(generated)" && !editSourcePath.startsWith("/reference/") }}
          <div class="docs-edit"><a href="{{ 'https://github.com/rickylabs/netscript/edit/main/docs/site' + editSourcePath }}">Edit this page ↗</a></div>
        {{ /if }}
        <details id="search-fallback" class="docs-search-fallback"><summary>Search all documentation</summary><div id="search"></div></details>
      </main>
    </div>

    <footer class="docs-footer">
      <div><a href="{{ '/' |> url }}" class="docs-brand"><span class="docs-logo" aria-hidden="true">N</span>NetScript</a><p>The Deno meta-framework for typed, observable systems.</p></div>
      <nav aria-label="Getting started"><p class="ns-eyebrow">Where to go</p><a href="{{ '/quickstart/' |> url }}">Scaffold and run a workspace</a><a href="{{ '/concepts/' |> url }}">The five-layer mental model</a><a href="{{ '/why/' |> url }}">The argument, with trade-offs</a><a href="{{ '/tutorials/storefront/' |> url }}">Build a real system</a><a href="{{ '/reference/' |> url }}">Package reference</a></nav>
      <nav aria-label="Footer documentation lanes"><p class="ns-eyebrow">Lanes</p>{{ for item of navLanes }}<a href="{{ item.href |> url }}">{{ item.label }}</a>{{ /for }}</nav>
    </footer>

    <dialog id="navigation-dialog" class="docs-drawer" aria-label="Documentation navigation"><button type="button" class="ns-icon-btn docs-drawer__close" data-sidebar-close aria-label="Close documentation navigation">×</button></dialog>
    <script type="module" src="{{ '/assets/docs/shell.js' |> url }}"></script>
    <script type="module" src="{{ '/assets/docs/tabs.js' |> url }}"></script>
    <script type="module" src="{{ '/assets/docs/toc.js' |> url }}"></script>
  </body>
</html>
