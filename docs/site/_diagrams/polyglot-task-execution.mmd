%% Source for assets/diagrams/polyglot-task-execution.svg
%% Render separately with the pinned Mermaid CLI; the site ships the static SVG.
%% Stdin is runtime-only: direct executor input, not persisted queue metadata.
flowchart LR
  worker["Worker runtime<br/>(queued task metadata)"] --> handler["Task executor"]
  caller["Direct executor call"] -- "optional private stdin" --> handler
  subgraph subprocess
    proc["deno / python / dotnet<br/>cmd / powershell / shell / exe<br/>(spawned process)"]
  end
  handler -- "spawn &middot; argv + env + optional stdin" --> proc
  proc -- "last stdout line &rarr; JSON object" --> handler
  handler -- "result" --> sink["Queue / DB<br/>(persist result)"]
