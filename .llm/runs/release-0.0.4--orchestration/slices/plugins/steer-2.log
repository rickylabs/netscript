    fs: new MemoryFileSystemAdapter(),
    loadConfig: () => Promise.resolve({ plugins: ['./plugins/broken/mod.ts'] } as never),
    loadRegisteredPlugins: () => Promise.reject(new Error('plugin import exploded')),
  });
