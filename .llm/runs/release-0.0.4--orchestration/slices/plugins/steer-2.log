    workspaceRoot: '/workspace',
    options: {},
    config: { [configKey]: 'configured' },
    dryRun: true,
    fileSystem: {
      exists: () => Promise.resolve(true),
      readText: () => Promise.resolve(source),
      writeText: () => Promise.reject(new Error('read only')),
    },
  } as const;
}

