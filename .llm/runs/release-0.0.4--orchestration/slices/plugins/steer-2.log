packages/cli/src/kernel/assets/embedded.generated.ts:95:  "/**\n * `/health` route — readiness endpoint for the {{appName}} app.\n *\n * The Aspire AppHost probes this route to decide whether the app is healthy, and its\n * probe sends no `Accept` header — so it takes the server-rendered branch below and a\n * broken SSR pipeline shows up as `Unhealthy` rather than as a green resource that\n * returns 500 to every request. Keep SSR as the fall-through: only a caller that asks\n * for JSON and not HTML gets the payload without rendering.\n */\nimport HealthView from './(_components)/health-view.tsx';\nimport { buildPayload, toHealthRouteData } from './(_shared)/health.ts';\nimport { appRoutes } from '@app/router.ts';\nimport { definePage } from '@app/utils.ts';\n\nexport const healthPage = definePage()\n  .withRoute(appRoutes.health)\n  .withMeta(() => ({\n    title: '{{name}} — health',\n    description: 'Liveness route for the {{appName}} app.',\n  }))\n  .withLayer('panel', HealthView, (ctx) => toHealthRouteData(ctx.data) ?? { payload: buildPayload() })\n  .withLayout((slots) => slots.panel())\n  .withHandler('GET', (ctx) => {\n    const accept = ctx.req.headers.get('accept') ?? '';\n    const payload = buildPayload('{{appName}}');\n\n    if (accept.includes('application/json') && !accept.includes('text/html')) {\n      return Response.json(payload);\n    }\n\n    return { data: { payload } };\n  })\n  .build();\n\nexport const { handler, default: page } = healthPage;\nexport { page as default };\n";
