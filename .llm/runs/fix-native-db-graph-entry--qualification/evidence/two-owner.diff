+        stdout: 'piped',
+        stderr: 'piped',
+      }).output();
+      assertEquals(result.success, true, new TextDecoder().decode(result.stderr));
+      const graph: {
+        roots: string[];
+        modules: { kind: string; specifier: string; error?: unknown }[];
+      } = JSON.parse(new TextDecoder().decode(result.stdout));
+      assertEquals(graph.roots, [fileUrl]);
