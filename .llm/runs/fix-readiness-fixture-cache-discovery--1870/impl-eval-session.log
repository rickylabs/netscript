{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_2f35c1230d76437ab1c4b90d","type":"tool_result","content":"1\timport { DEFAULT_TEMPLATE_REGISTRY } from '../../../../../../src/kernel/application/registries/template-registry.ts';\n2\timport { generateRegisterApps } from '../../../../../../src/kernel/templates/aspire/helpers/register/generate-register-apps.ts';\n3\timport { generateRegisterInfrastructure } from '../../../../../../src/kernel/templates/aspire/helpers/register/generate-register-infrastructure.ts';\n4\timport {\n5\t  GARNET_TEST_LISTENER_PORT,\n6\t  LISTENER_FAULT_ACK_FILE,\n7\t  LISTENER_FAULT_CONTROLLER_DIR,\n8\t  LISTENER_FAULT_STATE_FILE,\n9\t  POSTGRES_TEST_LISTENER_PORT,\n10\t  TEST_ONLY_GARNET_HEALTH_KEY,\n11\t  TEST_ONLY_POSTGRES_HEALTH_KEY,\n12\t} from './listener-fault-controller.ts';\n13\timport { DATABASE, type DatabaseEngine } from '../../../../domain/extension-axes.ts';\n14\timport {\n15\t  listenerFaultExpectations,\n16\t  parseListenerFaultDatabase,\n17\t} from './listener-readiness-gates.ts';\n18\t\n19\texport { TEST_ONLY_GARNET_HEALTH_KEY, TEST_ONLY_POSTGRES_HEALTH_KEY };\n20\t\n21\tconst RETURN_APPS_MARKER = '  return apps;';\n22\tconst POSTGRES_REAL_HEALTH_KEY = 'postgres_listener';\n23\tconst GARNET_REAL_HEALTH_KEY = 'garnet_resp';\n24\t\n25\t/** Prepare the dead-port app and D-101 synthetic listener controller before Aspire starts. */\n26\texport async function prepareReadinessFixture(\n27\t  projectRoot: string,\n28\t  database: DatabaseEngine,\n29\t): Promise<void> {\n30\t  await writeDeadPortFixture(projectRoot);\n31\t  await DEFAULT_TEMPLATE_REGISTRY.hydrate();\n32\t\n33\t  const registerInfrastructurePath = `${projectRoot}/aspire/.helpers/register-infrastructure.mts`;\n34\t  const registerInfrastructure = await Deno.readTextFile(registerInfrastructurePath);\n35\t  await writeControllerFixture(projectRoot);\n36\t\n37\t  const registerAppsPath = `${projectRoot}/aspire/.helpers/register-apps.mts`;\n38\t  const registerApps = await Deno.readTextFile(registerAppsPath);\n39\t  await Deno.writeTextFile(registerAppsPath, injectReadinessFixtureApps(registerApps));\n40\t\n41\t  await Deno.writeTextFile(\n42\t    registerInfrastructurePath,\n43\t    injectListenerFaultHealthChecks(registerInfrastructure, database),\n44\t  );\n45\t}\n46\t\n47\t/** Attach the two test-only checks at boundaries derived from the real infrastructure generator. */\n48\texport function injectListenerFaultHealthChecks(\n49\t  source: string,\n50\t  database: DatabaseEngine = DATABASE.POSTGRES,\n51\t): string {\n52\t  if (\n53\t    source.includes(TEST_ONLY_POSTGRES_HEALTH_KEY) ||\n54\t    source.includes(TEST_ONLY_GARNET_HEALTH_KEY)\n55\t  ) {\n56\t    throw new Error('test-only listener health checks were already registered');\n57\t  }\n58\t\n59\t  const reference = listenerInfrastructureReference();\n60\t  assertGeneratedHealthAttachment(reference, GARNET_REAL_HEALTH_KEY);\n61\t  const garnetAttachments = healthAttachments(source, GARNET_REAL_HEALTH_KEY);\n62\t  if (garnetAttachments.length === 0) {\n63\t    throw new Error(\n64\t      'generated register-infrastructure helper has no garnet health-check attachment',\n65\t    );\n66\t  }\n67\t  const includePostgres = listenerFaultExpectations(database).some((expectation) =>\n68\t    expectation.controllerListener === 'postgres'\n69\t  );\n70\t  let withPostgres = source;\n71\t  if (includePostgres) {\n72\t    assertGeneratedHealthAttachment(reference, POSTGRES_REAL_HEALTH_KEY);\n73\t    const postgresAttachments = healthAttachments(source, POSTGRES_REAL_HEALTH_KEY);\n74\t    if (postgresAttachments.length === 0) {\n75\t      throw new Error(\n76\t        'generated register-infrastructure helper has no postgres health-check attachment',\n77\t      );\n78\t    }\n79\t    withPostgres = injectAtHealthAttachments(\n80\t      source,\n81\t      postgresAttachments,\n82\t      (attachment, indentation) =>\n83\t        `${indentation}builder.addHealthCheck('${TEST_ONLY_POSTGRES_HEALTH_KEY}', createListenerReadinessCheck({ kind: 'tcp', host: 'localhost', port: ${POSTGRES_TEST_LISTENER_PORT} }));\n84\t${indentation}await ${attachment.resourceBinding}.withHealthCheck('${TEST_ONLY_POSTGRES_HEALTH_KEY}');`,\n85\t    );\n86\t  }\n87\t\n88\t  return injectAtHealthAttachments(\n89\t    withPostgres,\n90\t    healthAttachments(withPostgres, GARNET_REAL_HEALTH_KEY),\n91\t    (attachment, indentation) =>\n92\t      `${indentation}builder.addHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}', createRespPingCheck({ host: 'localhost', port: ${GARNET_TEST_LISTENER_PORT} }));\n93\t${indentation}await ${attachment.resourceBinding}.withHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}');`,\n94\t  );\n95\t}\n96\t\n97\t/** Inject the existing dead-port app plus the Aspire-managed listener controller task. */\n98\texport function injectReadinessFixtureApps(\n99\t  source: string,\n100\t  includeListenerFaultController = true,\n101\t): string {\n102\t  if (!source.includes(RETURN_APPS_MARKER)) {\n103\t    throw new Error('generated register-apps helper has no return marker');\n104\t  }\n105\t\n106\t  const generated = generateRegisterApps({\n107\t    apps: {\n108\t      'readiness-dead-port': {\n109\t        Enabled: true,\n110\t        Runtime: 'deno',\n111\t        Type: 'task',\n112\t        Workdir: '.netscript/e2e/readiness-dead-port',\n113\t        TaskName: 'start',\n114\t        Port: 18_997,\n115\t        WatchMode: false,\n116\t        RequiresKv: false,\n117\t      },\n118\t      'listener-fault-controller': {\n119\t        Enabled: true,\n120\t        Runtime: 'deno',\n121\t        Type: 'task',\n122\t        Workdir: LISTENER_FAULT_CONTROLLER_DIR,\n123\t        TaskName: 'start',\n124\t        WatchMode: false,\n125\t        RequiresKv: false,\n126\t      },\n127\t    },\n128\t    version: 'e2e',\n129\t    denoDefaults: { Permissions: [], WatchMode: false },\n130\t  });\n131\t\n132\t  let injected = source;\n133\t  const fixtureNames = in