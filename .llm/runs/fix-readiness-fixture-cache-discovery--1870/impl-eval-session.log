R #1871 — B1 (diagnosis), B2 (both arms), B5 (fail-closed).\n// Independent verification: counting uses this script's own regex, never the product's helpers.\nimport { generateRegisterInfrastructure } from '../../../packages/cli/src/kernel/templates/aspire/helpers/register/generate-register-infrastructure.ts';\nimport {\n  injectListenerFaultHealthChecks,\n  TEST_ONLY_GARNET_HEALTH_KEY,\n  TEST_ONLY_POSTGRES_HEALTH_KEY,\n} from '../../../packages/cli/e2e/src/application/gates/scaffold/runtime/prepare-readiness-fixture.ts';\nimport { DATABASE } from '../../../packages/cli/e2e/src/domain/extension-axes.ts';\n\nconst section = (title: string) => console.log(`\\n=== ${title} ===`);\n\n// The REAL config: redis from `netscript init`, garnet exactly as ensureSharedCache writes it\n// (workspace-mutator.ts:628-632: { Enabled: true, Engine: 'Garnet', Mode: 'Auto' } — no DataPath).\nconst realSource = generateRegisterInfrastructure({\n  databases: {\n    postgres: { Enabled: true, Engine: 'Postgres', Mode: 'Container', Persistent: false },\n  },\n  caches: {\n    redis: { Enabled: true, Engine: 'Redis', Mode: 'Container', DataPath: '.data/redis' },\n    garnet: { Enabled: true, Engine: 'Garnet', Mode: 'Auto' },\n  },\n  primaryDatabase: 'postgres',\n  primaryCache: 'garnet',\n});\n\n// The committed test's config variant (garnet carries DataPath + Auto).\nconst testVariantSource = generateRegisterInfrastructure({\n  databases: {},\n  caches: {\n    redis: { Enabled: true, Engine: 'Redis', Mode: 'Container', DataPath: '.data/redis' },\n    garnet: { Enabled: true, Engine: 'Garnet', Mode: 'Auto', DataPath: '.data/garnet' },\n  },\n  primaryCache: 'garnet',\n});\n\nfunction countAttachments(source: string, key: string): number {\n  return source.split('\\n').filter((line) =>\n    /^\\s*await\\s+[\\w$]+\\.withHealthCheck\\(['\"]/.test(line) && line.includes(`'${key}'`) ||\n    /^\\s*await\\s+[\\w$]+\\.withHealthCheck\\([\"]/.test(line) && line.includes(`\"${key}\"`)\n  ).length;\n}\n\nfunction armBounds(source: string): { ifLine: number; elseLine: number; closeLine: number } {\n  const lines = source.split('\\n');\n  const ifLine = lines.findIndex((l) => l.includes('if (shouldUseContainerCache()) {'));\n  const elseLine = lines.findIndex((l, i) => i > ifLine && l.trim() === '} else {');\n  let closeLine = -1;\n  for (let i = elseLine + 1; i < lines.length; i++) {\n    if (lines[i] === '  }') { closeLine = i; break; }\n  }\n  return { ifLine, elseLine, closeLine };\n}\n\nfunction armOf(source: string, occurrence: number): string {\n  const lines = source.split('\\n');\n  const { ifLine, elseLine, closeLine } = armBounds(source);\n  const matches = lines.flatMap((l, i) => (l.includes('withHealthCheck(\"garnet_resp\")') ? [i] : []));\n  const lineIndex = matches[occurrence];\n  if (lineIndex === undefined) return 'absent';\n  if (lineIndex < ifLine) return 'outside';\n  if (lineIndex < elseLine) return 'container';\n  if (lineIndex < closeLine) return 'executable';\n  return 'outside';\n}\n\n// ---------- B1 ----------\nsection('B1: diagnosis — attachment counts in real two-cache output');\nconsole.log('redis_resp   attachments:', countAttachments(realSource, 'redis_resp'));\nconsole.log('garnet_resp  attachments:', countAttachments(realSource, 'garnet_resp'));\nconsole.log('garnet_resp occurrences by arm:', [0, 1].map((n) => armOf(realSource, n)));\nconsole.log('test-variant garnet_resp attachments:', countAttachments(testVariantSource, 'garnet_resp'));\nif (countAttachments(realSource, 'garnet_resp') !== 2) {\n  console.log('!!! B1 FAILED: premise (garnet_resp emitted twice) not reproduced');\n} else {\n  console.log('B1 OK: garnet_resp emitted exactly twice (once per Auto arm)');\n}\n\n// ---------- B2 ----------\nsection('B2: injection placement in BOTH arms (real source, postgres present)');\nconst injected = injectListenerFaultHealthChecks(realSource, DATABASE.POSTGRES);\nconst lines = injected.split('\\n');\nconst { ifLine, elseLine, closeLine } = armBounds(injected);\nconst testKeyReg = (l: string) => l.includes(`builder.addHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}'`);\nconst testKeyAwait = (l: string) =>\n  l.includes(`.withHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}')`);\n\nconst containerRegs = lines.slice(ifLine, elseLine).map((l, i) => ({ l, i: i + ifLine })).filter((x) => testKeyReg(x.l));\nconst execRegs = lines.slice(elseLine, closeLine).map((l, i) => ({ l, i: i + elseLine })).filter((x) => testKeyReg(x.l));\nconst outsideRegs = lines.filter((l) => testKeyReg(l)).length - containerRegs.length - execRegs.length;\n\nconsole.log('ifLine/elseLine/closeLine:', ifLine, elseLine, closeLine);\nconsole.log('test-only addHealthCheck in CONTAINER arm:', containerRegs.length, 'at lines', containerRegs.map((x) => x.i + 1));\nconsole.log('test-only addHealthCheck in ELSE arm:    ', execRegs.length, 'at lines', execRegs.map((x) => x.i + 1));\nconsole.log('test-only addHealthCheck outside arms:   ', outsideRegs);\nconsole.log('test-only withHealthCheck awaits total:  ', lines.filter(testKeyAwait).length);\nconsole.log('postgres test key registrations:', lines.filter((l) => l.includes(`builder.addHealthCheck('${TEST_ONLY_POSTGRES_HEALTH_KEY}'`)).length);\n\n// each registration must be followed by an await bound to that arm's own binding\nfor (const [name, reg] of [['container', containerRegs[0]], ['else', execRegs[0]]] as const) {\n  if (!reg) { console.log(`!!! B2: no registration found in ${name} arm`); continue; }\n  const next1 = lines[reg.i + 1], next2 = lines[reg.i + 2];\n  console.log(`[${name} arm] line after reg: ${next1.trim()}`);\n  console.log(`[${name} arm] line after that: ${next2.trim()}`);\n  if (!next1.includes(TEST_ONLY_GARNET_HEALTH_KEY) || !next2.includes('.withHealthCheck(')) {\n    console.log(`!!! B2 FAILED: ${name} arm registration not immediately followed by its await`);\n  } else if (!next2.includes('cache_1')) {\n    console.log(`!!! B2 FAILED: ${name} arm await not bound to that arm's resource`);\n  }\n}\nconst realInContainer = lines.slice(ifLine, elseLine).filter((l) => l.includes('withHealthCheck(\"garnet_resp\")')).length;\nconst realInExec = lines.slice(elseLine, closeLine).filter((l) => l.includes('withHealthCheck(\"garnet_resp\")')).length;\nconsole.log('real garnet_resp attachments: container arm', realInContainer, '/ else arm', realInExec);\nconst prevBug = containerRegs.length === 2 && execRegs.length === 0;\nconsole.log(prevBug ? '!!! PREVIOUS BUG REPRODUCED (2 in first arm, 0 in second)' : 'B2 OK: exactly one test-only registration per arm, none outside');\n\n// Also verify SQLITE variant (no postgres injection) — the committed test's database choice.\nconst injectedSqlite = injectListenerFaultHealthChecks(realSource, DATABASE.SQLITE);\nconst sqliteLines = injectedSqlite.split('\\n');\nconsole.log('SQLITE variant: garnet test-key regs =', sqliteLines.filter(testKeyReg).length,\n  '| postgres test-key regs =', sqliteLines.filter((l) => l.includes(`builder.addHealthCheck('${TEST_ONLY_POSTGRES_HEALTH_KEY}'`)).length);\n\nawait Deno.writeTextFile(new URL('./injected-real.mts', import.meta.url), injected);\n\n// ---------- B5 ----------\nsection('B5: fail-closed paths');\n// (a) zero garnet attachments (remove both lines from real source)\nconst zero = realSource.split('\\n').filter((l) => !l.includes('withHealthCheck(\"garnet_resp\")')).join('\\n');\ntry {\n  injectListenerFaultHealthChecks(zero, DATABASE.POSTGRES);\n  console.log('!!! B5 FAILED: zero-attachment input did not throw');\n} catch (error) {\n  console.log('zero-attachment threw:', (error as Error).message);\n}\n// (b) a source with NO resp caches at all\nconst noResp = generateRegisterInfrastructure({ databases: {}, caches: {}, primaryCache: undefined });\ntry {\n  injectListenerFaultHealthChecks(noResp, DATABASE.POSTGRES);\n  console.log('!!! B5 FAILED: cache-less input did not throw');\n} catch (error) {\n  console.log('cache-less threw:', (error as Error).message);\n}\n// (c) test-only key already present anywhere\ntry {\n  injectListenerFaultHealthChecks(injected, DATABASE.POSTGRES);\n  console.log('!!! B5 FAILED: already-injected input did not throw');\n} catch (error) {\n  console.log('already-registered threw:', (error as Error).message);\n}\n// (d) not-unique is no longer an error: N>=1 accepted (already proven by B2, restate)\nconsole.log('multiple real attachments accepted (no throw):', countAttachments(injected, 'garnet_resp') >= 2 ? 'yes (B2 injected a 2-attachment source)' : 'unknown');\n// (e) the old conflated message must be gone from the product module\nconst productSource = await Deno.readTextFile(\n  new URL('../../../packages/cli/e2e/src/application/gates/scaffold/runtime/prepare-readiness-fixture.ts', import.meta.url),\n);\nconsole.log('old ambiguous message (\"has no garnet health-check marker\") present in product source:',\n  productSource.includes('has no garnet health-check marker'));\nconsole.log('absent-message:', productSource.includes('has no garnet health-check attachment') ? '\"no garnet health-check attachment\"' : 'MISSING');\nconsole.log('already-registered-message:', productSource.includes('test-only listener health checks were already registered') ? 'present' : 'MISSING');\n\n// ---------- B6 runtime half moved to b6.ts (operates on ./injected-real.mts) ----------\n","structuredPatch":[{"oldStart":99,"oldLines":13,"newStart":99,"newLines":14,"lines":[" // each registration must be followed by an await bound to that arm's own binding"," for (const [name, reg] of [['container', containerRegs[0]], ['else', execRegs[0]]] as const) {","   if (!reg) { console.log(`!!! B2: no registration found in ${name} arm`); continue; }","-  const next1 = lines[reg.i + 1], next2 = lines[reg.i + 2];","+  const next1 = lines[reg.i + 1];","   console.log(`[${name} arm] line after reg: ${next1.trim()}`);","-  console.log(`[${name} arm] line after that: ${next2.trim()}`);","-  if (!next1.includes(TEST_ONLY_GARNET