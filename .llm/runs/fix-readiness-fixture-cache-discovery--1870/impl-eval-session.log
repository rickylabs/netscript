= match.index;\n187\t    if (healthCheckKey === key && resourceBinding && startOffset !== undefined) {\n188\t      attachments.push({\n189\t        endOffset: startOffset + match[0].length,\n190\t        healthCheckKey,\n191\t        resourceBinding,\n192\t        startOffset,\n193\t        statement: match[0],\n194\t      });\n195\t    }\n196\t  }\n197\t  return attachments;\n198\t}\n199\t\n200\tfunction assertGeneratedHealthAttachment(source: string, key: string): void {\n201\t  const attachments = healthAttachments(source, key);\n202\t  if (attachments.length === 0) {\n203\t    throw new Error(`infrastructure generator omitted ${key} attachment marker`);\n204\t  }\n205\t}\n206\t\n207\tfunction injectAtHealthAttachments(\n208\t  source: string,\n209\t  attachments: readonly HealthAttachment[],\n210\t  injectedBlock: (attachment: HealthAttachment, indentation: string) => string,\n211\t): string {\n212\t  let injected = source;\n213\t  const descendingAttachments = [...attachments].sort((left, right) =>\n214\t    right.startOffset - left.startOffset\n215\t  );\n216\t  for (const attachment of descendingAttachments) {\n217\t    const indentation = attachment.statement.match(/^[ \\t]*/u)?.[0] ?? '';\n218\t    injected = `${injected.slice(0, attachment.endOffset)}\\n${\n219\t      injectedBlock(attachment, indentation)\n220\t    }${injected.slice(attachment.endOffset)}`;\n221\t  }\n222\t  return injected;\n223\t}\n224\t\n225\tfunction appRegistrations(source: string, name: string): readonly RegExpMatchArray[] {\n226\t  return [...source.matchAll(APP_REGISTRATION_PATTERN)].filter((match) =>\n227\t    (match[1] ?? match[2]) === name\n228\t  );\n229\t}\n230\t\n231\tfunction appBlock(generated: string, name: string): string {\n232\t  const registrations = appRegistrations(generated, name);\n233\t  if (registrations.length !== 1) {\n234\t    throw new Error(`generator did not emit ${name} fixture block`);\n235\t  }\n236\t  const registrationIndex = registrations[0].index;\n