Deno.test('amounts are grouped and carry two fraction digits by default', () => {
  assertEquals(formatMoney('1240'), '1,240.00');
  assertEquals(formatMoney('1234567.5'), '1,234,567.50');
  assertEquals(formatMoney('0.5'), '0.50');
});

Deno.test('precision is never flattened — a metered unit price keeps its decimals', () => {
  // The bug this guards: rendering a 4-dp unit price as 0.00 on an invoice line.
  assertEquals(formatMoney('0.0015'), '0.0015');
  assertEquals(formatMoney('0.000025'), '0.000025');
  assertEquals(formatMoney('12.345678'), '12.345678');
  // …and an explicit precision still wins when a surface calls for one.
  assertEquals(formatMoney('12.345678', { precision: 2 }), '12.35');
});

Deno.test('currency is carried as a symbol and separated from the amount', () => {
  const parts = moneyParts('1240', { currency: 'USD' });
  assertEquals(parts.currency, '$');
  assertEquals(parts.magnitude, '1,240.00');
  assertEquals(formatMoney('1240', { currency: 'USD' }), '1,240.00');
});

Deno.test('no float artefacts: string decimals survive the round trip', () => {
  // 0.1 + 0.2 style drift must never reach the screen.
  assertEquals(formatMoney('0.1'), '0.10');
  assertEquals(formatMoney('0.07'), '0.07');
  assertEquals(formatMoney('2.675', { precision: 2 }), '2.68');
  assertEquals(formatMoney('99999999999999.9999'), '99,999,999,999,999.9999');
});

