/* ns-money-text — components/product/money-text.tsx
   Token-driven money rendering: tabular numerals over the numeric font,
   pos/neg/flat intent via data-money-sign, muted currency prefix, and an em
   dash for absence (never a fabricated zero). */

.ns-money-text {
  display: inline-flex;
  align-items: baseline;
  gap: var(--ns-space-px);
  color: var(--ns-money-flat);
  font-family: var(--ns-font-numeric);
  font-variant-numeric: var(--ns-numeric-tabular);
  font-size: var(--ns-text-money);
  line-height: var(--ns-leading-tight);
  /* A column of figures aligns on the decimal point, so an amount never
     breaks across lines. */
  white-space: nowrap;
}

.ns-money-text[data-money-sign='pos'] {
  color: var(--ns-money-pos);
}

.ns-money-text[data-money-sign='neg'] {
  color: var(--ns-money-neg);
}

.ns-money-text[data-money-sign='flat'],
.ns-money-text[data-money='absent'] {
  color: var(--ns-money-flat);
}

/* A currency symbol is a prefix, not a suffix, and it lives in its own element
   so it can never concatenate onto the digits as `100.00USD`. */
.ns-money-text__currency {
  color: var(--ns-muted-fg);
  font-family: var(--ns-font-mono);
  font-size: 0.75em;
}
