import json,io,re
css=io.open('apps/ledgerline-web/assets/tokens.css',encoding='utf-8').read()
d=json.load(io.open('apps/ledgerline-web/assets/tokens.json',encoding='utf-8'))
def collect(o,out):
    if isinstance(o,dict):
        if 'cssVar' in o and 'value' in o: out.add(o['cssVar'])
        for v in o.values(): collect(v,out)
    elif isinstance(o,list):
        for v in o: collect(v,out)
declared=set(); collect(d,declared)
defined=set(re.findall(r'(--ns-[a-z0-9-]+)\s*:',css))
print('tokens.json declares :',len(declared))
print('tokens.css defines   :',len(defined))
miss=sorted(declared-defined); extra=sorted(defined-declared)
print('in JSON but not CSS  :',miss or 'none')
print('in CSS but not JSON  :',extra or 'none')
for n in ('--ns-control-thumb','--ns-shadow-drawer'):
    print(f'{n}: json={n in declared} css={n in defined}')
# value parity
def cval(name,block):
    m=re.search(re.escape(name)+r':\s*([^;]+);',block); return m.group(1).strip() if m else None
light=css.split("[data-theme='dark']")[0]; dark=css.split("[data-theme='dark']")[1]
print('light control-thumb css:',cval('--ns-control-thumb',light))
print('dark  control-thumb css:',cval('--ns-control-thumb',dark))
print('light shadow-drawer css:',cval('--ns-shadow-drawer',light))
print('dark  shadow-drawer css:',cval('--ns-shadow-drawer',dark))
