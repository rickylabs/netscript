/**
 * Run summary header — server component for the run detail `summary` layer.
 *
 * Shows period, status, and the console totals. Missing totals render as em
 * dashes; a failed console read degrades the stats section, never the header.
 */

import {
  Card,
  EmptyState,
  InlineNotice,
  MoneyText,
  Skeleton,
  StatsGrid,
  StatusBadge,
} from '@app/components/ui/mod.ts';
import type { RunConsoleV1, RunV1 } from '@ledgerline/contracts';
import type { VNode } from 'preact';

export interface RunSummaryProps {
  state: 'found' | 'not-found' | 'unavailable' | 'denied';
  run?: RunV1;
  totals?: RunConsoleV1['totals'];
}

export function RunSummarySkeleton(): VNode {
  return (
    <div class='ns-stack ns-stack--md'>
      <Card>
        <Card.Body class='ns-stack ns-stack--sm'>
          <Skeleton variant='detail' rows={2} />
        </Card.Body>
      </Card>
      <Skeleton variant='stats' cards={4} />
    </div>
  );
}

function formatPeriod(run: RunV1): string {
  return `${run.periodStart.slice(0, 10)} → ${run.periodEnd.slice(0, 10)}`;
}

