export default function RunSummary({ state, run, totals }: RunSummaryProps): VNode {
  if (state === 'not-found') {
    return (
      <Card>
        <Card.Body>
          <EmptyState heading='Run not found'>
            The run id does not exist (or was created before the console's data window).
          </EmptyState>
        </Card.Body>
      </Card>
    );
  }

  if (state === 'denied') {
    return (
      <Card>
        <Card.Body>
          <InlineNotice title='Permission denied' variant='destructive'>
            The console's service token does not carry the runs:read scope.
          </InlineNotice>
        </Card.Body>
      </Card>
    );
  }

  if (state === 'unavailable' || !run) {
    return (
      <Card>
        <Card.Body>
          <InlineNotice title='Runs service unavailable' variant='destructive'>
            The runs service did not answer. Retry in a moment.
          </InlineNotice>
        </Card.Body>
      </Card>
    );
  }

  return (
    <div class='ns-stack ns-stack--md'>
      <Card>
        <Card.Body class='ns-stack ns-stack--sm'>
          <div class='ns-cluster ns-cluster--sm'>
            <span class='font-mono text-xs text-ns-muted-fg'>{run.id}</span>
            <StatusBadge status={run.status === 'ISSUING' ? 'in-flight' : run.status} />
            {run.notes && <span class='text-xs text-ns-muted-fg'>{run.notes}</span>}
          </div>
          <h1 class='text-lg font-medium text-ns-fg'>{formatPeriod(run)}</h1>
        </Card.Body>
      </Card>
      {totals
        ? (
          <StatsGrid>
            <StatsGrid.Card
              label='Computed'
              value={<MoneyText value={totals.computed} currency='USD' />}
              detail='Total value measured across eligible items'
            />
            <StatsGrid.Card
              label='Issued'
              value={<MoneyText value={totals.issued} currency='USD' />}
              detail={`${run.issuedCount} invoices issued`}
            />
            <StatsGrid.Card
              label='Pending items'
              value={<span class='tabular-nums'>{totals.pendingCount}</span>}
            />
            <StatsGrid.Card
              label='Failed items'
              badge={totals.failedCount > 0 ? <StatusBadge status='FAILED' /> : undefined}
              value={<span class='tabular-nums'>{totals.failedCount}</span>}
              detail={totals.failedCount > 0 ? 'Review exceptions before issuing' : undefined}
            />
          </StatsGrid>
        )
        : (
          <InlineNotice title='Console totals unavailable' variant='warning'>
            The run loaded but its console projection did not answer, so totals are shown as em
            dashes until the service recovers.
