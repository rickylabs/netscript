# Union resolution: keep both demo branches. The HEAD demos (avatar/donut/dropzone etc) and
# the design lane's widget demos both must render. Remove markers, keep both bodies.
pattern = re.compile(r'<<<<<<< HEAD\n(.*?)=======\n(.*?)>>>>>>> design/ledgerline-ui\n', re.DOTALL)
