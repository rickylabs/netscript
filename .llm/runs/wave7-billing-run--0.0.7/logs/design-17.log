  // Credit note lifecycle
  APPLIED: 'status-paid',
};

/**
 * Derived ledger states — computed at the call sites from real facts (a PAID
 * invoice with a failed/refunded payment, a run mid-issue, a saga queued for
 * compensation), never invented as enum values. Keys map to their
 * `data-status` CSS hooks in status-badge.css.
 */
export const DERIVED_STATUS_LABELS: Readonly<Record<string, string>> = {
  'part-paid': 'part paid',
  'partially-refunded': 'partially refunded',
  'retrying': 'retrying',
  'in-flight': 'in flight',
};

interface StatusBadgeProps {
  status: string;
  /** Derived ledger state rendered instead of the raw enum literal. */
  derived?: keyof typeof DERIVED_STATUS_LABELS;
  class?: string;
}
