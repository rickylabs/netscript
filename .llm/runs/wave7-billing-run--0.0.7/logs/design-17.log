/**
 * @component TransitionFeed
 * @layer 2
 * @kind product
 * @description Recency-first list of run status transitions with chips and timestamps.
 */

import type { VNode } from 'preact';
import { cn } from '../../lib/cn.ts';
import { StatusBadge } from './status-badge.tsx';

/** One persisted run-state transition as mirrored into the console stream. */
export interface TransitionItem {
  readonly id: string;
  readonly status: string;
  readonly at: string;
}

interface TransitionFeedProps {
  items: readonly TransitionItem[];
  class?: string;
}

/**
 * Deterministic UTC clock time (HH:MM:SS) from an ISO instant. Formatting
 * must not depend on the rendering host's timezone: the same item renders
 * through this component during SSR and again on hydration (and later from
 * live stream events), so a locale- or TZ-sensitive format would disagree
 * with itself across those renders.
 */
function formatTimestamp(at: string): string {
  const date = new Date(at);
  if (Number.isNaN(date.getTime())) return at;
  const hh = String(date.getUTCHours()).padStart(2, '0');
  const mm = String(date.getUTCMinutes()).padStart(2, '0');
  const ss = String(date.getUTCSeconds()).padStart(2, '0');
  return `${hh}:${mm}:${ss}Z`;
}

/**
 * Renders live run transitions, most recent first. Server-loaded history and
 * stream-fed updates render through the same component.
 */
export function TransitionFeed({ items, class: className }: TransitionFeedProps): VNode {
  const ordered = [...items].sort((a, b) => b.at.localeCompare(a.at));
