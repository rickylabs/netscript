export interface FooterColumn {
  /** Quiet uppercase label, e.g. `APPROVED`. */
  readonly label: string;
  /** Preformatted amount. `null` renders the em dash (M1). */
  readonly value: string | null;
  /**
   * Direction of the amount, which is a domain fact — approved is towards us,
   * excepted is away — and never a colour decision at the call site (M5).
   * Omitted leaves the amount in the surface's own foreground.
   */
  readonly direction?: MoneyDirection;
  /** Optional tinted icon tile above the amount. */
  readonly glyph?: Renderable;
}

export interface FooterColumnsProps
  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children'> {
  columns: readonly FooterColumn[];
  class?: string;
}

/**
 * A hairline-divided footer strip.
 *
 * A column whose value is `null` is a fact that was not measured, so it renders
 * the em dash in the absent tone — the footer is exactly where a fabricated
 * `0.00` would do the most damage.
export interface GaugeSegment {
  readonly value: number;
  /** Legend name, e.g. `Issued`. */
  readonly label: string;
  /** Preformatted amount for the legend, e.g. `$842,000.00`. */
  readonly display: string;
  /** Series slot. Defaults to the segment's index in the cycle. */
  readonly series?: GaugeSeries;
}

export interface SemicircularGaugeProps
  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children'> {
  segments: readonly GaugeSegment[];
  /**
   * The denominator — every item the run covers, including the ones no segment
   * accounts for. Omitted means the segments are the whole. `null` means the
   * total was not measured, which renders the empty frame (H7, M1).
   */
  total?: number | null;
  /** Quiet uppercase label above the centre amount, e.g. `ISSUED`. */
  label: string;
  /** The preformatted centre amount. */
  value: string;
  /** Quiet line under the centre amount. */
  caption?: string;
  /** Show the inline dot legend below the rule (C6). Defaults to true. */
  legend?: boolean;
  /** Copy for the labelled empty frame. */
  emptyLabel?: string;
  /** Tighten the centre amount for narrow rails. */
  compact?: boolean;
  class?: string;
}
export interface AreaChartPoint {
  readonly value: number;
  /** Point name for the readout and, by default, the x-axis. */
  readonly label: string;
  /** Preformatted value for the readout. */
  readonly display: string;
}

export interface ComparisonAreaChartProps
  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children'> {
  points: readonly AreaChartPoint[];
  /** The comparison period. Same geometry, translucent, no stroke. */
  comparison?: readonly AreaChartPoint[] | null;
  /** Name for the comparison layer, e.g. `Previous period`. */
  comparisonLabel?: string;
  /** Name for the current layer, e.g. `This period`. */
  seriesLabel?: string;
  /**
   * Y-axis ticks, topmost first and preformatted, spread evenly from the top
   * gridline to the baseline. The topmost carries the currency (H6); the rest
   * are bare magnitudes. Omit for a chrome-free chart.
   */
  ticks?: readonly string[];
  /** X-axis labels. Defaults to each point's `label`. */
  xLabels?: readonly string[];
  /** Series slot for the current period. Defaults to 1. */
  series?: AreaSeries;
export interface SegmentedControlOption {
  /** Range key — `1D`, `1W`, `1M`, `3M`, `1Y`, or a product range id. */
  readonly value: string;
  /** Preformatted cell label. */
  readonly label: string;
  /** Render the cell as a link, so the range lives in the URL. */
  readonly href?: string;
  readonly disabled?: boolean;
}
