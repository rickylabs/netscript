/**
 * @component ProvisionalTag
 * @layer 2
 * @kind product
 * @description Small tag marking numbers that are not yet settled.
 */

import type { VNode } from 'preact';
import { cn } from '../../lib/cn.ts';

interface ProvisionalTagProps {
  /** Override the default label when a longer qualifier is needed. */
  label?: string;
  class?: string;
}

/**
 * Renders the provisional marker. Finance surfaces attach it to figures that
 * still depend on unresolved run items, so readers never mistake a moving
 * number for a booked one.
 */
export function ProvisionalTag(
  { label = 'provisional', class: className }: ProvisionalTagProps,
): VNode {
  return (
    <span class={cn('ns-badge', 'ns-provisional-tag', className)} data-provisional=''>
      {label}
    </span>
  );
}
