import { createServiceClient } from '@netscript/sdk/client';
import { createServiceQueryUtils } from '@netscript/sdk/query-client';
import { BillingContractV1 } from '@ledgerline/contracts';

export const billingName = 'billing';
export const billingRouterName = 'billing';
export const billingContract = BillingContractV1;

export const billingClient = createServiceClient<typeof billingContract>({
  contract: billingContract,
  serviceName: billingName,
  routerName: billingRouterName,
});

/**
 * Typed TanStack query utils over the billing contract.
 *
 * The billing contract nests procedures under resource groups
 * (`billing.invoices.list`), and `createQueryFactories` only exposes flat
 * contracts, so the billing data layer uses the thin oRPC/TanStack remap —
 * `queryOptions({ input })` / `.key()` / `.mutationOptions()` with the full
 * nested inference. Runs/webhooks keep `createQueryFactories` (flat
 * contracts) in their own lib modules.
 */
export const billingQueryUtils = createServiceQueryUtils(billingClient, {
  path: ['billing'],
});
