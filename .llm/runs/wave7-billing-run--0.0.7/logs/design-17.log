 /**
+ * Sums one class of payment — collected, or refunded.
+ *
+ * An empty list is a **measured zero**, not absence: "no payment has been
+ * recorded" is a fact the ledger states, and reporting it as unmeasured would
+ * hide a real outstanding balance behind an em dash. `sumMoney` keeps its own
+ * stricter rule for values that failed to parse, so a payment whose amount did
+ * not come back still degrades rather than being folded in as zero.
+ */
+function sumPayments(
+  payments: readonly { status: string; amount: string }[],
+  statuses: ReadonlySet<string>,
+): string | null {
+  const matching = payments.filter((payment) => statuses.has(payment.status));
+  if (matching.length === 0) return '0.00';
+  return sumMoney(matching.map((payment) => payment.amount));
+}
