database/postgres/schema/.generated/internal/class.ts:23:  "inlineSchema": "/// better-auth user record.\nmodel AuthUser {\n  id            String        @id @db.VarChar(191)\n  name          String        @db.VarChar(255)\n  email         String        @unique @db.VarChar(320)\n  emailVerified Boolean       @default(false) @map(\"email_verified\")\n  image         String?       @db.Text\n  createdAt     DateTime      @default(now()) @map(\"created_at\")\n  updatedAt     DateTime      @updatedAt @map(\"updated_at\")\n  sessions      AuthSession[]\n  accounts      AuthAccount[]\n\n  @@map(\"auth_users\")\n}\n\n/// better-auth session record.\nmodel AuthSession {\n  id        String   @id @db.VarChar(191)\n  expiresAt DateTime @map(\"expires_at\")\n  token     String   @unique @db.VarChar(191)\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n  ipAddress String?  @map(\"ip_address\") @db.VarChar(255)\n  userAgent String?  @map(\"user_agent\") @db.Text\n  userId    String   @map(\"user_id\") @db.VarChar(191)\n  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId])\n  @@map(\"auth_sessions\")\n}\n\n/// better-auth account/provider record.\nmodel AuthAccount {\n  id                    String    @id @db.VarChar(191)\n  accountId             String    @map(\"account_id\") @db.VarChar(191)\n  providerId            String    @map(\"provider_id\") @db.VarChar(191)\n  userId                String    @map(\"user_id\") @db.VarChar(191)\n  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)\n  accessToken           String?   @map(\"access_token\") @db.Text\n  refreshToken          String?   @map(\"refresh_token\") @db.Text\n  idToken               String?   @map(\"id_token\") @db.Text\n  accessTokenExpiresAt  DateTime? @map(\"access_token_expires_at\")\n  refreshTokenExpiresAt DateTime? @map(\"refresh_token_expires_at\")\n  scope                 String?   @db.Text\n  password              String?   @db.Text\n  createdAt             DateTime  @default(now()) @map(\"created_at\")\n  updatedAt             DateTime  @updatedAt @map(\"updated_at\")\n\n  @@unique([providerId, accountId], name: \"auth_accounts_provider_account\")\n  @@index([userId])\n  @@map(\"auth_accounts\")\n}\n\n/// better-auth verification token record.\nmodel AuthVerification {\n  id         String   @id @db.VarChar(191)\n  identifier String   @db.VarChar(255)\n  value      String   @db.Text\n  expiresAt  DateTime @map(\"expires_at\")\n  createdAt  DateTime @default(now()) @map(\"created_at\")\n  updatedAt  DateTime @updatedAt @map(\"updated_at\")\n\n  @@index([identifier])\n  @@map(\"auth_verifications\")\n}\n\n// Sagas Plugin Prisma Schema\n// This schema defines the database tables for the sagas plugin.\n// Runtime saga state can be persisted by KV or the dedicated Prisma durable\n// runtime tables below. The existing SagaInstance/SagaExecutionHistory models\n// remain a Postgres read model/projection for API querying, analytics, and\n// debugging.\n\n// ============================================================================\n// DURABLE SAGA RUNTIME STATE\n// ============================================================================\n\n/// Durable saga state envelope keyed by native saga instance id\nmodel SagaRuntimeState {\n  /// Native saga runtime instance id (for example, \"OrderSaga:order-123\")\n  instanceId String @id @map(\"instance_id\") @db.VarChar(200)\n\n  /// Saga definition id/name\n  sagaId String @map(\"saga_id\") @db.VarChar(100)\n\n  /// Optimistic concurrency version\n  version Int\n\n  /// Full SagaStateEnvelope payload\n  envelope Json\n\n  /// Record timestamps\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  @@index([sagaId])\n  @@index([updatedAt])\n  @@map(\"saga_runtime_state\")\n}\n\n/// Durable saga transition history keyed by instance id and version\nmodel SagaRuntimeTransition {\n  /// Native saga runtime instance id\n  instanceId String @map(\"instance_id\") @db.VarChar(200)\n\n  /// Saga state version produced by this transition\n  version Int\n\n  /// Full SagaTransitionRecord payload\n  record Json\n\n  /// Record timestamps\n  createdAt DateTime @default(now()) @map(\"created_at\")\n\n  @@id([instanceId, version], name: \"saga_runtime_transition_instance_version\")\n  @@index([instanceId])\n  @@map(\"saga_runtime_transition\")\n}\n\n/// Durable saga correlation index for O(1) instance lookup\nmodel SagaRuntimeCorrelation {\n  /// Internal row id\n  id String @id @default(uuid()) @db.Uuid\n\n  /// Saga definition id/name\n  sagaId String @map(\"saga_id\") @db.VarChar(100)\n\n  /// Correlation key from the inbound message\n  correlationKey String @map(\"correlation_key\") @db.VarChar(200)\n\n  /// Native saga runtime instance id\n  instanceId String @map(\"instance_id\") @db.VarChar(200)\n\n  /// Record timestamps\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  @@unique([sagaId, correlationKey], map: \"saga_runtime_correlation_saga_key\")\n  @@index([instanceId])\n  @@map(\"saga_runtime_correlation\")\n}\n\n// ============================================================================\n// SAGA INSTANCE\n// ============================================================================\n\n/// Saga instance read-model state projected into Postgres for API queries\n/// This projection is distinct from the native saga engine's durable write path\nmodel SagaInstance {\n  /// Unique saga instance identifier (UUID)\n  id String @db.VarChar(100)\n\n  /// Name of the saga definition (e.g., 'OrderSaga', 'PaymentSaga')\n  sagaName String @map(\"saga_name\") @db.VarChar(100)\n\n  /// Correlation ID for message routing and lookup\n  correlationId String @map(\"correlation_id\") @db.VarChar(100)\n\n  /// Version for optimistic concurrency control\n  version Int @default(1)\n\n  /// Whether the saga has completed (terminal state)\n  isCompleted Boolean @default(false) @map(\"is_completed\")\n\n  /// The saga state as JSON (contains all saga-specific data)\n  state Json\n\n  /// Record timestamps\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  // Composite primary key for stable API read-model lookups\n  @@id([sagaName, id], name: \"sagaName_id\")\n  // Index for correlation ID lookups (message routing)\n  @@index([sagaName, correlationId])\n  // Index for completed saga cleanup\n  @@index([sagaName, isCompleted])\n  // Index for updated timestamp (cleanup queries)\n  @@index([updatedAt])\n  @@map(\"saga_instances\")\n}\n\n// ============================================================================\n// SAGA DEFINITION (Optional - for dynamic saga registration)\n// ============================================================================\n\n/// Saga definition metadata - tracks registered sagas\n/// Note: Saga definitions from code are loaded at startup, this is for dynamic registration\nmodel SagaDefinition {\n  /// Unique saga name (e.g., 'OrderSaga')\n  name String @id @db.VarChar(100)\n\n  /// Human-readable display name\n  displayName String @map(\"display_name\") @db.VarChar(255)\n\n  /// Saga description\n  description String? @db.Text\n\n  /// Group/category for organization\n  groupName String? @map(\"group_name\") @db.VarChar(100)\n\n  /// Where this saga is defined: code, plugin, database\n  source String @default(\"code\") @db.VarChar(20)\n\n  /// Plugin ID that registered this saga (if source is 'plugin')\n  pluginId String? @map(\"plugin_id\") @db.VarChar(100)\n\n  /// Message types this saga handles (JSON array)\n  handledTypes Json? @map(\"handled_types\")\n\n  /// Initial state factory type/config (JSON)\n  initialState Json? @map(\"initial_state\")\n\n  /// Whether the saga is enabled\n  enabled Boolean @default(true)\n\n  /// Tags for categorization\n  tags String[] @default([])\n\n  /// Additional metadata (JSON)\n  metadata Json?\n\n  /// Record timestamps\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  @@index([source])\n  @@index([groupName])\n  @@index([enabled])\n  @@index([tags])\n  @@map(\"saga_definitions\")\n}\n\n// ============================================================================\n// SAGA EXECUTION HISTORY (Optional - for analytics and debugging)\n// ============================================================================\n\n/// Saga execution history - archived saga state transitions for debugging\nmodel SagaExecutionHistory {\n  /// Unique history entry ID\n  id String @id @default(uuid()) @db.Uuid\n\n  /// Saga name\n  sagaName String @map(\"saga_name\") @db.VarChar(100)\n\n  /// Saga instance ID\n  sagaId String @map(\"saga_id\") @db.VarChar(100)\n\n  /// Correlation ID\n  correlationId String @map(\"correlation_id\") @db.VarChar(100)\n\n  /// Message type that triggered this transition\n  messageType String @map(\"message_type\") @db.VarChar(100)\n\n  /// Message ID\n  messageId String? @map(\"message_id\") @db.VarChar(100)\n\n  /// State before the transition (JSON)\n  previousState Json? @map(\"previous_state\")\n\n  /// State after the transition (JSON)\n  newState Json @map(\"new_state\")\n\n  /// Transition outcome: success, error, compensated\n  outcome String @db.VarChar(20)\n\n  /// Error message if outcome is error\n  error String? @db.Text\n\n  /// Duration of handler execution in milliseconds\n  duration Int?\n\n  /// Timestamp of the transition\n  transitionAt DateTime @default(now()) @map(\"transition_at\")\n\n  @@index([sagaName, sagaId])\n  @@index([sagaName, correlationId])\n  @@index([transitionAt])\n  @@index([outcome])\n  @@map(\"saga_execution_history\")\n}\n\n// Triggers Plugin Prisma Schema\n// This schema defines the database tables for the triggers plugin.\n// Phase 2: Minimal stub for plugin manifest. Full event persistence in Phase 5.\n\n// ============================================================================\n// TRIGGER EVENT\n// ============================================================================\n\n/// Trigger event persistence — records fired trigger events for audit and replay.\n/// Phase 2 creates the schema; Phase 5 fully implements event storage.\nmodel TriggerEvent {\n  /// Unique event identifier (UUID)\n  id String @id @default(uuid()) @db.Uuid\n\n  /// ID of the trigger that fired\n  triggerId String @map(\"trigger_id\") @db.VarChar(100)\n\n  /// Trigger type (file, webhook, cron, etc.)\n  triggerType String @map(\"trigger_type\") @db.VarChar(50)\n\n  /// Event status (detected, processing, completed, failed)\n  status String @db.VarChar(20)\n\n  /// Event payload (file path, webhook body, etc.)\n  payload Json?\n\n  /// Content hash for deduplication\n  contentHash String? @map(\"content_hash\") @db.VarChar(64)\n\n  /// Action results (JSON array of ActionResult)\n  actionResults Json? @map(\"action_results\")\n\n  /// Error message if status is failed\n  error String? @db.Text\n\n  /// Record timestamps\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  @@index([triggerId])\n  @@index([status])\n  @@index([triggerType])\n  @@index([createdAt])\n  @@index([triggerId, status])\n  @@map(\"trigger_events\")\n}\n\n// ============================================================================\n// TRIGGER DEFINITION (Optional — for runtime-created triggers)\n// ============================================================================\n\n/// Trigger definition metadata — tracks triggers registered via API.\n/// Code-defined triggers are loaded at startup; this is for dynamic registration.\nmodel TriggerDefinition {\n  /// Unique trigger identifier (kebab-case)\n  id String @id @db.VarChar(100)\n\n  /// Human-readable display name\n  name String @db.VarChar(255)\n\n  /// Trigger description\n  description String? @db.Text\n\n  /// Trigger type (file, webhook, cron, etc.)\n  type String @db.VarChar(50)\n\n  /// Whether the trigger is active\n  enabled Boolean @default(true)\n\n  /// Topic grouping (mirrors worker topics)\n  topic String @default(\"default\") @db.VarChar(100)\n\n  /// Tags for categorization\n  tags String[] @default([])\n\n  /// Where this trigger is defined: code, api, config\n  source String @default(\"code\") @db.VarChar(20)\n\n  /// Full trigger configuration (JSON)\n  config Json?\n\n  /// Additional metadata (JSON)\n  metadata Json?\n\n  /// Record timestamps\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  @@index([type])\n  @@index([enabled])\n  @@index([topic])\n  @@index([source])\n  @@index([tags])\n  @@map(\"trigger_definitions\")\n}\n\n// Workers Plugin Prisma Schema\n// This schema defines the database tables for the workers plugin.\n// Job definitions are stored in Postgres for persistence and querying.\n// Note: Execution records remain in KV for real-time performance.\n\n// ============================================================================\n// JOB DEFINITION\n// ============================================================================\n\n/// Job definition - stored in Postgres for persistence\n/// This tracks registered jobs, their configuration, and source information.\nmodel JobDefinition {\n  /// Unique job identifier (e.g., 'export-data', 'analytics-cleanup')\n  id String @id @db.VarChar(100)\n\n  /// Human-readable name\n  name String @db.VarChar(255)\n\n  /// Job description\n  description String? @db.Text\n\n  /// Where this job definition comes from: local, plugin, database, remote\n  source String @default(\"database\") @db.VarChar(20)\n\n  /// Plugin ID that registered this job (if source is 'plugin')\n  pluginId String? @map(\"plugin_id\") @db.VarChar(100)\n\n  /// How this job should be executed: deno, task, wrapper\n  executionType String @default(\"deno\") @map(\"execution_type\") @db.VarChar(20)\n\n  /// Path to the job entrypoint script (for deno execution)\n  entrypoint String? @db.VarChar(500)\n\n  /// Remote URL for the script (for remote source)\n  sourceUrl String? @map(\"source_url\") @db.VarChar(1000)\n\n  /// Import map URL for Deno\n  importMapUrl String? @map(\"import_map_url\") @db.VarChar(1000)\n\n  /// Allowed hosts for dynamic imports (JSON array)\n  allowedImportHosts Json? @map(\"allowed_import_hosts\")\n\n  /// Task ID to execute (for task execution type)\n  taskId String? @map(\"task_id\") @db.VarChar(100)\n\n  /// Task type if using inline task (not referencing registered task)\n  taskType String? @map(\"task_type\") @db.VarChar(20)\n\n  /// Wrapper type name (for wrapper execution type)\n  wrapperType String? @map(\"wrapper_type\") @db.VarChar(50)\n\n  /// Wrapper configuration object (JSON)\n  wrapperConfig Json? @map(\"wrapper_config\")\n\n  /// Cron schedule expression\n  schedule String? @db.VarChar(100)\n\n  /// Timezone for schedule (IANA timezone)\n  timezone String @default(\"UTC\") @db.VarChar(50)\n\n  /// Execution timeout in milliseconds\n  timeout Int @default(300000)\n\n  /// Maximum retry attempts\n  maxRetries Int @default(3) @map(\"max_retries\")\n\n  /// Retry delay in milliseconds\n  retryDelay Int @default(1000) @map(\"retry_delay\")\n\n  /// Maximum concurrent executions (0 = unlimited)\n  maxConcurrency Int @default(1) @map(\"max_concurrency\")\n\n  /// Whether the job is enabled\n  enabled Boolean @default(true)\n\n  /// Deno permissions for job execution (JSON)\n  permissions Json?\n\n  /// Tags for categorization\n  tags String[] @default([])\n\n  /// Additional metadata (JSON)\n  metadata Json?\n\n  /// Cryptographic signature for remote scripts (JSON)\n  signature Json?\n\n  /// Record timestamps\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  // Relations\n  tasks TaskDefinition[]\n\n  @@index([source])\n  @@index([pluginId])\n  @@index([enabled])\n  @@index([schedule])\n  @@index([tags])\n  @@map(\"job_definitions\")\n}\n\n// ============================================================================\n// TASK DEFINITION\n// ============================================================================\n\n/// Task definition - executable unit that can be referenced by jobs\n/// Supports multiple runtime types (Deno, Python, .NET, shell, etc.)\nmodel TaskDefinition {\n  /// Unique task identifier\n  id String @id @db.VarChar(100)\n\n  /// Human-readable name\n  name String @db.VarChar(255)\n\n  /// Task description\n  description String? @db.Text\n\n  /// Execution type: deno, python, dotnet, cmd, powershell, shell, executable\n  type String @db.VarChar(20)\n\n  /// Source type: local, plugin, remote, inline, shared\n  source String @default(\"local\") @db.VarChar(20)\n\n  /// Path to the script/executable\n  entrypoint String @db.VarChar(500)\n\n  /// Remote URL for remote source tasks\n  sourceUrl String? @map(\"source_url\") @db.VarChar(1000)\n\n  /// Import map URL for Deno tasks\n  importMapUrl String? @map(\"import_map_url\") @db.VarChar(1000)\n\n  /// Command line arguments (JSON array)\n  args Json?\n\n  /// Working directory (supports UNC paths)\n  cwd String? @db.VarChar(500)\n\n  /// Environment variables (JSON object)\n  env Json?\n\n  /// Execution timeout in milliseconds\n  timeout Int @default(300000)\n\n  /// Deno permissions for Deno tasks (JSON)\n  permissions Json?\n\n  /// Plugin ID that registered this task (if plugin source)\n  pluginId String? @map(\"plugin_id\") @db.VarChar(100)\n\n  /// Inline script content (for inline source)\n  inlineScript String? @map(\"inline_script\") @db.Text\n\n  /// Runtime-specific configuration (JSON) - python, dotnet, shell configs\n  runtimeConfig Json? @map(\"runtime_config\")\n\n  /// Tags for categorization\n  tags String[] @default([])\n\n  /// Additional metadata (JSON)\n  metadata Json?\n\n  /// Record timestamps\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  // Relations\n  jobId String?        @map(\"job_id\") @db.VarChar(100)\n  job   JobDefinition? @relation(fields: [jobId], references: [id], onDelete: SetNull)\n\n  @@index([type])\n  @@index([source])\n  @@index([pluginId])\n  @@index([tags])\n  @@map(\"task_definitions\")\n}\n\n// ============================================================================\n// WRAPPER TYPE REGISTRATION\n// ============================================================================\n\n/// Registered wrapper types - enables custom execution patterns\nmodel WrapperType {\n  /// Wrapper type identifier (e.g., 'default', 'etl', 'conditional')\n  type String @id @db.VarChar(50)\n\n  /// Human-readable name\n  name String @db.VarChar(255)\n\n  /// Wrapper description\n  description String? @db.Text\n\n  /// Path to wrapper implementation module\n  entrypoint String? @db.VarChar(500)\n\n  /// Plugin ID that registered this wrapper\n  pluginId String? @map(\"plugin_id\") @db.VarChar(100)\n\n  /// Whether this is a built-in wrapper type\n  builtIn Boolean @default(false) @map(\"built_in\")\n\n  /// Record timestamps\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  @@index([pluginId])\n  @@map(\"wrapper_types\")\n}\n\n// ============================================================================\n// JOB EXECUTION HISTORY (Optional - for long-term analytics)\n// ============================================================================\n\n/// Job execution history - archived from KV for long-term storage\n/// Note: Active executions stay in KV for real-time performance\nmodel JobExecutionHistory {\n  /// Unique execution ID\n  id String @id @db.Uuid\n\n  /// Job identifier\n  jobId String @map(\"job_id\") @db.VarChar(100)\n\n  /// Final execution status\n  status String @db.VarChar(20)\n\n  /// What triggered this execution\n  triggeredBy String @map(\"triggered_by\") @db.VarChar(20)\n\n  /// When the execution was triggered\n  triggeredAt DateTime @map(\"triggered_at\")\n\n  /// When execution started\n  startedAt DateTime? @map(\"started_at\")\n\n  /// When execution completed\n  completedAt DateTime? @map(\"completed_at\")\n\n  /// Process exit code\n  exitCode Int? @map(\"exit_code\")\n\n  /// Execution duration in milliseconds\n  duration Int?\n\n  /// Error message if failed\n  error String? @db.Text\n\n  /// Result data from the job (JSON)\n  result Json?\n\n  /// Worker ID that processed this job\n  workerId String? @map(\"worker_id\") @db.VarChar(100)\n\n  /// Retry attempt number\n  attempt Int @default(0)\n\n  /// Original payload (JSON)\n  payload Json?\n\n  /// Correlation ID for tracing\n  correlationId String? @map(\"correlation_id\") @db.VarChar(100)\n\n  /// Record created timestamp (when archived)\n  archivedAt DateTime @default(now()) @map(\"archived_at\")\n\n  @@index([jobId])\n  @@index([status])\n  @@index([triggeredAt])\n  @@index([completedAt])\n  @@index([correlationId])\n  @@map(\"job_execution_history\")\n}\n\ngenerator client {\n  provider = \"prisma-client\"\n  output   = \"./.generated\"\n  runtime  = \"deno\"\n}\n\ngenerator zod {\n  provider = \"prisma-zod-generator\"\n  output   = \"./.generated/zod\"\n  config   = \"./zod-generator.config.json\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n}\n\n// ---------------------------------------------------------------------------\n// Meters & usage\n// ---------------------------------------------------------------------------\n\nenum UsageAggregation {\n  COUNT\n  SUM\n  MAX\n  UNIQUE\n}\n\nmodel Meter {\n  id             String           @id @default(cuid())\n  key            String           @unique\n  name           String\n  aggregation    UsageAggregation @default(SUM)\n  unit           String           @default(\"unit\")\n  eventSchema    Json?\n  createdAt      DateTime         @default(now())\n  updatedAt      DateTime         @updatedAt\n  planComponents PlanComponent[]\n  usageEvents    UsageEvent[]\n\n  @@map(\"meters\")\n}\n\n// Ingestion is idempotent per (meter, idempotencyKey): a retried delivery\n// within the dedup window resolves to the first recorded event.\nmodel UsageEvent {\n  id             String        @id @default(cuid())\n  meterId        String\n  subscriptionId String?\n  customerId     String\n  idempotencyKey String\n  value          Decimal       @db.Decimal(24, 6)\n  occurredAt     DateTime\n  ingestedAt     DateTime      @default(now())\n  attributes     Json?\n  meter          Meter         @relation(fields: [meterId], references: [id])\n  customer       Customer      @relation(fields: [customerId], references: [id])\n  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])\n\n  @@unique([meterId, idempotencyKey])\n  @@index([subscriptionId, occurredAt])\n  @@map(\"usage_events\")\n}\n\n// ---------------------------------------------------------------------------\n// Catalog: plans, versions, prices\n// ---------------------------------------------------------------------------\n\nmodel Plan {\n  id          String        @id @default(cuid())\n  key         String        @unique\n  name        String\n  description String?\n  versions    PlanVersion[]\n  createdAt   DateTime      @default(now())\n  updatedAt   DateTime      @updatedAt\n\n  @@map(\"plans\")\n}\n\n// A plan version is immutable pricing; subscriptions pin one version.\n// Changing list prices means publishing a new version and migrating cohorts.\nmodel PlanVersion {\n  id                 String               @id @default(cuid())\n  planId             String\n  version            Int\n  status             PlanVersionStatus    @default(DRAFT)\n  interval           BillingInterval\n  currency           String               @default(\"USD\")\n  grandfatheredUntil DateTime?\n  components         PlanComponent[]\n  plan               Plan                 @relation(fields: [planId], references: [id])\n  subscriptions      Subscription[]\n  incomingChanges    SubscriptionChange[] @relation(\"ChangeTarget\")\n\n  @@unique([planId, version])\n  @@map(\"plan_versions\")\n}\n\nenum PlanVersionStatus {\n  DRAFT\n  ACTIVE\n  RETIRED\n}\n\nenum BillingInterval {\n  MONTHLY\n  QUARTERLY\n  ANNUAL\n}\n\n// One price component: either a fixed recurring fee or metered usage pricing\n// with graduated tiers. tiersJson is [{ upTo: number|null, unitAmount: string }] —\n// money stays out of float arithmetic: string-encoded decimals.\nmodel PlanComponent {\n  id            String            @id @default(cuid())\n  planVersionId String\n  kind          PlanComponentKind\n  meterId       String?\n  fixedAmount   Decimal?          @db.Decimal(18, 4)\n  currency      String            @default(\"USD\")\n  tiers         Json?\n  meter         Meter?            @relation(fields: [meterId], references: [id])\n  planVersion   PlanVersion       @relation(fields: [planVersionId], references: [id])\n\n  @@map(\"plan_components\")\n}\n\nenum PlanComponentKind {\n  FIXED\n  METERED\n}\n\n// ---------------------------------------------------------------------------\n// Customers & payment methods\n// ---------------------------------------------------------------------------\n\nmodel Customer {\n  id             String              @id @default(cuid())\n  externalRef    String              @unique\n  name           String\n  email          String\n  country        String              @default(\"US\")\n  taxExempt      Boolean             @default(false)\n  createdAt      DateTime            @default(now())\n  updatedAt      DateTime            @updatedAt\n  subscriptions  Subscription[]\n  invoices       Invoice[]\n  usageEvents    UsageEvent[]\n  creditEntries  CreditLedgerEntry[]\n  paymentMethods PaymentMethod[]\n  entitlements   EntitlementGrant[]\n  creditNotes    CreditNote[]\n\n  @@map(\"customers\")\n}\n\nmodel PaymentMethod {\n  id         String            @id @default(cuid())\n  customerId String\n  kind       PaymentMethodKind\n  brand      String?\n  last4      String?\n  expiresAt  DateTime?\n  isDefault  Boolean           @default(false)\n  blocked    Boolean           @default(false)\n  createdAt  DateTime          @default(now())\n  customer   Customer          @relation(fields: [customerId], references: [id])\n  payments   Payment[]\n\n  @@map(\"payment_methods\")\n}\n\nenum PaymentMethodKind {\n  CARD\n  SEPA\n  ACH\n  INVOICE\n}\n\n// ---------------------------------------------------------------------------\n// Subscriptions & mid-cycle changes\n// ---------------------------------------------------------------------------\n\nenum SubscriptionStatus {\n  TRIALING\n  ACTIVE\n  PAST_DUE\n  CANCELED\n  ENDED\n}\n\nmodel Subscription {\n  id                String               @id @default(cuid())\n  customerId        String\n  planVersionId     String\n  status            SubscriptionStatus   @default(ACTIVE)\n  seats             Int                  @default(1)\n  billingAnchor     DateTime\n  startedAt         DateTime             @default(now())\n  endedAt           DateTime?\n  cancelAtPeriodEnd Boolean              @default(false)\n  createdAt         DateTime             @default(now())\n  updatedAt         DateTime             @updatedAt\n  customer          Customer             @relation(fields: [customerId], references: [id])\n  planVersion       PlanVersion          @relation(fields: [planVersionId], references: [id])\n  usageEvents       UsageEvent[]\n  changes           SubscriptionChange[]\n  invoices          Invoice[]\n  paymentAttempts   PaymentAttempt[]\n  runItems          RunItem[]\n\n  @@index([customerId, status])\n  @@map(\"subscriptions\")\n}\n\nenum ProrationMode {\n  CREATE_PRORATIONS\n  NONE\n}\n\n// A staged mid-cycle change: nothing is applied until `appliedAt` is set.\n// `previewLines` carries the exact proration computation shown before commit —\n// the preview-before-commit discipline.\nmodel SubscriptionChange {\n  id                  String        @id @default(cuid())\n  subscriptionId      String\n  targetPlanVersionId String\n  prorationMode       ProrationMode @default(CREATE_PRORATIONS)\n  effectiveAt         DateTime?\n  appliedAt           DateTime?\n  previewLines        Json\n  appliedLines        Json?\n  requestedBy         String\n  subscription        Subscription  @relation(fields: [subscriptionId], references: [id])\n  targetVersion       PlanVersion   @relation(\"ChangeTarget\", fields: [targetPlanVersionId], references: [id])\n\n  @@index([subscriptionId, appliedAt])\n  @@map(\"subscription_changes\")\n}\n\n// ---------------------------------------------------------------------------\n// Invoices, lines, credit notes, ledger\n// ---------------------------------------------------------------------------\n\nenum InvoiceStatus {\n  DRAFT\n  OPEN\n  PAID\n  VOID\n  UNCOLLECTIBLE\n}\n\n// Finalization freezes the lines: after `finalizedAt`, no line may change.\n// All post-issue correction flows through credit notes, never edits.\nmodel Invoice {\n  id             String                  @id @default(cuid())\n  number         String                  @unique\n  customerId     String\n  subscriptionId String?\n  status         InvoiceStatus           @default(DRAFT)\n  currency       String                  @default(\"USD\")\n  subtotal       Decimal                 @db.Decimal(18, 4)\n  total          Decimal                 @db.Decimal(18, 4)\n  periodStart    DateTime\n  periodEnd      DateTime\n  finalizedAt    DateTime?\n  issuedAt       DateTime?\n  dueAt          DateTime?\n  paidAt         DateTime?\n  voidedAt       DateTime?\n  voidReason     String?\n  billingRunId   String?\n  createdAt      DateTime                @default(now())\n  updatedAt      DateTime                @updatedAt\n  customer       Customer                @relation(fields: [customerId], references: [id])\n  subscription   Subscription?           @relation(fields: [subscriptionId], references: [id])\n  lines          InvoiceLine[]\n  payments       Payment[]\n  creditNotes    CreditNote[]\n  applications   CreditNoteApplication[]\n  runItems       RunItem[]\n  billingRun     BillingRun?             @relation(fields: [billingRunId], references: [id])\n\n  @@unique([customerId, periodStart, periodEnd])\n  @@index([status, dueAt])\n  @@map(\"invoices\")\n}\n\nmodel InvoiceLine {\n  id          String  @id @default(cuid())\n  invoiceId   String\n  description String\n  quantity    Decimal @db.Decimal(24, 6)\n  unitAmount  Decimal @db.Decimal(18, 4)\n  amount      Decimal @db.Decimal(18, 4)\n  derivation  Json\n  invoice     Invoice @relation(fields: [invoiceId], references: [id])\n\n  @@map(\"invoice_lines\")\n}\n\nenum CreditNoteType {\n  ADJUSTMENT\n  REFUNDABLE\n}\n\nenum CreditNoteStatus {\n  ISSUED\n  APPLIED\n  VOID\n}\n\nmodel CreditNote {\n  id           String                  @id @default(cuid())\n  customerId   String\n  invoiceId    String?\n  type         CreditNoteType\n  status       CreditNoteStatus        @default(ISSUED)\n  reason       String\n  amount       Decimal                 @db.Decimal(18, 4)\n  createdAt    DateTime                @default(now())\n  updatedAt    DateTime                @updatedAt\n  customer     Customer                @relation(fields: [customerId], references: [id])\n  invoice      Invoice?                @relation(fields: [invoiceId], references: [id])\n  applications CreditNoteApplication[]\n\n  @@map(\"credit_notes\")\n}\n\nmodel CreditNoteApplication {\n  id           String     @id @default(cuid())\n  creditNoteId String\n  invoiceId    String\n  amount       Decimal    @db.Decimal(18, 4)\n  appliedAt    DateTime   @default(now())\n  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id])\n  invoice      Invoice    @relation(fields: [invoiceId], references: [id])\n\n  @@map(\"credit_note_applications\")\n}\n\n// Append-only money-in/money-out ledger. Balances are derived by summation,\n// never stored as a mutable column.\nenum LedgerEntryKind {\n  GRANT\n  DEDUCTION\n  EXPIRATION\n  ADJUSTMENT\n}\n\nmodel CreditLedgerEntry {\n  id         String          @id @default(cuid())\n  customerId String\n  kind       LedgerEntryKind\n  amount     Decimal         @db.Decimal(18, 4)\n  currency   String          @default(\"USD\")\n  reason     String\n  sourceType String?\n  sourceId   String?\n  actorId    String?\n  createdAt  DateTime        @default(now())\n  customer   Customer        @relation(fields: [customerId], references: [id])\n\n  @@index([customerId, createdAt])\n  @@map(\"credit_ledger_entries\")\n}\n\nenum EntitlementSource {\n  PLAN\n  MANUAL\n}\n\nmodel EntitlementGrant {\n  id         String            @id @default(cuid())\n  customerId String\n  featureKey String\n  source     EntitlementSource\n  limit      Int?\n  revokedAt  DateTime?\n  createdAt  DateTime          @default(now())\n  customer   Customer          @relation(fields: [customerId], references: [id])\n\n  @@unique([customerId, featureKey])\n  @@map(\"entitlement_grants\")\n}\n\n// ---------------------------------------------------------------------------\n// Payments & dunning\n// ---------------------------------------------------------------------------\n\nenum PaymentStatus {\n  PENDING\n  SUCCEEDED\n  FAILED\n  REFUNDED\n}\n\nenum PaymentAttemptOutcome {\n  APPROVED\n  DECLINED_SOFT\n  DECLINED_HARD\n}\n\nmodel Payment {\n  id              String           @id @default(cuid())\n  invoiceId       String\n  paymentMethodId String\n  status          PaymentStatus    @default(PENDING)\n  amount          Decimal          @db.Decimal(18, 4)\n  currency        String           @default(\"USD\")\n  idempotencyKey  String           @unique\n  processedAt     DateTime?\n  createdAt       DateTime         @default(now())\n  invoice         Invoice          @relation(fields: [invoiceId], references: [id])\n  paymentMethod   PaymentMethod    @relation(fields: [paymentMethodId], references: [id])\n  attempts        PaymentAttempt[]\n\n  @@map(\"payments\")\n}\n\nmodel PaymentAttempt {\n  id             String                @id @default(cuid())\n  paymentId      String\n  subscriptionId String?\n  attemptNumber  Int\n  outcome        PaymentAttemptOutcome\n  declineReason  String?\n  nextRetryAt    DateTime?\n  createdAt      DateTime              @default(now())\n  payment        Payment               @relation(fields: [paymentId], references: [id])\n  subscription   Subscription?         @relation(fields: [subscriptionId], references: [id])\n\n  @@index([paymentId, attemptNumber])\n  @@map(\"payment_attempts\")\n}\n\n// ---------------------------------------------------------------------------\n// The billing run — Ledgerline's first-class object\n// ---------------------------------------------------------------------------\n\nenum RunStatus {\n  DRAFT\n  COMPUTING\n  REVIEW\n  ISSUING\n  ISSUED\n  FAILED\n  COMPENSATED\n  CANCELED\n}\n\nenum RunItemStatus {\n  PENDING\n  COMPUTED\n  APPROVED\n  EXCLUDED\n  ISSUING\n  ISSUED\n  FAILED\n  COMPENSATED\n  SKIPPED\n}\n\nenum ExceptionBucket {\n  NONE\n  FIRST_INVOICE\n  AMOUNT_DELTA\n  NO_PAYMENT_METHOD\n  HARD_DECLINE\n  PAST_DUE\n}\n\nenum RunDecision {\n  APPROVE\n  EXCLUDE\n}\n\nmodel BillingRun {\n  id            String    @id @default(cuid())\n  periodStart   DateTime\n  periodEnd     DateTime\n  status        RunStatus @default(DRAFT)\n  expectedCount Int       @default(0)\n  issuedCount   Int       @default(0)\n  failedCount   Int       @default(0)\n  totalCents    Decimal   @default(0) @db.Decimal(18, 4)\n  notes         String?\n  createdAt     DateTime  @default(now())\n  updatedAt     DateTime  @updatedAt\n  runItems      RunItem[]\n  invoices      Invoice[]\n\n  @@map(\"billing_runs\")\n}\n\nmodel RunItem {\n  id              String              @id @default(cuid())\n  runId           String\n  subscriptionId  String\n  customerId      String\n  status          RunItemStatus       @default(PENDING)\n  exceptionBucket ExceptionBucket     @default(NONE)\n  skipReason      String?\n  draftInvoiceId  String?\n  computedTotal   Decimal?            @db.Decimal(18, 4)\n  priorTotal      Decimal?            @db.Decimal(18, 4)\n  decision        RunDecision?\n  decidedBy       String?\n  decidedAt       DateTime?\n  decisionKey     String?             @unique\n  sagaState       String?\n  decisionRecords RunDecisionRecord[]\n  createdAt       DateTime            @default(now())\n  updatedAt       DateTime            @updatedAt\n  run             BillingRun          @relation(fields: [runId], references: [id])\n  subscription    Subscription        @relation(fields: [subscriptionId], references: [id])\n  invoice         Invoice?            @relation(fields: [draftInvoiceId], references: [id])\n\n  @@unique([runId, subscriptionId])\n  @@index([runId, status])\n  @@map(\"run_items\")\n}\n\nmodel RunDecisionRecord {\n  id             String      @id @default(cuid())\n  runItemId      String\n  decision       RunDecision\n  actorId        String\n  idempotencyKey String      @unique\n  createdAt      DateTime    @default(now())\n  runItem        RunItem     @relation(fields: [runItemId], references: [id])\n\n  @@map(\"run_decision_records\")\n}\n\n// ---------------------------------------------------------------------------\n// Webhooks (outbound delivery) & audit\n// ---------------------------------------------------------------------------\n\nenum WebhookEventStatus {\n  PENDING\n  DELIVERED\n  FAILED\n  RETRYING\n  REPLAYED\n  DISABLED\n}\n\nmodel WebhookEndpoint {\n  id         String            @id @default(cuid())\n  url        String\n  secret     String\n  events     String[]\n  active     Boolean     