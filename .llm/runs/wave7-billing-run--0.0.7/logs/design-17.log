export function ratio(numerator: MoneyValue, denominator: MoneyValue): number | null {
  const top = moneyParts(numerator).value;
  const bottom = moneyParts(denominator).value;
  if (top === null || bottom === null || bottom === 0) return null;
  return top / bottom;
}

/**
 * Formats a ratio as a percentage. `null` renders as the em dash.
 */
export function formatPercent(
  value: number | null | undefined,
  options: { precision?: number; signed?: boolean } = {},
): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return ABSENT;
  const precision = options.precision ?? 1;
  const sign = options.signed && value > 0 ? '+' : '';
  return `${sign}${(value * 100).toFixed(precision)}%`;
}

/** Moves the decimal point left by `shift` digits, on the digit string. */
function shiftLeft(parsed: ParsedDecimal, shift: number): ParsedDecimal {
  if (shift === 0) return parsed;
  let digits = `${parsed.int}${parsed.frac}`;
  let point = parsed.int.length - shift;
  if (point <= 0) {
    digits = `${'0'.repeat(1 - point)}${digits}`;
    point = 1;
  }
  return { negative: parsed.negative, int: digits.slice(0, point), frac: digits.slice(point) };
}

/**
 * Compact money for dense surfaces and chart ticks: `$12.4k`, `1.2M`.
 *
 * Rounds half-up on the decimal digits, like every other amount. Absent stays
 * the em dash. Charts use this for ticks only — a chart never formats a value
 * it was handed; it receives preformatted labels.
 */
export function formatMoneyCompact(
  value: MoneyValue,
  options: MoneyFormatOptions = {},
): string {
  const parsed = parseDecimal(value);
  if (!parsed) return ABSENT;

  const locale = options.locale ?? 'en-US';
  const mag = `${parsed.int}${parsed.frac}`;
  const whole = Number(mag) / 10 ** parsed.frac.length;
  const scale = whole >= 1_000_000
    ? { shift: 6, suffix: 'M', digits: 1 }
    : whole >= 10_000
    ? { shift: 3, suffix: 'k', digits: 0 }
    : whole >= 1_000
    ? { shift: 3, suffix: 'k', digits: 1 }
    : { shift: 0, suffix: '', digits: MIN_PRECISION };

  const shifted = shiftLeft(parsed, scale.shift);
  const rounded = roundToPrecision(shifted.int, shifted.frac, scale.digits);
  const isZero = /^0*$/.test(rounded.int) && /^0*$/.test(rounded.frac);
  const negative = !isZero && parsed.negative;

  const sign = negative ? '-' : isZero ? '' : options.signed ? '+' : '';
  const symbol = currencyPrefix(options.currency, locale) ?? '';
  const body = scale.digits > 0
    ? `${groupInteger(rounded.int, locale)}.${rounded.frac}`
    : groupInteger(rounded.int, locale);
  return `${sign}${symbol}${body}${scale.suffix}`;
}
