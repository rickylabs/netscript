/**
 * Invoice detail — `/invoices/[id]`.
 *
 * Header (number, customer, status, dates), lines, payments, and credit
 * notes all load through one server resource (the nested `invoices.get`
 * action). Reachable states are data: not-found, permission denied,
 * unavailable, no lines, no payments (em dashes), void (rust frame), and
 * refunded payment chips.
 */

import { definePage } from '@app/utils.ts';
import { z } from 'zod';
import { billingClient } from '@app/lib/billing.ts';
import { isServiceAuthError } from '@app/lib/service-auth.ts';
import InvoiceHeader, { InvoiceHeaderSkeleton } from './(_components)/invoice-header.tsx';
import InvoiceBody, { InvoiceBodySkeleton } from './(_components)/invoice-body.tsx';
import type { InvoiceDetailV1 } from '@ledgerline/contracts';
import { routePatterns } from '@app/.generated/manifest.ts';

interface InvoiceResource {
  state: 'found' | 'not-found' | 'unavailable' | 'denied';
  invoice?: InvoiceDetailV1;
}

function isNotFound(error: unknown): boolean {
  return error && typeof error === 'object' && 'status' in error
    ? (error as { status?: unknown }).status === 404
    : false;
}

export const invoiceDetailPage = definePage()
  .withRouteContract({ $route: routePatterns.invoices.$id.$route, pathSchema: z.object({ id: z.string() }) })
  .withMeta(() => ({
    title: 'Invoice — ledgerline',
    description: 'A single invoice with its lines, payments, and credit notes.',
  }))
  .withResource('invoice', async (ctx): Promise<InvoiceResource> => {
    try {
      const invoice = await billingClient.invoices.get({ id: ctx.path.id });
      return { state: 'found', invoice };
    } catch (error) {
      if (isNotFound(error)) return { state: 'not-found' };
      if (isServiceAuthError(error)) return { state: 'denied' };
      return { state: 'unavailable' };
    }
  })
  .withLayer('header', InvoiceHeader, {
    loader: (ctx) => {
      const entry = ctx.resource('invoice');
      return { state: entry.state, invoice: entry.invoice };
    },
    fallback: <InvoiceHeaderSkeleton />,
    staleTime: 15_000,
    staleReloadMode: 'background',
  })
  .withLayer('body', InvoiceBody, {
    loader: (ctx) => {
      const entry = ctx.resource('invoice');
      return { state: entry.state, invoice: entry.invoice };
    },
    fallback: <InvoiceBodySkeleton />,
    staleTime: 15_000,
    staleReloadMode: 'background',
  })
  .withLayout((slots) => (
    <div class='ns-stack ns-stack--lg'>
      {slots.header()}
      {slots.body()}
    </div>
  ))
  .build();

export const { default: page } = invoiceDetailPage;
export { page as default };
