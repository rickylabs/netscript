 /**
+ * Adds money values on their digit strings.
+ *
+ * Billing needs sums a component cannot fake: whether an invoice is part-paid
+ * depends on how much of it actually arrived, and "how much" is a total over
+ * payments. The addition happens on integers scaled to one common fraction
+ * width, so no value passes through a float at any point.
+ *
+ * Returns a string-encoded decimal — a `MoneyValue`, ready to hand straight
+ * back to `MoneyText` — because summing is not formatting. Values that do not
+ * parse are **skipped, not treated as zero**: a `null` in the list means
+ * "not measured", and silently folding it in as `0.00` would understate a
+ * collected total, which is the one error a billing product cannot make. An
+ * empty (or entirely absent) list sums to `null`, which renders as the em
+ * dash rather than a confident `0.00`.
+ */
+export function sumMoney(values: readonly MoneyValue[]): string | null {
+  const parsed = values
+    .map(parseDecimal)
+    .filter((value): value is ParsedDecimal => value !== null);
+
+  if (parsed.length === 0) return null;
+
+  const scale = Math.min(
+    MAX_PRECISION,
+    parsed.reduce((widest, value) => Math.max(widest, value.frac.length), 0),
+  );
+
+  let total = 0n;
+  for (const value of parsed) {
+    const digits = `${value.int}${value.frac.padEnd(scale, '0').slice(0, scale)}`;
+    total += BigInt(digits) * (value.negative ? -1n : 1n);
+  }
+
+  const negative = total < 0n;
+  const digits = (negative ? -total : total).toString().padStart(scale + 1, '0');
+  const split = digits.length - scale;
+  const int = digits.slice(0, split);
+  const frac = digits.slice(split);
+
+  // `-0.00` is not a fact. A total that nets to nothing is `0.00`.
+  const isZero = /^0*$/.test(int) && /^0*$/.test(frac);
+  const sign = isZero ? '' : negative ? '-' : '';
+  return `${sign}${int}${scale > 0 ? `.${frac}` : ''}`;
+}
+
