import { Partial } from 'fresh/runtime';
import ThemeToggle from '@app/islands/ui/ThemeToggle.tsx';
import { Badge, Button, SidebarShell } from '@app/components/ui/mod.ts';
import { appRoutes } from '@app/router.ts';
import { define } from '@app/utils.ts';

/**
 * Product chrome navigation — Runs / Invoices / Customers / Design. Every
 * product page renders inside the sidebar shell below the topbar, so the
 * console's IA is reachable from anywhere.
 */
const PRODUCT_NAVIGATION = [
  {
    label: 'Billing',
    items: [
      { href: appRoutes.runs.href(), label: 'Runs', icon: '↻', matchPrefix: true },
      { href: appRoutes.invoices.href(), label: 'Invoices', icon: '≡', matchPrefix: true },
      { href: appRoutes.customers.href(), label: 'Customers', icon: '◎', matchPrefix: true },
    ],
  },
  {
    label: 'Reference',
    items: [
      { href: appRoutes.design.href(), label: 'Design', icon: '◧', matchPrefix: true },
    ],
  },
] as const;

export default define.layout(function RootLayout({ Component, url }) {
  const homeHref = appRoutes.home.href();
  const runsHref = appRoutes.runs.href();
  const invoicesHref = appRoutes.invoices.href();
  const webhooksHref = '/webhooks';
  const customersHref = appRoutes.customers.href();
  const healthHref = appRoutes.health.href();

  // Partial requests carry only their fragment — no chrome.
  if (url.pathname.startsWith('/partials/')) {
    return (
      <Partial name='page'>
        <Component />
      </Partial>
    );
  }

  // The design sub-app drives its own sidebar-shell chrome, including the
  // theme toggle in its topbar.
  if (url.pathname.startsWith(appRoutes.design.href())) {
    return (
      <Partial name='page'>
        <Component />
      </Partial>
    );
  }

  // The landing keeps its hero under the global topbar.
  if (url.pathname === homeHref) {
    return (
      <Partial name='page'>
        <header class='ns-topbar'>
          <div class='ns-cluster ns-cluster--sm'>
            <a href={homeHref} f-client-nav class='ns-topbar__brand'>
              ledgerline
            </a>
            <Badge variant='muted'>ledgerline-web</Badge>
          </div>
          <nav class='ns-cluster ns-cluster--sm'>
            <Button
              type='link'
              href={homeHref}
              variant='ghost'
              size='sm'
              aria-current='page'
            >
              Home
            </Button>
            <Button
              type='link'
              href={runsHref}
              variant='ghost'
              size='sm'
            >
              Runs
            </Button>
            <Button
              type='link'
              href={invoicesHref}
              variant='ghost'
              size='sm'
            >
              Invoices
            </Button>
            <Button
              type='link'
              href={customersHref}
              variant='ghost'
              size='sm'
            >
              Customers
            </Button>
            <Button
              type='link'
              href={healthHref}
              variant='ghost'
              size='sm'
            >
              Health
            </Button>
            <Button
              type='link'
              href={appRoutes.design.href()}
              variant='ghost'
              size='sm'
            >
              Design
            </Button>
            <ThemeToggle />
          </nav>
        </header>
        <Component />
      </Partial>
    );
  }

  // Product pages: sidebar chrome with the product nav; the shell's topbar
  // carries the theme toggle so every page can switch themes.
  return (
    <Partial name='page'>
      <SidebarShell
        pathname={url.pathname}
        navigation={PRODUCT_NAVIGATION}
        brand={
          <a href={homeHref} class='ns-topbar__brand'>
            ledgerline
          </a>
        }
        brandBadge={<Badge variant='secondary'>billing console</Badge>}
        topbarEnd={<ThemeToggle />}
        contentId='page-content'
      >
        <Component />
      </SidebarShell>
    </Partial>
  );
});
