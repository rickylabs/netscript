/**
 * @module components/blocks
 *
 * Composed screens, not components.
 *
 * `components/ui` is the vocabulary and `components/product` is the domain
 * layer over it. This directory is the third step: whole page bodies, built
 * from the vocabulary, that a route drops in as one call. A block owns its
 * layout, its empty and loading states, and its own composition order — a
 * route that renders a block renders a screen, not a grid it assembled.
 *
 * Blocks take plain data and render. They read no service and import no
 * router, so they can be lifted into any route that can supply the model.
 */

export {
  Overview,
  OVERVIEW_RANGES,
  type OverviewModel,
  type OverviewRange,
  OverviewSkeleton,
} from './overview.tsx';
