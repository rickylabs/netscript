/**
 * @component SegmentedControl
 * @layer 2
 * @depends theme-seed
 * @description Range selection as one full-width capsule: N equal cells, the
 * selected one a filled pill. Never a border change (C4). Renders as buttons
 * for client-side selection, or as links when the range is a route, and wraps
 * onto further lines when the options outgrow one.
 */

import type { JSX, VNode } from 'preact';
import { cn } from '../../lib/cn.ts';

export interface SegmentedControlOption {
  /** Range key — `1D`, `1W`, `1M`, `3M`, `1Y`, or a product range id. */
  readonly value: string;
  /** Preformatted cell label. */
  readonly label: string;
  /** Render the cell as a link, so the range lives in the URL. */
  readonly href?: string;
  readonly disabled?: boolean;
}

/**
 * An anchor that opts into Fresh's client-side navigation. The framework's own
 * link attribute is not in Preact's anchor attribute set.
 */
interface ClientNavAnchorAttributes extends JSX.AnchorHTMLAttributes<HTMLAnchorElement> {
  'f-client-nav'?: boolean;
}

export interface SegmentedControlProps
  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children' | 'onSelect'> {
  /** Accessible name for the group, e.g. `Billing period`. */
  label: string;
  options: readonly SegmentedControlOption[];
  /** The selected option's `value`. Omit only when nothing is selected. */
  value?: string | null;
  /** Called with the chosen `value`. Required unless every option has an `href`. */
  onSelect?: (value: string) => void;
  size?: 'sm' | 'md';
  /** Stretch to the container width. The reference control is full-width. */
  block?: boolean;
  /**
   * Let the cells wrap onto more than one line instead of stretching to fill
   * one. A capsule is a one-line shape, so this also steps the container down
   * to a panel radius and drops the inter-cell hairlines — reach for it when
   * the options outgrow a line, the way a filter over eight run statuses does
   * against a range control's four.
   */
  wrap?: boolean;
  /**
   * Let link options navigate client-side. A range that lives in the URL is
   * usually a filter, and a filter that reloads the whole page is a slower
   * version of the same navigation.
   */
  clientNav?: boolean;
  class?: string;
}

=== gauge props ===
/**
 * @component SemicircularGauge
 * @layer 2
 * @depends theme-seed
 * @description 180° two-tone gauge — the run-progress widget. Hand-authored
 * SVG over the fixed series cycle: a grey unallocated track, then one arc per
 * segment, terminated with flat baseline cuts. Centre carries a quiet label
 * over the hero amount.
 */

import type { JSX, VNode } from 'preact';
import { cn } from '../../lib/cn.ts';

/** Series slot in the fixed `--ns-series-1..6` cycle (H3). */
export type GaugeSeries = 1 | 2 | 3 | 4 | 5 | 6;

/**
 * One arc of the gauge.
 *
 * `value` is geometry only — it is never rendered (H2). The label the reader
 * sees arrives as `display`, already formatted by the caller.
 */
export interface GaugeSegment {
  readonly value: number;
  /** Legend name, e.g. `Issued`. */
  readonly label: string;
  /** Preformatted amount for the legend, e.g. `$842,000.00`. */
  readonly display: string;
  /** Series slot. Defaults to the segment's index in the cycle. */
  readonly series?: GaugeSeries;
}

export interface SemicircularGaugeProps
  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children'> {
  segments: readonly GaugeSegment[];
  /**
   * The denominator — every item the run covers, including the ones no segment
   * accounts for. Omitted means the segments are the whole. `null` means the
   * total was not measured, which renders the empty frame (H7, M1).
   */
  total?: number | null;
  /** Quiet uppercase label above the centre amount, e.g. `ISSUED`. */
  label: string;
  /** The preformatted centre amount. */
  value: string;
  /** Quiet line under the centre amount. */
  caption?: string;
  /** Show the inline dot legend below the rule (C6). Defaults to true. */
  legend?: boolean;
  /** Copy for the labelled empty frame. */
  emptyLabel?: string;
  /** Tighten the centre amount for narrow rails. */
  compact?: boolean;
  class?: string;
}
