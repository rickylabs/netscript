+/**
+ * The type the product declares is the type it loads.
+ *
+ * `--ns-font-sans` named "Inter" while `_app.tsx` requested DM Sans. Neither
+ * is a runtime error: the family simply is not there, so the browser walks the
+ * stack to `system-ui` and the whole product renders in whatever the host
+ * happens to have. Nothing crashes, nothing logs, and every screen is one
+ * step short of designed — which is exactly why it survived eleven passes of
+ * review that all read the file.
+ *
+ * The rule is mechanical: every family the token layer names must be a family
+ * the document requests, and the display face must be a face with a serif
+ * fallback, so losing the webfont degrades to Georgia rather than to the sans.
+ */
+Deno.test('F1 — the token layer names only typefaces the document loads', async () => {
+  const css = await read('./assets/tokens.css');
+  const app = await read('./routes/_app.tsx');
+
+  const requested = new Set(
+    [...app.matchAll(/family=([^&:"']+)/g)].flatMap((match) =>
+      decodeURIComponent(match[1]).split('&')[0].split('+')
+    ),
+  );
+  const loaded = new Set([...requested].flatMap((family) => [family, family.replaceAll('+', ' ')]));
+
+  const fontTokens = [...css.matchAll(/--ns-font-(sans|display|mono|numeric):\s*([^;]+);/g)];
+  assert(fontTokens.length >= 4, 'tokens.css must declare the sans, display, mono and numeric faces');
+
+  for (const [, name, stack] of fontTokens) {
+    const families = [...stack.matchAll(/"([^"]+)"/g)].map((match) => match[1]);
+    const first = families[0];
+    assert(first !== undefined, `--ns-font-${name} must name at least one family`);
+
+    // Generic families are always available and are never webfont requests.
+    const generic = /^(serif|sans-serif|monospace|system-ui|cursive|fantasy)$/;
+    if (generic.test(first)) continue;
+
+    assert(
+      loaded.has(first) || loaded.has(first.replaceAll(' ', '+')),
+      `--ns-font-${name} names "${first}", which _app.tsx never requests — the browser ` +
+        'falls through to the next entry in the stack and the product silently renders ' +
+        'in another face',
+    );
+  }
+
+  // The voice has to survive the CDN. A serif fallback is what makes that true.
+  const display = fontTokens.find(([, name]) => name === 'display');
+  assert(display !== undefined, 'tokens.css must declare --ns-font-display');
+  assert(
+    /serif/.test(display[2]),
+    '--ns-font-display must end in a generic serif, so losing the webfont degrades to ' +
+      'a serif rather than to the UI face',
+  );
+});
