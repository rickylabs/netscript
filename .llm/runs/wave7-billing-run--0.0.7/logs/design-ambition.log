 /* App-specific custom styles below. */
+
+/*
+ * The display face is spent on prose, never on data.
+ *
+ * A heading has to be read as a sentence; a label has to be scanned as a
+ * field. So the serif goes on the wordmark, page and section headings, and
+ * the empty-state line that exists to be read, and it is taken back off every
+ * surface that carries a value — card titles, table headers, badge text and
+ * anything explicitly monospaced. A date range like `2026-08-01 → 2026-08-31`
+ * is data even when it sits in an `h1`, so `.ns-widget__title` opts out.
+ *
+ * Fallback stack matters here: if Fraunces does not arrive, this degrades to
+ * Georgia, which is still a deliberate serif, rather than to the sans default.
+ */
+.ns-topbar__brand,
+.ns-page-header h1,
+.ns-section-heading,
+.ns-section-heading h2,
+.ns-section-heading h3,
+.ns-empty-state__heading,
+.ns-display {
+  font-family: var(--ns-font-display);
+  font-optical-sizing: auto;
+  font-variant-ligatures: common-ligatures;
+}
+
+.ns-page-header h1 {
+  font-weight: 600;
+  letter-spacing: -0.015em;
+}
+
+.ns-empty-state__heading {
+  font-size: var(--ns-text-base);
+}
+
+/*
+ * Opt-outs. Every one of these is a label or a value, so each keeps the UI
+ * face regardless of the element it happens to be rendered as.
+ */
+.ns-widget__title,
+.ns-card__title,
+.ns-table th,
+.ns-badge,
+.ns-delta-chip,
+.ns-money,
+.font-mono,
+[class*='font-mono'] {
+  font-family: var(--ns-font-sans);
+}
+
+.ns-widget__title,
+.ns-card__title {
+  font-weight: 600;
+}
+
+/* Money keeps the numeric face wherever the display rules above could reach
+   it — a tabular figure set in a proportional serif is not the same number. */
+.ns-money,
+[class*='font-mono'] {
+  font-family: var(--ns-font-numeric);
+  font-variant-numeric: var(--ns-numeric-tabular);
+}

