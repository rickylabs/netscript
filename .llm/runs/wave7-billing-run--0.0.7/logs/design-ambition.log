/* Ledgerline design tokens — GENERATED from tokens.json. Do not edit by hand. */

:root {
  color-scheme: light;

  /* Primitive ramps */
  --ns-paper-1: oklch(98.5% 0.009 95);
  --ns-paper-2: oklch(94.5% 0.009 95);
  --ns-paper-3: oklch(88.5% 0.009 95);
  --ns-paper-4: oklch(80.5% 0.009 95);
  --ns-paper-5: oklch(73.5% 0.009 95);
  --ns-paper-6: oklch(59.5% 0.009 95);
  --ns-paper-7: oklch(47% 0.009 95);
  --ns-paper-8: oklch(37% 0.009 95);
  --ns-paper-9: oklch(27% 0.009 95);
  --ns-paper-10: oklch(21.5% 0.009 95);
  --ns-paper-11: oklch(17.5% 0.009 95);
  --ns-paper-12: oklch(13.5% 0.009 95);

  --ns-ledger-1: oklch(95.5% 0.09 155);
  --ns-ledger-2: oklch(87.5% 0.11 155);
  --ns-ledger-3: oklch(78.5% 0.11 155);
  --ns-ledger-4: oklch(70.5% 0.11 155);
  --ns-ledger-5: oklch(61% 0.11 155);
  --ns-ledger-6: oklch(53.5% 0.11 155);
  --ns-ledger-7: oklch(45.5% 0.105 155);

  --ns-rust-4: oklch(70.5% 0.145 38);
  --ns-rust-5: oklch(62.5% 0.145 38);
  --ns-rust-6: oklch(54.5% 0.145 38);
  --ns-rust-7: oklch(45.5% 0.145 38);

  --ns-ink-1: oklch(96.5% 0.016 255);
  --ns-ink-2: oklch(89.5% 0.016 255);
  --ns-ink-3: oklch(79% 0.016 255);
  --ns-ink-4: oklch(70.5% 0.016 255);
  --ns-ink-5: oklch(61.5% 0.016 255);
  --ns-ink-6: oklch(52.5% 0.016 255);
  --ns-ink-7: oklch(43.5% 0.016 255);

  --ns-brass-1: oklch(95.5% 0.025 85);
  --ns-brass-2: oklch(88.5% 0.068 85);
  --ns-brass-3: oklch(81.5% 0.105 85);
  --ns-brass-4: oklch(74.5% 0.105 85);
  --ns-brass-5: oklch(69.5% 0.105 85);
  --ns-brass-6: oklch(63.5% 0.105 85);
  --ns-brass-7: oklch(55.5% 0.105 85);
  --ns-brass-8: oklch(47% 0.105 85);

  --ns-amber-4: oklch(81.5% 0.125 78);
  --ns-amber-5: oklch(73.5% 0.125 78);
  --ns-amber-6: oklch(65.5% 0.125 78);
  --ns-amber-7: oklch(57.5% 0.125 78);
  --ns-amber-8: oklch(49.5% 0.125 78);

  /* Semantic aliases */
  --ns-bg: var(--ns-paper-1);
  --ns-fg: var(--ns-paper-12);
  --ns-surface: var(--ns-paper-2);
  --ns-surface-raised: #ffffff;
  --ns-overlay: rgba(0, 0, 0, 0.4);

  --ns-card: #ffffff;
  --ns-card-fg: var(--ns-paper-12);

  --ns-primary: var(--ns-ledger-6);
  --ns-primary-fg: var(--ns-paper-1);
  --ns-primary-hover: var(--ns-ledger-7);
  --ns-primary-subtle: color-mix(in oklab, var(--ns-ledger-6) 10%, transparent);
  --ns-primary-border: color-mix(in oklab, var(--ns-ledger-6) 25%, transparent);

  --ns-secondary: var(--ns-ink-5);
  --ns-secondary-fg: var(--ns-paper-12);
  --ns-secondary-hover: var(--ns-ink-6);
  --ns-secondary-subtle: color-mix(in oklab, var(--ns-ink-5) 10%, transparent);
  --ns-secondary-border: color-mix(in oklab, var(--ns-ink-5) 20%, transparent);

  --ns-muted: var(--ns-paper-3);
  --ns-muted-fg: var(--ns-paper-7);

  --ns-accent: var(--ns-brass-6);
  --ns-accent-fg: var(--ns-paper-12);
  --ns-accent-subtle: color-mix(in oklab, var(--ns-brass-6) 8%, transparent);
  --ns-accent-border: color-mix(in oklab, var(--ns-brass-6) 18%, transparent);

  --ns-success: var(--ns-ledger-5);
  --ns-success-fg: var(--ns-paper-12);
  --ns-success-subtle: color-mix(in oklab, var(--ns-ledger-5) 10%, transparent);
  --ns-success-border: color-mix(in oklab, var(--ns-ledger-5) 20%, transparent);

  --ns-warning: var(--ns-amber-5);
  /* Text on a tinted warning chip. Not `--ns-warning`: amber-5 is the fill
     role and measures 2.9:1 as small text on paper. The 4.5:1 a chip's label
     needs starts at amber-8 in light (5.75:1) and amber-5 in dark (6.00:1). */
  --ns-warning-text: var(--ns-amber-8);
  --ns-warning-fg: var(--ns-paper-12);
  --ns-warning-subtle: color-mix(in oklab, var(--ns-amber-5) 10%, transparent);
  --ns-warning-border: color-mix(in oklab, var(--ns-amber-5) 20%, transparent);

  --ns-destructive: var(--ns-rust-5);
  --ns-destructive-fg: #ffffff;
  /* Hover goes darker on a light ground and lighter on a dark one, so the pair
     has to be a role the theme re-steps. A component that hardcodes rust-7 for
     hover is a component whose hover is invisible on one ground (T2a). */
  --ns-destructive-hover: var(--ns-rust-7);
  --ns-destructive-subtle: color-mix(in oklab, var(--ns-rust-5) 10%, transparent);
  --ns-destructive-border: color-mix(in oklab, var(--ns-rust-5) 20%, transparent);

  --ns-money-pos: var(--ns-ledger-6);
  --ns-money-neg: var(--ns-rust-6);
  --ns-money-flat: var(--ns-paper-7);

  --ns-status-draft: var(--ns-ink-5);
  --ns-status-issued: var(--ns-brass-6);
  --ns-status-paid: var(--ns-ledger-6);
  --ns-status-failed: var(--ns-rust-6);
  --ns-status-refunded: var(--ns-brass-5);
  --ns-status-void: var(--ns-paper-6);
  --ns-status-review: var(--ns-ink-6);
  --ns-status-compensated: var(--ns-ledger-5);

  /* Chart series cycle — fixed order, so a series keeps its colour across
     renders and across routes. The cycle is keyed by index, never by data
     order, so a sort cannot re-colour a series (H3). */
  --ns-series-1: var(--ns-ledger-6);
  --ns-series-2: var(--ns-brass-8);
  --ns-series-3: var(--ns-ink-6);
  --ns-series-4: var(--ns-rust-6);
  --ns-series-5: var(--ns-amber-6);
  --ns-series-6: var(--ns-paper-7);
  --ns-chart-grid: rgba(31, 26, 20, 0.07);
  --ns-chart-axis: var(--ns-paper-6);

  /* The em dash's own tone. Absence is a fact the reader has to be able to
     see, so this is the floor, not a decoration: measured against the card it
     was 2.35:1 at paper-5, under the 3:1 that even a large glyph needs.
     paper-6 clears that floor at 4.03:1 and stays quieter than every value it
     sits beside — money-pos measures 4.90:1 here, so a step that reached the
     4.5:1 small-text bar would out-shout the real amounts it is standing in
     for. Light is the binding theme: it is the money ramp, not the paper one,
     that runs out of headroom first. */
  --ns-absent: var(--ns-paper-6);

  /* The chart tooltip inverts against the card in both themes, so no component
     has to ask which theme is active (T3). */
  --ns-tip-bg: var(--ns-paper-12);
  --ns-tip-fg: var(--ns-paper-1);

  --ns-border: rgba(31, 26, 20, 0.08);
  --ns-border-hover: rgba(31, 26, 20, 0.14);
  --ns-border-strong: rgba(31, 26, 20, 0.22);

  --ns-input-border: var(--ns-paper-4);
  --ns-ring: var(--ns-ledger-5);

  /* A switch thumb stays light in both themes. It cannot be a ramp step: the
     paper ramp inverts, so `paper-12` is near-black in light and near-white in
     dark — a component that reaches for it directly breaks one theme. */
  --ns-control-thumb: #ffffff;

  --ns-font-sans: "Inter", "SF Pro Text", system-ui, sans-serif;
  --ns-font-mono: "DM Mono", ui-monospace, "SF Mono", "Cascadia Code", monospace;
  --ns-font-numeric: "DM Mono", ui-monospace, "SF Mono", "Cascadia Code", monospace;
  --ns-numeric-tabular: tabular-nums;

  --ns-text-xs: 0.75rem;
  --ns-text-sm: 0.875rem;
  --ns-text-base: 1rem;
  --ns-text-lg: 1.125rem;
  --ns-text-xl: 1.25rem;
  --ns-text-2xl: 1.5rem;
  --ns-text-3xl: 1.875rem;
  --ns-text-4xl: 2.25rem;
  /* The page's one answer, above every card's own hero. `--ns-text-4xl` is
     the card hero, so a page that needs a figure larger than the cards beside
     it used to have nowhere to step: the widget hero and the page hero were
     the same size, which is what makes a console read as a grid of equal
     tiles rather than as a page with a headline. Sizes are theme-invariant,
     so there is no dark override for this one. */
  --ns-text-display: 3rem;
  --ns-text-3xs: 0.625rem;
  --ns-text-2xs: 0.6875rem;
  --ns-text-chat: 0.9375rem;
  --ns-text-money: 0.9375rem;

  --ns-leading-tight: 1.1;
  --ns-leading-snug: 1.3;
  --ns-leading-normal: 1.5;
  --ns-leading-relaxed: 1.7;

  --ns-tracking-tight: -0.02em;
  --ns-tracking-normal: 0;
  --ns-tracking-wide: 0.12em;

  --ns-space-0: 0;
  --ns-space-px: 1px;
  --ns-space-0-5: 0.125rem;
  --ns-space-1: 0.25rem;
  --ns-space-1-5: 0.375rem;
  --ns-space-2: 0.5rem;
