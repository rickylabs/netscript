/**
 * @component ComparisonAreaChart
 * @layer 2
 * @depends theme-seed
 * @description Two-layer area chart — billed versus collected. The current
 * period is a stroked area; the comparison period is the same geometry at
 * reduced opacity underneath it (H5), never a second axis. Hand-authored SVG
 * over the series cycle, with a CSS-only crosshair readout (H4).
 */

import type { JSX, VNode } from 'preact';
import { useId } from 'preact/hooks';
import { cn } from '../../lib/cn.ts';

/** Series slot in the fixed `--ns-series-1..6` cycle (H3). */
export type AreaSeries = 1 | 2 | 3 | 4 | 5 | 6;

/**
 * One plotted point.
 *
 * `value` is geometry and is never rendered; `display` is the preformatted
 * string the readout shows (H2). The chart never formats a number.
 */
export interface AreaChartPoint {
  readonly value: number;
  /** Point name for the readout and, by default, the x-axis. */
  readonly label: string;
  /** Preformatted value for the readout. */
  readonly display: string;
}

export interface ComparisonAreaChartProps
  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children'> {
  points: readonly AreaChartPoint[];
  /** The comparison period. Same geometry, translucent, no stroke. */
  comparison?: readonly AreaChartPoint[] | null;
  /** Name for the comparison layer, e.g. `Previous period`. */
  comparisonLabel?: string;
  /** Name for the current layer, e.g. `This period`. */
  seriesLabel?: string;
  /**
   * Y-axis ticks, topmost first and preformatted, spread evenly from the top
   * gridline to the baseline. The topmost carries the currency (H6); the rest
   * are bare magnitudes. Omit for a chrome-free chart.
   */
  ticks?: readonly string[];
  /** X-axis labels. Defaults to each point's `label`. */
  xLabels?: readonly string[];
  /** Series slot for the current period. Defaults to 1. */
  series?: AreaSeries;
  /** Copy for the labelled empty frame. */
  emptyLabel?: string;
  class?: string;
}

/** viewBox units. The frame is drawn in CSS, so the plot can bleed to the edge. */
const VB_WIDTH = 320;
const VB_HEIGHT = 120;
/** Headroom inside the plot so a peak stroke never clips the frame. */
const VB_TOP = 10;
const VB_BASELINE = 120;
/** Horizontal inset so an end-point marker stays inside the frame. */
const VB_INSET = 6;
const GRID_LINES = 4;

const PLOT_HEIGHT = VB_BASELINE - VB_TOP;

/** Axis steps worth landing on. Denser than 1/2/5 so a peak keeps headroom. */
const NICE_STEPS = [1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 9, 10] as const;

/**
 * The axis maximum a chart will scale to for these values.
 *
 * Exported because a caller has to build its own tick labels from the same
 * number the gridlines sit on — a tick that disagrees with its gridline is a
 * lie about the scale — while still doing all the formatting itself (H2).
 */
export function areaChartMax(values: readonly number[]): number {
  const value = Math.max(0, ...values);
  if (!Number.isFinite(value) || value <= 0) return 1;
