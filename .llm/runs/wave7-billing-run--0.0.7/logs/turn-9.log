# Rewrite the webhooks contract: real WebhookEndpoint + WebhookDelivery surface
# derived from @database/zod (house rule: DB before contract).
p = 'contracts/versions/v1/webhooks.contract.ts'
open(p, 'w').write('''/**
 * Webhooks contract — Version 1
 *
 * The outbound-webhook boundary: endpoints and their delivery log. The
 * database owns field existence, enum values and nullability — every entity
 * schema here is derived from the generated Prisma-Zod models
 * (`@database/zod`) and only re-encoded where the public surface is stricter
 * (secrets never cross, timestamps as ISO strings).
 */

import { z } from 'zod';
import { implement } from '@orpc/server';
import { baseContract } from '@netscript/contracts';
import {
  WebhookDeliverySchema as DatabaseWebhookDeliverySchema,
  WebhookEndpointSchema as DatabaseWebhookEndpointSchema,
} from '@database/zod';

export const WebhooksHealthSchemaV1 = z.object({
  status: z.enum(['healthy', 'unhealthy', 'degraded']).describe('Service health status'),
  service: z.string().describe('Service name'),
  version: z.string().describe('Service version'),
  timestamp: z.string().datetime().describe('ISO timestamp'),
  uptime: z.number().int().nonnegative().optional().describe('Uptime in seconds'),
});

/** DB-derived enum: WebhookEventStatus. */
export const WebhookDeliveryStatusV1Schema = z.enum([
  'PENDING',
  'DELIVERED',
  'FAILED',
  'RETRYING',
  'REPLAYED',
  'DISABLED',
]);

export const WebhookEndpointSchemaV1 = DatabaseWebhookEndpointSchema
  .pick({ id: true, url: true, events: true, active: true, createdAt: true })
  .extend({
    createdAt: z.string().datetime(),
    /** Projection: the delivery log the endpoint has produced. */
    deliveries: z.array(z.object({})).optional(),
  });

export const WebhookDeliverySchemaV1 = DatabaseWebhookDeliverySchema
  .pick({
    id: true,
    endpointId: true,
    eventId: true,
    eventType: true,
    payload: true,
    status: true,
    attempts: true,
    attemptLog: true,
    nextRetryAt: true,
    deliveredAt: true,
    createdAt: true,
  })
  .extend({
    nextRetryAt: z.string().datetime().nullable(),
    deliveredAt: z.string().datetime().nullable(),
    createdAt: z.string().datetime(),
  });

export const WebhooksListInputSchemaV1 = z.object({
  limit: z.number().int().min(1).max(100).default(25),
  offset: z.number().int().nonnegative().optional(),
  search: z.string().max(200).optional(),
  active: z.boolean().optional(),
});

export const WebhooksListOutputSchemaV1 = z.object({
  items: z.array(WebhookEndpointSchemaV1),
  total: z.number().int().nonnegative(),
});

export const WebhooksDeliveriesInputSchemaV1 = z.object({
  limit: z.number().int().min(1).max(200).default(50),
  offset: z.number().int().nonnegative().optional(),
  endpointId: z.string().optional(),
  status: WebhookDeliveryStatusV1Schema.optional(),
});

export const WebhooksDeliveriesOutputSchemaV1 = z.object({
  items: z.array(WebhookDeliverySchemaV1),
  total: z.number().int().nonnegative(),
});

export const WebhooksReplayInputSchemaV1 = z.object({
  deliveryId: z.string().min(1),
  idempotencyKey: z.string().min(1).max(255),
});

export const WebhooksReplayOutputSchemaV1 = z.object({
  deliveryId: z.string(),
  status: WebhookDeliveryStatusV1Schema,
  replayed: z.boolean(),
});

export const WebhooksContractV1 = {
  health: {
    check: baseContract
      .route({ method: 'GET', path: '/webhooks/health' })
      .input(z.object({}).optional())
      .output(WebhooksHealthSchemaV1)
      .meta({ access: { authentication: 'none' } }),
  },

  list: baseContract
    .route({ method: 'GET', path: '/webhooks/endpoints' })
    .input(WebhooksListInputSchemaV1)
    .output(WebhooksListOutputSchemaV1)
    .meta({
      access: {
        authentication: 'required',
        authorization: { scopes: ['webhooks:read'] },
      },
    }),

  deliveries: baseContract
    .route({ method: 'GET', path: '/webhooks/deliveries' })
    .input(WebhooksDeliveriesInputSchemaV1)
    .output(WebhooksDeliveriesOutputSchemaV1)
    .meta({
      access: {
        authentication: 'required',
        authorization: { scopes: ['webhooks:read'] },
      },
    }),

  replay: baseContract
    .route({ method: 'POST', path: '/webhooks/deliveries/{deliveryId}/replay' })
    .input(WebhooksReplayInputSchemaV1)
    .output(WebhooksReplayOutputSchemaV1)
    .meta({
      access: {
        authentication: 'required',
        authorization: { scopes: ['webhooks:write'], roles: ['finance:admin'] },
      },
    }),
} as const;

export type WebhookEndpointV1 = z.infer<typeof WebhookEndpointSchemaV1>;
export type WebhookDeliveryV1 = z.infer<typeof WebhookDeliverySchemaV1>;

/**
 * Implemented contract ready for `.handler()` binding in the service router.
 */
export const WebhooksV1 = implement(WebhooksContractV1);
''')
print('contract rewritten')
EOF
