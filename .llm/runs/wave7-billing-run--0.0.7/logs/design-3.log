/**
 * Money formatting for Ledgerline.
 *
 * Two rules govern everything here, and both exist because this is a finance
 * product where a wrong number is a false statement:
 *
 *   1. Absence is an em dash, never a zero. `null` means "not measured", and
 *      `0.00` would assert a fact that was never established.
 *   2. Money arrives as a string-encoded decimal (see `MoneySchemaV1`:
 *      `/^-?\d+(\.\d{1,6})?$/`) and is formatted from that string. It is never
 *      round-tripped through a float to get to the screen.
 *
 * This module is pure and client-safe — islands import it directly.
 */

/** The rendered form of "not measured". Never `0`, never `0.00`, never empty. */
export const ABSENT = '\u2014';

/**
 * A money amount as the domain carries it: a string-encoded decimal, or a
 * number for already-normalised derived values. `null`/`undefined` = absent.
 */
export type MoneyValue = string | number | null | undefined;

/**
 * Direction of an amount. Maps 1:1 onto the money tokens, so a component
 * picks `--ns-money-pos` / `--ns-money-neg` / `--ns-money-flat` / `--ns-absent`
 * from this rather than from a comparison it re-implements.
 */
export type MoneyDirection = 'in' | 'out' | 'flat' | 'absent';

export interface MoneyFormatOptions {
  /** ISO 4217 code. Omit to render a bare amount (the panel states currency). */
  readonly currency?: string;
  /** BCP-47 locale for grouping and separators. Defaults to `en-US`. */
  readonly locale?: string;
  /** Render an explicit `+` on amounts towards us. Deltas want this; cells do not. */
  readonly signed?: boolean;
  /** Force a fraction-digit count instead of deriving it from the value. */
  readonly precision?: number;
  /** Upper bound for derived precision. Defaults to the domain maximum of 6. */
  readonly maxPrecision?: number;
}

/** The domain's maximum scale: `Decimal(18, 4)` storage, 6 in the wire schema. */
const MAX_PRECISION = 6;

/** Minimum fraction digits for anything that looks like a currency amount. */
const MIN_PRECISION = 2;

/** The wire schema's money shape. Anything else is not a Ledgerline amount. */
const MONEY_PATTERN = /^(-?)(\d+)(?:\.(\d+))?$/;

interface ParsedDecimal {
  readonly negative: boolean;
  readonly int: string;
  readonly frac: string;
}

/**
 * Splits a money value into sign, integer digits and fraction digits without
 * ever converting the whole amount to a float.
 */
function parseDecimal(value: MoneyValue): ParsedDecimal | null {
  if (value === null || value === undefined) return null;

  if (typeof value === 'number') {
    if (!Number.isFinite(value)) return null;
    // A number is accepted only as an already-normalised derived value; it is
    // re-serialised with enough digits to survive the round trip.
    return parseDecimal(value.toFixed(MAX_PRECISION));
  }

  const trimmed = value.trim();
  if (trimmed === '') return null;

  const match = MONEY_PATTERN.exec(trimmed);
  if (!match) return null;

  return { negative: match[1] === '-', int: match[2], frac: match[3] ?? '' };
}

/**
 * Groups the integer part with locale separators. The integer part of a
 * `Decimal(18, n)` is at most 18 digits, so this keeps exact digits for every
 * value the schema can hold and only borrows `Intl` for the separators.
 */
function groupInteger(int: string, locale: string): string {
  const digits = int.replace(/^0+(?=\d)/, '');
  // Beyond 2^53 `Number()` would lose trailing digits; group by hand to stay
  // exact for the widest value the storage type can hold.
  if (digits.length > 15) {
    return digits.replace(/\B(?=(\d{3})+(?!\d))/g, '\u2009');
  }
  return new Intl.NumberFormat(locale, { useGrouping: true }).format(Number(digits));
}

/**
 * How many fraction digits to render.
 *
 * Defaults to the value's own precision, never fewer than 2 — a metered unit
 * price of `0.0015` must not be flattened to `0.00`, and `1200` must still
 * read `1,200.00`.
 */
function precisionFor(frac: string, options: MoneyFormatOptions): number {
  if (options.precision !== undefined) return Math.max(0, options.precision);
  const max = options.maxPrecision ?? MAX_PRECISION;
  const significant = frac.replace(/0+$/, '').length;
  return Math.min(max, Math.max(MIN_PRECISION, significant));
}

/** Adds one to a digit string, carrying left. Returns the carry-out. */
function incrementDigitString(digits: readonly string[]): { digits: string[]; carry: boolean } {
  const out = [...digits];
  let carry = true;
  for (let i = out.length - 1; i >= 0 && carry; i -= 1) {
    const next = out[i].charCodeAt(0) - 48 + 1;
    if (next === 10) {
      out[i] = '0';
    } else {
      out[i] = String.fromCharCode(48 + next);
      carry = false;
    }
  }
  return { digits: out, carry };
}

/**
 * Rounds an integer/fraction digit pair to `precision` fraction digits.
 *
 * Half-up, applied to the decimal digits themselves. `toFixed` is not used: it
 * goes through a float, so `(2.675).toFixed(2)` is `'2.67'` — a billing
 * product must round the digits it was given, not their binary shadow.
 */
function roundToPrecision(
  int: string,
  frac: string,
  precision: number,
): { int: string; frac: string } {
  if (frac.length <= precision) {
    return { int, frac: frac.padEnd(precision, '0') };
  }

  const kept = frac.slice(0, precision);
  const discarded = frac.slice(precision);
  // Any leading discarded digit of 5 or more rounds up — half-up, on digits.
  if (discarded.charCodeAt(0) < 53) return { int, frac: kept };

  const rounded = incrementDigitString(kept.split(''));
  let nextInt = int;
  if (rounded.carry) {
    const carried = incrementDigitString(int.split(''));
    nextInt = (carried.carry ? '1' : '') + carried.digits.join('');
  }
  return { int: nextInt, frac: rounded.digits.join('') };
}

function currencyPrefix(currency: string | undefined, locale: string): string | null {
  if (!currency) return null;
  const parts = new Intl.NumberFormat(locale, {
    style: 'currency',
    currency,
    currencyDisplay: 'narrowSymbol',
  }).formatToParts(0);
  const symbol = parts.find((part) => part.type === 'currency')?.value ?? currency;
  return symbol;
}

/** A fully resolved, ready-to-render money value. */
export interface MoneyParts {
  /** Direction, for token selection. */
  readonly direction: MoneyDirection;
  /** `'-'`, or `'+'` when signed and towards us, or `''`. */
  readonly sign: string;
  /** Grouped magnitude with no sign, e.g. `1,240.00`. The em dash when absent. */
  readonly magnitude: string;
  /** Currency symbol without the amount, or `null` when rendering bare. */
  readonly currency: string | null;
  /** Sign + magnitude, or the em dash. The default thing to render. */
  readonly text: string;
  /** True when the input meant "not measured". */
  readonly absent: boolean;
  /** Parsed numeric value for chart math, or `null` when absent. */
  readonly value: number | null;
}

/**
 * Resolves a money value into every part a component needs: sign, magnitude,
 * direction and the rendered string. Absent in, em dash out.
 */
export function moneyParts(value: MoneyValue, options: MoneyFormatOptions = {}): MoneyParts {
  const parsed = parseDecimal(value);
  const locale = options.locale ?? 'en-US';

  if (!parsed) {
    return {
      direction: 'absent',
      sign: '',
      magnitude: ABSENT,
      currency: null,
      text: ABSENT,
      absent: true,
      value: null,
    };
  }

  const precision = precisionFor(parsed.frac, options);
  const rounded = roundToPrecision(parsed.int, parsed.frac, precision);
  const magnitude = precision > 0
    ? `${groupInteger(rounded.int, locale)}.${rounded.frac}`
    : groupInteger(rounded.int, locale);

  // Zero is decided after rounding: -0.004 at two digits is 0.00, not -0.00.
  const isZero = /^0*$/.test(rounded.int) && /^0*$/.test(rounded.frac);
  const direction: MoneyDirection = isZero ? 'flat' : parsed.negative ? 'out' : 'in';
  const sign = direction === 'out' ? '-' : direction === 'in' && options.signed ? '+' : '';

  return {
    direction,
    sign,
    magnitude,
    currency: currencyPrefix(options.currency, locale),
    text: `${sign}${magnitude}`,
    absent: false,
    value: Number(`${parsed.negative ? '-' : ''}${parsed.int}.${parsed.frac || '0'}`),
  };
}

/**
 * Formats a money amount. Returns the em dash for any value that is not a
 * usable amount — never `0.00`.
 */
export function formatMoney(value: MoneyValue, options: MoneyFormatOptions = {}): string {
  return moneyParts(value, options).text;
}

/** The direction of an amount, for token selection without formatting. */
export function moneyDirection(value: MoneyValue): MoneyDirection {
  return moneyParts(value).direction;
}

/**
 * A ratio whose denominator cannot support one is `null`, not `0`.
 *
 * Collection rate with no billed amount is *undefined*, not zero percent; the
 * caller renders `null` as the em dash.
 */
export function ratio(numerator: MoneyValue, denominator: MoneyValue): number | null {
  const top = moneyParts(numerator).value;
  const bottom = moneyParts(denominator).value;
  if (top === null || bottom === null || bottom === 0) return null;
  return top / bottom;
}

/**
 * Formats a ratio as a percentage. `null` renders as the em dash.
 */
export function formatPercent(
  value: number | null | undefined,
  options: { precision?: number; signed?: boolean } = {},
): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return ABSENT;
  const precision = options.precision ?? 1;
  const sign = options.signed && value > 0 ? '+' : '';
  return `${sign}${(value * 100).toFixed(precision)}%`;
}

/** Moves the decimal point left by `shift` digits, on the digit string. */
function shiftLeft(parsed: ParsedDecimal, shift: number): ParsedDecimal {
  if (shift === 0) return parsed;
  let digits = `${parsed.int}${parsed.frac}`;
  let point = parsed.int.length - shift;
  if (point <= 0) {
    digits = `${'0'.repeat(1 - point)}${digits}`;
    point = 1;
  }
  return { negative: parsed.negative, int: digits.slice(0, point), frac: digits.slice(point) };
}

/**
 * Compact money for dense surfaces and chart ticks: `$12.4k`, `1.2M`.
 *
 * Rounds half-up on the decimal digits, like every other amount. Absent stays
 * the em dash. Charts use this for ticks only — a chart never formats a value
 * it was handed; it receives preformatted labels.
 */
export function formatMoneyCompact(
  value: MoneyValue,
  options: MoneyFormatOptions = {},
): string {
  const parsed = parseDecimal(value);
  if (!parsed) return ABSENT;

  const locale = options.locale ?? 'en-US';
  const mag = `${parsed.int}${parsed.frac}`;
  const whole = Number(mag) / 10 ** parsed.frac.length;
  const scale = whole >= 1_000_000
    ? { shift: 6, suffix: 'M', digits: 1 }
    : whole >= 10_000
    ? { shift: 3, suffix: 'k', digits: 0 }
    : whole >= 1_000
    ? { shift: 3, suffix: 'k', digits: 1 }
    : { shift: 0, suffix: '', digits: MIN_PRECISION };

  const shifted = shiftLeft(parsed, scale.shift);
  const rounded = roundToPrecision(shifted.int, shifted.frac, scale.digits);
  const isZero = /^0*$/.test(rounded.int) && /^0*$/.test(rounded.frac);
  const negative = !isZero && parsed.negative;

  const sign = negative ? '-' : isZero ? '' : options.signed ? '+' : '';
  const symbol = currencyPrefix(options.currency, locale) ?? '';
  const body = scale.digits > 0
    ? `${groupInteger(rounded.int, locale)}.${rounded.frac}`
    : groupInteger(rounded.int, locale);
  return `${sign}${symbol}${body}${scale.suffix}`;
}
