/**
 * Money contract tests.
 *
 * These assert the two rules DESIGN.md states as testable, plus the
 * string-decimal discipline the wire schema (`MoneySchemaV1`) demands:
 *
 *   1. Absence renders as an em dash, never a zero.
 *   2. Amounts are formatted from the decimal string, never through a float,
 *      so a metered unit price keeps its real precision.
 */

import { assertEquals } from '@std/assert';

import {
  ABSENT,
  formatMoney,
  formatMoneyCompact,
  formatPercent,
  moneyDirection,
  moneyParts,
  ratio,
} from '../apps/ledgerline-web/lib/money.ts';

Deno.test('absence is an em dash, never a zero', () => {
  for (const absent of [null, undefined, '', '   ', 'not-money', 'NaN', Number.NaN]) {
    assertEquals(formatMoney(absent as never), ABSENT);
    assertEquals(moneyParts(absent as never).absent, true);
    assertEquals(moneyParts(absent as never).direction, 'absent');
    assertEquals(moneyParts(absent as never).value, null);
  }
  // The glyph, not a hyphen and not a blank.
  assertEquals(ABSENT, '\u2014');
});

Deno.test('a real zero is not absence', () => {
  const parts = moneyParts('0');
  assertEquals(parts.absent, false);
  assertEquals(parts.direction, 'flat');
  assertEquals(parts.value, 0);
  assertEquals(parts.text, '0.00');
});

Deno.test('direction maps to the money tokens', () => {
  assertEquals(moneyDirection('1240'), 'in');
  assertEquals(moneyDirection('-1240'), 'out');
... tail ...
  assertEquals(formatMoneyCompact('12400', { currency: 'USD' }), '$12k');
  assertEquals(formatMoneyCompact('2400000', { currency: 'USD' }), '$2.4M');
  // Sub-thousand amounts stay whole — compact is for ticks, not for cells.
  assertEquals(formatMoneyCompact('940', { currency: 'USD' }), '$940.00');
  assertEquals(formatMoneyCompact('-12400', { currency: 'USD' }), '-$12k');
  assertEquals(formatMoneyCompact('0', { currency: 'USD' }), '$0.00');
  assertEquals(formatMoneyCompact(null), ABSENT);
});

Deno.test('rounding is half-up on the decimal digits, never float-dependent', () => {
  // `(2.675).toFixed(2)` is '2.67' in JS; billing must round the digits given.
  assertEquals(formatMoney('2.675', { precision: 2 }), '2.68');
  assertEquals(formatMoney('2.674', { precision: 2 }), '2.67');
  assertEquals(formatMoney('0.005', { precision: 2 }), '0.01');
  // Rounding carries through the integer part and its separators.
  assertEquals(formatMoney('999.999', { precision: 2 }), '1,000.00');
  // …and a value that rounds to zero is zero, not a signed zero.
  assertEquals(moneyParts('-0.004', { precision: 2 }).direction, 'flat');
  assertEquals(formatMoney('-0.004', { precision: 2 }), '0.00');
});
