  background: var(--ns-primary);
}

.ns-donut__swatch[data-tone='success'] {
  background: var(--ns-success);
}

.ns-donut__swatch[data-tone='warning'] {
  background: var(--ns-warning);
}

.ns-donut__swatch[data-tone='secondary'] {
  background: var(--ns-secondary);
}

.ns-donut__swatch[data-tone='destructive'] {
  background: var(--ns-destructive);
}

@media (prefers-reduced-motion: reduce) {
  .ns-donut__ring {
    transition: none;
  }
}
