/**
 * @component MoneyText
 * @layer 2
 * @kind product
 * @description The money correctness component: tabular numerals, money-pos/neg/flat color, em dash on absence.
 */

import type { VNode } from 'preact';
import { cn } from '../../lib/cn.ts';

const DASH = '—';

interface MoneyTextProps {
  /** String-encoded decimal from the contract; null/undefined = not measured. */
  value: string | number | null | undefined;
  currency?: string;
  class?: string;
}

function formatMoney(raw: string | number): string | null {
  const text = String(raw).trim();
  if (text === '' || text === DASH) return null;
  const parsed = Number(text);
  if (!Number.isFinite(parsed)) return null;
  const decimals = text.includes('.') ? text.split('.')[1]!.length : 0;
  return new Intl.NumberFormat('en-US', {
    minimumFractionDigits: Math.min(decimals, 6),
    maximumFractionDigits: Math.min(Math.max(decimals, 2), 6),
  }).format(parsed);
}

/**
 * Renders money with the money-* semantic colors and tabular numerals.
 * Absence (`null`/`undefined`/unparseable) renders an em dash — never `0.00`,
 * because in a ledger "not measured" and "zero" are different facts. The
 * pos/neg/flat intent is carried as `data-money-sign` for per-surface CSS.
 */
export function MoneyText({ value, currency, class: className }: MoneyTextProps): VNode {
  const formatted = value === null || value === undefined ? null : formatMoney(value);
  if (formatted === null) {
    return (
      <span class={cn('ns-money-text', className)} data-money='absent' data-currency={currency}>
        <span aria-hidden='true'>{DASH}</span>
        <span class='sr-only'>not measured</span>
      </span>
    );
  }
  const amount = Number(value);
  const sign = amount > 0 ? 'pos' : amount < 0 ? 'neg' : 'flat';
  return (
    <span
      class={cn('ns-money-text', className)}
      data-money
      data-money-sign={sign}
      data-currency={currency}
    >
      {formatted}
      {currency && <span class='ns-money-text__currency'>{currency}</span>}
    </span>
  );
}
===== EXCEPTION BADGE 30-50 =====
 * Renders an exception bucket as a rust-tinted chip. `NONE`/absence renders
 * an em dash so "no exception" never reads like a flagged item. The rust
 * treatment lives in `assets/ui/exception-badge.css`, keyed off the
 * `data-exception` attribute.
 */
export function ExceptionBadge({ bucket, class: className }: ExceptionBadgeProps): VNode {
  if (!bucket || bucket === 'NONE' || !(bucket in EXCEPTION_LABELS)) {
    return (
      <span class={cn('ns-exception-badge', className)} data-exception='none'>
        {DASH}
      </span>
    );
  }
  return (
    <span
      class={cn('ns-badge', 'ns-exception-badge', className)}
      data-exception={bucket}
    >
      {EXCEPTION_LABELS[bucket]}
    </span>
  );
}
