+/**
+ * Tick labels for a chart, built from the maximum the chart will actually scale
+ * to. Hardcoding them is how a tick ends up disagreeing with its own gridline;
+ * the topmost tick carries the currency and the rest are bare magnitudes (H6).
+ */
+export function compactTicks(...series: readonly (readonly number[])[]): readonly string[] {
+  const max = areaChartMax(series.flat());
+  return AREA_CHART_TICK_RATIOS.map((ratio, index) =>
+    moneyParts(String(max * ratio), index === 0 ? { currency: 'USD' } : {}).magnitude
