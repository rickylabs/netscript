  border-color: color-mix(in srgb, var(--ns-secondary) 30%, transparent);
  transform: translate(1px, 1px);
  box-shadow: 2px 2px 0 color-mix(in srgb, var(--ns-secondary-border) 40%, transparent);
}

.ns-btn--secondary:active {
  transform: translate(2px, 2px);
  box-shadow: 1px 1px 0 color-mix(in srgb, var(--ns-secondary-border) 40%, transparent);
}

/* Ghost — minimal, surface-only hover */
.ns-btn--ghost {
  background: transparent;
  color: var(--ns-muted-fg);
}

.ns-btn--ghost:hover {
  background: color-mix(in srgb, var(--ns-fg) 4%, transparent);
  color: var(--ns-fg);
}

/* Outline — bordered with subtle depth */
.ns-btn--outline {
  background: transparent;
