/**
 * Design contract tests.
 *
 * DESIGN.md states several rules as mechanically checkable — "fails if" a ramp
 * step appears in a component, an offset shadow survives in a stylesheet, or a
 * catalogue entry has no demo. These tests are that check. They read the files,
 * because a rule that is not run is a rule that rots.
 */

import { assert, assertEquals } from '@std/assert';

const APP = new URL('../apps/ledgerline-web/', import.meta.url);
const ASSETS = new URL('./assets/', APP);
const COMPONENTS = new URL('./components/', APP);

/** Every CSS file an installed component owns. */
async function componentStylesheets(): Promise<string[]> {
  const files: string[] = [];
  for (const dir of ['ui', 'blocks']) {
    for await (const entry of Deno.readDir(new URL(`./${dir}/`, ASSETS))) {
      if (entry.isFile && entry.name.endsWith('.css')) files.push(`${dir}/${entry.name}`);
    }
  }
  return files.sort();
}

/** Every component module in the app-owned UI barrel directory. */
async function componentModules(): Promise<string[]> {
  const files: string[] = [];
  for await (const entry of Deno.readDir(new URL('./ui/', COMPONENTS))) {
    if (entry.isFile && entry.name.endsWith('.tsx')) files.push(entry.name);
  }
  return files.sort();
}

async function read(path: string): Promise<string> {
  return await Deno.readTextFile(new URL(path, APP));
}

/** Every app source file that can put text in front of a reader. */
async function appSources(): Promise<string[]> {
  const files: string[] = [];

  async function walk(dir: string): Promise<void> {
    try {
      for await (const entry of Deno.readDir(new URL(`./${dir}/`, APP))) {
        const rel = `${dir}/${entry.name}`;
        if (entry.isDirectory) await walk(rel);
        else if (/\.tsx?$/.test(entry.name)) files.push(rel);
      }
    } catch {
      // A root that does not exist in this branch contributes nothing.
    }
  }

  for (const root of ['routes', 'components', 'islands', 'lib']) await walk(root);
  return files.sort();
}

