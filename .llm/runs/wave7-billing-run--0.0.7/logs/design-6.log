import json, collections

p = 'assets/tokens.json'
d = json.load(open(p), object_pairs_hook=collections.OrderedDict)

def insert_after(od, anchor, items):
    """Rebuild an OrderedDict inserting `items` right after `anchor`."""
    out = collections.OrderedDict()
    for k, v in od.items():
        out[k] = v
        if k == anchor:
            for nk, nv in items:
                out[nk] = nv
    if anchor not in od:
        raise SystemExit(f'anchor {anchor!r} not found')
    return out

def entry(value, cssVar, path):
    return collections.OrderedDict([
        ('type', 'color'),
        ('value', value),
        ('cssVar', cssVar),
        ('path', path),
    ])

# 1) Extend the amber ramp two steps. The ramp's own arithmetic is -8% L per
#    step at constant chroma/hue (4=81.5, 5=73.5, 6=65.5), so these are
#    extrapolated, not invented. Amber is the only warm ramp that stopped at 6.
d['tokens'] = insert_after(d['tokens'], 'amber-6', [
    ('amber-7', entry('oklch(57.5% 0.125 78)', '--ns-amber-7', ['color', 'amber', '7'])),
    ('amber-8', entry('oklch(49.5% 0.125 78)', '--ns-amber-8', ['color', 'amber', '8'])),
])

# 2) A semantic text role for the warning family. Text on a tinted chip needs
#    4.5:1; amber-6 (the step the provisional tag named) reaches only 2.91:1 on
#    paper in light, and amber-7 still only 4.11:1. amber-8 measures 5.75:1.
d['tokens'] = insert_after(d['tokens'], 'warning', [
    ('warning-text', entry('var(--ns-amber-8)', '--ns-warning-text', ['semantic', 'warning-text'])),
])

# 3) Dark: the ramp steps brighter, mirroring --ns-money-neg (rust-6 -> rust-4).
d['themes']['dark'] = insert_after(d['themes']['dark'], 'paper-12', [])  # no-op guard
d['themes']['dark'] = insert_after(d['themes']['dark'], list(d['themes']['dark'])[
    [k for k in d['themes']['dark']].index('warning-fg') - 1
] if 'warning-fg' in d['themes']['dark'] else None, [
    ('warning-text', entry('var(--ns-amber-5)', '--ns-warning-text', ['semantic', 'warning-text'])),
])

json.dump(d, open(p, 'w'), indent=2)
open(p, 'a').write('\n')
print('ok')
EOF
