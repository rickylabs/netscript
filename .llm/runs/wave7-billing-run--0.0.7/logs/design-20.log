  // One decimal below 10k, none from 10k up, one again in millions.
  assertEquals(formatMoneyCompact('1240', { currency: 'USD' }), '$1.2k');
  assertEquals(formatMoneyCompact('12400', { currency: 'USD' }), '$12k');
