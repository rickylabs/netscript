Deno.test('sums are added on digit strings, so no value meets a float', () => {
  // The case `(0.1 + 0.2) !== 0.3` is why this function exists.
  assertEquals(sumMoney(['0.1', '0.2']), '0.3');
  assertEquals(sumMoney(['0.7', '0.1']), '0.8');
  // Mixed widths are scaled to the widest fraction, not truncated.
  assertEquals(sumMoney(['100', '0.50']), '100.50');
  assertEquals(sumMoney(['1.5', '2.25']), '3.75');
  // Metered precision survives: six fraction digits is the wire maximum.
  assertEquals(sumMoney(['0.0015', '0.0015']), '0.0030');
  // Signs net, and a negative total carries its sign.
  assertEquals(sumMoney(['1000.00', '-250.50']), '749.50');
  assertEquals(sumMoney(['100.00', '-400.00']), '-300.00');
  // A total that nets to nothing is 0.00, never a signed zero.
  assertEquals(sumMoney(['124.00', '-124.00']), '0.00');
});
