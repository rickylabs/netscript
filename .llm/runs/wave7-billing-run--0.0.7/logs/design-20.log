}

/* Hover layer: one column per point, tiled so there is no dead zone. Hovering
   the column — not a 4px dot — is what reveals the readout, so the reader aims
   at an x rather than at a target. */
.ns-areachart__hits {
  position: absolute;
  inset: 0;
}

/* `left`/`width` are set inline and already name the band's own box, so there
   is no centring transform to undo. `--hit-x` is the point's x as a percentage
   of *this band* — 50% for every interior band, and off-centre only where an
   end band had to be clipped to the frame. */
.ns-areachart__hit {
  --hit-x: 50%;
  position: absolute;
  top: 0;
  bottom: 0;
}

.ns-areachart__crosshair,
.ns-areachart__dot,
.ns-areachart__tip {
  opacity: 0;
  transition: opacity var(--ns-ease-fast);
  pointer-events: none;
}

/* The crosshair drops from the point marker to the baseline — downward, never
   up and out of the chart. */
.ns-areachart__crosshair {
  position: absolute;
  top: var(--hit-dot);
  bottom: 0;
  left: var(--hit-x);
  border-inline-start: 1px dashed var(--ns-chart-axis);
}

.ns-areachart__dot {
  position: absolute;
  top: var(--hit-dot);
  left: var(--hit-x);
  width: var(--ns-space-2);
  height: var(--ns-space-2);
  transform: translate(-50%, -50%);
  border: 2px solid var(--ns-card);
  border-radius: var(--ns-radius-full);
  background: var(--ns-series-1);
}

.ns-areachart__dot[data-series='2'] {
  background: var(--ns-series-2);
}

.ns-areachart__dot[data-series='3'] {
  background: var(--ns-series-3);
}

.ns-areachart__dot[data-series='4'] {
  background: var(--ns-series-4);
}

.ns-areachart__dot[data-series='5'] {
  background: var(--ns-series-5);
}

.ns-areachart__dot[data-series='6'] {
  background: var(--ns-series-6);
}

/* Dark bubble with a downward pointer, centred over the node. `--ns-tip-*`
   inverts against the card in both themes, so no component asks which theme
   is active (T3). */
.ns-areachart__tip {
  position: absolute;
  bottom: calc(100% - var(--hit-dot));
  left: var(--hit-x);
  transform: translate(-50%, calc(-1 * var(--ns-space-3)));
  display: flex;
  flex-direction: column;
  gap: var(--ns-space-0-5);
  padding: var(--ns-space-1-5) var(--ns-space-2-5);
  border-radius: var(--ns-radius-md);
  background: var(--ns-tip-bg);
  color: var(--ns-tip-fg);
  box-shadow: var(--ns-shadow-md);
  white-space: nowrap;
  z-index: var(--ns-z-dropdown);
}

.ns-areachart__tip::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border: var(--ns-space-1) solid transparent;
  border-top-color: var(--ns-tip-bg);
}

.ns-areachart__tip-label {
