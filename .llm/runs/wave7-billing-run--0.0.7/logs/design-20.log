Deno.test('T2a — no component reaches for a ramp step', async () => {
  // The paper ramp inverts in dark: paper-12 is near-black in light and
  // near-white in dark. A ramp step in a component is a broken dark theme.
  const rampStep = /var\(--ns-(?:paper|ledger|rust|ink|brass|amber)-\d+\)/;

  for (const sheet of await componentStylesheets()) {
    const css = await read(`./assets/${sheet}`);
    assert(!rampStep.test(css), `${sheet} references a ramp step; use the semantic role instead`);
  }

  for (const name of await componentModules()) {
    const source = await read(`./components/ui/${name}`);
    assert(
      !rampStep.test(source),
      `components/ui/${name} references a ramp step; use the semantic role instead`,
    );
  }
