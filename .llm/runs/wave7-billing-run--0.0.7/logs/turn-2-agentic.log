/**
 * Money arithmetic on string-encoded decimals.
 *
 * Everything money crosses this module: string in, string out, exact decimal
 * semantics via BigInt scaled arithmetic. Floats never touch an amount.
 *
 * Internal representation: BigInt scaled by 10^6 (micros). Rendered output
 * keeps at most 6 decimals with trailing zeros trimmed and at least 2 decimals.
 */

const SCALE = 6n;
const SCALE_FACTOR = 10n ** SCALE;

export type Money = string;

/** Parse a money string into scaled BigInt micros. Throws on malformed input. */
export function parseMoney(value: Money): bigint {
  const match = /^(-?)(\d+)(?:\.(\d{1,6}))?$/.exec(value);
  if (!match) {
    throw new Error(`invalid money value: ${JSON.stringify(value)}`);
  }
  const [, sign, whole, frac = ''] = match;
  const padded = (frac + '000000').slice(0, 6);
  const micros = BigInt(whole) * SCALE_FACTOR + BigInt(padded);
  return sign === '-' ? -micros : micros;
}

/** Render a micro-scaled BigInt back to a money string. */
export function formatMoney(micros: bigint): Money {
  const negative = micros < 0n;
  const abs = negative ? -micros : micros;
  const whole = abs / SCALE_FACTOR;
  const frac = abs % SCALE_FACTOR;
  let fracStr = frac.toString().padStart(6, '0').replace(/0+$/, '');
  if (fracStr.length < 2) fracStr = fracStr.padEnd(2, '0');
  return `${negative ? '-' : ''}${whole}.${fracStr}`;
}

/** Exact addition. */
export function add(a: Money, b: Money): Money {
  return formatMoney(parseMoney(a) + parseMoney(b));
}

/** Exact subtraction. */
export function sub(a: Money, b: Money): Money {
  return formatMoney(parseMoney(a) - parseMoney(b));
}

/** Exact negation. */
export function neg(a: Money): Money {
  return formatMoney(-parseMoney(a));
}

/** Multiply by an integer quantity (exact). */
export function mulInt(a: Money, qty: bigint | number): Money {
  return formatMoney(parseMoney(a) * BigInt(qty));
}

/** Sum an ordered list of money values exactly. */
export function sum(values: readonly Money[]): Money {
  let acc = 0n;
  for (const value of values) acc += parseMoney(value);
  return formatMoney(acc);
}

/** Compare two money values; returns -1, 0, or 1. */
export function compare(a: Money, b: Money): number {
  const left = parseMoney(a);
  const right = parseMoney(b);
  if (left === right) return 0;
  return left < right ? -1 : 1;
}

export function zero(): Money {
  return '0.00';
}

function roundHalfAwayFromZero(numerator: bigint, denominator: bigint): bigint {
  const quotient = numerator / denominator;
  const remainderTwice = (numerator % denominator) * 2n;
  if (remainderTwice > denominator || remainderTwice === denominator) {
    // numerator/denominator is non-negative here only if inputs are; sign follows quotient
    if (numerator < 0n) return quotient - 1n;
    return quotient + 1n;
  }
  return quotient;
}

/**
 * Time-pro-rate an amount: amount × (shareMs / totalMs), rounded half-away-
 * from-zero at the 4th decimal. Negative amounts (credits) round symmetrically.
 */
export function prorate(amount: Money, shareMs: number, totalMs: number): Money {
  if (!Number.isFinite(totalMs) || totalMs <= 0) return '0.00';
  if (!Number.isFinite(shareMs) || shareMs <= 0) return '0.00';
  if (shareMs >= totalMs) return amount;
  const micros = parseMoney(amount);
  const numerator = micros * BigInt(shareMs);
  const denominator = BigInt(totalMs);
  const scaled = roundHalfAwayFromZero(numerator, denominator);
  // Truncate to 4 decimal places (cent-precision money with a safety margin).
  const fourDp = (scaled / 100n) * 100n;
  return formatMoney(fourDp);
}
