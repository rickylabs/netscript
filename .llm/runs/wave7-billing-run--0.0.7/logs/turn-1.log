import { db } from '../mod.ts';
if (import.meta.main) {
  const client = await db.getClient();

  try {
    const existing = await client.user.findFirst({
      select: { id: true },
    });
    if (!existing) {
      await client.user.create({
        data: {
          name: 'Seed User',
        },
      });
      console.log('✅ Seeded representative User row.');
    } else {
      console.log('ℹ️ User rows already exist; seed left them unchanged.');
    }
  } finally {
    await db.disconnect();
  }
}
