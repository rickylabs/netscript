// Sagas Plugin Prisma Schema
// This schema defines the database tables for the sagas plugin.
// Runtime saga state can be persisted by KV or the dedicated Prisma durable
// runtime tables below. The existing SagaInstance/SagaExecutionHistory models
// remain a Postgres read model/projection for API querying, analytics, and
// debugging.

// ============================================================================
// DURABLE SAGA RUNTIME STATE
// ============================================================================

/// Durable saga state envelope keyed by native saga instance id
model SagaRuntimeState {
  /// Native saga runtime instance id (for example, "OrderSaga:order-123")
  instanceId String   @id @map("instance_id") @db.VarChar(200)

  /// Saga definition id/name
  sagaId     String   @map("saga_id") @db.VarChar(100)

  /// Optimistic concurrency version
  version    Int

  /// Full SagaStateEnvelope payload
  envelope   Json

  /// Record timestamps
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([sagaId])
  @@index([updatedAt])
  @@map("saga_runtime_state")
}

/// Durable saga transition history keyed by instance id and version
model SagaRuntimeTransition {
  /// Native saga runtime instance id
  instanceId String   @map("instance_id") @db.VarChar(200)

  /// Saga state version produced by this transition
