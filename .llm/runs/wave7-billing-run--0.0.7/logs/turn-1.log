/**
 * PostgreSQL database module.
 *
 * @module
 */

import { enablePrismaTracing } from '@netscript/database/tracing';
import { PrismaPg } from '@prisma/adapter-pg';
import { PrismaClient as PostgresClient } from './schema/.generated/client.server.ts';

if (Deno.env.get('OTEL_DENO') === 'true') {
  enablePrismaTracing();
}

let client: PostgresClient | null = null;

function getClientSync(): PostgresClient {
  if (!client) {
    const connectionString = resolveConnectionString('POSTGRES_URI');
    if (!connectionString) {
      throw new Error('PostgreSQL connection string not found.');
    }
    Deno.env.set('POSTGRES_URI', connectionString);
    Deno.env.set('DATABASE_URL', connectionString);
    client = new PostgresClient({
      adapter: new PrismaPg({ connectionString }),
    });
  }
  return client;
}

/** Get the PostgreSQL Prisma client. */
export function getPostgres(): Promise<PostgresClient> {
  return Promise.resolve(getClientSync());
}

/** Unified database facade for this workspace. */
export const db = {
  get postgres(): PostgresClient {
    return getClientSync();
  },

  get client(): PostgresClient {
    return getClientSync();
  },

  getClient(): Promise<PostgresClient> {
    return Promise.resolve(getClientSync());
  },

  async disconnect(): Promise<void> {
    if (client) {
      await client.$disconnect();
      client = null;
    }
  },

  async healthCheck(): Promise<Record<string, boolean>> {
    try {
      await getClientSync().$queryRawUnsafe('SELECT 1');
      return { postgres: true };
    } catch {
      return { postgres: false };
    }
  },
};

function resolveConnectionString(
  envKey: string,
  fallback?: string,
): string | undefined {
  const rawValue = Deno.env.get(envKey) ?? Deno.env.get('DATABASE_URL') ?? fallback;
  if (!rawValue) {
    return undefined;
  }

  return normalizeDatabaseUrl(rawValue);
}

