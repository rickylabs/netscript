/**
 * Billing contract — Version 1
 *
 * The money boundary. Every procedure declares its access requirements;
 * the contract's Zod boundaries are derived from the database schemas where a
 * model crosses the boundary verbatim, and narrowed/extended where the public
 * surface is stricter than the table.
 *
 * Money is string-encoded decimal ("49.00") end to end — never a float.
 */

import { z } from 'zod';
import {
  baseContract,
  paginationLimit,
  paginationOffset,
  positiveInt,
  boundedString,
} from '@netscript/contracts';

// ---------------------------------------------------------------------------
// Shared primitives
// ---------------------------------------------------------------------------

export const MoneySchemaV1 = z
  .string()
  .regex(/^-?\d+(\.\d{1,6})?$/, 'string-encoded decimal')
  .describe('Money as a string-encoded decimal, never a float');

export const IsoDateTimeSchemaV1 = z.string().datetime();
