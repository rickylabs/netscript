// ---------------------------------------------------------------------------
// Subscriptions & mid-cycle changes
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  ENDED
}

model Subscription {
  id             String   @id @default(cuid())
  customerId     String
  planVersionId  String
  status         SubscriptionStatus @default(ACTIVE)
  seats          Int      @default(1)
  billingAnchor  DateTime
  startedAt      DateTime @default(now())
  endedAt        DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  customer       Customer    @relation(fields: [customerId], references: [id])
  planVersion    PlanVersion @relation(fields: [planVersionId], references: [id])
  usageEvents    UsageEvent[]
  changes        SubscriptionChange[]
  invoices       Invoice[]
  paymentAttempts PaymentAttempt[]
  runItems       RunItem[]

  @@index([customerId, status])
  @@map("subscriptions")
// All post-issue correction flows through credit notes, never edits.
model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  customerId    String
  subscriptionId String?
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("USD")
  subtotal      Decimal       @db.Decimal(18, 4)
  total         Decimal       @db.Decimal(18, 4)
  periodStart   DateTime
  periodEnd     DateTime
  finalizedAt   DateTime?
  issuedAt      DateTime?
  dueAt         DateTime?
  paidAt        DateTime?
  voidedAt      DateTime?
  voidReason    String?
  billingRunId  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer      @relation(fields: [customerId], references: [id])
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id])
  lines         InvoiceLine[]
  payments      Payment[]
  creditNotes   CreditNote[]
  applications  CreditNoteApplication[]
  runItems      RunItem[]
  billingRun    BillingRun?   @relation(fields: [billingRunId], references: [id])

  @@unique([customerId, periodStart, periodEnd])
  @@index([status, dueAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(24, 6)
  unitAmount  Decimal @db.Decimal(18, 4)
  amount      Decimal @db.Decimal(18, 4)
  derivation  Json
  invoice     Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_lines")
}
  amount      Decimal         @db.Decimal(18, 4)
  currency    String          @default("USD")
  reason      String
  sourceType  String?
  sourceId    String?
  actorId     String?
  createdAt   DateTime        @default(now())
  customer    Customer        @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@map("credit_ledger_entries")
}

enum EntitlementSource {
  PLAN
  MANUAL
}

model EntitlementGrant {
  id          String            @id @default(cuid())
  customerId  String
  featureKey  String
  source      EntitlementSource
  limit       Int?
  revokedAt   DateTime?
  createdAt   DateTime          @default(now())
  customer    Customer          @relation(fields: [customerId], references: [id])

  @@unique([customerId, featureKey])
  @@map("entitlement_grants")
}

// ---------------------------------------------------------------------------
// Payments & dunning
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  attemptNumber Int
  outcome       PaymentAttemptOutcome
  declineReason String?
  nextRetryAt   DateTime?
  createdAt     DateTime             @default(now())
  payment       Payment              @relation(fields: [paymentId], references: [id])
  subscription  Subscription?        @relation(fields: [subscriptionId], references: [id])

  @@index([paymentId, attemptNumber])
  @@map("payment_attempts")
}

// ---------------------------------------------------------------------------
// The billing run — Ledgerline's first-class object
// ---------------------------------------------------------------------------

enum RunStatus {
  DRAFT
  COMPUTING
  REVIEW
  ISSUING
  ISSUED
  FAILED
  COMPENSATED
  CANCELED
}

enum RunItemStatus {
  PENDING
  COMPUTED
  APPROVED
  EXCLUDED
  ISSUING
  ISSUED
  FAILED
  COMPENSATED
  SKIPPED
}

enum ExceptionBucket {
  NONE
  FIRST_INVOICE
  AMOUNT_DELTA
  NO_PAYMENT_METHOD
  HARD_DECLINE
  PAST_DUE
  createdAt   DateTime    @default(now())
  runItem     RunItem     @relation(fields: [runItemId], references: [id])

  @@map("run_decision_records")
}

// ---------------------------------------------------------------------------
// Webhooks (outbound delivery) & audit
// ---------------------------------------------------------------------------

enum WebhookEventStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
  REPLAYED
  DISABLED
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}
