### surface-styles.css (head 60)
/* C7 — radius and elevation encode containment, so they are not uniform.

   The containing card is the largest radius on the page and carries the
   diffuse ambient shadow. A panel sits *inside* a card, so it steps down and
   drops the shadow: at the card's radius and elevation it reads as a second
   card competing with the surface that contains it. Sharing one rule between
   the two is what kept every surface here at 12px while the widget cards
   beside them were 24px — the same page, two card grammars. */
.ns-card {
  border-radius: var(--ns-radius-3xl);
  border: 1px solid var(--ns-border-hover);
  box-shadow: var(--ns-shadow-ambient);
  overflow: hidden;
}

.ns-panel {
  border-radius: var(--ns-radius-xl);
  border: 1px solid var(--ns-border-hover);
  overflow: hidden;
}

.ns-card__header,
.ns-panel__header {
  display: flex;
  flex-direction: column;
  gap: var(--ns-space-2);
}

/* A title the same size as the description under it has no presence — the eye
   reads the pair as one paragraph and the card never announces what it is.
   One step up is enough; the hero number below it still outranks both (C2). */
.ns-card__title,
.ns-panel__title {
  font-size: var(--ns-text-base);
  font-weight: 600;
  line-height: 1.35;
}

.ns-card__description,
.ns-panel__description {
  font-size: var(--ns-text-sm);
  line-height: 1.55;
  color: var(--ns-muted-fg);
}
