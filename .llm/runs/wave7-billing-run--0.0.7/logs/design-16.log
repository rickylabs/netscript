     1	/**
     2	 * @component ComparisonAreaChart
     3	 * @layer 2
     4	 * @depends theme-seed
     5	 * @description Two-layer area chart — billed versus collected. The current
     6	 * period is a stroked area; the comparison period is the same geometry at
     7	 * reduced opacity underneath it (H5), never a second axis. Hand-authored SVG
     8	 * over the series cycle, with a CSS-only crosshair readout (H4).
     9	 */
    10	
    11	import type { JSX, VNode } from 'preact';
    12	import { useId } from 'preact/hooks';
    13	import { cn } from '../../lib/cn.ts';
    14	
    15	/** Series slot in the fixed `--ns-series-1..6` cycle (H3). */
    16	export type AreaSeries = 1 | 2 | 3 | 4 | 5 | 6;
    17	
    18	/**
    19	 * One plotted point.
    20	 *
    21	 * `value` is geometry and is never rendered; `display` is the preformatted
    22	 * string the readout shows (H2). The chart never formats a number.
    23	 */
    24	export interface AreaChartPoint {
    25	  readonly value: number;
    26	  /** Point name for the readout and, by default, the x-axis. */
    27	  readonly label: string;
    28	  /** Preformatted value for the readout. */
    29	  readonly display: string;
    30	}
    31	
    32	export interface ComparisonAreaChartProps
    33	  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children'> {
    34	  points: readonly AreaChartPoint[];
    35	  /** The comparison period. Same geometry, translucent, no stroke. */
    36	  comparison?: readonly AreaChartPoint[] | null;
    37	  /** Name for the comparison layer, e.g. `Previous period`. */
    38	  comparisonLabel?: string;
    39	  /** Name for the current layer, e.g. `This period`. */
    40	  seriesLabel?: string;
    41	  /**
    42	   * Y-axis ticks, topmost first and preformatted, spread evenly from the top
    43	   * gridline to the baseline. The topmost carries the currency (H6); the rest
    44	   * are bare magnitudes. Omit for a chrome-free chart.
    45	   */
    46	  ticks?: readonly string[];
    47	  /** X-axis labels. Defaults to each point's `label`. */
    48	  xLabels?: readonly string[];
    49	  /** Series slot for the current period. Defaults to 1. */
    50	  series?: AreaSeries;
    51	  /** Copy for the labelled empty frame. */
    52	  emptyLabel?: string;
    53	  class?: string;
    54	}
    55	
    56	/** viewBox units. The frame is drawn in CSS, so the plot can bleed to the edge. */
    57	const VB_WIDTH = 320;
    58	const VB_HEIGHT = 120;
    59	/** Headroom inside the plot so a peak stroke never clips the frame. */
    60	const VB_TOP = 10;
    61	const VB_BASELINE = 120;
    62	/** Horizontal inset so an end-point marker stays inside the frame. */
    63	const VB_INSET = 6;
    64	const GRID_LINES = 4;
    65	
    66	const PLOT_HEIGHT = VB_BASELINE - VB_TOP;
    67	
    68	/** Axis steps worth landing on. Denser than 1/2/5 so a peak keeps headroom. */
    69	const NICE_STEPS = [1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 9, 10] as const;
    70	
    71	/**
    72	 * The axis maximum a chart will scale to for these values.
    73	 *
    74	 * Exported because a caller has to build its own tick labels from the same
    75	 * number the gridlines sit on — a tick that disagrees with its gridline is a
    76	 * lie about the scale — while still doing all the formatting itself (H2).
    77	 */
    78	export function areaChartMax(values: readonly number[]): number {
    79	  const value = Math.max(0, ...values);
    80	  if (!Number.isFinite(value) || value <= 0) return 1;
    81	  const pow = 10 ** Math.floor(Math.log10(value));
    82	  const n = value / pow;
    83	  const nice = NICE_STEPS.find((step) => n <= step) ?? 10;
    84	  return nice * pow;
    85	}
    86	
    87	/** Where the gridlines sit, as a fraction of the axis maximum, topmost first. */
    88	export const AREA_CHART_TICK_RATIOS: readonly number[] = [1, 0.75, 0.5, 0.25, 0];
    89	
    90	function niceMax(value: number): number {
    91	  return areaChartMax([value]);
    92	}
    93	
    94	/** x in viewBox units for point `index` of `count`. */
    95	function xAt(index: number, count: number): number {
    96	  const span = VB_WIDTH - VB_INSET * 2;
    97	  return VB_INSET + (count > 1 ? (span / (count - 1)) * index : span / 2);
    98	}
    99	
   100	/** y in viewBox units for a value, clamped to the plot. */
   101	function yAt(value: number, max: number): number {
   102	  const ratio = max > 0 ? Math.max(0, Math.min(value, max)) / max : 0;
   103	  return VB_BASELINE - ratio * PLOT_HEIGHT;
   104	}
   105	
   106	/** Position as a percentage of the drawn chart box, for CSS-positioned overlays. */
   107	function percentX(index: number, count: number): number {
   108	  return (xAt(index, count) / VB_WIDTH) * 100;
   109	}
   110	
   111	/** Width of one hover column, so adjacent columns tile the plot exactly. */
   112	function percentStep(count: number): number {
   113	  if (count <= 1) return 100;
   114	  return ((VB_WIDTH - VB_INSET * 2) / (count - 1) / VB_WIDTH) * 100;
   115	}
   116	
   117	/**
   118	 * The hover band for point `index`, as percentages of the drawn frame.
   119	 *
   120	 * The band is centred on its point but clipped to the frame, and it carries the
   121	 * point's own x back out as `x` (a percentage of the band) for `--hit-x`. Both
   122	 * halves matter: an unclipped end band hangs outside the frame by half a step,
   123	 * and the frame does not clip — so the first band reaches into the y-axis
   124	 * gutter and hovering a tick label pops a readout for a point it is not on.
   125	 * A clipped band whose marker still sat at `50%` would draw the dot and the
   126	 * crosshair off the point they name. Clipping is safe for tiling because
   127	 * adjacent bands still meet exactly at the midpoint between their points.
   128	 */
   129	function hitBand(index: number, count: number): { left: number; width: number; x: number } {
   130	  const centre = percentX(index, count);
   131	  const half = percentStep(count) / 2;
   132	  const left = Math.max(0, centre - half);
   133	  const right = Math.min(100, centre + half);
   134	  const width = right - left;
   135	  return { left, width, x: width > 0 ? ((centre - left) / width) * 100 : 50 };
   136	}
   137	
   138	function percentY(value: number, max: number): number {
   139	  return (yAt(value, max) / VB_HEIGHT) * 100;
   140	}
   141	
   142	/**
   143	 * Builds an area path for a series.
   144	 *
   145	 * Control points sit one third of the span either side of each vertex at the
   146	 * vertex's own y, so every join has a horizontal tangent: the curve is smooth
   147	 * but can never overshoot into a value the data does not contain.
   148	 */
   149	function areaPath(values: readonly number[], max: number, close: boolean): string {
   150	  if (values.length === 0) return '';
   151	
   152	  const coords = values.map((value, index) => ({
   153	    x: xAt(index, values.length),
   154	    y: yAt(value, max),
   155	  }));
   156	
   157	  let d = `M ${coords[0].x} ${coords[0].y}`;
   158	  for (let i = 1; i < coords.length; i += 1) {
   159	    const from = coords[i - 1];
   160	    const to = coords[i];
   161	    const handle = (to.x - from.x) / 3;
   162	    d += ` C ${from.x + handle} ${from.y} ${to.x - handle} ${to.y} ${to.x} ${to.y}`;
   163	  }
   164	
   165	  if (!close) return d;
   166	
   167	  const last = coords[coords.length - 1];
   168	  return `${d} L ${last.x} ${VB_BASELINE} L ${coords[0].x} ${VB_BASELINE} Z`;
   169	}
   170	
   171	/**
   172	 * A two-layer area chart with a CSS-only hover readout.
   173	 *
   174	 * The comparison layer is the prior period at reduced opacity — same hue, same
   175	 * geometry, no second axis, no second stroke. Because the hue is shared,
   176	 * "which line is this?" is answered by the legend, not by colour.
   177	 */
   178	export function ComparisonAreaChart({
   179	  points,
   180	  comparison,
   181	  comparisonLabel = 'Previous period',
   182	  seriesLabel = 'This period',
   183	  ticks,
   184	  xLabels,
   185	  series = 1,
   186	  emptyLabel = 'Nothing recorded in this period',
   187	  class: className,
   188	  ...props
   189	}: ComparisonAreaChartProps): VNode {
   190	  const gradientId = useId();
   191	  const hasComparison = (comparison?.length ?? 0) > 1;
   192	
   193	  if (points.length === 0) {
   194	    return (
   195	      <div {...props} class={cn('ns-areachart', className)}>
   196	        <div class='ns-areachart__frame ns-areachart__frame--empty'>
   197	          <p class='ns-areachart__empty'>{emptyLabel}</p>
   198	        </div>
   199	      </div>
   200	    );
   201	  }
   202	
   203	  const max = niceMax(
   204	    Math.max(
   205	      0,
   206	      ...points.map((point) => point.value),
   207	      ...(comparison ?? []).map((point) => point.value),
   208	    ),
   209	  );
   210	  const values = points.map((point) => point.value);
   211	  const comparisonValues = hasComparison ? comparison!.map((point) => point.value) : null;
   212	  const labels = xLabels ?? points.map((point) => point.label);
   213	
   214	  return (
   215	    <div {...props} class={cn('ns-areachart', className)}>
   216	      {ticks && ticks.length > 0 && (
   217	        <ul class='ns-areachart__yaxis' aria-hidden='true'>
   218	          {ticks.map((tick, index) => (
   219	            <li
   220	              class='ns-areachart__ytick'
   221	              style={{
   222	                top: `${percentY(max * (1 - index / (ticks.length - 1 || 1)), max)}%`,
   223	              }}
   224	            >
   225	              {tick}
   226	            </li>
   227	          ))}
   228	        </ul>
   229	      )}
   230	
   231	      <div class='ns-areachart__frame'>
   232	        <svg
   233	          class='ns-areachart__svg'
   234	          viewBox={`0 0 ${VB_WIDTH} ${VB_HEIGHT}`}
   235	          role='img'
   236	          aria-label={`${seriesLabel} against ${comparisonLabel}, ${points.length} periods`}
   237	        >
   238	          <defs>
   239	            <linearGradient id={gradientId} x1='0' y1='0' x2='0' y2='1'>
   240	              <stop class='ns-areachart__stop-top' data-series={series} offset='0%' />
   241	              <stop class='ns-areachart__stop-bottom' data-series={series} offset='100%' />
   242	            </linearGradient>
   243	          </defs>
   244	
   245	          <g class='ns-areachart__grid' aria-hidden='true'>
   246	            {Array.from({ length: GRID_LINES }, (_, i) => {
   247	              const y = yAt(max * ((GRID_LINES - i) / GRID_LINES), max);
   248	              return (
   249	                <line
   250	                  key={i}
   251	                  class='ns-areachart__gridline'
   252	                  x1={VB_INSET}
   253	                  y1={y}
   254	                  x2={VB_WIDTH - VB_INSET}
   255	                  y2={y}
   256	                />
   257	              );
   258	            })}
   259	            <line
   260	              class='ns-areachart__baseline'
   261	              x1='0'
   262	              y1={VB_BASELINE}
   263	              x2={VB_WIDTH}
   264	              y2={VB_BASELINE}
   265	            />
   266	          </g>
   267	
   268	          {comparisonValues && (
   269	            <path
   270	              class='ns-areachart__comparison'
   271	              data-series={series}
   272	              d={areaPath(comparisonValues, max, true)}
   273	            />
   274	          )}
   275	
   276	          <path
   277	            class='ns-areachart__area'
   278	            data-series={series}
   279	            d={areaPath(values, max, true)}
   280	            fill={`url(#${gradientId})`}
   281	          />
   282	          <path
   283	            class='ns-areachart__line'
   284	            data-series={series}
   285	            d={areaPath(values, max, false)}
   286	            fill='none'
   287	          />
   288	        </svg>
   289	
   290	        {
   291	          /* The readout is a hover layer over the geometry, not part of it:
   292	            crosshair, point marker and tooltip reveal on :hover with no script
   293	            and no first-paint mismatch (H4). */
   294	        }
   295	        <div class='ns-areachart__hits' aria-hidden='true'>
   296	          {points.map((point, index) => {
   297	            const band = hitBand(index, points.length);
   298	            return (
   299	              <span
   300	                key={point.label}
   301	                class='ns-areachart__hit'
   302	                style={{
   303	                  left: `${band.left}%`,
   304	                  width: `${band.width}%`,
   305	                  '--hit-x': `${band.x}%`,
   306	                  '--hit-dot': `${percentY(point.value, max)}%`,
   307	                } as JSX.CSSProperties}
   308	              >
   309	                <span class='ns-areachart__crosshair' />
   310	                <span class='ns-areachart__dot' data-series={series} />
   311	                <span class='ns-areachart__tip'>
   312	                  <span class='ns-areachart__tip-label'>{point.label}</span>
   313	                  <span class='ns-areachart__tip-value'>{point.display}</span>
   314	                </span>
   315	              </span>
   316	            );
   317	          })}
   318	        </div>
   319	      </div>
   320	
   321	      <ul class='ns-areachart__xaxis' aria-hidden='true'>
   322	        {labels.map((label, index) => (
   323	          <li
   324	            class='ns-areachart__xtick'
   325	            style={{ left: `${percentX(index, labels.length)}%` }}
   326	          >
   327	            {label}
   328	          </li>
   329	        ))}
   330	      </ul>
   331	
   332	      {hasComparison && (
   333	        <ul class='ns-areachart__legend'>
   334	          <li class='ns-areachart__legend-row'>
