import { routePatterns } from './.generated/manifest.ts';
import { routes as generatedRoutes } from './.generated/routes.ts';

/**
 * App-local route entrypoint.
 *
 * Route consumers should import from this stable module instead of reaching into
 * the generated files directly.
 */
export { routePatterns };

export const routes = {
  ...generatedRoutes,
} as const;

/**
 * Section-level entries resolved from the GENERATED route references — never
 * hand-built patterns, which cannot express dynamic segments (Fresh uses
 * `[id]`, not `{id}`). Detail pages use the generated `$id` references
 * directly (e.g. `routes.runs.$id.$route`).
 */
export const appRoutes = {
  home: routes.$route,
  health: routes.health.$route,
  runs: routes.runs.$route,
  invoices: routes.invoices.$route,
  customers: routes.customers.$route,
  design: routes.design.$route,
  designTokens: routes.design.tokens.$route,
  designComponents: routes.design.components.$route,
  designComposition: routes.design.composition.$route,
} as const;

export const appRouter = {
  routePatterns,
  routes,
  appRoutes,
} as const;

export type AppRouter = typeof appRouter;
