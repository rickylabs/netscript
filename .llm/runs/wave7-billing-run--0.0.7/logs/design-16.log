     1	/**
     2	 * @component SegmentedControl
     3	 * @layer 2
     4	 * @depends theme-seed
     5	 * @description Range selection as one full-width capsule: N equal cells, the
     6	 * selected one a filled pill. Never a border change (C4). Renders as buttons
     7	 * for client-side selection, or as links when the range is a route, and wraps
     8	 * onto further lines when the options outgrow one.
     9	 */
    10	
    11	import type { JSX, VNode } from 'preact';
    12	import { cn } from '../../lib/cn.ts';
    13	
    14	export interface SegmentedControlOption {
    15	  /** Range key — `1D`, `1W`, `1M`, `3M`, `1Y`, or a product range id. */
    16	  readonly value: string;
    17	  /** Preformatted cell label. */
    18	  readonly label: string;
    19	  /** Render the cell as a link, so the range lives in the URL. */
    20	  readonly href?: string;
    21	  readonly disabled?: boolean;
    22	}
    23	
    24	/**
    25	 * An anchor that opts into Fresh's client-side navigation. The framework's own
    26	 * link attribute is not in Preact's anchor attribute set.
    27	 */
    28	interface ClientNavAnchorAttributes extends JSX.AnchorHTMLAttributes<HTMLAnchorElement> {
    29	  'f-client-nav'?: boolean;
    30	}
    31	
    32	export interface SegmentedControlProps
    33	  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children' | 'onSelect'> {
    34	  /** Accessible name for the group, e.g. `Billing period`. */
    35	  label: string;
    36	  options: readonly SegmentedControlOption[];
    37	  /** The selected option's `value`. Omit only when nothing is selected. */
    38	  value?: string | null;
    39	  /** Called with the chosen `value`. Required unless every option has an `href`. */
    40	  onSelect?: (value: string) => void;
    41	  size?: 'sm' | 'md';
    42	  /** Stretch to the container width. The reference control is full-width. */
    43	  block?: boolean;
    44	  /**
    45	   * Let the cells wrap onto more than one line instead of stretching to fill
    46	   * one. A capsule is a one-line shape, so this also steps the container down
    47	   * to a panel radius and drops the inter-cell hairlines — reach for it when
    48	   * the options outgrow a line, the way a filter over eight run statuses does
    49	   * against a range control's four.
    50	   */
    51	  wrap?: boolean;
    52	  /**
    53	   * Let link options navigate client-side. A range that lives in the URL is
    54	   * usually a filter, and a filter that reloads the whole page is a slower
    55	   * version of the same navigation.
    56	   */
    57	  clientNav?: boolean;
    58	  class?: string;
    59	}
    60	
    61	/**
    62	 * A segmented range control.
    63	 *
    64	 * Link options turn the group into navigation and drop the tab semantics,
    65	 * because a link is not a tab; selection is then announced with
    66	 * `aria-current`. Link and button options are not mixed — the first option
    67	 * decides the whole control's mode.
    68	 */
    69	export function SegmentedControl({
    70	  label,
    71	  options,
    72	  value = null,
    73	  onSelect,
    74	  size = 'md',
    75	  block = true,
    76	  wrap = false,
    77	  clientNav = false,
    78	  class: className,
    79	  ...props
    80	}: SegmentedControlProps): VNode {
    81	  const asLinks = options.length > 0 && options.every((option) => option.href !== undefined);
    82	
    83	  return (
    84	    <div
    85	      {...props}
    86	      class={cn(
    87	        'ns-segmented',
    88	        size === 'sm' && 'ns-segmented--sm',
    89	        block && !wrap && 'ns-segmented--block',
    90	        wrap && 'ns-segmented--wrap',
    91	        className,
    92	      )}
    93	      role={asLinks ? 'group' : 'tablist'}
    94	      aria-label={label}
    95	    >
    96	      {options.map((option) => {
    97	        const selected = option.value === value;
    98	        const cellClass = cn('ns-segmented__cell', selected && 'is-selected');
    99	
   100	        if (asLinks) {
   101	          return (
   102	            <a
   103	              key={option.value}
   104	              class={cellClass}
   105	              href={option.href}
