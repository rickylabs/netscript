1	/* DeltaChip — one component for every "versus last period" in the product (C3).
     2	
     3	   It is a pill sitting *beside* the number it qualifies, optically centred on
     4	   it, not a badge parked in the card header. The tinted background is a
     5	   `color-mix` of the money token so dark mode re-tints without a second rule. */
     6	
     7	.ns-delta-chip {
     8	  display: inline-flex;
     9	  align-items: baseline;
    10	  gap: var(--ns-space-2);
    11	  /* Optically centred on a hero number rather than box-centred: the pill rides
    12	     the cap height of the figure next to it. */
    13	  vertical-align: middle;
    14	}
    15	
    16	.ns-delta-chip__pill {
    17	  display: inline-flex;
    18	  align-items: center;
    19	  gap: var(--ns-space-1);
    20	  padding: var(--ns-space-0-5) var(--ns-space-2);
    21	  border-radius: var(--ns-radius-full);
    22	  font-family: var(--ns-font-sans);
    23	  font-size: var(--ns-text-xs);
    24	  font-weight: 600;
    25	  line-height: 1.35;
    26	  white-space: nowrap;
    27	  font-variant-numeric: var(--ns-numeric-tabular);
    28	}
    29	
    30	.ns-delta-chip__glyph {
    31	  font-size: 0.875em;
    32	  line-height: 1;
    33	}
    34	
    35	.ns-delta-chip__note {
    36	  font-size: var(--ns-text-xs);
    37	  color: var(--ns-muted-fg);
    38	  white-space: nowrap;
    39	}
    40	
    41	.ns-delta-chip__pill[data-direction='up'] {
    42	  color: var(--ns-money-pos);
    43	  background: color-mix(in srgb, var(--ns-money-pos) 12%, transparent);
    44	}
    45	
    46	.ns-delta-chip__pill[data-direction='down'] {
    47	  color: var(--ns-money-neg);
