/** Scratch: render the five steer-#2 widgets and print the spec-critical markup. */
import { render } from 'npm:preact-render-to-string@^6.7.0';
import {
  ComparisonAreaChart,
  DeltaChip,
  FooterColumns,
  SegmentedControl,
  SemicircularGauge,
  WidgetCard,
} from '../apps/ledgerline-web/components/ui/mod.ts';

function show(title: string, vnode: unknown): void {
  const html = render(vnode as never);
  console.log(`\n===== ${title} =====`);
  console.log(html);
}

show('DeltaChip up', <DeltaChip value='+2.1%' direction='up' />);
show('DeltaChip absent', <DeltaChip value='' direction='absent' />);

show(
  'SemicircularGauge',
  <SemicircularGauge
    label='Issued'
    value='$1,240,500.00'
    caption='of 412 run items'
    total={412}
    segments={[
      { label: 'Issued', value: 318, display: '$1,240,500.00' },
      { label: 'In review', value: 47, display: '$183,400.00' },
    ]}
  />,
);

show(
  'SegmentedControl',
  <SegmentedControl
    label='Collection period'
    options={[{ value: '1M', label: '1M' }, { value: '3M', label: '3M' }, { value: '1Y', label: '1Y' }]}
    value='3M'
