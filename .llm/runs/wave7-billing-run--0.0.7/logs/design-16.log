     1	/**
     2	 * @component FooterColumns
     3	 * @layer 2
     4	 * @depends theme-seed, lib/money
     5	 * @description The bottom band of a widget card: N equal columns of label and
     6	 * amount, divided by hairline rules. Gaps alone do not separate columns (C5).
     7	 */
     8	
     9	import type { JSX, VNode } from 'preact';
    10	import { cn } from '../../lib/cn.ts';
    11	import { ABSENT, type MoneyDirection } from '../../lib/money.ts';
    12	import type { Renderable } from '../../lib/public-types.ts';
    13	
    14	export interface FooterColumn {
    15	  /** Quiet uppercase label, e.g. `APPROVED`. */
    16	  readonly label: string;
    17	  /** Preformatted amount. `null` renders the em dash (M1). */
    18	  readonly value: string | null;
    19	  /**
    20	   * Direction of the amount, which is a domain fact — approved is towards us,
    21	   * excepted is away — and never a colour decision at the call site (M5).
    22	   * Omitted leaves the amount in the surface's own foreground.
    23	   */
    24	  readonly direction?: MoneyDirection;
    25	  /** Optional tinted icon tile above the amount. */
    26	  readonly glyph?: Renderable;
    27	}
    28	
    29	export interface FooterColumnsProps
    30	  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children'> {
    31	  columns: readonly FooterColumn[];
    32	  class?: string;
    33	}
    34	
    35	/**
    36	 * A hairline-divided footer strip.
    37	 *
    38	 * A column whose value is `null` is a fact that was not measured, so it renders
    39	 * the em dash in the absent tone — the footer is exactly where a fabricated
    40	 * `0.00` would do the most damage.
    41	 */
    42	export function FooterColumns({ columns, class: className, ...props }: FooterColumnsProps): VNode {
    43	  if (columns.length === 0) return <div {...props} class={cn('ns-footer-cols', className)} />;
    44	
    45	  return (
    46	    <div {...props} class={cn('ns-footer-cols', className)}>
    47	      {columns.map((column) => {
    48	        const absent = column.value === null || column.direction === 'absent';
    49	        return (
    50	          <div
    51	            key={column.label}
    52	            class='ns-footer-cols__col'
    53	            // `absent` wins over a caller-supplied direction: once the value is
    54	            // null there is no amount for a direction to qualify, and the em
    55	            // dash has to land in the absent tone or it reads as data.
    56	            data-direction={absent ? 'absent' : (column.direction ?? 'inherit')}
    57	          >
    58	            {column.glyph && <span class='ns-footer-cols__glyph'>{column.glyph}</span>}
    59	            <span class='ns-footer-cols__label'>{column.label}</span>
    60	            <span class='ns-footer-cols__value'>
    61	              {absent
    62	                ? (
    63	                  <>
    64	                    <span aria-hidden='true'>{ABSENT}</span>
    65	                    <span class='sr-only'>not recorded</span>
    66	                  </>
    67	                )
    68	                : column.value}
    69	            </span>
    70	          </div>
    71	        );
    72	      })}
    73	    </div>
    74	  );
    75	}
########## components/product/money-text.tsx
     1	/**
     2	 * @component MoneyText
     3	 * @layer 2
     4	 * @kind product
     5	 * @depends lib/money
     6	 * @description The one renderer for a money amount. It formats nothing itself:
     7	 * every digit comes from `lib/money.ts`, direction comes from
     8	 * `moneyParts().direction`, and absence is an em dash.
     9	 */
    10	
    11	import type { VNode } from 'preact';
    12	import { cn } from '../../lib/cn.ts';
    13	import { ABSENT, type MoneyDirection, moneyParts, type MoneyValue } from '../../lib/money.ts';
    14	
    15	interface MoneyTextProps {
    16	  /** String-encoded decimal from the contract; null/undefined = not measured. */
    17	  value: MoneyValue;
    18	  currency?: string;
    19	  class?: string;
    20	}
    21	
    22	/**
    23	 * `moneyParts` direction -> the `data-money-sign` this component's stylesheet
    24	 * keys off. Absent is styled by `data-money='absent'`, so it lands on `flat`
    25	 * here and never reaches this map.
    26	 */
    27	const SIGN: Readonly<Record<MoneyDirection, string>> = {
    28	  in: 'pos',
    29	  out: 'neg',
    30	  flat: 'flat',
    31	  absent: 'flat',
    32	};
    33	
    34	/**
    35	 * Renders money with the money-* semantic colors and tabular numerals.
    36	 *
    37	 * Every digit and the direction both come from one `moneyParts()` call. This
    38	 * component does no arithmetic of its own: the float round-trip it used to
    39	 * make is what printed `$100` where the ledger requires `$100.00`, and the
    40	 * sign it used to re-derive with `amount > 0` is a fact the money layer
    41	 * already resolves — including the case where rounding a small negative to
    42	 * two digits makes it a flat zero rather than a negative amount.
    43	 *
    44	 * Absence (`null`/`undefined`/unparseable) renders an em dash — never `0.00`,
    45	 * because in a ledger "not measured" and "zero" are different facts.
    46	 */
    47	export function MoneyText({ value, currency, class: className }: MoneyTextProps): VNode {
    48	  const parts = moneyParts(value, { currency });
    49	
    50	  if (parts.absent) {
    51	    return (
    52	      <span class={cn('ns-money-text', className)} data-money='absent' data-currency={currency}>
    53	        <span aria-hidden='true'>{ABSENT}</span>
    54	        <span class='sr-only'>not measured</span>
    55	      </span>
    56	    );
    57	  }
    58	
    59	  return (
    60	    <span
    61	      class={cn('ns-money-text', className)}
    62	      data-money
    63	      data-money-sign={SIGN[parts.direction]}
    64	      data-currency={currency}
    65	    >
    66	      {
    67	        /* Currency leads as its own element, so it is a prefix the layout can
    68	          space — never a code concatenated onto the digits as `100.00USD`. */
    69	      }
    70	      {parts.currency !== null && <span class='ns-money-text__currency'>{parts.currency}</span>}
    71	      {parts.text}
    72	    </span>
    73	  );
    74	}
