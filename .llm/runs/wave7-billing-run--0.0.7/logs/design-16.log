     1	/**
     2	 * @component DeltaChip
     3	 * @layer 2
     4	 * @depends theme-seed
     5	 * @description The one "up or down versus last period" in the product. A
     6	 * tinted pill, a directional glyph, and a signed value rendered beside the
     7	 * number it qualifies — never in the card header, and never a re-styled Badge.
     8	 */
     9	
    10	import type { JSX, VNode } from 'preact';
    11	import { cn } from '../../lib/cn.ts';
    12	import { ABSENT } from '../../lib/money.ts';
    13	
    14	/** Which way the number moved, or that the comparison could not be made. */
    15	export type DeltaDirection = 'up' | 'down' | 'flat' | 'absent';
    16	
    17	/** Glyph set. `arrow` is the default; `none` is what the reference's hero chip uses. */
    18	export type DeltaGlyph = 'arrow' | 'none';
    19	
    20	export interface DeltaChipProps
    21	  extends Omit<JSX.HTMLAttributes<HTMLSpanElement>, 'class' | 'children'> {
    22	  /**
    23	   * The delta, already formatted and already signed — `+2.1%`, `-$1,204.00`.
    24	   * The chip never formats a number (H2) and never infers a sign.
    25	   */
    26	  value: string;
    27	  /** Direction of the movement. `absent` renders the em dash in the absent tone. */
    28	  direction?: DeltaDirection;
    29	  /** Draw the directional glyph. Defaults to `arrow`. */
    30	  glyph?: DeltaGlyph;
    31	  /** Quiet trailing context, e.g. `vs last week`. Rendered outside the pill. */
    32	  note?: string;
    33	  class?: string;
    34	}
    35	
    36	const GLYPHS: Record<Exclude<DeltaDirection, 'absent'>, string> = {
    37	  up: '\u2191',
    38	  down: '\u2193',
    39	  flat: '\u2192',
    40	};
    41	
    42	/**
    43	 * A delta chip: tinted pill, directional glyph, signed value.
    44	 *
    45	 * `absent` is the case that matters most and is easiest to lose: a comparison
    46	 * with no prior period is not a zero movement, it is a movement that does not
    47	 * exist, and it renders the em dash (M1) in the absent tone.
    48	 */
    49	export function DeltaChip({
    50	  value,
    51	  direction = 'flat',
    52	  glyph = 'arrow',
    53	  note,
    54	  class: className,
    55	  ...props
    56	}: DeltaChipProps): VNode {
    57	  const absent = direction === 'absent';
    58	
    59	  return (
    60	    <span {...props} class={cn('ns-delta-chip', className)}>
    61	      <span class='ns-delta-chip__pill' data-direction={direction}>
    62	        {!absent && glyph === 'arrow' && (
    63	          <span class='ns-delta-chip__glyph' aria-hidden='true'>
    64	            {GLYPHS[direction]}
    65	          </span>
    66	        )}
    67	        <span class='ns-delta-chip__value'>
    68	          {absent
    69	            ? (
    70	              <>
    71	                <span aria-hidden='true'>{ABSENT}</span>
    72	                <span class='sr-only'>no prior period</span>
    73	              </>
    74	            )
    75	            : value}
    76	        </span>
    77	      </span>
    78	      {note && <span class='ns-delta-chip__note'>{note}</span>}
    79	    </span>
    80	  );
    81	}
