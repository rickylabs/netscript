   348	
   349	      {
   350	        /* The readout is pointer-only by construction (H4), so the same facts
   351	          are available to a screen reader as text. */
   352	      }
   353	      <ul class='sr-only'>
   354	        {points.map((point) => <li key={point.label}>{point.label}: {point.display}</li>)}
   355	      </ul>
   356	    </div>
   357	  );
   358	}
