import { render } from 'npm:preact-render-to-string@^6.7.0';
import DesignComponentsView from '@app/routes/(design)/design/(_components)/components-view.tsx';

const html = render(<DesignComponentsView />);

const five = [
  'delta-chip',
  'semicircular-gauge',
  'segmented-control',
  'comparison-area-chart',
  'footer-columns',
  'widget-card',
];
const items = [...html.matchAll(/data-registry-item="([^"]+)"/g)].map((m) => m[1]);
console.log('gallery items:', items.length);
const sections = [...html.matchAll(/<h2 id="([^"]+)"[^>]*>([\s\S]{0,140}?)<\/h2>/g)]
  .map((m) => `${m[1]}[${m[2].replace(/<[^>]*>/g, '').trim()}]`);
console.log('sections:', sections.join(' | '));

for (const name of five) {
  const inCatalog = items.includes(name);
  const re = new RegExp(`data-registry-item="${name}"([\\s\\S]*?)</article>`);
  const block = re.exec(html)?.[0] ?? '';
  const demo = /class="ns-gallery-demo"[^>]*>([\s\S]{0,120})/.exec(block)?.[1] ?? '';
  console.log(
    `${name.padEnd(24)} catalogued=${inCatalog} demo=${demo.length > 0 ? 'yes' : 'NO'} demoStart=${demo.replace(/\s+/g, ' ').slice(0, 70)}`,
  );
}

const marks: [string, string][] = [
  ['delta-chip', 'ns-delta-chip__pill'],
  ['gauge', 'ns-gauge__seg'],
  ['segmented', 'ns-segmented__cell'],
  ['areachart', 'ns-areachart__area'],
  ['footer-cols', 'ns-footer-cols__col'],
  ['widget-hero', 'ns-widget__hero'],
];
console.log('markup marks:', marks.filter(([, m]) => html.includes(m)).map(([k]) => k).join(','));
EOF
