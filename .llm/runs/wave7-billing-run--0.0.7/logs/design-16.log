}

  const themes: readonly [name: string, block: string][] = [
    ['light', root],
    ['dark', darkBlock],
  ];

  for (const [name, block] of themes) {
    const absent = contrast('absent', 'card', block);
    const money = contrast('money-pos', 'card', block);

    // The floor: a glyph a reader is meant to notice clears 3:1 on its own
    // ground. Dark clears the 4.5:1 small-text bar as well, because its money
    // ramp steps up far enough to leave the room; see the note in tokens.css.
    assert(
      absent >= 3,
      `--ns-absent is ${absent.toFixed(2)}:1 against the card in ${name} — the em dash is unreadable`,
    );
    // The ceiling, and the constraint that makes light the binding theme:
    // absence stands in for an amount, so it must never out-shout a real one.
    assert(
      absent < money,
      `--ns-absent (${absent.toFixed(2)}:1) is louder than --ns-money-pos (${
        money.toFixed(2)
      }:1) in ${name} — absence is quieter than the value it replaces`,
    );
