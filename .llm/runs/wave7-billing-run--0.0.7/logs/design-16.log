     1	/**
     2	 * @component SemicircularGauge
     3	 * @layer 2
     4	 * @depends theme-seed
     5	 * @description 180° two-tone gauge — the run-progress widget. Hand-authored
     6	 * SVG over the fixed series cycle: a grey unallocated track, then one arc per
     7	 * segment, terminated with flat baseline cuts. Centre carries a quiet label
     8	 * over the hero amount.
     9	 */
    10	
    11	import type { JSX, VNode } from 'preact';
    12	import { cn } from '../../lib/cn.ts';
    13	
    14	/** Series slot in the fixed `--ns-series-1..6` cycle (H3). */
    15	export type GaugeSeries = 1 | 2 | 3 | 4 | 5 | 6;
    16	
    17	/**
    18	 * One arc of the gauge.
    19	 *
    20	 * `value` is geometry only — it is never rendered (H2). The label the reader
    21	 * sees arrives as `display`, already formatted by the caller.
    22	 */
    23	export interface GaugeSegment {
    24	  readonly value: number;
    25	  /** Legend name, e.g. `Issued`. */
    26	  readonly label: string;
    27	  /** Preformatted amount for the legend, e.g. `$842,000.00`. */
    28	  readonly display: string;
    29	  /** Series slot. Defaults to the segment's index in the cycle. */
    30	  readonly series?: GaugeSeries;
    31	}
    32	
    33	export interface SemicircularGaugeProps
    34	  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children'> {
    35	  segments: readonly GaugeSegment[];
    36	  /**
    37	   * The denominator — every item the run covers, including the ones no segment
    38	   * accounts for. Omitted means the segments are the whole. `null` means the
    39	   * total was not measured, which renders the empty frame (H7, M1).
    40	   */
    41	  total?: number | null;
    42	  /** Quiet uppercase label above the centre amount, e.g. `ISSUED`. */
    43	  label: string;
    44	  /** The preformatted centre amount. */
    45	  value: string;
    46	  /** Quiet line under the centre amount. */
    47	  caption?: string;
    48	  /** Show the inline dot legend below the rule (C6). Defaults to true. */
    49	  legend?: boolean;
    50	  /** Copy for the labelled empty frame. */
    51	  emptyLabel?: string;
    52	  /** Tighten the centre amount for narrow rails. */
    53	  compact?: boolean;
    54	  class?: string;
    55	}
    56	
    57	/** viewBox: the arc is 160 wide and 100 tall, plus room for the 18-wide stroke. */
    58	const VIEW_WIDTH = 200;
    59	const VIEW_HEIGHT = 110;
    60	const RADIUS = 80;
    61	const STROKE = 18;
    62	const CENTRE_X = 100;
    63	const BASELINE_Y = 100;
    64	
    65	const ARC = `M ${CENTRE_X - RADIUS} ${BASELINE_Y} A ${RADIUS} ${RADIUS} 0 0 1 ${
    66	  CENTRE_X + RADIUS
    67	} ${BASELINE_Y}`;
    68	
    69	/** Dash lengths are declared in `pathLength` units, so they read as percentages. */
    70	const PATH_LENGTH = 100;
    71	
    72	/**
    73	 * A 180° two-tone gauge.
    74	 *
    75	 * Terminals are `butt` caps: the arc ends in flat horizontal cuts flush with
    76	 * the baseline, and the junction between two segments is a crisp radial cut —
    77	 * no rounded overhang below the baseline and no bleed across the junction.
    78	 */
    79	export function SemicircularGauge({
    80	  segments,
    81	  total,
    82	  label,
    83	  value,
    84	  caption,
    85	  legend = true,
    86	  emptyLabel = 'Nothing to measure yet',
    87	  compact = false,
    88	  class: className,
    89	  ...props
    90	}: SemicircularGaugeProps): VNode {
    91	  const sum = segments.reduce((acc, segment) => acc + segment.value, 0);
    92	  const denominator = total ?? sum;
    93	
    94	  if (!Number.isFinite(denominator) || denominator <= 0 || sum < 0) {
    95	    return (
    96	      <div {...props} class={cn('ns-gauge', 'ns-gauge--empty', className)}>
    97	        <div class='ns-gauge__frame'>
    98	          <p class='ns-gauge__empty'>{emptyLabel}</p>
    99	        </div>
   100	      </div>
   101	    );
   102	  }
   103	
   104	  // A segment can never claim more than the whole; the track keeps the rest.
   105	  let cursor = 0;
   106	  const arcs = segments.map((segment, index) => {
   107	    const share = Math.max(0, Math.min(segment.value, denominator)) / denominator;
   108	    const start = cursor;
   109	    cursor = Math.min(cursor + share, 1);
   110	    return {
   111	      key: `${segment.label}-${index}`,
   112	      series: segment.series ?? ((index % 6) + 1) as GaugeSeries,
   113	      length: share * PATH_LENGTH,
   114	      offset: -start * PATH_LENGTH,
   115	    };
   116	  });
   117	
   118	  return (
   119	    <div {...props} class={cn('ns-gauge', compact && 'ns-gauge--compact', className)}>
   120	      <div class='ns-gauge__plot'>
   121	        <svg
   122	          class='ns-gauge__svg'
   123	          viewBox={`0 0 ${VIEW_WIDTH} ${VIEW_HEIGHT}`}
   124	          role='img'
   125	          aria-label={`${label} ${value} of ${denominator} run items`}
   126	        >
   127	          <path
   128	            class='ns-gauge__track'
   129	            d={ARC}
   130	            pathLength={PATH_LENGTH}
   131	            fill='none'
   132	            stroke-width={STROKE}
   133	            stroke-linecap='butt'
   134	          />
   135	          {arcs.map((arc) => (
   136	            <path
   137	              key={arc.key}
   138	              class='ns-gauge__seg'
   139	              data-series={arc.series}
   140	              d={ARC}
   141	              pathLength={PATH_LENGTH}
   142	              fill='none'
   143	              stroke-width={STROKE}
   144	              stroke-linecap='butt'
   145	              stroke-dasharray={`${arc.length} ${PATH_LENGTH - arc.length}`}
   146	              stroke-dashoffset={arc.offset}
   147	            />
   148	          ))}
   149	        </svg>
   150	        <div class='ns-gauge__center'>
   151	          <span class='ns-gauge__label'>{label}</span>
   152	          <span class='ns-gauge__value'>{value}</span>
   153	          {caption && <span class='ns-gauge__caption'>{caption}</span>}
   154	        </div>
   155	      </div>
   156	
   157	      {
   158	        /* The baseline rule is part of the graphic: it separates the arc from
   159	          whatever the card puts beneath it. */
   160	      }
   161	      <span class='ns-gauge__rule' aria-hidden='true' />
   162	
   163	      {legend && (
   164	        <ul class='ns-gauge__legend'>
   165	          {segments.map((segment, index) => (
   166	            <li key={`${segment.label}-${index}`} class='ns-gauge__legend-row'>
   167	              <span
   168	                class='ns-gauge__dot'
   169	                data-series={segment.series ?? ((index % 6) + 1) as GaugeSeries}
   170	                aria-hidden='true'
   171	              />
   172	              <span class='ns-gauge__legend-label'>{segment.label}</span>
   173	              <span class='ns-gauge__legend-value'>{segment.display}</span>
   174	            </li>
   175	          ))}
   176	        </ul>
   177	      )}
   178	    </div>
   179	  );
   180	}
