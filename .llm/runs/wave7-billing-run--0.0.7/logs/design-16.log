    28	 * Renders an exception bucket as a rust-tinted chip. `NONE`/absence renders
    29	 * an em dash so "no exception" never reads like a flagged item. The rust
    30	 * treatment lives in `assets/ui/exception-badge.css`, keyed off the
    31	 * `data-exception` attribute.
    32	 */
    33	export function ExceptionBadge({ bucket, class: className }: ExceptionBadgeProps): VNode {
    34	  if (!bucket || bucket === 'NONE' || !(bucket in EXCEPTION_LABELS)) {
    35	    return (
    36	      <span class={cn('ns-exception-badge', className)} data-exception='none'>
    37	        {DASH}
    38	      </span>
    39	    );
    40	  }
    41	  return (
    42	    <span
    43	      class={cn('ns-badge', 'ns-exception-badge', className)}
    44	      data-exception={bucket}
    45	    >
    46	      {EXCEPTION_LABELS[bucket]}
    47	    </span>
    48	  );
    49	}
