+ *
+ * `ratio` answers "what fraction"; a movement answers "which way, and by how
+ * much". They part company on the case that matters most: with no prior amount
+ * there is no movement at all, which is not a movement of zero. A run with
+ * nothing before it has not held steady — it has not been compared (M1).
+ */
+export function movement(current: MoneyValue, prior: MoneyValue): MoneyMovement {
+  const change = ratio(current, prior);
+  if (change === null || !Number.isFinite(change)) return { label: ABSENT, direction: 'absent' };
+
+  const delta = change - 1;
+  return {
+    label: formatPercent(delta, { signed: true }),
+    direction: delta > 0 ? 'up' : delta < 0 ? 'down' : 'flat',
+  };
+}
