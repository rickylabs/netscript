const VB_TOP = 10;
const VB_BASELINE = 120;
/** Horizontal inset so an end-point marker stays inside the frame. */
const VB_INSET = 6;
const GRID_LINES = 4;

const PLOT_HEIGHT = VB_BASELINE - VB_TOP;

/** Axis steps worth landing on. Denser than 1/2/5 so a peak keeps headroom. */
const NICE_STEPS = [1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 9, 10] as const;

/**
 * The axis maximum a chart will scale to for these values.
 *
 * Exported because a caller has to build its own tick labels from the same
 * number the gridlines sit on — a tick that disagrees with its gridline is a
 * lie about the scale — while still doing all the formatting itself (H2).
 */
export function areaChartMax(values: readonly number[]): number {
  const value = Math.max(0, ...values);
  if (!Number.isFinite(value) || value <= 0) return 1;
  const pow = 10 ** Math.floor(Math.log10(value));
  const n = value / pow;
  const nice = NICE_STEPS.find((step) => n <= step) ?? 10;
  return nice * pow;
}

/** Where the gridlines sit, as a fraction of the axis maximum, topmost first. */
export const AREA_CHART_TICK_RATIOS: readonly number[] = [1, 0.75, 0.5, 0.25, 0];

function niceMax(value: number): number {
  return areaChartMax([value]);
}

/** x in viewBox units for point `index` of `count`. */
function xAt(index: number, count: number): number {
  const span = VB_WIDTH - VB_INSET * 2;
  return VB_INSET + (count > 1 ? (span / (count - 1)) * index : span / 2);
}

/** y in viewBox units for a value, clamped to the plot. */
function yAt(value: number, max: number): number {
  const ratio = max > 0 ? Math.max(0, Math.min(value, max)) / max : 0;
  return VB_BASELINE - ratio * PLOT_HEIGHT;
}

/** Position as a percentage of the drawn chart box, for CSS-positioned overlays. */
function percentX(index: number, count: number): number {
  return (xAt(index, count) / VB_WIDTH) * 100;
}

/** Width of one hover column, so adjacent columns tile the plot exactly. */
function percentStep(count: number): number {
  if (count <= 1) return 100;
  return ((VB_WIDTH - VB_INSET * 2) / (count - 1) / VB_WIDTH) * 100;
}

function percentY(value: number, max: number): number {
  return (yAt(value, max) / VB_HEIGHT) * 100;
}

/**
 * Builds an area path for a series.
 *
 * Control points sit one third of the span either side of each vertex at the
 * vertex's own y, so every join has a horizontal tangent: the curve is smooth
 * but can never overshoot into a value the data does not contain.
 */
function areaPath(values: readonly number[], max: number, close: boolean): string {
  if (values.length === 0) return '';

  const coords = values.map((value, index) => ({
    x: xAt(index, values.length),
    y: yAt(value, max),
  }));

  let d = `M ${coords[0].x} ${coords[0].y}`;
  for (let i = 1; i < coords.length; i += 1) {
    const from = coords[i - 1];
    const to = coords[i];
    const handle = (to.x - from.x) / 3;
    d += ` C ${from.x + handle} ${from.y} ${to.x - handle} ${to.y} ${to.x} ${to.y}`;
  }

  if (!close) return d;

  const last = coords[coords.length - 1];
  return `${d} L ${last.x} ${VB_BASELINE} L ${coords[0].x} ${VB_BASELINE} Z`;
}

/**
 * A two-layer area chart with a CSS-only hover readout.
 *
 * The comparison layer is the prior period at reduced opacity — same hue, same
 * geometry, no second axis, no second stroke. Because the hue is shared,
 * "which line is this?" is answered by the legend, not by colour.
 */
