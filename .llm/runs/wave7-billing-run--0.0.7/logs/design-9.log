import pathlib
p = pathlib.Path("routes/runs/(_components)/run-comparison.tsx")
s = p.read_text()

s = s.replace(
"""/** One item, in both periods, as chart geometry plus the two readouts. */
interface ComparedItem {
  readonly label: string;
  readonly current: number;
  readonly prior: number;
  readonly currentDisplay: string;
  readonly priorDisplay: string;
}""",
"""/** One item, in both periods, as chart geometry plus the two readouts. */
interface ComparedItem {
  /** The item itself, so a total can be summed over exactly this population. */
  readonly item: RunItemV1;
  readonly label: string;
  readonly current: number;
  readonly prior: number;
  readonly currentDisplay: string;
  readonly priorDisplay: string;
}""")

s = s.replace(
"""  return {
    label: item.customerName ?? item.id,""",
"""  return {
    item,
    label: item.customerName ?? item.id,""")

s = s.replace(
"""  const totals = totalsFor(items, pairs);""",
"""  const totals = totalsFor(pairs);""")

s = s.replace(
"""function totalsFor(
  items: readonly RunItemV1[],
  pairs: readonly ComparedItem[],
): RunComparisonTotals {
  const compared = new Set(pairs.map((pair) => pair.label));
  const population = items.filter((item) => compared.has(item.customerName ?? item.id));
  return {
    current: sumMoney(population.map((item) => item.computedTotal)),
    prior: sumMoney(population.map((item) => item.priorTotal)),
  };
}""",
"""function totalsFor(pairs: readonly ComparedItem[]): RunComparisonTotals {
  return {
    current: sumMoney(pairs.map((pair) => pair.item.computedTotal)),
    prior: sumMoney(pairs.map((pair) => pair.item.priorTotal)),
  };
}""")
p.write_text(s)
print("ok")
