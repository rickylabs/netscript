/**
 * Runs contract — Version 1
 *
 * The billing run is Ledgerline's first-class object: draft → compute →
 * review → issue. This contract serves the run console: reads are reload-safe,
 * decisions are idempotent, and the console read drives the live view.
 *
 * Database first: `RunSchemaV1` and `RunItemSchemaV1` are derived from the
 * generated Prisma-Zod models (`@database/zod`) — field existence, enum
 * values and nullability come from the table. Only the serialization
 * encodings (Decimal → money string, Date → ISO string) and the computed
 * projections (`total`, `customerName`) are contract-owned.
 */

import { z } from 'zod';
import { implement } from '@orpc/server';
import { baseContract } from '@netscript/contracts';
import {
  BillingRunSchema as DatabaseBillingRunSchema,
  RunItemSchema as DatabaseRunItemSchema,
} from '@database/zod';
import { IsoDateTimeSchemaV1, MoneySchemaV1 } from './billing.contract.ts';

const Roles = {
  read: { authentication: 'required', authorization: { scopes: ['runs:read'] } },
  write: {
    authentication: 'required',
    authorization: { scopes: ['runs:write'], roles: ['finance:operator', 'finance:admin'] },
  },
} as const;

// ---------------------------------------------------------------------------
// DB-derived enums
// ---------------------------------------------------------------------------

export const RunStatusV1Schema = z.enum(
  DatabaseBillingRunSchema.shape.status.removeDefault().options,
);

export const RunItemStatusV1Schema = z.enum(
  DatabaseRunItemSchema.shape.status.removeDefault().options,
);

export const ExceptionBucketV1Schema = z.enum(
  DatabaseRunItemSchema.shape.exceptionBucket.removeDefault().options,
);

// ---------------------------------------------------------------------------
// DB-derived entities
// ---------------------------------------------------------------------------

export const RunSchemaV1 = DatabaseBillingRunSchema
  .pick({
    id: true,
    periodStart: true,
    periodEnd: true,
    status: true,
    expectedCount: true,
    issuedCount: true,
    failedCount: true,
    notes: true,
    createdAt: true,
  })
  .extend({
    periodStart: IsoDateTimeSchemaV1,
    periodEnd: IsoDateTimeSchemaV1,
    notes: z.string().nullable(),
    createdAt: IsoDateTimeSchemaV1,
    /** Projection: serialized run total (the table's totalCents column). */
    total: MoneySchemaV1,
  });

export const RunItemSchemaV1 = DatabaseRunItemSchema
  .pick({
    id: true,
    runId: true,
    subscriptionId: true,
    customerId: true,
    status: true,
    exceptionBucket: true,
    skipReason: true,
    draftInvoiceId: true,
    computedTotal: true,
    priorTotal: true,
    decision: true,
    decidedBy: true,
    sagaState: true,
