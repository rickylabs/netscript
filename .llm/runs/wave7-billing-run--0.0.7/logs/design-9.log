+ * Adds amounts on their digit strings, carrying left — never through a float.
+ *
+ * A column footer in a billing product is a statement about what was billed,
+ * so it is added the way the ledger adds it: every value is scaled to the
+ * domain's maximum precision and summed as exact integer digits. `Number` is
+ * not involved at any step.
+ *
+ * Values that were never measured are skipped rather than treated as zero. A
+ * sum over nothing measured is therefore *absent*, not `0.00` — three items
+ * whose amounts were not computed do not add up to a known nothing.
+ */
+export function sumMoney(values: readonly MoneyValue[]): MoneyValue {
+  const scale = MAX_PRECISION;
+  let total = 0n;
+  let measured = false;
+
+  for (const value of values) {
+    const parsed = parseDecimal(value);
+    if (!parsed) continue;
+    measured = true;
+    // The wire schema caps a fraction at 6 digits, so scaling to the domain
+    // maximum loses nothing. Adding at a wider scale would only invent
+    // precision the contract does not carry.
+    const frac = parsed.frac.padEnd(scale, '0').slice(0, scale);
+    total += BigInt(`${parsed.int}${frac}`) * (parsed.negative ? -1n : 1n);
+  }
+
+  if (!measured) return null;
+
+  // Zero has no sign: a column of offsets that cancels out is `0`, not `-0`.
+  const negative = total < 0n;
+  const digits = (negative ? -total : total).toString().padStart(scale + 1, '0');
+  const int = digits.slice(0, -scale);
+  const frac = digits.slice(-scale).replace(/0+$/, '');
+  const signed = negative && (int !== '0' || frac !== '');
+  return `${signed ? '-' : ''}${int}${frac === '' ? '' : `.${frac}`}`;
+}
