/**
 * `/partials/runs/list` — the deferred `list` layer partial behind `/runs`.
 *
 * This route carries the AUTHORITATIVE read: the `/runs` page loader renders
 * from the query cache (`getCachedEntry`) and this partial revalidates in the
 * background (`staleReloadMode: 'background'`). It renders the same
 * `RunsTable` the layer renders — including the unavailable/denied frames —
 * so a failed service read is data, never a thrown 500.
 */

import { definePartial, type PageRequestContext } from '@netscript/fresh/builders';
import { RunStatusV1Schema } from '@ledgerline/contracts';
import { z } from 'zod';
import RunsTable from '@app/routes/runs/(_components)/runs-table.tsx';
import { readService, runsQueries } from '@app/lib/runs.ts';

/**
 * Mirrors the `/runs` page's search derivation exactly — the page clamps the
 * parsed limit to 100 before it builds the cache input, and cache keys derive
 * from that input, so this partial must land on the same { status, limit }.
 */
const LIST_SEARCH_SCHEMA = z.object({
  status: RunStatusV1Schema.optional().catch(undefined),
  limit: z.coerce.number().int().min(1).catch(10),
});

export const runsListPartial = definePartial({
  name: 'runs-list',
  loader: async (ctx: PageRequestContext) => {
    const parsed = LIST_SEARCH_SCHEMA.safeParse(Object.fromEntries(ctx.url.searchParams));
    const search = parsed.success ? parsed.data : { status: undefined, limit: 10 };
    const result = await readService(() =>
      runsQueries.list({
        status: search.status,
        limit: Math.min(search.limit, 100),
      })
    );
    return result.ok
      ? { runs: result.data.items, unavailable: false, denied: false }
      : { runs: [], unavailable: true, denied: result.denied };
  },
  component: RunsTable,
});

export const config = runsListPartial.config;
export default runsListPartial.default;
