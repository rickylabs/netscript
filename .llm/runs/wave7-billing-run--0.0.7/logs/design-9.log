/**
 * @component FooterColumns
 * @layer 2
 * @depends theme-seed, lib/money
 * @description The bottom band of a widget card: N equal columns of label and
 * amount, divided by hairline rules. Gaps alone do not separate columns (C5).
 */

import type { JSX, VNode } from 'preact';
import { cn } from '../../lib/cn.ts';
import { ABSENT, type MoneyDirection } from '../../lib/money.ts';
import type { Renderable } from '../../lib/public-types.ts';

export interface FooterColumn {
  /** Quiet uppercase label, e.g. `APPROVED`. */
  readonly label: string;
  /** Preformatted amount. `null` renders the em dash (M1). */
  readonly value: string | null;
  /**
   * Direction of the amount, which is a domain fact — approved is towards us,
   * excepted is away — and never a colour decision at the call site (M5).
   * Omitted leaves the amount in the surface's own foreground.
   */
  readonly direction?: MoneyDirection;
  /** Optional tinted icon tile above the amount. */
  readonly glyph?: Renderable;
}

export interface FooterColumnsProps
  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children'> {
  columns: readonly FooterColumn[];
  class?: string;
}

/**
 * A hairline-divided footer strip.
 *
 * A column whose value is `null` is a fact that was not measured, so it renders
 * the em dash in the absent tone — the footer is exactly where a fabricated
 * `0.00` would do the most damage.
 */
export function FooterColumns({ columns, class: className, ...props }: FooterColumnsProps): VNode {
  if (columns.length === 0) return <div {...props} class={cn('ns-footer-cols', className)} />;

  return (
    <div {...props} class={cn('ns-footer-cols', className)}>
      {columns.map((column) => {
        const absent = column.value === null || column.direction === 'absent';
        return (
          <div
            key={column.label}
            class='ns-footer-cols__col'
            data-direction={column.direction ?? 'inherit'}
          >
            {column.glyph && <span class='ns-footer-cols__glyph'>{column.glyph}</span>}
            <span class='ns-footer-cols__label'>{column.label}</span>
            <span class='ns-footer-cols__value'>
              {absent
                ? (
                  <>
                    <span aria-hidden='true'>{ABSENT}</span>
                    <span class='sr-only'>not recorded</span>
                  </>
                )
                : column.value}
            </span>
          </div>
        );
      })}
    </div>
  );
}
