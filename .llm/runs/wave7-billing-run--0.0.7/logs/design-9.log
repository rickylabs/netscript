export function RunsTableSkeleton(): VNode {
  return (
    <Card>
      <Card.Body class='ns-stack ns-stack--md'>
        <Skeleton variant='table' rows={6} columns={5} />
      </Card.Body>
    </Card>
  );
}

function formatPeriod(run: RunV1): string {
  return `${run.periodStart.slice(0, 10)} → ${run.periodEnd.slice(0, 10)}`;
}

function formatTimestamp(iso: string): string {
  return iso.slice(0, 16).replace('T', ' ');
}

const COLUMNS: readonly ResponsiveTableColumn<RunV1>[] = [
  {
    key: 'id',
    label: 'Run',
    priority: 'primary',
    cell: (run) => (
      <a
        href={routes.runs.$id.$route.href({ path: { id: run.id } })}
        f-client-nav
        class='font-mono text-xs text-ns-fg'
      >
        {run.id}
      </a>
    ),
  },
  {
    key: 'period',
    label: 'Period',
    cell: (run) => <span class='text-xs text-ns-muted-fg'>{formatPeriod(run)}</span>,
  },
  {
    key: 'status',
    label: 'Status',
    cell: (run) => (
      <StatusBadge
        status={run.status === 'ISSUING' ? 'in-flight' : run.status}
      />
    ),
  },
  {
    key: 'createdAt',
    label: 'Created',
    cell: (run) => (
      <span class='font-mono text-xs text-ns-muted-fg'>{formatTimestamp(run.createdAt)}</span>
    ),
  },
  {
    key: 'counts',
    label: 'Issued / failed',
    cell: (run) => (
      <span class='tabular-nums text-xs'>
        <span class='text-ns-fg'>{run.issuedCount}</span>
        <span class='text-ns-muted-fg'>/</span>
        <span class={run.failedCount > 0 ? 'text-ns-money-neg' : 'text-ns-muted-fg'}>
          {run.failedCount}
        </span>
      </span>
    ),
  },
  {
    key: 'total',
    label: 'Total',
    align: 'end',
    // Run money aggregates invoices that carry the billing schema's USD
    // default — the domain default is real here, not a guess.
    cell: (run) => <MoneyText value={run.total} currency='USD' />,
  },
];

export default function RunsTable({ runs, unavailable, denied, status }: RunsTableProps): VNode {
  return (
    <div class='ns-stack ns-stack--md'>
      <RunStatusFilter active={status} />
      {tableFor({ runs, unavailable, denied })}
    </div>
  );
}

function tableFor(
  { runs, unavailable, denied }: Omit<RunsTableProps, 'status'>,
): VNode {
  if (denied) {
    return (
      <Card>
        <Card.Body>
          <InlineNotice title='Permission denied' variant='destructive'>
            The console's service token does not carry the runs:read scope. Ask a finance admin to
            grant access.
          </InlineNotice>
        </Card.Body>
      </Card>
    );
  }

  if (unavailable) {
    return (
      <Card>
        <Card.Body>
          <InlineNotice title='Runs service unavailable' variant='destructive'>
            The runs service did not answer. The console stays read-only until it is back; nothing
            was queued in the meantime.
          </InlineNotice>
        </Card.Body>
      </Card>
    );
  }

  if (runs.length === 0) {
    return (
      <Card>
        <Card.Body>
          <EmptyState heading='No billing runs yet'>
            Create the first run to compute charges for a billing period.
          </EmptyState>
        </Card.Body>
      </Card>
    );
  }
