/* WidgetCard — the composed-widget card (C1): five bands, in order.

   Cascade order matters and is deliberate. This file is imported from
   `assets/styles.css` AFTER `ui/card.css` and `ui/surface-styles.css`, so the
   rules below ride the `class` seam the base component already merges (T4) —
   the header is restored to a row here rather than forked into a second card.

   Radius encodes containment, so the scale is not uniform: the card that
   contains is the largest radius on the page, the panels inside it step down,
   and the controls inside those are full pills. Nothing shares a radius with
   the thing it sits inside. */

.ns-widget {
  border-radius: var(--ns-radius-3xl);
  border: 1px solid var(--ns-border);
  box-shadow: var(--ns-shadow-ambient);
  /* Band padding lives on the card, not on each band, so a band can be dropped
     without leaving a gap where it used to be. */
  padding-block: var(--ns-space-1);
}

.ns-widget .ns-card__header,
.ns-widget .ns-card__body,
.ns-widget .ns-card__footer {
  padding-inline: var(--ns-space-6);
  border: 0;
  background: none;
}

/* Band 1 — the base header is a column; a widget header is a row. */
.ns-widget__header {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: var(--ns-space-3);
  padding-block: var(--ns-space-5);
}

/* C2 — the title is quiet, because the hero number under it is not. Keeping
   the two at the same size is what makes a card read as a list item. */
.ns-widget__title {
  display: flex;
  align-items: center;
  gap: var(--ns-space-2);
  font-family: var(--ns-font-sans);
  font-size: var(--ns-text-base);
  font-weight: 600;
  line-height: var(--ns-leading-tight);
  color: var(--ns-fg);
}

.ns-widget__action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: var(--ns-space-2);
}

/* Band 2 */
.ns-widget__range {
  padding-inline: var(--ns-space-6);
  padding-block-end: var(--ns-space-4);
}

/* Band 3 — hero amount and its delta chip share one baseline.

   The hero's size belongs to this band, not to the amount component: any
   amount dropped in here becomes the card's answer, so a caller does not
   repeat a size prop at every call site. Roughly 3x the band's own label —
   a hero the same size as the title above it is what makes a widget read as a
   list item rather than a card (C2). */
.ns-widget__hero .ns-money-text {
  font-size: var(--ns-text-4xl);
  font-weight: 600;
  line-height: var(--ns-leading-tight);
  letter-spacing: var(--ns-tracking-tight);
}

/* M9 — a hero states a balance, not a movement, so it does not take the
   direction colour. In the reference cards the hero number is plain and only
   the delta beside it is green; colouring the figure green *because it is
   positive* is the failure this rule names. The DeltaChip on the same baseline
   is what carries direction. */
.ns-widget__hero .ns-money-text[data-money-sign] {
  color: var(--ns-fg);
}

.ns-widget__hero--lg .ns-money-text {
  font-size: var(--ns-text-4xl);
}

.ns-widget__hero--lg {
  padding-block-start: var(--ns-space-1);
}

/* Band 4 */
.ns-widget__body {
  padding-block: var(--ns-space-2) var(--ns-space-5);
}

.ns-widget__body:empty {
  display: none;
}

/* Band 5 — the footer carries no tinted bar of its own; the columns inside it
   are the strip. A CTA fills the width instead. */
.ns-widget__footer {
  display: flex;
  flex-direction: column;
  gap: var(--ns-space-3);
  padding-block: 0 var(--ns-space-5);
}

.ns-widget__footer:empty {
  display: none;
}
