/**
 * Ledgerline product components — the domain layer above the copied UI kit.
 *
 * These components speak the money/status token vocabulary (`--ns-money-*`,
 * `--ns-status-*`, `--ns-font-numeric`, `--ns-numeric-tabular`) and encode the
 * ledger facts: absence is an em dash, never a fabricated zero.
 */

export { ExceptionBadge } from './exception-badge.tsx';
export { MoneyText } from './money-text.tsx';
export { ProvisionalTag } from './provisional-tag.tsx';
