/**
 * Negative-authorization tests for the billing service.
 *
 * The contract declares `authentication`/`scopes`/`roles` on every procedure;
 * `createContractAuthorizer` enforces them. These tests prove the gate the
 * way the framework's own tutorial does: unauthenticated → 401, wrong scope →
 * 403, correct scope → 200 — with the app exercised in-process (no network
 * listener, no database).
 */

import { createService } from '@netscript/service';
import type { ServiceHandlerContext } from '@netscript/service';
import { assertEquals } from '@std/assert';
import { BillingContractV1, BillingV1 } from '@ledgerline/contracts';

const ADMIN_TOKEN = 'test-admin-token';
const OPERATOR_TOKEN = 'test-operator-token';
const USAGE_TOKEN = 'test-usage-token';

const { authenticator, authorizer } = await (async () => {
  Deno.env.set('LEDGERLINE_ADMIN_TOKEN', ADMIN_TOKEN);
  Deno.env.set('LEDGERLINE_OPERATOR_TOKEN', OPERATOR_TOKEN);
  Deno.env.set('LEDGERLINE_USAGE_INGEST_TOKEN', USAGE_TOKEN);
  return await import('../src/auth.ts');
})();

const { BillingV1: Router } = await import('../src/routers/v1.ts');

const billing = BillingV1.$context<ServiceHandlerContext>();
void billing;

const app = createService(Router as typeof BillingContractV1 extends never ? never : never, {
  name: 'billing-test',
}).build();
void app;
EOF
