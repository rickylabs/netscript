/**
 * Run pipeline: compute → review → issue.
 *
 * Compute materializes draft invoices (through the billing service's typed
 * client) and classifies exceptions BEFORE any money moves. Issue flips the
 * run to ISSUING and triggers the per-item effector job; the run-issue saga
 * (plugins/sagas) owns the finalize→charge→record path and its compensation.
 */

import { Prisma } from '../../../../database/postgres/schema/.generated/client.server.ts';
import { db } from '@ledgerline/db';
import { workersClient } from '../lib/workers-client.ts';
import { publishRunConsole } from '../lib/stream.ts';
import { classifyException, NotFoundError, RunStateError } from './runs.ts';
import { formatMoney, parseMoney } from '../lib/money.ts';
import { billingClient } from '../lib/billing-client.ts';

async function loadRun(runId: string) {
  const client = await db.getClient();
  const run = await client.billingRun.findUnique({
    where: { id: runId },
    include: { runItems: { include: { subscription: true } } },
  });
  if (!run) throw new NotFoundError(`run ${runId} not found`);
  return run;
}

/** DRAFT/COMPUTING → REVIEW: draft every pending item, classify exceptions. */
export async function computeRun(input: {
  runId: string;
  actorId: string;
}): Promise<{ runId: string }> {
  const client = await db.getClient();
  const run = await loadRun(input.runId);
  if (run.status !== 'DRAFT' && run.status !== 'COMPUTING') {
    throw new RunStateError(`run is ${run.status}; only DRAFT runs can compute`);
  }
  await client.billingRun.update({ where: { id: run.id }, data: { status: 'COMPUTING' } });
  await publishRunConsole(run.id, 'COMPUTING');
