import { defineSaga, sagaComplete } from '@netscript/plugin-sagas-core';
import type { SagaDefinition } from '@netscript/plugin-sagas-core/domain';

type State = Readonly<{
  status: string;
  processedAt?: string;
}>;

type Message = Readonly<{ type: 'run.item.started'; payload: unknown }>;

/**
 * Starter saga definition for run-issue.
 */
export const RunIssueSaga: SagaDefinition<'run-issue', State, Message> = defineSaga(
  'run-issue',
)
  .durability('t1')
  .state<State>({ status: 'pending' })
  .on<Message['type'], Message['payload']>('run.item.started', (saga, message, context) => {
    saga.state = {
      ...saga.state,
      status: 'completed',
      processedAt: context.now.toISOString(),
    };

    return [
      sagaComplete({
        messageType: message.type,
        processedAt: context.now.toISOString(),
      }),
    ];
  })
  .compensate<Message['type'], Message['payload']>('run.item.started', (saga, _message, context) => {
    saga.state = {
      ...saga.state,
      status: 'pending',
      processedAt: context.now.toISOString(),
    };

    return [];
  })
  .build();

export default RunIssueSaga;
