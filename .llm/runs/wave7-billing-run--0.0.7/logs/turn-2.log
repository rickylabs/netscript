/**
 * Machine-to-machine bearer credential for service-to-service calls.
 *
 * The credential resolves from the caller's environment per request; the
 * procedure's own contract metadata (`access.authentication`) decides when
 * the header is attached, so public procedures never carry it and guarded
 * procedures fail closed when the env token is absent.
 */

import { createBearerSdkClientContribution } from '@netscript/plugin-auth-core/sdk';

export const SERVICE_TOKEN_ENV = 'LEDGERLINE_SERVICE_TOKEN';

export const serviceBearer = createBearerSdkClientContribution({
  context: {},
  resolveCredential: () => Deno.env.get(SERVICE_TOKEN_ENV),
  responseCache: { mode: 'direct-only' },
  unmarked: 'none',
});===

