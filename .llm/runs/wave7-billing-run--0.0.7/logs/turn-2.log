/**
 * Run pipeline: compute → review → issue.
 *
 * Compute materializes draft invoices (through the billing service's typed
 * client) and classifies exceptions BEFORE any money moves. Issue is
 * idempotency-guarded per operator key and flips the run to ISSUING and
 * triggers the per-item effector job; the run-issue saga (plugins/sagas)
 * owns the finalize→charge→record path and its compensation.
 */

import type { PostgresClient } from '@ledgerline/db';
import { withTransaction } from '@netscript/database';
import { workersClient } from '../lib/workers-client.ts';
import { publishRunConsole } from '../lib/stream.ts';
import { classifyException } from './runs.ts';
import { DomainStateError, NotFoundError } from '@shared/domain-errors.ts';
import { formatMoney, fromDb, parseMoney, toDb } from '@shared/money.ts';
import { IdempotencyError, withIdempotency } from '@shared/idempotency.ts';
import { billingClient } from '../lib/billing-client.ts';

async function loadRun(client: PostgresClient, runId: string) {
  const run = await client.billingRun.findUnique({
    where: { id: runId },
    include: { runItems: { include: { subscription: true } } },
  });
  if (!run) throw new NotFoundError('run', runId);
  return run;
}

/** DRAFT/COMPUTING → REVIEW: draft every pending item, classify exceptions. */
export async function computeRun(
  client: PostgresClient,
  input: { runId: string; actorId: string },
): Promise<{ runId: string }> {
  const run = await loadRun(client, input.runId);
  if (run.status !== 'DRAFT' && run.status !== 'COMPUTING') {
    throw new DomainStateError(`run is ${run.status}; only DRAFT runs can compute`);
  }
  await withTransaction(client, async (tx) => {
    await tx.billingRun.update({ where: { id: run.id }, data: { status: 'COMPUTING' } });
  });
  await publishRunConsole(run.id, 'COMPUTING');

  for (const item of run.runItems) {
    if (item.status !== 'PENDING') continue;
    const draft = await callCreateDraft({
      subscriptionId: item.subscriptionId,
      periodStart: run.periodStart,
      periodEnd: run.periodEnd,
      billingRunId: run.id,
    });
    const prior = await priorInvoiceTotal(client, item.subscriptionId, run.periodStart);
    const exception = await classifyException(client, {
      subscriptionId: item.subscriptionId,
      customerId: item.customerId,
      computedTotal: draftTotalOf(draft),
      priorTotal: prior,
      startedAfterPeriodStart: item.subscription.startedAt >= run.periodStart,
    });
    await client.runItem.update({
      where: { id: item.id },
      data: {
        status: 'COMPUTED',
        draftInvoiceId: draft.invoiceId,
        computedTotal: toDb(draft.total),
        priorTotal: prior === null ? null : toDb(prior),
        exceptionBucket: exception.bucket,
        skipReason: exception.skipReason,
      },
    });
  }

  const items = await client.runItem.findMany({ where: { runId: run.id } });
  let computedTotal = 0n;
  for (const item of items) {
    if (item.computedTotal) computedTotal += parseMoney(fromDb(item.computedTotal));
  }
  const updated = await withTransaction(client, async (tx) => {
    const saved = await tx.billingRun.update({
      where: { id: run.id },
      data: {
        status: 'REVIEW',
        expectedCount: items.length,
        totalCents: toDb(formatMoney(computedTotal)),
      },
    });
    await tx.auditEvent.create({
      data: {
        actorId: input.actorId,
        action: 'run.computed',
        target: `run:${run.id}`,
        metadata: { items: items.length },
      },
    });
    return saved;
  });
  await publishRunConsole(run.id, 'REVIEW');
  return { runId: updated.id };
}

