export const MoneySchemaV1 = z
  .string()
  .regex(/^-?\d+(\.\d{1,6})?$/, 'string-encoded decimal')
  .describe('Money as a string-encoded decimal, never a float');

export const IsoDateTimeSchemaV1 = z.string().datetime();

const Roles = {
  read: { authentication: 'required', authorization: { scopes: ['billing:read'] } },
  write: { authentication: 'required', authorization: { scopes: ['billing:write'] } },
  admin: {
    authentication: 'required',
    authorization: { scopes: ['billing:write'], roles: ['finance:admin'] },
  },
} as const;

