@@ -160,8 +160,65 @@
 }
 
 export { IdempotencyError };
 
+/** ISSUING → ISSUING: re-drive every stuck item (P0 #1 resume).
+ *
+ * Items left ISSUING by a crashed effector are re-triggered. The effector's
+ * billing keys are derived from the run item id, so every attempt replays the
+ * same invoice issue and the same payment — resume can never double-issue.
+ * Idempotency-guarded per operator key; call again with a fresh key to
+ * re-sweep after a crash between the audit write and a trigger. */
+export async function resumeRun(
+  client: PostgresClient,
+  input: {
+    runId: string;
+    actorId: string;
+    idempotencyKey: string;
+  },
+): Promise<{ resumed: number; message: string }> {
+  const run = await loadRun(client, input.runId);
+  if (run.status !== 'ISSUING') {
+    throw new DomainStateError(`run is ${run.status}; only ISSUING runs can resume`);
+  }
+  const stuck = run.runItems.filter((item) => item.status === 'ISSUING');
+  if (stuck.length === 0) {
+    return { resumed: 0, message: 'no items stuck mid-flight' };
+  }
+
+  const result = await withIdempotency({
+    db: client,
+    key: input.idempotencyKey,
+    request: { runId: input.runId, items: stuck.map((item) => item.id) },
+    operation: (tx) =>
+      (async () => {
+        await tx.auditEvent.create({
+          data: {
+            actorId: input.actorId,
+            action: 'run.resume_started',
+            target: `run:${run.id}`,
+            metadata: { items: stuck.length, idempotencyKey: input.idempotencyKey },
+          },
+        });
+        for (const item of stuck) {
+          await workersClient.triggerJob({
+            id: 'run-item-issue',
+            payload: {
+              runId: run.id,
+              runItemId: item.id,
+              idempotencyKey: `${input.idempotencyKey}:${item.id}`,
+            },
+            correlationId: item.id,
+          });
+        }
+        return { resumed: stuck.length, message: `resuming ${stuck.length} items` };
+      })(),
+  });
+
+  await publishRunConsole(run.id, 'ISSUING');
+  return result.value;
+}
