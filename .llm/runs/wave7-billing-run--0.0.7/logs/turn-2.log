```ts
import { createDurableSagaRuntime } from '@netscript/plugin-sagas/runtime';
import { PrismaClient } from './generated/prisma/client.ts';

// Low-level Prisma construction. Prefer startSagaRunner() for complete delivery + lifecycle.
const prisma = new PrismaClient();
const { runtime, dispose } = await createDurableSagaRuntime({ backend: 'prisma', prisma });
await runtime.register(definitions);
await runtime.start();
// A definition that emits schedule() also requires an injected scheduler on this low-level path.
await runtime.publish(message);
await runtime.stop('application shutdown');
await dispose();
```

```ts
import { createDurableSagaRuntime } from '@netscript/plugin-sagas/runtime';
import { resolveSagaStoreBackend } from '@netscript/plugin-sagas-core/stores';

// Read the backend from the environment (or appsettings) — throws if unset.
const backend = resolveSagaStoreBackend({
  env: Deno.env.toObject(),
  // appsettings: loadedAppsettings, // sagas.store.backend
});

const runtime = await createDurableSagaRuntime({
  backend,
  prisma: backend === 'prisma' ? prismaClient : undefined,
});
```

