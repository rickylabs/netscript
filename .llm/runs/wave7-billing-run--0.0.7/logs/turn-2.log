    name = re.sub(r'\x1b\]8;id=\d+;https?://\S+\\\\', '', parts[1]).strip()
    name = re.sub(r'\x1b\]8;;', '', name).strip()
    urls = re.findall(r'http://localhost:\d+', line)
    if name and urls:
        print(name, urls[0])
" 2>/dev/null | head -12
