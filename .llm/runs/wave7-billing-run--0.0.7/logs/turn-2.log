Found a second real bug in the shared idempotency seam: a **failed** operation's stored response replays the error object as the *value* instead of rethrowing — the record's own doc comment promises Stripe semantics ("same-key retry replays the same failure") that the code doesn't implement. Fixing:
[0m← [0mEdit services/_shared/idempotency.ts
Index: /home/agent/projects/netscript/wave7-billing/services/_shared/idempotency.ts
===================================================================
--- /home/agent/projects/netscript/wave7-billing/services/_shared/idempotency.ts
+++ /home/agent/projects/netscript/wave7-billing/services/_shared/idempotency.ts
@@ -31,8 +31,21 @@
     this.code = code;
   }
 }
 
+/**
+ * A replayed key whose first operation FAILED. Stripe semantics (documented
+ * in the module header): the first stored response — success or failure — is
+ * what a same-key replay gets. This surfaces the stored failure message so
+ * the caller sees the original fault, not a value-shaped error object.
+ */
+export class StoredOperationError extends Error {
+  constructor(message: string) {
+    super(`stored failure replayed for idempotency key: ${message}`);
+    this.name = 'StoredOperationError';
+  }
+}
+
