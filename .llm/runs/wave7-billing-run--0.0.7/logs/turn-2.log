/**
 * Maps domain errors onto the contract's typed error vocabulary.
 *
 * Every handler wraps its domain call with `raise(error, errors)` — client
 * mistakes surface as 404/409/422, genuine server faults stay 500.
 * Idempotency-guarded procedures (which declare the CONFLICT error) use
 * `raiseWithConflict` so a duplicate/mismatched key surfaces as 409.
 */

import { IdempotencyError } from '@shared/idempotency.ts';
import { DomainStateError, NotFoundError } from '@shared/domain-errors.ts';

/** The error vocabulary every `baseContract` procedure carries. */
export interface BaseContractErrors {
  NOT_FOUND(options: {
    data: { resourceType: string; resourceId: string | number };
  }): unknown;
  VALIDATION_ERROR(options: {
    data: { formErrors: string[]; fieldErrors: Record<string, string[] | undefined> };
  }): unknown;
  UNAUTHORIZED(options: {
    data: { reason?: 'missing_token' | 'invalid_token' | 'expired_token' };
  }): unknown;
}

/** The extended vocabulary on procedures that declare the CONFLICT error. */
export interface ConflictContractErrors extends BaseContractErrors {
  CONFLICT(options: { data: { key: string; code: string } }): unknown;
}

export function raise(error: unknown, errors: BaseContractErrors): never {
  if (error instanceof NotFoundError) {
    throw errors.NOT_FOUND({
      data: { resourceType: error.resourceType, resourceId: error.resourceId },
    });
  }
  if (error instanceof IdempotencyError) {
    // Only reachable on procedures without the CONFLICT declaration, where a
    // key clash cannot legitimately occur; surface it as a validation fault.
    throw errors.VALIDATION_ERROR({
      data: { formErrors: [error.message], fieldErrors: {} },
    });
  }
  if (error instanceof DomainStateError) {
    throw errors.VALIDATION_ERROR({
      data: { formErrors: [error.message], fieldErrors: {} },
    });
  }
  throw error;
}

/** For idempotency-guarded procedures: CONFLICT/MISMATCH surface as 409. */
export function raiseWithConflict(error: unknown, errors: ConflictContractErrors): never {
  if (error instanceof IdempotencyError) {
    const data = { key: keyOf(error.message), code: error.code };
    // Only procedures that declare the CONFLICT code carry the factory.
    if (errors.CONFLICT) throw errors.CONFLICT({ data });
    throw errors.VALIDATION_ERROR({ data: { formErrors: [error.message], fieldErrors: {} } });
  }
  raise(error, errors);
}

/** Narrow the authenticated principal — authz guarantees one on guarded
 * routes; this guard is defense in depth, never a fallback actor. */
export function requireActor(
  context: { principal?: { subject: string } },
  errors: BaseContractErrors,
): string {
  const subject = context.principal?.subject;
  if (!subject) throw errors.UNAUTHORIZED({ data: { reason: 'missing_token' } });
  return subject;
}

/** Idempotency messages embed the key; pull it out for the error data. */
function keyOf(message: string): string {
  const match = /idempotency key ([^\s]+)/.exec(message);
  return match?.[1] ?? 'unknown';
}
