import os
os.chdir('/home/agent/projects/netscript/wave7-billing')
p = 'services/billing/src/domain/invoices.ts'
s = open(p).read()
old = """  if (!invoice) throw new NotFoundError('invoice', input.invoiceId);
  if (invoice.status !== 'OPEN') {
    throw new DomainStateError(`invoice ${invoice.number} is ${invoice.status}, not OPEN`);
  }
"""
new = """  if (!invoice) throw new NotFoundError('invoice', input.invoiceId);

  // Key-based replay BEFORE the state guard: if a payment already exists for
  // this exact key, its stored outcome IS the answer — even if the invoice
  // has since moved on (crash-era PAID, refunded, void). Replaying by key is
  // Stripe semantics; throwing on later state turns a client retry into a
  // fabricated failure.
  const replayedPayment = await client.payment.findUnique({
    where: { idempotencyKey: input.idempotencyKey },
  });
  if (replayedPayment) {
    return {
      paymentId: replayedPayment.id,
      status: replayedPayment.status === 'SUCCEEDED' ? 'SUCCEEDED' : 'FAILED',
      amount: fromDb(replayedPayment.amount),
      replayed: true,
    };
  }
  if (invoice.status !== 'OPEN') {
    throw new DomainStateError(`invoice ${invoice.number} is ${invoice.status}, not OPEN`);
  }
"""
assert old in s
s = s.replace(old, new, 1)
open(p, 'w').write(s)
print('replay-first fix applied')
EOF
