import { createTestSagaRuntime } from '@netscript/plugin-sagas-core/testing';
import { defineSaga, sagaFail } from '@netscript/plugin-sagas-core';

type State = { status: string; reason: string; key: string };
const saga = defineSaga('probe-saga')
  .durability('t1')
  .state<State>({ status: 'charged', reason: '', key: '' })
  .on<'X', { reason: string; key: string }>('X', (s, e) => {
    s.state = { ...s.state, reason: e.payload.reason, key: e.payload.key };
    return [];
  })
  .on<'Y', { reason: string; key: string }>('Y', (s, e) => {
    s.state = { ...s.state, status: 'compensated', reason: e.payload.reason };
    return [sagaFail(e.payload.reason)];
  })
  .correlate((message) => String((message.payload as { key?: string }).key ?? '') as never)
  .build();

const runtime = createTestSagaRuntime();
await runtime.start();
await runtime.register([saga]);
await runtime.publish({ type: 'X', payload: { reason: 'r1', key: 'k1' } });
await new Promise((r) => setTimeout(r, 150));
await runtime.publish({ type: 'Y', payload: { reason: 'undo done', key: 'k1' } });
await new Promise((r) => setTimeout(r, 250));

const correlated = await (runtime.store as unknown as {
  findByCorrelation: (sagaId: string, key: string) => Promise<{ id?: string; metadata?: { status?: string } }[]>;
}).findByCorrelation('probe-saga', 'k1');
console.log('correlated:', JSON.stringify(correlated, null, 1).slice(0, 400));
const first = correlated?.[0];
if (first?.id) {
  const loaded = await (runtime.store as unknown as { load: (id: string) => Promise<{ metadata?: { status?: string }; state?: unknown } | undefined> }).load(first.id);
  console.log('persisted status:', loaded?.metadata?.status, '| business state:', JSON.stringify(loaded?.state));
}
await runtime.stop?.();
EOF
