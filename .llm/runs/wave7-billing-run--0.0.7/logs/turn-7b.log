async function refundPayment(
  input: Payload,
  traceparent: string | undefined,
): Promise<JobResult<RefundOutcome>> {
  const publisher = createSagaPublisher<PaymentRefundMessage>({});
  const route = {
    correlationKey: input.paymentId as SagaCorrelationKey,
    traceparent,
  };
  let creditNoteId: string | null = null;

  try {
    await loadPayment(await getPostgres(), input.paymentId);

    await publishSagaOrThrow(publisher, {
      type: 'payment.refund.started',
      payload: { paymentId: input.paymentId },
    }, route);

    const credit = await issueRefundCreditNote(await getPostgres(), {
      paymentId: input.paymentId,
      refundReason: input.refundReason,
      idempotencyKey: `${input.idempotencyKey}:credit`,
      actorId: ACTOR,
    });
    creditNoteId = credit.creditNoteId;

    await publishSagaOrThrow(publisher, {
      type: 'payment.refund.credit_issued',
      payload: { paymentId: input.paymentId, creditNoteId: credit.creditNoteId },
    }, route);

    if (input.failStep === 'apply') {
      throw new DomainStateError('processor rejected the refund (simulated apply failure)');
    }

    await applyRefund(await getPostgres(), {
      paymentId: input.paymentId,
      creditNoteId: credit.creditNoteId,
      actorId: ACTOR,
    });

    await publishSagaOrThrow(publisher, {
      type: 'payment.refund.completed',
      payload: { paymentId: input.paymentId },
    }, route);

    return createSuccessResult<RefundOutcome>({
      paymentId: input.paymentId,
      creditNoteId: credit.creditNoteId,
      status: 'REFUNDED',
      replayed: credit.replayed,
    });
  } catch (error) {
    const reason = error instanceof Error ? error.message : String(error);

    // Compensation first, then the message — the saga must only ever record
    // a compensated state that is already durable.
    if (creditNoteId) {
      await compensateRefund(await getPostgres(), {
        paymentId: input.paymentId,
        creditNoteId,
        reason,
        actorId: ACTOR,
      });
    }

    await publishSagaOrThrow(publisher, {
      type: 'payment.refund.failed',
      payload: { paymentId: input.paymentId, reason, step: 'apply' },
    }, route);

    return createFailureResult<RefundOutcome>(
      `refund failed: ${reason} (paymentId: ${input.paymentId})`,
      {
        paymentId: input.paymentId,
        creditNoteId,
        status: 'COMPENSATED',
        replayed: false,
      },
    );
  }
}

export default paymentRefundJob;
