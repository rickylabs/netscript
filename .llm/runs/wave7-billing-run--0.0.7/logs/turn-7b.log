// netscript-workers-resource: {"kind":"job","id":"period-close-check","enabled":true,"entrypoint":"workers/jobs/period-close-check.ts"}
import {
  createSuccessResult,
  defineJobHandler,
  type JobHandlerDefinition,
  type JobResult,
} from '@netscript/plugin-workers-core';
import { z } from 'zod';

import { db, Prisma } from '@ledgerline/db';
import type { PostgresClient } from '@ledgerline/db';
import { withTransaction } from '@shared/tx.ts';

/**
 * Nightly close guard (enqueued by the daily-maintenance scheduled trigger):
 * find billing runs stuck in ISSUING whose items are ALL terminal
 * (issued + failed >= expected, nothing left non-terminal) and flip them
 * ISSUED with an audit row — a self-heal for the one state a crashed effector
 * could otherwise leave the close in. One bounded query per pass; the flip is
 * guarded on the run still being ISSUING and wrapped with its audit row in
 * one transaction, so a re-drive is a no-op and a concurrent close cannot
 * double-write. Enqueues nothing else.
 */

const PayloadSchema = z.object({});
type Payload = z.infer<typeof PayloadSchema>;

type CloseCheckOutcome = Readonly<{
  stuckRunsClosed: number;
  inspected: number;
}>;

const ACTOR = 'worker:period-close-check';
const MAX_RUNS_PER_PASS = 100;

export const periodCloseCheckJob: JobHandlerDefinition<Payload> = defineJobHandler(
  PayloadSchema,
  (): Promise<JobResult<CloseCheckOutcome>> => periodCloseCheck(),
);
