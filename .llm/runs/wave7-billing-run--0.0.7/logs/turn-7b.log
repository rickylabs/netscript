+/** Settle a declined item: FAILED on the row, failedCount on the run. */
+async function settleDeclined(
+  client: PostgresClient,
+  input: { runId: string; runItemId: string },
+): Promise<{ replayed: boolean }> {
+  return await withTransaction(client, async (tx) => {
+    const updated = await tx.runItem.updateMany({
+      where: { id: input.runItemId, status: 'ISSUING' },
+      data: {
+        status: 'FAILED',
+        sagaState: 'declined',
+        exceptionBucket: 'HARD_DECLINE',
+        skipReason: 'card_declined',
+      },
+    });
+    if (updated.count === 0) return { replayed: true };
+    const run = await tx.billingRun.update({
+      where: { id: input.runId },
+      data: { failedCount: { increment: 1 } },
+    });
+    // Same close check the issued path applies — a declined item can be the
+    // last one to settle, and the run must not stay ISSUING forever.
+    if (run.status === 'ISSUING' && run.issuedCount + run.failedCount >= run.expectedCount) {
+      await tx.billingRun.update({ where: { id: run.id }, data: { status: 'ISSUED' } });
+    }
+    await tx.auditEvent.create({
+      data: {
+        actorId: ACTOR,
+        action: 'run.item_failed',
+        target: `run_item:${input.runItemId}`,
+        metadata: { runId: input.runId, reason: 'card_declined' },
+      },
+    });
+    return { replayed: false };
+  });
+}
