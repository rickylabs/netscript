import { SagaEngine } from '@netscript/plugin-sagas-core/runtime';
import { MemorySagaStore } from '@netscript/plugin-sagas-core/testing';
import type { SagaMessage, SagaStateEnvelope } from '@netscript/plugin-sagas-core/domain';
import { assertEquals } from '@std/assert';

import { PaymentRefundSaga } from '../sagas/payment-refund-saga.ts';
import { RunIssueSaga } from '../sagas/run-issue-saga.ts';

/**
 * Saga RUNTIME tests — assertions on PERSISTED state, never handler returns.
 *
 * Drives the REAL `SagaEngine` — the class the production saga runner
 * composes, and the ONLY component that writes the store (`#persistTransition`)
 * — over a `MemorySagaStore`, then asserts on
 * `store.load(instanceId).metadata.status`.
 *
 * Why this exists: the plugin-sagas-core@0.0.7 engine persists ONLY on the
 * `.on()` path; `.compensate()` effects are never written, and
 * `isTerminalStatus()` treats `compensating` as terminal — so an instance
 * routed into a `sagaCompensate` cascade rests `compensating` forever no
 * matter what its handlers return. Handler-level tests stayed green through
 * that defect. These tests assert the capability itself: a terminal outcome
 * that IS in the store. The effector jobs own every undo; the tests publish
 * the same messages the jobs publish after their durable undo
 * (`RunItemCompensated` / `payment.refund.compensated`).
 */

/** New engine + store per test: an isolated, real persistence surface. */
function engineFor(store: MemorySagaStore): SagaEngine {
  return new SagaEngine({ id: 'sagas-runtime-test', store });
}

/**
 * The engine's `register()` widens the definition to
 * `SagaDefinition<string, SagaState, SagaMessage>`; a concrete definition's
 * branded `SagaId`/narrow-message `correlate` is not assignable to that
 * (contravariance), which is why the production registry resolves through a
 * structural check. One localized seam here — no erasure anywhere else.
 */
function registrable(
  definition: typeof RunIssueSaga | typeof PaymentRefundSaga,
): Parameters<SagaEngine['register']>[0][number] {
  return definition as unknown as Parameters<SagaEngine['register']>[0][number];
}

