import { createServiceClient } from '@netscript/sdk/client';

/**
 * Sagas API client — the PROOF surface. The run console reads real saga
 * instances here so the operator sees the durable state machine (instance
 * status from the sagas store), not a worker-written column nothing verifies.
 *
 * The sagas API is a plugin service whose contract is not exported for
 * client typing at 0.0.7 (probed: jsr:@netscript/plugin-sagas@0.0.7/contracts
 * ships the RESPONSE types; the oRPC contract lives behind the plugin
 * service). The two read surfaces used are the documented REST endpoints:
 *   GET /api/v1/sagas/instances?sagaName=run-issue&correlationKey=<runItemId>
 *   GET /api/v1/sagas/sagas
 * Both are plugin-service endpoints reached through Aspire discovery.
 */

const SAGAS_BASE = () =>
  Deno.env.get('services__sagas-api__http__0') ?? Deno.env.get('DURABLE_STREAMS_URL') ?? '';

export interface SagaInstanceResponse {
  readonly sagaName: string;
  readonly instanceId?: string;
  readonly correlationId: string;
  readonly correlationKey?: string;
  readonly state: Readonly<Record<string, unknown>>;
  readonly status: 'queued' | 'running' | 'compensating' | 'completed' | 'failed';
  readonly createdAt: string;
  readonly updatedAt: string;
  readonly completedAt?: string;
  readonly version: number;
  readonly messageCount: number;
  readonly lastMessageType?: string;
}

/** List run-issue instances for one run item (or all, when key omitted). */
export async function listRunIssueInstances(
  correlationKey?: string,
): Promise<SagaInstanceResponse[]> {
  const base = SAGAS_BASE();
  if (!base) return [];
  const url = new URL('/api/v1/sagas/instances', base);
  url.searchParams.set('sagaName', 'run-issue');
  url.searchParams.set('limit', '50');
  if (correlationKey) url.searchParams.set('correlationKey', correlationKey);
  const response = await fetch(url, { headers: { accept: 'application/json' } });
  if (!response.ok) return [];
  const body = (await response.json()) as { instances?: SagaInstanceResponse[] } | SagaInstanceResponse[];
  return Array.isArray(body) ? body : body.instances ?? [];
}

/** The most relevant instance status for one run item ('' when none). */
export async function runItemInstanceStatus(runItemId: string): Promise<string> {
  const instances = await listRunIssueInstances(runItemId);
  return instances[0]?.status ?? '';
}
