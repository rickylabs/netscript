import {
  createFailureResult,
  createSuccessResult,
  defineJobHandler,
  type JobHandlerDefinition,
  type JobResult,
} from '@netscript/plugin-workers-core';
import { publishSagaOrThrow } from '@netscript/plugin-sagas-core/integration/publisher';
import type { SagaCorrelationKey } from '@netscript/plugin-sagas-core/domain';
import { createSagaPublisher } from '@netscript/plugin-sagas/runtime';
import { z } from 'zod';

import { getPostgres } from '@ledgerline/db';
import { DomainStateError } from '@shared/domain-errors.ts';
import {
  applyRefund,
  compensateRefund,
  issueRefundCreditNote,
  loadPayment,
} from '../../services/billing/src/domain/refunds.ts';
import type { PaymentRefundMessage } from '../../sagas/payment-refund-saga.ts';

/**
 * Refund effector: drives the two-step refund for one captured payment and
 * reports every step to the payment-refund saga, which owns the durable state
 * machine and its terminal compensation.
 *
 * Failure semantics: any error after the credit note was issued first runs the
 * compensation (void the note, payment unchanged) and THEN publishes
 * `payment.refund.failed`, so the saga's compensation branch records a state
 * that is already true in the database. Workers retries replay the same
 * idempotency keys: the credit note replays, the apply step guards on the
 * payment status, and compensation is idempotent — no retry can double-move
 * money.
 */

const PayloadSchema = z.object({
  paymentId: z.string().min(1),
  idempotencyKey: z.string().min(1).max(255),
  refundReason: z.string().min(3).max(500),
  // Processor simulation: forces the failure that exercises compensation.
  failStep: z.enum(['apply']).optional(),
});
type Payload = z.infer<typeof PayloadSchema>;

/** One shape for both terminals of the job so the runner sees a single result type. */
type RefundOutcome = Readonly<{
  paymentId: string;
  creditNoteId: string | null;
  status: 'REFUNDED' | 'COMPENSATED';
  replayed: boolean;
}>;

const ACTOR = 'worker:payment-refund';

export const paymentRefundJob: JobHandlerDefinition<Payload> = defineJobHandler(
  PayloadSchema,
  (context): Promise<JobResult<RefundOutcome>> =>
    refundPayment(PayloadSchema.parse(context.payload), context.traceparent),
