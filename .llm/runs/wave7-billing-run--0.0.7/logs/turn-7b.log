      }, publishOptions);
      if (!failed.published) {
        return createFailureResult<ItemOutcome>(
          `saga publish failed (RunItemChargeRecordFailed): ${failed.reason}`,
          {
            ...base,
            outcome: 'publish-failed',
            stage: 'record',
            paymentId: chargedPaymentId,
            retryable: failed.retryable,
          },
        );
      }

      // The undo — refund first (money truth), then the COMPENSATED stamp.
      try {
        const refund = await billingClient.invoices.refund({
          id: chargedPaymentId,
          reason: clampRefundReason(reason),
          idempotencyKey: `refund:${input.runItemId}`,
        });
        await markRunItemCompensated(dbClient, {
          runId: input.runId,
          runItemId: input.runItemId,
          reason,
          actorId: ACTOR,
        });
        const compensated = await publisher.publish({
          type: 'RunItemCompensated',
          payload: {
            runId: input.runId,
            runItemId: input.runItemId,
            reason,
            paymentId: chargedPaymentId,
          },
        }, publishOptions);
        if (!compensated.published) {
          // The undo is already durable; a retryable publish failure re-drives
          // the job, whose guards replay to the same terminal publish.
          return createFailureResult<ItemOutcome>(
            `saga publish failed (RunItemCompensated): ${compensated.reason}`,
            {
              ...base,
              outcome: 'publish-failed',
              stage: 'record',
              paymentId: chargedPaymentId,
              retryable: compensated.retryable,
            },
          );
        }
        return createSuccessResult<ItemOutcome>({
          ...base,
          outcome: 'compensated',
          stage: 'record',
          paymentId: refund.id,
          reason,
        });
      } catch (undoError) {
        const undoReason = undoError instanceof Error ? undoError.message : String(undoError);
        return createFailureResult<ItemOutcome>(
          `compensation undo failed: ${undoReason}`,
          {
            ...base,
            outcome: 'compensating',
            stage: 'record',
            paymentId: chargedPaymentId,
            reason: undoReason,
            retryable: true,
          },
        );
      }
    }""")

