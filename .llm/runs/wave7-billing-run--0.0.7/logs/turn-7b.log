async function periodCloseCheck(): Promise<JobResult<CloseCheckOutcome>> {
  const client = await db.getClient();

  // One bounded query: runs stuck in ISSUING, oldest first, at most 100 per
  // pass — the next nightly pass (or a manual re-drive) handles more.
  const stuck = await client.billingRun.findMany({
    where: { status: 'ISSUING' },
    include: { runItems: { select: { status: true } } },
    orderBy: { updatedAt: 'asc' },
    take: MAX_RUNS_PER_PASS,
  });

  let stuckRunsClosed = 0;
  for (const run of stuck) {
    // Every item must be terminal: nothing still issuing/pending/approved.
    const nonTerminal = run.runItems.filter(
      (item) =>
        item.status === 'ISSUING' || item.status === 'PENDING' ||
        item.status === 'COMPUTED' || item.status === 'APPROVED',
    ).length;
    const terminal = run.issuedCount + run.failedCount;
    if (nonTerminal > 0 || terminal < run.expectedCount) continue;
    const closed = await closeStuckRun(client, run.id, {
      issued: run.issuedCount,
      failed: run.failedCount,
    });
    if (closed) stuckRunsClosed += 1;
  }

  return createSuccessResult<CloseCheckOutcome>({
    stuckRunsClosed,
    inspected: stuck.length,
  });
}

/**
 * Flip one stuck run to ISSUED with its audit row, atomically and exactly
 * once: the update is guarded on `status: 'ISSUING'` (a concurrent close or
 * a re-driven job updates zero rows and writes no audit row).
 */
async function closeStuckRun(
  client: PostgresClient,
  runId: string,
  metadata: Record<string, unknown>,
): Promise<boolean> {
  return await withTransaction(client, async (tx) => {
    const updated = await tx.billingRun.updateMany({
      where: { id: runId, status: 'ISSUING' },
      data: { status: 'ISSUED' },
    });
    if (updated.count === 0) return false;
    await tx.auditEvent.create({
      data: {
        actorId: ACTOR,
        action: 'run.close_healed',
