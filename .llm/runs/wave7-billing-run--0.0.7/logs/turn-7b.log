// netscript-workers-resource: {"kind":"job","id":"period-close-check","enabled":true,"entrypoint":"workers/jobs/period-close-check.ts"}
import {
  createSuccessResult,
  defineJobHandler,
  type JobHandlerDefinition,
  type JobResult,
} from '@netscript/plugin-workers-core';
import { z } from 'zod';

import { db } from '@ledgerline/db';

/**
 * Daily maintenance for the run close (steer: a period that never closes
 * unattended has no product). Self-healing, bounded, idempotent:
 *
 * 1. Runs stuck in ISSUING whose items are ALL terminal flip to ISSUED (a
 *    lost job completion must not hold the run open forever).
 * 2. Every audit row records what moved, so the operator sees the heal.
 */

const PayloadSchema = z.object({});
type Payload = z.infer<typeof PayloadSchema>;

const ACTOR = 'worker:period-close-check';

type CloseCheckOutcome = Readonly<{
  runsReconciled: number;
  runsStillOpen: number;
}>;

export const periodCloseCheckJob: JobHandlerDefinition<Payload> = defineJobHandler(
  PayloadSchema,
  async (): Promise<JobResult<CloseCheckOutcome>> => {
    const client = await db.getClient();

    // Runs in ISSUING where every expected item has reached a terminal state.
    const stuck = await client.billingRun.findMany({
      where: { status: 'ISSUING' },
      include: { runItems: { select: { status: true } } },
      take: 100,
    });
    let runsReconciled = 0;
    let runsStillOpen = 0;
    for (const run of stuck) {
      const terminal = run.runItems.filter(
        (item) =>
          item.status === 'ISSUED' || item.status === 'FAILED' ||
          item.status === 'COMPENSATED' || item.status === 'SKIPPED' ||
          item.status === 'EXCLUDED',
      ).length;
      if (run.runItems.length > 0 && terminal === run.runItems.length) {
        await client.billingRun.update({
          where: { id: run.id },
          data: { status: 'ISSUED' },
        });
        await client.auditEvent.create({
          data: {
            actorId: ACTOR,
            action: 'run.close_healed',
            target: `run:${run.id}`,
            metadata: { issued: run.issuedCount, failed: run.failedCount },
          },
        });
        runsReconciled += 1;
      } else {
        runsStillOpen += 1;
      }
    }

    return createSuccessResult<CloseCheckOutcome>({ runsReconciled, runsStillOpen });
  },
);

export default periodCloseCheckJob;
