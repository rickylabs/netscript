/** Payload stored per console transition. */
export type RunConsoleEvent = Readonly<{
  id: string;
  runId: string;
  status: string;
  at: string;
}>;

/** Collection definition for the run console stream. */
interface RunConsoleStreamDefinition extends StreamStateDefinition {
  readonly transition: {
    readonly schema: StreamStandardSchema<RunConsoleEvent>;
    readonly type: 'runs.console';
    readonly primaryKey: 'id';
  };
}

export const runConsoleStreamSchema: StateSchema<RunConsoleStreamDefinition> = defineStreamSchema({
  transition: {
    type: 'runs.console',
    primaryKey: 'id',
    schema: z.object({
      id: z.string(),
      runId: z.string(),
      status: z.string(),
      at: z.string().datetime(),
    }),
  },
});

let producer: DurableStreamProducer<RunConsoleStreamDefinition> | null = null;

function producerFor(): DurableStreamProducer<RunConsoleStreamDefinition> {
  producer ??= createServiceStreamProducer({
    streamPath: '/v1/streams/runs/console',
    schema: runConsoleStreamSchema,
    producerId: 'runs-service',
  });
  return producer;
}

