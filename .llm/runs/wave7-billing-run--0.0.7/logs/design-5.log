/**
 * Money formatting for Ledgerline.
 *
 * Two rules govern everything here, and both exist because this is a finance
 * product where a wrong number is a false statement:
 *
 *   1. Absence is an em dash, never a zero. `null` means "not measured", and
 *      `0.00` would assert a fact that was never established.
 *   2. Money arrives as a string-encoded decimal (see `MoneySchemaV1`:
 *      `/^-?\d+(\.\d{1,6})?$/`) and is formatted from that string. It is never
 *      round-tripped through a float to get to the screen.
 *
 * This module is pure and client-safe — islands import it directly.
 */

/** The rendered form of "not measured". Never `0`, never `0.00`, never empty. */
export const ABSENT = '\u2014';

/**
 * A money amount as the domain carries it: a string-encoded decimal, or a
 * number for already-normalised derived values. `null`/`undefined` = absent.
 */
export type MoneyValue = string | number | null | undefined;

/**
 * Direction of an amount. Maps 1:1 onto the money tokens, so a component
 * picks `--ns-money-pos` / `--ns-money-neg` / `--ns-money-flat` / `--ns-absent`
 * from this rather than from a comparison it re-implements.
 */
export type MoneyDirection = 'in' | 'out' | 'flat' | 'absent';

export interface MoneyFormatOptions {
  /** ISO 4217 code. Omit to render a bare amount (the panel states currency). */
  readonly currency?: string;
  /** BCP-47 locale for grouping and separators. Defaults to `en-US`. */
  readonly locale?: string;
  /** Render an explicit `+` on amounts towards us. Deltas want this; cells do not. */
  readonly signed?: boolean;
  /** Force a fraction-digit count instead of deriving it from the value. */
  readonly precision?: number;
  /** Upper bound for derived precision. Defaults to the domain maximum of 6. */
  readonly maxPrecision?: number;
}

/** The domain's maximum scale: `Decimal(18, 4)` storage, 6 in the wire schema. */
const MAX_PRECISION = 6;

/** Minimum fraction digits for anything that looks like a currency amount. */
const MIN_PRECISION = 2;

/** The wire schema's money shape. Anything else is not a Ledgerline amount. */
const MONEY_PATTERN = /^(-?)(\d+)(?:\.(\d+))?$/;

interface ParsedDecimal {
  readonly negative: boolean;
  readonly int: string;
  readonly frac: string;
}

/**
