=== exception-badge.tsx ===
/**
 * @component ExceptionBadge
 * @layer 2
 * @kind product
 * @description Labeled chip for a run item's exception bucket; absence renders an em dash.
 */

import type { VNode } from 'preact';
import { cn } from '../../lib/cn.ts';

const DASH = '—';

const EXCEPTION_LABELS: Readonly<Record<string, string>> = {
  NONE: '',
  FIRST_INVOICE: 'First invoice',
  AMOUNT_DELTA: 'Amount delta',
  NO_PAYMENT_METHOD: 'No payment method',
  HARD_DECLINE: 'Hard decline',
  PAST_DUE: 'Past due',
};

interface ExceptionBadgeProps {
  bucket: string | null | undefined;
  class?: string;
}

/**
 * Renders an exception bucket as a rust-tinted chip. `NONE`/absence renders
 * an em dash so "no exception" never reads like a flagged item. The rust
 * treatment lives in `assets/ui/exception-badge.css`, keyed off the
 * `data-exception` attribute.
 */
export function ExceptionBadge({ bucket, class: className }: ExceptionBadgeProps): VNode {
  if (!bucket || bucket === 'NONE' || !(bucket in EXCEPTION_LABELS)) {
    return (
      <span class={cn('ns-exception-badge', className)} data-exception='none'>
        {DASH}
      </span>
    );
  }
  return (
    <span
      class={cn('ns-badge', 'ns-exception-badge', className)}
      data-exception={bucket}
    >
      {EXCEPTION_LABELS[bucket]}
    </span>
  );
}
=== exception-badge.css ===
/* ns-exception-badge — components/product/exception-badge.tsx
   Rust-tinted chip for a run item's exception bucket. Presence and absence
   are distinguished by the data-exception attribute: 'none' renders the em
   dash so "no exception" never reads like a flagged item. */

.ns-exception-badge[data-exception]:not([data-exception='none']) {
  color: var(--ns-rust-6);
  background: color-mix(in srgb, var(--ns-rust-6) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--ns-rust-6) 24%, transparent);
}

.ns-exception-badge[data-exception='none'] {
  color: var(--ns-muted-fg);
}
