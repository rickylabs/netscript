  display: flex;
  flex-direction: column;
  gap: var(--ns-space-2);
}

.ns-chart__row {
  display: grid;
  grid-template-columns: minmax(5rem, 0.3fr) minmax(0, 1fr) auto;
  align-items: center;
  gap: var(--ns-space-2);
}

.ns-chart__label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--ns-text-xs);
  color: var(--ns-muted-fg);
}

