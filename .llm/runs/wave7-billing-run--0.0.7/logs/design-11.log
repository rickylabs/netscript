+/**
+ * The hover band for point `index`: centred on the point, then clipped to the
+ * frame.
+ *
+ * This has to be centred rather than started at the point. A band that opens
+ * at its own point extends a full step to the right, so every readout is
+ * reached by hovering to the *right* of the marker it belongs to, and the last
+ * point's band sits entirely outside the frame. Clipping the two end bands to
+ * the frame is what keeps the tiling exact: the inner edge of an end band is
+ * still half a step from its point, and the outer edge lands on the frame.
+ */
+function hitBand(index: number, count: number): { left: number; width: number } {
+  const centre = percentX(index, count);
+  const half = percentStep(count) / 2;
+  const left = Math.max(0, centre - half);
+  const right = Math.min(100, centre + half);
+  return { left, width: right - left };
+}
