import HomeView from './(_components)/home-view.tsx';
import { appRoutes } from '@app/router.ts';
import { definePage } from '@app/utils.ts';
import { routes } from '@app/.generated/routes.ts';

export const homePage = definePage()
  .withRoute(routes.$route)
  .withRoute(appRoutes.home)
  .withMeta(() => ({
    title: 'Ledgerline — close the month with the number defensible',
    description:
      'Billing runs you can inspect, pause and resume. Every number settled or provisional.',
  }))
  .withLayer('home', HomeView, () => ({
    projectName: 'ledgerline',
    appName: 'ledgerline-web',
    designHref: appRoutes.design.href(),
    compositionHref: appRoutes.designComposition.href(),
    routes: [
      {
        title: 'Billing runs',
        href: appRoutes.runs.href(),
        description:
          'Draft → compute → review → issue, with per-item decisions, exceptions and terminal compensation.',
        cta: 'Open the run console',
        badge: 'product',
      },
      {
        title: 'Invoices',
        href: appRoutes.invoices.href(),
        description: 'Invoice ledger with typed search and drill-down to lines, payments and notes.',
        cta: 'Open invoices',
        badge: 'product',
      },
      {
        title: 'Customers',
        href: appRoutes.customers.href(),
        description: 'Customer accounts with credit balance, open invoices and subscriptions.',
        cta: 'Open customers',
        badge: 'product',
      },
      {
        title: 'Design reference',
        href: appRoutes.design.href(),
        description: 'Living index for the Ledgerline tokens, components, and composition rules.',
        cta: 'Open design',
        badge: 'design',
      },
    ],
  }))
  .withLayout((slots) => slots.home())
  .build();

export const { default: page } = homePage;
export { page as default };
