=== BUTTON TRANSFORMS ===
19:    transform var(--ns-ease-normal);
35:  transform: none;
=== PILL VARIANT ===

.ns-btn--outline:hover {
  background: color-mix(in srgb, var(--ns-fg) 4%, transparent);
  border-color: var(--ns-border-strong);
}

/* Pill — the reference-card action affordance: full capsule, hairline border */
.ns-btn--pill {
  background: var(--ns-card);
  color: var(--ns-fg);
  border-color: var(--ns-border);
  border-radius: var(--ns-radius-full);
  padding-inline: var(--ns-space-4);
}

.ns-btn--pill:hover {
  background: color-mix(in srgb, var(--ns-fg) 4%, var(--ns-card));
  border-color: var(--ns-border-strong);
}

/* Destructive — reversal, so it is the only rust-filled surface on a card */
.ns-btn--destructive {
  background: var(--ns-destructive);
  color: var(--ns-destructive-fg);
  border-color: var(--ns-destructive);
}

.ns-btn--destructive:hover {
  background: var(--ns-destructive-hover);
  border-color: var(--ns-destructive-hover);
}

.ns-btn--primary:active,
.ns-btn--secondary:active,
.ns-btn--outline:active,
.ns-btn--pill:active,
.ns-btn--destructive:active {
  filter: brightness(0.96);
}

/* Sizes. The radius override skips the pill variant: a size must not be able
   to un-round the one control whose whole identity is its capsule. */
.ns-btn--sm {
  font-size: var(--ns-text-xs);
  padding: var(--ns-space-1-5) var(--ns-space-3);
}

.ns-btn--sm:not(.ns-btn--pill) {
  border-radius: var(--ns-radius-sm);
}

.ns-btn--lg {
  font-size: var(--ns-text-base);
  padding: var(--ns-space-3) var(--ns-space-6);
}

.ns-btn--lg:not(.ns-btn--pill) {
  border-radius: var(--ns-radius-lg);
}

.ns-btn--icon {
  padding: var(--ns-space-2);
  aspect-ratio: 1;
  /* The visually-hidden label span is still a flex item; without this the
     inherited gap pushes the glyph ~4px off center. */
  gap: 0;
}
