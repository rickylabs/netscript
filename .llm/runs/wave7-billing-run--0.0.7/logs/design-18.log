########## comparison-area-chart.css ##########
/* ComparisonAreaChart — two-layer area chart, current period over the
   comparison period (H5).

   Geometry is SVG and only SVG; the hover readout and both axes are an HTML
   layer over it, so labels are real text at token type sizes. The two meet
   through custom properties the component sets as percentages of the drawn
   chart box — geometry, not formatting (H2).

   Layout: the y-axis gutter is column 1 and is only rendered when the chart
   is given ticks, so a chrome-free chart loses the gutter and its gap with it. */

.ns-areachart {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  row-gap: var(--ns-space-2);
  column-gap: 0;
}

/* One hairline frame around the plot. Never a border per series, never four
   axis lines — chrome stays minimal (H6). */
.ns-areachart__frame {
  grid-column: 2;
  grid-row: 1;
  position: relative;
  border: 1px solid var(--ns-border);
  border-radius: var(--ns-radius-xl);
  background: var(--ns-card);
}

.ns-areachart__svg {
  display: block;
  width: 100%;
  height: auto;
}

.ns-areachart__gridline {
  stroke: var(--ns-chart-grid);
  stroke-width: 1;
  stroke-dasharray: 2 4;
  vector-effect: non-scaling-stroke;
}

.ns-areachart__baseline {
  stroke: var(--ns-border);
  stroke-width: 1;
  vector-effect: non-scaling-stroke;
}

/* The comparison period: same hue, no stroke, reduced opacity. It is a shadow
   of the current period, not a second series to be told apart by colour. */
.ns-areachart__comparison {
  fill: color-mix(in srgb, var(--ns-series-1) 18%, transparent);
  stroke: none;
}

.ns-areachart__comparison[data-series='2'] {
  fill: color-mix(in srgb, var(--ns-series-2) 18%, transparent);
}

.ns-areachart__comparison[data-series='3'] {
  fill: color-mix(in srgb, var(--ns-series-3) 18%, transparent);
}

.ns-areachart__comparison[data-series='4'] {
  fill: color-mix(in srgb, var(--ns-series-4) 18%, transparent);
}

.ns-areachart__comparison[data-series='5'] {
  fill: color-mix(in srgb, var(--ns-series-5) 18%, transparent);
}

.ns-areachart__comparison[data-series='6'] {
  fill: color-mix(in srgb, var(--ns-series-6) 18%, transparent);
}

.ns-areachart__line {
  stroke: var(--ns-series-1);
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  vector-effect: non-scaling-stroke;
}

.ns-areachart__line[data-series='2'] {
  stroke: var(--ns-series-2);
}

.ns-areachart__line[data-series='3'] {
  stroke: var(--ns-series-3);
}

.ns-areachart__line[data-series='4'] {
  stroke: var(--ns-series-4);
}

.ns-areachart__line[data-series='5'] {
  stroke: var(--ns-series-5);
}

.ns-areachart__line[data-series='6'] {
  stroke: var(--ns-series-6);
}

.ns-areachart__stop-top {
  stop-color: var(--ns-series-1);
  stop-opacity: 0.28;
}

.ns-areachart__stop-top[data-series='2'] {
  stop-color: var(--ns-series-2);
}

.ns-areachart__stop-top[data-series='3'] {
  stop-color: var(--ns-series-3);
}

.ns-areachart__stop-top[data-series='4'] {
  stop-color: var(--ns-series-4);
}

.ns-areachart__stop-top[data-series='5'] {
  stop-color: var(--ns-series-5);
}

.ns-areachart__stop-top[data-series='6'] {
  stop-color: var(--ns-series-6);
}

.ns-areachart__stop-bottom {
  stop-color: var(--ns-series-1);
  stop-opacity: 0;
}

.ns-areachart__stop-bottom[data-series='2'] {
  stop-color: var(--ns-series-2);
}

.ns-areachart__stop-bottom[data-series='3'] {
  stop-color: var(--ns-series-3);
}

.ns-areachart__stop-bottom[data-series='4'] {
  stop-color: var(--ns-series-4);
}

.ns-areachart__stop-bottom[data-series='5'] {
  stop-color: var(--ns-series-5);
}

.ns-areachart__stop-bottom[data-series='6'] {
  stop-color: var(--ns-series-6);
}

/* Hover layer: one column per point, tiled so there is no dead zone. Hovering
   the column — not a 4px dot — is what reveals the readout, so the reader aims
   at an x rather than at a target. */
.ns-areachart__hits {
  position: absolute;
  inset: 0;
}

/* `left`/`width` are set inline and already name the band's own box, so there
   is no centring transform to undo. `--hit-x` is the point's x as a percentage
   of *this band* — 50% for every interior band, and off-centre only where an
   end band had to be clipped to the frame. */
.ns-areachart__hit {
  --hit-x: 50%;
  position: absolute;
  top: 0;
  bottom: 0;
}

.ns-areachart__crosshair,
.ns-areachart__dot,
.ns-areachart__tip {
  opacity: 0;
  transition: opacity var(--ns-ease-fast);
  pointer-events: none;
}

/* The crosshair drops from the point marker to the baseline — downward, never
   up and out of the chart. */
.ns-areachart__crosshair {
  position: absolute;
  top: var(--hit-dot);
  bottom: 0;
  left: var(--hit-x);
  border-inline-start: 1px dashed var(--ns-chart-axis);
}

.ns-areachart__dot {
  position: absolute;
  top: var(--hit-dot);
  left: var(--hit-x);
  width: var(--ns-space-2);
  height: var(--ns-space-2);
  transform: translate(-50%, -50%);
  border: 2px solid var(--ns-card);
  border-radius: var(--ns-radius-full);
  background: var(--ns-series-1);
}

.ns-areachart__dot[data-series='2'] {
  background: var(--ns-series-2);
}

.ns-areachart__dot[data-series='3'] {
  background: var(--ns-series-3);
}

.ns-areachart__dot[data-series='4'] {
  background: var(--ns-series-4);
}

.ns-areachart__dot[data-series='5'] {
  background: var(--ns-series-5);
}

.ns-areachart__dot[data-series='6'] {
  background: var(--ns-series-6);
}

/* Dark bubble with a downward pointer, centred over the node. `--ns-tip-*`
   inverts against the card in both themes, so no component asks which theme
   is active (T3). */
.ns-areachart__tip {
  position: absolute;
  bottom: calc(100% - var(--hit-dot));
  left: var(--hit-x);
  transform: translate(-50%, calc(-1 * var(--ns-space-3)));
  display: flex;
  flex-direction: column;
  gap: var(--ns-space-0-5);
  padding: var(--ns-space-1-5) var(--ns-space-2-5);
  border-radius: var(--ns-radius-md);
  background: var(--ns-tip-bg);
  color: var(--ns-tip-fg);
  box-shadow: var(--ns-shadow-md);
  white-space: nowrap;
  z-index: var(--ns-z-dropdown);
}

.ns-areachart__tip::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border: var(--ns-space-1) solid transparent;
  border-top-color: var(--ns-tip-bg);
}

.ns-areachart__tip-label {
  font-size: var(--ns-text-3xs);
  text-transform: uppercase;
  letter-spacing: var(--ns-tracking-wide);
  opacity: 0.72;
}

.ns-areachart__tip-value {
  font-family: var(--ns-font-numeric);
  font-variant-numeric: var(--ns-numeric-tabular);
  font-size: var(--ns-text-xs);
  font-weight: 600;
}

.ns-areachart__hit:hover > .ns-areachart__crosshair,
.ns-areachart__hit:hover > .ns-areachart__dot,
.ns-areachart__hit:hover > .ns-areachart__tip {
  opacity: 1;
}

/* Axes sit outside the bounded plot (H6), positioned from the same geometry
   the SVG used, so a tick cannot drift from its gridline. */
.ns-areachart__yaxis {
  grid-column: 1;
  grid-row: 1;
  position: relative;
  width: max-content;
  margin: 0;
  padding: 0 var(--ns-space-2) 0 0;
  list-style: none;
}

.ns-areachart__ytick {
  position: absolute;
  right: var(--ns-space-2);
  transform: translateY(-50%);
  font-family: var(--ns-font-numeric);
  font-variant-numeric: var(--ns-numeric-tabular);
  font-size: var(--ns-text-3xs);
  line-height: 1;
  white-space: nowrap;
  color: var(--ns-chart-axis);
}

.ns-areachart__xaxis {
  grid-column: 2;
  grid-row: 2;
  position: relative;
  height: var(--ns-space-4);
  margin: 0;
  padding: 0;
  list-style: none;
}

.ns-areachart__xtick {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  max-width: 5rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--ns-text-3xs);
  color: var(--ns-muted-fg);
}

/* C6: an inline dot legend, never a boxed key. The comparison swatch is the
   same hue at the same opacity as the layer it stands for. */
.ns-areachart__legend {
  grid-column: 1 / -1;
  display: flex;
  flex-wrap: wrap;
  gap: var(--ns-space-2) var(--ns-space-4);
  margin: 0;
  padding: 0;
  list-style: none;
}

.ns-areachart__legend-row {
  display: flex;
  align-items: center;
  gap: var(--ns-space-2);
  font-size: var(--ns-text-2xs);
  color: var(--ns-muted-fg);
}

.ns-areachart__swatch {
  flex-shrink: 0;
  width: var(--ns-space-2);
  height: var(--ns-space-2);
  border-radius: var(--ns-radius-full);
  background: var(--ns-series-1);
}

.ns-areachart__swatch[data-series='2'] {
  background: var(--ns-series-2);
}

.ns-areachart__swatch[data-series='3'] {
  background: var(--ns-series-3);
}

.ns-areachart__swatch[data-series='4'] {
  background: var(--ns-series-4);
}

.ns-areachart__swatch[data-series='5'] {
  background: var(--ns-series-5);
}

.ns-areachart__swatch[data-series='6'] {
  background: var(--ns-series-6);
}

.ns-areachart__swatch--ghost {
  background: color-mix(in srgb, var(--ns-series-1) 18%, transparent);
}

.ns-areachart__swatch--ghost[data-series='2'] {
  background: color-mix(in srgb, var(--ns-series-2) 18%, transparent);
}

.ns-areachart__swatch--ghost[data-series='3'] {
  background: color-mix(in srgb, var(--ns-series-3) 18%, transparent);
}

.ns-areachart__swatch--ghost[data-series='4'] {
  background: color-mix(in srgb, var(--ns-series-4) 18%, transparent);
}

.ns-areachart__swatch--ghost[data-series='5'] {
  background: color-mix(in srgb, var(--ns-series-5) 18%, transparent);
}

.ns-areachart__swatch--ghost[data-series='6'] {
  background: color-mix(in srgb, var(--ns-series-6) 18%, transparent);
}

/* H7: no data is a labelled frame, never a flat line at zero. */
.ns-areachart__frame--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--ns-space-20);
  padding: var(--ns-space-6);
  border-style: dashed;
}

.ns-areachart__empty {
  margin: 0;
  font-size: var(--ns-text-sm);
  color: var(--ns-muted-fg);
  text-align: center;
}

@media (prefers-reduced-motion: reduce) {
  .ns-areachart__crosshair,
  .ns-areachart__dot,
  .ns-areachart__tip {
    transition: none;
  }
}
