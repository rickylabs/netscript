########## segmented-control.css ##########
/* SegmentedControl — range selection by filling, not by bordering (C4).

   The container is the capsule; the selected cell is a raised pill inside it
   with the surface's own background, so light and dark both read without a
   theme-specific rule (T3). Dividers are hairlines between cells only — never
   a border around the whole control competing with the card's. */

.ns-segmented {
  display: inline-flex;
  align-items: center;
  gap: 0;
  padding: var(--ns-space-0-5);
  border: 1px solid var(--ns-border);
  border-radius: var(--ns-radius-full);
  background: var(--ns-muted);
}

.ns-segmented--block {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 1fr;
  width: 100%;
}

.ns-segmented__cell {
  appearance: none;
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--ns-space-1-5) var(--ns-space-3);
  border: 0;
  border-radius: var(--ns-radius-full);
  background: transparent;
  font-family: var(--ns-font-sans);
  font-size: var(--ns-text-xs);
  font-weight: 500;
  line-height: 1.2;
  color: var(--ns-muted-fg);
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  transition: background var(--ns-ease-normal), color var(--ns-ease-normal);
}

.ns-segmented--sm .ns-segmented__cell {
  padding: var(--ns-space-1) var(--ns-space-2-5);
  font-size: var(--ns-text-2xs);
}

/* Hairline divider between cells, drawn on the leading edge of every cell but
   the first so it never doubles up and never sits on the capsule's edge. */
.ns-segmented__cell + .ns-segmented__cell::before {
  content: '';
  position: absolute;
  inset-block: 25%;
  inset-inline-start: 0;
  width: 1px;
  background: var(--ns-border);
}

.ns-segmented__cell:hover:not(.is-selected):not(:disabled) {
  color: var(--ns-fg);
}

.ns-segmented__cell.is-selected {
  background: var(--ns-card);
  color: var(--ns-fg);
  font-weight: 600;
  box-shadow: var(--ns-shadow-xs);
}

/* A selected cell swallows the divider that would run into it. */
.ns-segmented__cell.is-selected::before,
.ns-segmented__cell.is-selected + .ns-segmented__cell::before {
  background: transparent;
}

.ns-segmented__cell:disabled,
.ns-segmented__cell[aria-disabled='true'] {
  opacity: 0.45;
  cursor: not-allowed;
}

.ns-segmented__cell:focus-visible {
  outline: 2px solid var(--ns-ring);
  outline-offset: 1px;
}

@media (prefers-reduced-motion: reduce) {
  .ns-segmented__cell {
    transition: none;
  }
}
########## footer-columns.css ##########
/* FooterColumns — the bottom band of a widget card (C5).

   Columns are equal-width and divided by hairline *rules*, not by gaps: a gap
   reads as two separate facts, a rule reads as one strip of related facts. The
   divider is drawn on the leading edge of every column but the first so it
   never doubles and never sits on the strip's own outer edge. */

.ns-footer-cols {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 1fr;
  border: 1px solid var(--ns-border);
  border-radius: var(--ns-radius-xl);
  overflow: hidden;
}

.ns-footer-cols__col {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--ns-space-1);
  min-width: 0;
  padding: var(--ns-space-3) var(--ns-space-2);
  text-align: center;
}

.ns-footer-cols__col + .ns-footer-cols__col::before {
  content: '';
  position: absolute;
  inset-block: var(--ns-space-2);
  inset-inline-start: 0;
  width: 1px;
  background: var(--ns-border);
}

.ns-footer-cols__glyph {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--ns-space-6);
  height: var(--ns-space-6);
  margin-bottom: var(--ns-space-1);
  border-radius: var(--ns-radius-lg);
  background: color-mix(in srgb, var(--ns-primary) 12%, transparent);
  color: var(--ns-primary);
  font-size: var(--ns-text-sm);
}

.ns-footer-cols__label {
  font-family: var(--ns-font-mono);
  font-size: var(--ns-text-3xs);
  text-transform: uppercase;
  letter-spacing: var(--ns-tracking-wide);
  color: var(--ns-muted-fg);
  white-space: nowrap;
}

.ns-footer-cols__value {
  font-family: var(--ns-font-numeric);
  font-variant-numeric: var(--ns-numeric-tabular);
  font-size: var(--ns-text-sm);
  font-weight: 600;
  color: var(--ns-fg);
  white-space: nowrap;
}

/* M5: direction selects the money token; the call site never picks a colour. */
.ns-footer-cols__col[data-direction='in'] .ns-footer-cols__value {
  color: var(--ns-money-pos);
}

.ns-footer-cols__col[data-direction='out'] .ns-footer-cols__value {
  color: var(--ns-money-neg);
}

.ns-footer-cols__col[data-direction='flat'] .ns-footer-cols__value {
  color: var(--ns-money-flat);
}

/* M1: a null column is "not measured", and says so in the absent tone. */
.ns-footer-cols__col[data-direction='absent'] .ns-footer-cols__value {
  color: var(--ns-absent);
}
