=== money-text.tsx ===
/**
 * @component MoneyText
 * @layer 2
 * @kind product
 * @depends lib/money
 * @description The one renderer for a money amount. It formats nothing itself:
 * every digit comes from `lib/money.ts`, direction comes from
 * `moneyParts().direction`, and absence is an em dash.
 */

import type { VNode } from 'preact';
import { cn } from '../../lib/cn.ts';
import { ABSENT, type MoneyDirection, moneyParts, type MoneyValue } from '../../lib/money.ts';

interface MoneyTextProps {
  /** String-encoded decimal from the contract; null/undefined = not measured. */
  value: MoneyValue;
  currency?: string;
  class?: string;
}

/**
 * `moneyParts` direction -> the `data-money-sign` this component's stylesheet
 * keys off. Absent is styled by `data-money='absent'`, so it lands on `flat`
 * here and never reaches this map.
 */
const SIGN: Readonly<Record<MoneyDirection, string>> = {
  in: 'pos',
  out: 'neg',
  flat: 'flat',
  absent: 'flat',
};

/**
 * Renders money with the money-* semantic colors and tabular numerals.
 *
 * Every digit and the direction both come from one `moneyParts()` call. This
 * component does no arithmetic of its own: the float round-trip it used to
 * make is what printed `$100` where the ledger requires `$100.00`, and the
 * sign it used to re-derive with `amount > 0` is a fact the money layer
 * already resolves — including the case where rounding a small negative to
 * two digits makes it a flat zero rather than a negative amount.
 *
 * Absence (`null`/`undefined`/unparseable) renders an em dash — never `0.00`,
 * because in a ledger "not measured" and "zero" are different facts.
 */
export function MoneyText({ value, currency, class: className }: MoneyTextProps): VNode {
  const parts = moneyParts(value, { currency });

  if (parts.absent) {
    return (
      <span class={cn('ns-money-text', className)} data-money='absent' data-currency={currency}>
        <span aria-hidden='true'>{ABSENT}</span>
        <span class='sr-only'>not measured</span>
      </span>
    );
  }

  return (
    <span
      class={cn('ns-money-text', className)}
      data-money
      data-money-sign={SIGN[parts.direction]}
      data-currency={currency}
    >
      {
        /* Currency leads as its own element, so it is a prefix the layout can
          space — never a code concatenated onto the digits as `100.00USD`. */
      }
      {parts.currency !== null && <span class='ns-money-text__currency'>{parts.currency}</span>}
