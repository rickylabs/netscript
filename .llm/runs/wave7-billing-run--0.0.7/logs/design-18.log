/* MoneyText — the one renderer for a money amount.

   M4: every amount is tabular and never wraps, so a column of figures aligns
   on the decimal point. M5: colour comes from `data-direction`, which the
   component reads off `moneyParts()` — it never re-derives sign by comparing
   the value. Colour is opt-in (`data-tone='direction'`); a hero amount reads
   in the surface's own foreground and lets its delta chip carry the hue. */

.ns-money {
  display: inline-flex;
  align-items: baseline;
  gap: var(--ns-space-px);
  font-family: var(--ns-font-numeric);
  font-variant-numeric: var(--ns-numeric-tabular);
  font-size: var(--ns-text-money);
  line-height: var(--ns-leading-tight);
  white-space: nowrap;
  color: inherit;
}

.ns-money--sm {
  font-size: var(--ns-text-sm);
}

.ns-money--lg {
  font-size: var(--ns-text-lg);
}

.ns-money--hero {
  font-family: var(--ns-font-sans);
  font-size: var(--ns-text-4xl);
  font-weight: 600;
  letter-spacing: var(--ns-tracking-tight);
}

/* A currency symbol is a prefix, not a suffix, and never touches the digits
   (the defect this component replaced printed `100.00USD`). */
.ns-money__currency {
  font-size: 0.75em;
  color: var(--ns-muted-fg);
}

.ns-money[data-tone='direction'][data-direction='in'] {
  color: var(--ns-money-pos);
}

.ns-money[data-tone='direction'][data-direction='out'] {
  color: var(--ns-money-neg);
}

.ns-money[data-tone='direction'][data-direction='flat'] {
  color: var(--ns-money-flat);
}

/* M1: absence is an em dash, never a zero — and it reads as "not recorded"
   rather than as a dash. */
.ns-money[data-direction='absent'] {
  color: var(--ns-absent);
}
