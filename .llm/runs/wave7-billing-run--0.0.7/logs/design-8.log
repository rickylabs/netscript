/**
 * @component SegmentedControl
 * @layer 2
 * @depends theme-seed
 * @description Range selection as one full-width capsule: N equal cells, the
 * selected one a filled pill. Never a border change (C4). Renders as buttons
 * for client-side selection, or as links when the range is a route.
 */

import type { JSX, VNode } from 'preact';
import { cn } from '../../lib/cn.ts';

export interface SegmentedControlOption {
  /** Range key — `1D`, `1W`, `1M`, `3M`, `1Y`, or a product range id. */
  readonly value: string;
  /** Preformatted cell label. */
  readonly label: string;
  /** Render the cell as a link, so the range lives in the URL. */
  readonly href?: string;
  readonly disabled?: boolean;
}

export interface SegmentedControlProps
  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children' | 'onSelect'> {
  /** Accessible name for the group, e.g. `Billing period`. */
  label: string;
  options: readonly SegmentedControlOption[];
  /** The selected option's `value`. Omit only when nothing is selected. */
  value?: string | null;
  /** Called with the chosen `value`. Required unless every option has an `href`. */
  onSelect?: (value: string) => void;
  size?: 'sm' | 'md';
  /** Stretch to the container width. The reference control is full-width. */
  block?: boolean;
  class?: string;
}

/**
 * A segmented range control.
 *
 * Link options turn the group into navigation and drop the tab semantics,
 * because a link is not a tab; selection is then announced with
 * `aria-current`. Link and button options are not mixed — the first option
 * decides the whole control's mode.
 */
export function SegmentedControl({
  label,
  options,
  value = null,
  onSelect,
  size = 'md',
  block = true,
  class: className,
  ...props
}: SegmentedControlProps): VNode {
  const asLinks = options.length > 0 && options.every((option) => option.href !== undefined);

  return (
    <div
      {...props}
      class={cn(
        'ns-segmented',
        size === 'sm' && 'ns-segmented--sm',
        block && 'ns-segmented--block',
        className,
      )}
      role={asLinks ? 'group' : 'tablist'}
      aria-label={label}
    >
      {options.map((option) => {
        const selected = option.value === value;
        const cellClass = cn('ns-segmented__cell', selected && 'is-selected');

        if (asLinks) {
          return (
            <a
              key={option.value}
              class={cellClass}
              href={option.href}
              aria-current={selected ? 'true' : undefined}
              aria-disabled={option.disabled ? 'true' : undefined}
            >
              {option.label}
            </a>
          );
        }

        return (
          <button
            key={option.value}
            type='button'
            class={cellClass}
            role='tab'
            // Explicit "true"/"false" rather than a boolean: an empty
            // aria-selected reads as false to assistive tech, which would leave
            // the control with no selected tab at all.
            aria-selected={selected ? 'true' : 'false'}
            disabled={option.disabled}
            onClick={() => onSelect?.(option.value)}
          >
            {option.label}
          </button>
        );
      })}
    </div>
  );
}
===== assets/ui/segmented-control.css =====
/* SegmentedControl — range selection by filling, not by bordering (C4).

   The container is the capsule; the selected cell is a raised pill inside it
   with the surface's own background, so light and dark both read without a
   theme-specific rule (T3). Dividers are hairlines between cells only — never
   a border around the whole control competing with the card's. */

.ns-segmented {
  display: inline-flex;
  align-items: center;
  gap: 0;
  padding: var(--ns-space-0-5);
  border: 1px solid var(--ns-border);
  border-radius: var(--ns-radius-full);
  background: var(--ns-muted);
}

.ns-segmented--block {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 1fr;
  width: 100%;
}

.ns-segmented__cell {
  appearance: none;
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--ns-space-1-5) var(--ns-space-3);
  border: 0;
  border-radius: var(--ns-radius-full);
  background: transparent;
  font-family: var(--ns-font-sans);
  font-size: var(--ns-text-xs);
  font-weight: 500;
  line-height: 1.2;
  color: var(--ns-muted-fg);
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  transition: background var(--ns-ease-normal), color var(--ns-ease-normal);
}

.ns-segmented--sm .ns-segmented__cell {
  padding: var(--ns-space-1) var(--ns-space-2-5);
  font-size: var(--ns-text-2xs);
}

/* Hairline divider between cells, drawn on the leading edge of every cell but
   the first so it never doubles up and never sits on the capsule's edge. */
.ns-segmented__cell + .ns-segmented__cell::before {
  content: '';
  position: absolute;
  inset-block: 25%;
  inset-inline-start: 0;
  width: 1px;
  background: var(--ns-border);
}

.ns-segmented__cell:hover:not(.is-selected):not(:disabled) {
  color: var(--ns-fg);
}

.ns-segmented__cell.is-selected {
  background: var(--ns-card);
  color: var(--ns-fg);
  font-weight: 600;
  box-shadow: var(--ns-shadow-xs);
}

/* A selected cell swallows the divider that would run into it. */
.ns-segmented__cell.is-selected::before,
.ns-segmented__cell.is-selected + .ns-segmented__cell::before {
  background: transparent;
}

.ns-segmented__cell:disabled,
.ns-segmented__cell[aria-disabled='true'] {
  opacity: 0.45;
  cursor: not-allowed;
}

.ns-segmented__cell:focus-visible {
  outline: 2px solid var(--ns-ring);
  outline-offset: 1px;
}

@media (prefers-reduced-motion: reduce) {
  .ns-segmented__cell {
    transition: none;
  }
}
