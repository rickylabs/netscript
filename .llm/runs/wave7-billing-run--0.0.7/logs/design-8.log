/* ns-exception-badge — components/product/exception-badge.tsx
   Rust-tinted chip for a run item's exception bucket. Presence and absence
   are distinguished by the data-exception attribute: 'none' renders the em
   dash so "no exception" never reads like a flagged item. */

/* A component never reaches into a ramp step, because the ramp is theme-variant
   and this chip has to hold its contrast on both grounds. `--ns-rust-6` is a
   mid red: legible on paper, but roughly 3.4:1 against a dark card, under the
   4.5:1 a chip's small text needs. These three are semantic and the theme
   re-steps them — `--ns-money-neg` moves rust-6 to rust-4 in dark and the
   tint/border pair steps 10/20% up to 12/24% — so one rule covers both
   themes instead of a dark-mode override that drifts. */
.ns-exception-badge[data-exception]:not([data-exception='none']) {
  color: var(--ns-money-neg);
  background: var(--ns-destructive-subtle);
  border: 1px solid var(--ns-destructive-border);
}

.ns-exception-badge[data-exception='none'] {
  color: var(--ns-muted-fg);
}
=== money-text.css ===
/* ns-money-text — components/product/money-text.tsx
   Token-driven money rendering: tabular numerals over the numeric font,
   pos/neg/flat intent via data-money-sign, muted currency prefix, and an em
   dash for absence (never a fabricated zero). */

.ns-money-text {
  display: inline-flex;
  align-items: baseline;
  gap: var(--ns-space-px);
  color: var(--ns-money-flat);
  font-family: var(--ns-font-numeric);
  font-variant-numeric: var(--ns-numeric-tabular);
  font-size: var(--ns-text-money);
  line-height: var(--ns-leading-tight);
  /* A column of figures aligns on the decimal point, so an amount never
     breaks across lines. */
  white-space: nowrap;
}

.ns-money-text[data-money-sign='pos'] {
  color: var(--ns-money-pos);
}

.ns-money-text[data-money-sign='neg'] {
  color: var(--ns-money-neg);
}

.ns-money-text[data-money-sign='flat'],
.ns-money-text[data-money='absent'] {
  color: var(--ns-money-flat);
}

/* A currency symbol is a prefix, not a suffix, and it lives in its own element
   so it can never concatenate onto the digits as `100.00USD`. */
.ns-money-text__currency {
  color: var(--ns-muted-fg);
  font-family: var(--ns-font-mono);
  font-size: 0.75em;
}
