/* SemicircularGauge — 180° two-tone run-progress arc (H1: hand-authored SVG).

   Two things are load-bearing and were both got wrong by the 360° donut:
     · `stroke-linecap: butt` — the arc terminates in flat cuts flush with the
       baseline. A round cap bulges below the baseline and bleeds across the
       segment junction.
     · the centre block is absolutely positioned against the plot's *height*
       (top: % resolves against height for an abspos box), so it stays centred
       inside the arc at every width. */

.ns-gauge {
  display: flex;
  flex-direction: column;
  gap: var(--ns-space-3);
}

.ns-gauge__plot {
  position: relative;
}

.ns-gauge__svg {
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;
}

.ns-gauge__track {
  stroke: var(--ns-muted);
}

.ns-gauge__seg {
  stroke: var(--ns-series-1);
  transition: stroke-dasharray var(--ns-ease-normal);
}

.ns-gauge__seg[data-series='1'] {
  stroke: var(--ns-series-1);
}

.ns-gauge__seg[data-series='2'] {
  stroke: var(--ns-series-2);
}

.ns-gauge__seg[data-series='3'] {
  stroke: var(--ns-series-3);
}

.ns-gauge__seg[data-series='4'] {
  stroke: var(--ns-series-4);
}

.ns-gauge__seg[data-series='5'] {
  stroke: var(--ns-series-5);
}

.ns-gauge__seg[data-series='6'] {
  stroke: var(--ns-series-6);
}

/* Centred inside the arc, not inside the viewBox: the arc's inner void spans
   roughly 26%–91% of the plot height. */
.ns-gauge__center {
  position: absolute;
  top: 64%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--ns-space-1);
  max-width: 64%;
  text-align: center;
}

.ns-gauge__label {
  font-family: var(--ns-font-mono);
  font-size: var(--ns-text-3xs);
  text-transform: uppercase;
  letter-spacing: var(--ns-tracking-wide);
  color: var(--ns-muted-fg);
}

.ns-gauge__value {
  font-family: var(--ns-font-sans);
  font-size: var(--ns-text-2xl);
  font-weight: 600;
  line-height: var(--ns-leading-tight);
  letter-spacing: var(--ns-tracking-tight);
  font-variant-numeric: var(--ns-numeric-tabular);
  color: var(--ns-fg);
}

.ns-gauge__caption {
  font-size: var(--ns-text-2xs);
  color: var(--ns-muted-fg);
}

.ns-gauge--compact .ns-gauge__value {
  font-size: var(--ns-text-xl);
}

/* The hairline the reference puts directly beneath the arc baseline. */
.ns-gauge__rule {
  display: block;
  height: 1px;
  background: var(--ns-border);
}

/* C6: inline dot + label, never a boxed key. */
.ns-gauge__legend {
  display: flex;
  flex-wrap: wrap;
  gap: var(--ns-space-2) var(--ns-space-4);
  margin: 0;
  padding: 0;
  list-style: none;
}

.ns-gauge__legend-row {
  display: flex;
  align-items: baseline;
  gap: var(--ns-space-2);
  font-size: var(--ns-text-xs);
}

.ns-gauge__dot {
  flex-shrink: 0;
  align-self: center;
  width: var(--ns-space-2);
  height: var(--ns-space-2);
  border-radius: var(--ns-radius-full);
  background: var(--ns-series-1);
}

.ns-gauge__dot[data-series='1'] {
  background: var(--ns-series-1);
}

.ns-gauge__dot[data-series='2'] {
  background: var(--ns-series-2);
}

.ns-gauge__dot[data-series='3'] {
  background: var(--ns-series-3);
}

.ns-gauge__dot[data-series='4'] {
  background: var(--ns-series-4);
}

.ns-gauge__dot[data-series='5'] {
  background: var(--ns-series-5);
}

.ns-gauge__dot[data-series='6'] {
  background: var(--ns-series-6);
}

.ns-gauge__legend-label {
  color: var(--ns-muted-fg);
}

.ns-gauge__legend-value {
  font-family: var(--ns-font-numeric);
  font-variant-numeric: var(--ns-numeric-tabular);
  color: var(--ns-fg);
}

/* H7: no data is a labelled frame, never a flat arc at zero. */
.ns-gauge__frame {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--ns-space-24);
  padding: var(--ns-space-6);
  border: 1px dashed var(--ns-border);
  border-radius: var(--ns-radius-xl);
}

.ns-gauge__empty {
  margin: 0;
  font-size: var(--ns-text-sm);
  color: var(--ns-muted-fg);
  text-align: center;
}

@media (prefers-reduced-motion: reduce) {
  .ns-gauge__seg {
    transition: none;
  }
}
