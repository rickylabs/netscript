/**
 * Design contract tests.
 *
 * DESIGN.md states several rules as mechanically checkable — "fails if" a ramp
 * step appears in a component, an offset shadow survives in a stylesheet, or a
 * catalogue entry has no demo. These tests are that check. They read the files,
 * because a rule that is not run is a rule that rots.
 */

import { assert, assertEquals } from '@std/assert';

const APP = new URL('../apps/ledgerline-web/', import.meta.url);
const ASSETS = new URL('./assets/', APP);
const COMPONENTS = new URL('./components/', APP);

/** Every CSS file an installed component owns. */
async function componentStylesheets(): Promise<string[]> {
  const files: string[] = [];
  for (const dir of ['ui', 'blocks']) {
    for await (const entry of Deno.readDir(new URL(`./${dir}/`, ASSETS))) {
      if (entry.isFile && entry.name.endsWith('.css')) files.push(`${dir}/${entry.name}`);
    }
  }
  return files.sort();
}

/** Every component module in the app-owned UI barrel directory. */
async function componentModules(): Promise<string[]> {
  const files: string[] = [];
  for await (const entry of Deno.readDir(new URL('./ui/', COMPONENTS))) {
    if (entry.isFile && entry.name.endsWith('.tsx')) files.push(entry.name);
  }
  return files.sort();
}

async function read(path: string): Promise<string> {
  return await Deno.readTextFile(new URL(path, APP));
}

/**
 * Source with its comments removed, so a rule about the text a reader sees
 * does not fire on the prose that documents the code. `components/ui/mod.ts`
 * legitimately names `netscript ui:init` — that is provenance, not demo copy.
 * A `//` directly after a colon is a URL scheme, not a comment.
 */
function withoutComments(source: string): string {
  return source
    .replace(/\/\*[\s\S]*?\*\//g, '')
    .replace(/(?<!:)\/\/[^\n]*/g, '');
}

/** Every app source file that can put text in front of a reader. */
async function appSources(): Promise<string[]> {
  const files: string[] = [];

  async function walk(dir: string): Promise<void> {
    try {
      for await (const entry of Deno.readDir(new URL(`./${dir}/`, APP))) {
        const rel = `${dir}/${entry.name}`;
        if (entry.isDirectory) await walk(rel);
        else if (/\.tsx?$/.test(entry.name)) files.push(rel);
      }
    } catch {
      // A root that does not exist in this branch contributes nothing.
    }
  }

  for (const root of ['routes', 'components', 'islands', 'lib']) await walk(root);
  return files.sort();
}

Deno.test('T2a — no component reaches for a ramp step', async () => {
  // The paper ramp inverts in dark: paper-12 is near-black in light and
  // near-white in dark. A ramp step in a component is a broken dark theme.
  const rampStep = /var\(--ns-(?:paper|ledger|rust|ink|brass|amber)-\d+\)/;

  for (const sheet of await componentStylesheets()) {
    const css = await read(`./assets/${sheet}`);
    assert(!rampStep.test(css), `${sheet} references a ramp step; use the semantic role instead`);
  }

  for (const name of await componentModules()) {
    const source = await read(`./components/ui/${name}`);
    assert(
      !rampStep.test(source),
      `components/ui/${name} references a ramp step; use the semantic role instead`,
    );
  }
});

Deno.test('T2 — no raw colour literal in a component stylesheet', async () => {
  for (const sheet of await componentStylesheets()) {
    const css = await read(`./assets/${sheet}`);
    assert(
      !/#[0-9a-fA-F]{3,8}\b/.test(css),
      `${sheet} contains a hex literal outside the token files`,
    );
    assert(!/\brgba?\(/.test(css), `${sheet} contains an rgb()/rgba() literal`);
  }
});

Deno.test('C8 — no hard offset shadow survives', async () => {
  for (const sheet of await componentStylesheets()) {
    const css = await read(`./assets/${sheet}`);
    assert(
      !/box-shadow:[^;]*\d+px\s+\d+px\s+0/.test(css),
      `${sheet} uses an offset brutalist shadow; elevation is diffuse and token-driven`,
    );
  }
});

Deno.test('M8 — only lib/money turns a decimal into text', async () => {
  const formatters = /\bNumber\s*\(|\.toFixed\s*\(|\bIntl\.NumberFormat/;
  const moneyModule = await read('./lib/money.ts');
  const allowed = new Set(['money-text.tsx']);

  for (const name of await componentModules()) {
    if (allowed.has(name)) continue;
    const source = await read(`./components/ui/${name}`);
    assert(
      !formatters.test(source),
      `components/ui/${name} formats a value itself; render it through MoneyText instead`,
    );
  }

  // And the one component that is allowed to touch money must not format either.
  const moneyText = await read('./components/ui/money-text.tsx');
  assert(
    !formatters.test(moneyText),
    'money-text.tsx must not call Number/toFixed/Intl — it resolves through moneyParts()',
  );
  // …but it must actually use the module, not shadow it.
  assert(moneyText.includes('moneyParts'), 'money-text.tsx must resolve values through moneyParts');
  assert(moneyModule.includes('export function moneyParts'));
});

Deno.test('T1 — tokens.json and tokens.css declare the same custom properties', async () => {
  const manifest = JSON.parse(await read('./assets/tokens.json')) as {
    tokens: Record<string, { cssVar: string }>;
    themes: { dark: Record<string, { cssVar: string }> };
  };
  const css = await read('./assets/tokens.css');
  const [light, dark] = css.split("[data-theme='dark']");
  assert(light !== undefined && dark !== undefined, 'tokens.css must declare a dark theme block');

  for (const token of Object.values(manifest.tokens)) {
    assert(light.includes(token.cssVar), `${token.cssVar} is in tokens.json but not in tokens.css`);
  }
  for (const token of Object.values(manifest.themes.dark)) {
    assert(
      dark.includes(token.cssVar),
      `${token.cssVar} has a dark override in tokens.json but not in tokens.css`,
    );
  }
});

Deno.test('T1 — every token a component uses is declared', async () => {
  const css = await read('./assets/tokens.css');
  const declared = new Set([...css.matchAll(/(--ns-[a-z0-9-]+)\s*:/g)].map((match) => match[1]));
  // Custom properties a component sets or receives at runtime from its own
  // script rather than from the theme. `--ns-floating-*` is the anchor-
  // positioning seam: the floating runtime writes those values inline.
  const runtime = /^--ns-floating-/;

  for (const sheet of await componentStylesheets()) {
    const source = await read(`./assets/${sheet}`);
    for (const match of source.matchAll(/var\((--ns-[a-z0-9-]+)/g)) {
      assert(
        declared.has(match[1]) || runtime.test(match[1]),
        `${sheet} uses ${
          match[1]
        }, which tokens.css does not declare — a typo here renders nothing`,
      );
    }
  }
});

Deno.test('T6 — every component stylesheet is imported by styles.css', async () => {
  const styles = await read('./assets/styles.css');
  for (const sheet of await componentStylesheets()) {
    assert(
      styles.includes(`./${sheet}`),
      `assets/${sheet} is not imported by assets/styles.css — the component is unreachable`,
    );
  }
});

Deno.test('R1 — every component module is exported from the barrel', async () => {
  const barrel = await read('./components/ui/mod.ts');
  for (const name of await componentModules()) {
    const stem = name.replace(/\.tsx$/, '');
    assert(
      barrel.includes(`'./${name}'`),
      `components/ui/${name} is not exported from components/ui/mod.ts — it is invisible`,
    );
    assert(stem.length > 0);
  }
});

Deno.test('R3 — every Ledgerline catalogue entry has a gallery demo', async () => {
  const registry = await read('./routes/(design)/design/(_shared)/registry.ts');
  const gallery = await read('./routes/(design)/design/(_components)/components-view.tsx');

  const catalog = registry.split('ledgerlineCatalog')[1] ?? '';
  const names = [...catalog.matchAll(/^\s{4}name: '([a-z-]+)',$/gm)].map((match) => match[1]);
  assertEquals(names.length > 0, true, 'ledgerlineCatalog must declare entries');

  for (const name of names) {
    assert(
      gallery.includes(`case '${name}':`),
      `${name} is catalogued but has no renderDemo case — unregistered work does not exist`,
    );
  }
});

Deno.test('R3 — the upstream registry count is not inflated by app-owned widgets', async () => {
  const registry = await read('./routes/(design)/design/(_shared)/registry.ts');
  const declared = /total:\s*(\d+),\s*\n\} as const;/.exec(registry.split('registryMeta')[1]);
  assert(declared !== null, 'registryMeta must declare a total');

  const upstream = registry
    .split('export const registryCatalog')[1]
    .split('export const registryCollections')[0];
  const itemCount = [...upstream.matchAll(/^\s{4}name: '/gm)].length;
  assertEquals(
    Number(declared[1]),
    itemCount,
    'registryMeta.total must equal the number of upstream items, not the app-owned ones',
  );
});

Deno.test('H8 — gauge arcs terminate with a flat cut', async () => {
  const gauge = await read('./components/ui/semicircular-gauge.tsx');
  assert(
    gauge.includes("stroke-linecap='butt'"),
    'a gauge arc must declare stroke-linecap="butt"; a round cap bulges past the baseline',
  );
  assert(!gauge.includes("stroke-linecap='round'"), 'a gauge arc must not use a round cap');
});

Deno.test('R8 — no scaffold fiction ships', async () => {
  // Rule 8. The scaffold's cloud/DevOps vocabulary is the fingerprint of a
  // themed starter, and the gallery is the file a reviewer opens first. Every
  // demo string is a real Ledgerline value: an invoice number, a customer, a
  // plan, a money amount, a decline reason.
  const fiction = [
    'api-gateway',
    'eu-west',
    'v2.4.1',
    'NS One',
    'starter scaffold',
    'maintainer scaffold',
    'lorem ipsum',
  ];

  // A denylist only catches what someone already thought to name: this file
  // shipped "No services yet / run netscript service:add" straight through a
  // green R8, because "service" was never on the list. These patterns catch
  // the *shape* of the fiction instead — the scaffold talking about itself in
  // the product's own voice.
  const fictionPatterns: ReadonlyArray<readonly [RegExp, string]> = [
    // The CLI invocation form (`netscript service:add`) is the framework
    // addressing the reader. A billing UI never instructs anyone to run it.
    [/netscript\s+\w+:\w+/, 'a netscript CLI command'],
    [/scaffold your first/i, 'an instruction to scaffold'],
  ];

  for (const file of await appSources()) {
    const source = withoutComments(await read(`./${file}`));
    for (const term of fiction) {
      assert(
        !source.includes(term),
        `${file} ships scaffold fiction ("${term}") — every demo string is a real Ledgerline value`,
      );
    }
    for (const [pattern, what] of fictionPatterns) {
      const hit = source.match(pattern);
      const found = hit?.[0] ?? '';
      assert(
        hit === null,
        `${file} ships scaffold fiction ("${found}" is ${what}) — every demo string is a real Ledgerline value`,
      );
    }
  }
});

Deno.test('R8 — an internal link is not a dead end', async () => {
  // A string-literal href is a promise the router has to keep. `/dashboard`
  // was deleted with the scaffold routes but stayed linked, so the landing
  // page shipped a 404. Only literals are checkable here — the hrefs a page
  // receives as props are resolved by whoever renders it.
  const literal = /href='(\/[^']*)'/g;

  let checked = 0;
  for (const file of await appSources()) {
    const source = await read(`./${file}`);

    for (const match of source.matchAll(literal)) {
      const path = match[1].replace(/\/+$/, '');
      const candidates = path === '' ? ['routes/index.tsx'] : [
        `routes/${path}.tsx`,
        `routes/${path}/index.tsx`,
        ...(path.startsWith('/design/')
          ? [`routes/(design)/design/${path.slice('/design/'.length)}.tsx`]
          : []),
      ];

      const resolved = await Promise.all(
        candidates.map((candidate) =>
          Deno.stat(new URL(`./${candidate}`, APP)).then(() => true).catch(() => false)
        ),
      );
      checked += 1;
      assert(
        resolved.some(Boolean),
        `${file} links ${match[1]}, but no route module resolves for it — a dead link`,
      );
    }
  }

  // Guard against the check going quietly vacuous: a rewrite that moves every
  // href into a prop would leave this test passing while proving nothing.
  assert(checked > 0, 'no internal href literals found — this assertion has stopped testing');
});
