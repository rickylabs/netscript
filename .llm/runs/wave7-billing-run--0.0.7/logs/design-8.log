export interface MoneyFormatOptions {
  /** ISO 4217 code. Omit to render a bare amount (the panel states currency). */
  readonly currency?: string;
  /** BCP-47 locale for grouping and separators. Defaults to `en-US`. */
  readonly locale?: string;
  /** Render an explicit `+` on amounts towards us. Deltas want this; cells do not. */
  readonly signed?: boolean;
  /** Force a fraction-digit count instead of deriving it from the value. */
  readonly precision?: number;
  /** Upper bound for derived precision. Defaults to the domain maximum of 6. */
  readonly maxPrecision?: number;
}

/** The domain's maximum scale: `Decimal(18, 4)` storage, 6 in the wire schema. */
const MAX_PRECISION = 6;

/** Minimum fraction digits for anything that looks like a currency amount. */
const MIN_PRECISION = 2;

/** The wire schema's money shape. Anything else is not a Ledgerline amount. */
const MONEY_PATTERN = /^(-?)(\d+)(?:\.(\d+))?$/;

interface ParsedDecimal {
  readonly negative: boolean;
  readonly int: string;
  readonly frac: string;
}

/**
 * Rounds half-up on the decimal digits, like every other amount. Absent stays
 * the em dash. Charts use this for ticks only — a chart never formats a value
 * it was handed; it receives preformatted labels.
 */
export function formatMoneyCompact(
  value: MoneyValue,
  options: MoneyFormatOptions = {},
): string {
  const parsed = parseDecimal(value);
  if (!parsed) return ABSENT;

  const locale = options.locale ?? 'en-US';
  const mag = `${parsed.int}${parsed.frac}`;
  const whole = Number(mag) / 10 ** parsed.frac.length;
  const scale = whole >= 1_000_000
    ? { shift: 6, suffix: 'M', digits: 1 }
    : whole >= 10_000
    ? { shift: 3, suffix: 'k', digits: 0 }
