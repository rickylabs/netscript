/**
 * @component DeltaChip
 * @layer 2
 * @depends theme-seed
 * @description The one "up or down versus last period" in the product. A
 * tinted pill, a directional glyph, and a signed value rendered beside the
 * number it qualifies — never in the card header, and never a re-styled Badge.
 */

import type { JSX, VNode } from 'preact';
import { cn } from '../../lib/cn.ts';
import { ABSENT } from '../../lib/money.ts';

/** Which way the number moved, or that the comparison could not be made. */
export type DeltaDirection = 'up' | 'down' | 'flat' | 'absent';

/** Glyph set. `arrow` is the default; `none` is what the reference's hero chip uses. */
export type DeltaGlyph = 'arrow' | 'none';

export interface DeltaChipProps
  extends Omit<JSX.HTMLAttributes<HTMLSpanElement>, 'class' | 'children'> {
  /**
   * The delta, already formatted and already signed — `+2.1%`, `-$1,204.00`.
   * The chip never formats a number (H2) and never infers a sign.
   */
  value: string;
  /** Direction of the movement. `absent` renders the em dash in the absent tone. */
  direction?: DeltaDirection;
  /** Draw the directional glyph. Defaults to `arrow`. */
  glyph?: DeltaGlyph;
  /** Quiet trailing context, e.g. `vs last week`. Rendered outside the pill. */
  note?: string;
  class?: string;
}

const GLYPHS: Record<Exclude<DeltaDirection, 'absent'>, string> = {
  up: '\u2191',
  down: '\u2193',
  flat: '\u2192',
};

/**
 * A delta chip: tinted pill, directional glyph, signed value.
 *
 * `absent` is the case that matters most and is easiest to lose: a comparison
 * with no prior period is not a zero movement, it is a movement that does not
 * exist, and it renders the em dash (M1) in the absent tone.
 */
export function DeltaChip({
  value,
  direction = 'flat',
  glyph = 'arrow',
  note,
  class: className,
  ...props
}: DeltaChipProps): VNode {
  const absent = direction === 'absent';

  return (
    <span {...props} class={cn('ns-delta-chip', className)}>
      <span class='ns-delta-chip__pill' data-direction={direction}>
        {!absent && glyph === 'arrow' && (
          <span class='ns-delta-chip__glyph' aria-hidden='true'>
            {GLYPHS[direction]}
          </span>
        )}
        <span class='ns-delta-chip__value'>
          {absent
            ? (
              <>
                <span aria-hidden='true'>{ABSENT}</span>
                <span class='sr-only'>no prior period</span>
              </>
            )
            : value}
        </span>
      </span>
      {note && <span class='ns-delta-chip__note'>{note}</span>}
    </span>
  );
}
===== assets/ui/delta-chip.css =====
/* DeltaChip — one component for every "versus last period" in the product (C3).

   It is a pill sitting *beside* the number it qualifies, optically centred on
   it, not a badge parked in the card header. The tinted background is a
   `color-mix` of the money token so dark mode re-tints without a second rule. */

.ns-delta-chip {
  display: inline-flex;
  align-items: baseline;
  gap: var(--ns-space-2);
  /* Optically centred on a hero number rather than box-centred: the pill rides
     the cap height of the figure next to it. */
  vertical-align: middle;
}

.ns-delta-chip__pill {
  display: inline-flex;
  align-items: center;
  gap: var(--ns-space-1);
  padding: var(--ns-space-0-5) var(--ns-space-2);
  border-radius: var(--ns-radius-full);
  font-family: var(--ns-font-sans);
  font-size: var(--ns-text-xs);
  font-weight: 600;
  line-height: 1.35;
  white-space: nowrap;
  font-variant-numeric: var(--ns-numeric-tabular);
}

.ns-delta-chip__glyph {
  font-size: 0.875em;
  line-height: 1;
}

.ns-delta-chip__note {
  font-size: var(--ns-text-xs);
  color: var(--ns-muted-fg);
  white-space: nowrap;
}

.ns-delta-chip__pill[data-direction='up'] {
  color: var(--ns-money-pos);
  background: color-mix(in srgb, var(--ns-money-pos) 12%, transparent);
}

.ns-delta-chip__pill[data-direction='down'] {
  color: var(--ns-money-neg);
  background: color-mix(in srgb, var(--ns-money-neg) 12%, transparent);
}

.ns-delta-chip__pill[data-direction='flat'] {
  color: var(--ns-money-flat);
  background: color-mix(in srgb, var(--ns-money-flat) 12%, transparent);
}

/* M1 for movements: no prior period is not a 0.0% movement. */
.ns-delta-chip__pill[data-direction='absent'] {
  color: var(--ns-absent);
  background: color-mix(in srgb, var(--ns-absent) 12%, transparent);
}
