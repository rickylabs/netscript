/**
 * @component SemicircularGauge
 * @layer 2
 * @depends theme-seed
 * @description 180° two-tone gauge — the run-progress widget. Hand-authored
 * SVG over the fixed series cycle: a grey unallocated track, then one arc per
 * segment, terminated with flat baseline cuts. Centre carries a quiet label
 * over the hero amount.
 */

import type { JSX, VNode } from 'preact';
import { cn } from '../../lib/cn.ts';

/** Series slot in the fixed `--ns-series-1..6` cycle (H3). */
export type GaugeSeries = 1 | 2 | 3 | 4 | 5 | 6;

/**
 * One arc of the gauge.
 *
 * `value` is geometry only — it is never rendered (H2). The label the reader
 * sees arrives as `display`, already formatted by the caller.
 */
export interface GaugeSegment {
  readonly value: number;
  /** Legend name, e.g. `Issued`. */
  readonly label: string;
  /** Preformatted amount for the legend, e.g. `$842,000.00`. */
  readonly display: string;
  /** Series slot. Defaults to the segment's index in the cycle. */
  readonly series?: GaugeSeries;
}

export interface SemicircularGaugeProps
  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children'> {
  segments: readonly GaugeSegment[];
  /**
   * The denominator — every item the run covers, including the ones no segment
   * accounts for. Omitted means the segments are the whole. `null` means the
   * total was not measured, which renders the empty frame (H7, M1).
   */
  total?: number | null;
  /** Quiet uppercase label above the centre amount, e.g. `ISSUED`. */
  label: string;
  /** The preformatted centre amount. */
  value: string;
  /** Quiet line under the centre amount. */
  caption?: string;
  /** Show the inline dot legend below the rule (C6). Defaults to true. */
  legend?: boolean;
  /** Copy for the labelled empty frame. */
  emptyLabel?: string;
  /** Tighten the centre amount for narrow rails. */
  compact?: boolean;
  class?: string;
}

/** viewBox: the arc is 160 wide and 100 tall, plus room for the 18-wide stroke. */
const VIEW_WIDTH = 200;
const VIEW_HEIGHT = 110;
const RADIUS = 80;
const STROKE = 18;
const CENTRE_X = 100;
const BASELINE_Y = 100;

const ARC = `M ${CENTRE_X - RADIUS} ${BASELINE_Y} A ${RADIUS} ${RADIUS} 0 0 1 ${
  CENTRE_X + RADIUS
} ${BASELINE_Y}`;

/** Dash lengths are declared in `pathLength` units, so they read as percentages. */
const PATH_LENGTH = 100;

/**
 * A 180° two-tone gauge.
 *
 * Terminals are `butt` caps: the arc ends in flat horizontal cuts flush with
 * the baseline, and the junction between two segments is a crisp radial cut —
 * no rounded overhang below the baseline and no bleed across the junction.
 */
export function SemicircularGauge({
  segments,
  total,
  label,
  value,
  caption,
  legend = true,
  emptyLabel = 'Nothing to measure yet',
  compact = false,
  class: className,
  ...props
}: SemicircularGaugeProps): VNode {
  const sum = segments.reduce((acc, segment) => acc + segment.value, 0);
  const denominator = total ?? sum;

  if (!Number.isFinite(denominator) || denominator <= 0 || sum < 0) {
    return (
      <div {...props} class={cn('ns-gauge', 'ns-gauge--empty', className)}>
        <div class='ns-gauge__frame'>
          <p class='ns-gauge__empty'>{emptyLabel}</p>
        </div>
      </div>
    );
  }

  // A segment can never claim more than the whole; the track keeps the rest.
  let cursor = 0;
  const arcs = segments.map((segment, index) => {
    const share = Math.max(0, Math.min(segment.value, denominator)) / denominator;
    const start = cursor;
    cursor = Math.min(cursor + share, 1);
    return {
      key: `${segment.label}-${index}`,
      series: segment.series ?? ((index % 6) + 1) as GaugeSeries,
      length: share * PATH_LENGTH,
      offset: -start * PATH_LENGTH,
    };
  });

  return (
    <div {...props} class={cn('ns-gauge', compact && 'ns-gauge--compact', className)}>
      <div class='ns-gauge__plot'>
        <svg
          class='ns-gauge__svg'
          viewBox={`0 0 ${VIEW_WIDTH} ${VIEW_HEIGHT}`}
          role='img'
          aria-label={`${label} ${value} of ${denominator} run items`}
        >
          <path
            class='ns-gauge__track'
            d={ARC}
            pathLength={PATH_LENGTH}
            fill='none'
            stroke-width={STROKE}
            stroke-linecap='butt'
          />
          {arcs.map((arc) => (
            <path
              key={arc.key}
              class='ns-gauge__seg'
              data-series={arc.series}
              d={ARC}
              pathLength={PATH_LENGTH}
              fill='none'
              stroke-width={STROKE}
              stroke-linecap='butt'
              stroke-dasharray={`${arc.length} ${PATH_LENGTH - arc.length}`}
              stroke-dashoffset={arc.offset}
            />
          ))}
        </svg>
        <div class='ns-gauge__center'>
          <span class='ns-gauge__label'>{label}</span>
          <span class='ns-gauge__value'>{value}</span>
          {caption && <span class='ns-gauge__caption'>{caption}</span>}
        </div>
      </div>

      {
        /* The baseline rule is part of the graphic: it separates the arc from
          whatever the card puts beneath it. */
      }
      <span class='ns-gauge__rule' aria-hidden='true' />

      {legend && (
        <ul class='ns-gauge__legend'>
          {segments.map((segment, index) => (
            <li key={`${segment.label}-${index}`} class='ns-gauge__legend-row'>
              <span
                class='ns-gauge__dot'
                data-series={segment.series ?? ((index % 6) + 1) as GaugeSeries}
                aria-hidden='true'
              />
              <span class='ns-gauge__legend-label'>{segment.label}</span>
              <span class='ns-gauge__legend-value'>{segment.display}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  );
}
