=== RangeControlDemo ===
/**
 * @component RangeControlDemo
 * @layer 3
 * @depends theme-seed, widget-card, segmented-control, comparison-area-chart
 * @description The gallery proof that the widget vocabulary composes: a
 * segmented range control driving an area chart, a hero amount, its delta chip
 * and a hairline footer, all inside one five-band widget card.
 *
 * The only thing this island owns is the selected range. The data arrives as
 * props (I2) and the selection is local state, never a query key (D5) —
 * switching range re-projects data already on the page.
 */

import { useState } from 'preact/hooks';
import type { VNode } from 'preact';
import {
  AREA_CHART_TICK_RATIOS,
  areaChartMax,
  type AreaChartPoint,
  Button,
  ComparisonAreaChart,
  DeltaChip,
  type DeltaDirection,
  FooterColumns,
  MoneyText,
  SegmentedControl,
  WidgetCard,
} from '@app/components/ui/mod.ts';
import { formatMoneyCompact } from '@app/lib/money.ts';

/** One point of a demo series: geometry plus the preformatted readout (H2). */
export interface RangeDemoPoint {
  readonly value: number;
  readonly label: string;
  readonly display: string;
}

/** One range the control can select. */
export interface RangeDemo {
  readonly value: string;
  readonly label: string;
  /** Collected cash for the range, as a string-encoded decimal. */
  readonly collected: string;
  readonly billed: string;
  readonly outstanding: string;
  readonly deltaLabel: string;
  readonly deltaDirection: DeltaDirection;
  readonly deltaNote: string;
  readonly points: readonly RangeDemoPoint[];
  readonly comparison: readonly RangeDemoPoint[];
}

export interface RangeControlDemoProps {
  readonly ranges: readonly RangeDemo[];
  /** Range selected on first paint. Defaults to the first. */
  readonly initial?: string;
}

/**
 * Builds the tick labels for a range from the same maximum the chart scales to.
 *
 * The topmost tick carries the currency; the rest are bare magnitudes (H6, M7).
 */
function ticksFor(
  points: readonly AreaChartPoint[],
  comparison: readonly AreaChartPoint[],
): readonly string[] {
  const max = areaChartMax([
    ...points.map((point) => point.value),
    ...comparison.map((point) => point.value),
  ]);
  return AREA_CHART_TICK_RATIOS.map((ratio, index) =>
    formatMoneyCompact(String(max * ratio), index === 0 ? { currency: 'USD' } : {})
  );
}

/**
 * A composed billing widget with a working period selector.
 */
export function RangeControlDemo({ ranges, initial }: RangeControlDemoProps): VNode | null {
  const [active, setActive] = useState(initial ?? ranges[0]?.value ?? '1M');
  const range = ranges.find((candidate) => candidate.value === active) ?? ranges[0];

  if (!range) return null;

  const points: readonly AreaChartPoint[] = range.points;
  const comparison: readonly AreaChartPoint[] = range.comparison;

  return (
    <WidgetCard class='ns-gallery-widget'>
      <WidgetCard.Header>
        <WidgetCard.Title>Collected cash</WidgetCard.Title>
        <WidgetCard.Action>
          <Button variant='pill' size='sm'>Report</Button>
        </WidgetCard.Action>
      </WidgetCard.Header>

      <WidgetCard.Range>
        <SegmentedControl
          label='Collection period'
          options={ranges.map((candidate) => ({
            value: candidate.value,
            label: candidate.label,
          }))}
          value={range.value}
          onSelect={setActive}
        />
      </WidgetCard.Range>

      <WidgetCard.Hero>
        <MoneyText value={range.collected} currency='USD' size='hero' />
        <DeltaChip
          value={range.deltaLabel}
          direction={range.deltaDirection}
          note={range.deltaNote}
        />
      </WidgetCard.Hero>

      <WidgetCard.Body>
        <ComparisonAreaChart
          points={points}
          comparison={comparison}
          seriesLabel='Collected'
          comparisonLabel='Billed'
          ticks={ticksFor(points, comparison)}
          emptyLabel='No collections recorded in this period'
        />
      </WidgetCard.Body>

      <WidgetCard.Footer>
        <FooterColumns
          columns={[
            { label: 'Billed', value: formatMoneyCompact(range.billed, { currency: 'USD' }) },
            {
              label: 'Collected',
              value: formatMoneyCompact(range.collected, { currency: 'USD' }),
              direction: 'in',
            },
            {
              label: 'Outstanding',
              value: formatMoneyCompact(range.outstanding, { currency: 'USD' }),
              direction: 'out',
            },
          ]}
        />
      </WidgetCard.Footer>
    </WidgetCard>
  );
}

export default RangeControlDemo;
=== collection-ranges ===
/**
 * Gallery fixtures for the composed collection widget.
 *
 * Every figure here is a real Ledgerline value — the twelve months of the
 * 2025-08 through 2026-07 fiscal year for one billing book. The four ranges are
 * projections of the same twelve months, not four invented datasets: the last
 * month of the year is also the `1M` range, the last three are the `3M` range,
 * and so on. A widget whose ranges disagree with each other is a widget that
 * cannot be believed, so the fixtures are derived rather than typed by hand.
 */

import { formatMoneyCompact, moneyParts } from '@app/lib/money.ts';
import { AREA_CHART_TICK_RATIOS, areaChartMax } from '@app/components/ui/mod.ts';
import type { RangeDemo, RangeDemoPoint } from '@app/islands/ui/RangeControlDemo.tsx';

/** The domain's maximum scale, matching `MoneySchemaV1`. */
const SCALE = 6;
const SCALE_FACTOR = 10n ** BigInt(SCALE);

/** Month labels for the fiscal year, oldest first. */
const MONTHS = [
  'AUG',
  'SEP',
  'OCT',
  'NOV',
  'DEC',
  'JAN',
  'FEB',
  'MAR',
  'APR',
  'MAY',
  'JUN',
  'JUL',
] as const;

/** Week labels inside the closing month. */
const WEEKS = ['10 JUL', '17 JUL', '24 JUL', '31 JUL'] as const;

/** Collected cash by month, as string-encoded decimals (never floats). */
const COLLECTED_BY_MONTH = [
  '498000',
  '512000',
  '534500',
  '561200',
  '583900',
  '604000',
  '612000',
  '647500',
  '672800',
  '704250.50',
  '742800',
  '778900',
] as const;

/** Amounts invoiced by month. Never below the cash collected against them. */
const BILLED_BY_MONTH = [
  '540000',
  '556000',
  '578000',
  '602000',
  '631000',
  '655000',
  '668000',
  '702000',
  '731000',
  '766000',
  '804000',
  '842500',
] as const;

/** The closing month, broken into the weeks the `1M` range plots. */
const COLLECTED_BY_WEEK = ['164200', '178450.50', '192300', '243949.50'] as const;
const BILLED_BY_WEEK = ['178000', '196000', '214000', '254500'] as const;

/** A point's readout: the currency symbol and the grouped amount, together. */
function money(value: string): string {
  const parts = moneyParts(value, { currency: 'USD' });
  return `${parts.currency ?? ''}${parts.text}`;
}

/**
 * Exact decimal-string arithmetic on BigInt scaled by the domain's six places.
 *
 * M2 binds here too: fixtures are still money, and a fixture that drifts by a
 * cent produces a demo whose footer does not add up.
 */
function toScaled(value: string): bigint {
  const [int = '0', frac = ''] = value.trim().split('.');
  const padded = frac.padEnd(SCALE, '0').slice(0, SCALE);
  const negative = int.startsWith('-');
  const digits = BigInt(int || '0') * SCALE_FACTOR + BigInt(padded || '0');
  return negative ? -digits : digits;
}

function fromScaled(value: bigint): string {
  const negative = value < 0n;
  const abs = negative ? -value : value;
  const int = abs / SCALE_FACTOR;
  const frac = (abs % SCALE_FACTOR).toString().padStart(SCALE, '0');
  return `${negative ? '-' : ''}${int}.${frac}`;
}

/** Sums string-encoded decimals exactly. */
function sum(values: readonly string[]): string {
  return fromScaled(values.reduce((total, value) => total + toScaled(value), 0n));
}

/** Decimal-string subtraction. */
function subtract(left: string, right: string): string {
  return fromScaled(toScaled(left) - toScaled(right));
}

/**
 * Tick labels for a chart, built from the maximum the chart will actually scale
 * to. Hardcoding them is how a tick ends up disagreeing with its own gridline;
 * the topmost tick carries the currency and the rest are bare magnitudes (H6).
 */
export function compactTicks(...series: readonly (readonly number[])[]): readonly string[] {
  const max = areaChartMax(series.flat());
  return AREA_CHART_TICK_RATIOS.map((ratio, index) =>
    // The baseline is zero, not "0.00": a compact axis tick is a magnitude.
    ratio === 0
      ? '0'
      : formatMoneyCompact(String(max * ratio), index === 0 ? { currency: 'USD' } : {})
  );
}

function pointsFrom(
  labels: readonly string[],
  values: readonly string[],
): readonly RangeDemoPoint[] {
  return values.map((value, index) => ({
    value: Number.parseFloat(value),
    label: labels[index] ?? `Point ${index + 1}`,
    display: money(value),
  }));
}

/** The last `count` entries of a series. */
function tail<T>(values: readonly T[], count: number): readonly T[] {
  return values.slice(Math.max(0, values.length - count));
}

const YEAR_COLLECTED = sum(COLLECTED_BY_MONTH);
const YEAR_BILLED = sum(BILLED_BY_MONTH);

const SIX_COLLECTED = sum(tail(COLLECTED_BY_MONTH, 6));
const SIX_BILLED = sum(tail(BILLED_BY_MONTH, 6));

const QUARTER_COLLECTED = sum(tail(COLLECTED_BY_MONTH, 3));
const QUARTER_BILLED = sum(tail(BILLED_BY_MONTH, 3));

const MONTH_COLLECTED = sum(COLLECTED_BY_WEEK);
const MONTH_BILLED = sum(BILLED_BY_WEEK);

/**
 * The four ranges the demo control selects between.
 */
export const COLLECTION_RANGES: readonly RangeDemo[] = [
  {
    value: '1M',
    label: '1M',
    collected: MONTH_COLLECTED,
    billed: MONTH_BILLED,
    outstanding: subtract(MONTH_BILLED, MONTH_COLLECTED),
    deltaLabel: '+6.4%',
    deltaDirection: 'up',
    deltaNote: 'vs June',
    points: pointsFrom(WEEKS, COLLECTED_BY_WEEK),
    comparison: pointsFrom(WEEKS, BILLED_BY_WEEK),
  },
  {
    value: '3M',
    label: '3M',
    collected: QUARTER_COLLECTED,
    billed: QUARTER_BILLED,
    outstanding: subtract(QUARTER_BILLED, QUARTER_COLLECTED),
    deltaLabel: '+9.1%',
    deltaDirection: 'up',
    deltaNote: 'vs prior quarter',
    points: pointsFrom(tail(MONTHS, 3), tail(COLLECTED_BY_MONTH, 3)),
    comparison: pointsFrom(tail(MONTHS, 3), tail(BILLED_BY_MONTH, 3)),
  },
  {
    value: '6M',
    label: '6M',
    collected: SIX_COLLECTED,
    billed: SIX_BILLED,
    outstanding: subtract(SIX_BILLED, SIX_COLLECTED),
    deltaLabel: '+12.7%',
    deltaDirection: 'up',
    deltaNote: 'vs prior 6 months',
    points: pointsFrom(tail(MONTHS, 6), tail(COLLECTED_BY_MONTH, 6)),
    comparison: pointsFrom(tail(MONTHS, 6), tail(BILLED_BY_MONTH, 6)),
  },
  {
    value: '1Y',
    label: '1Y',
    collected: YEAR_COLLECTED,
    billed: YEAR_BILLED,
    outstanding: subtract(YEAR_BILLED, YEAR_COLLECTED),
    deltaLabel: '+21.3%',
    deltaDirection: 'up',
    deltaNote: 'vs prior year',
    points: pointsFrom(MONTHS, COLLECTED_BY_MONTH),
    comparison: pointsFrom(MONTHS, BILLED_BY_MONTH),
  },
];
