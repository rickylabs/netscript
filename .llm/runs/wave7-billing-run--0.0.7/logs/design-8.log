/**
 * @component ComparisonAreaChart
 * @layer 2
 * @depends theme-seed
 * @description Two-layer area chart — billed versus collected. The current
 * period is a stroked area; the comparison period is the same geometry at
 * reduced opacity underneath it (H5), never a second axis. Hand-authored SVG
 * over the series cycle, with a CSS-only crosshair readout (H4).
 */

import type { JSX, VNode } from 'preact';
import { useId } from 'preact/hooks';
import { cn } from '../../lib/cn.ts';

/** Series slot in the fixed `--ns-series-1..6` cycle (H3). */
export type AreaSeries = 1 | 2 | 3 | 4 | 5 | 6;

/**
 * One plotted point.
 *
 * `value` is geometry and is never rendered; `display` is the preformatted
 * string the readout shows (H2). The chart never formats a number.
 */
export interface AreaChartPoint {
  readonly value: number;
  /** Point name for the readout and, by default, the x-axis. */
  readonly label: string;
  /** Preformatted value for the readout. */
  readonly display: string;
}

export interface ComparisonAreaChartProps
  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children'> {
  points: readonly AreaChartPoint[];
  /** The comparison period. Same geometry, translucent, no stroke. */
  comparison?: readonly AreaChartPoint[] | null;
  /** Name for the comparison layer, e.g. `Previous period`. */
  comparisonLabel?: string;
  /** Name for the current layer, e.g. `This period`. */
  seriesLabel?: string;
  /**
   * Y-axis ticks, topmost first and preformatted, spread evenly from the top
   * gridline to the baseline. The topmost carries the currency (H6); the rest
   * are bare magnitudes. Omit for a chrome-free chart.
   */
  ticks?: readonly string[];
  /** X-axis labels. Defaults to each point's `label`. */
  xLabels?: readonly string[];
  /** Series slot for the current period. Defaults to 1. */
  series?: AreaSeries;
  /** Copy for the labelled empty frame. */
  emptyLabel?: string;
  class?: string;
}

/** viewBox units. The frame is drawn in CSS, so the plot can bleed to the edge. */
const VB_WIDTH = 320;
const VB_HEIGHT = 120;
/** Headroom inside the plot so a peak stroke never clips the frame. */
const VB_TOP = 10;
const VB_BASELINE = 120;
/** Horizontal inset so an end-point marker stays inside the frame. */
const VB_INSET = 6;
const GRID_LINES = 4;

const PLOT_HEIGHT = VB_BASELINE - VB_TOP;

/** Axis steps worth landing on. Denser than 1/2/5 so a peak keeps headroom. */
const NICE_STEPS = [1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 9, 10] as const;

/**
 * The axis maximum a chart will scale to for these values.
 *
 * Exported because a caller has to build its own tick labels from the same
 * number the gridlines sit on — a tick that disagrees with its gridline is a
 * lie about the scale — while still doing all the formatting itself (H2).
 */
export function areaChartMax(values: readonly number[]): number {
  const value = Math.max(0, ...values);
  if (!Number.isFinite(value) || value <= 0) return 1;
  const pow = 10 ** Math.floor(Math.log10(value));
  const n = value / pow;
  const nice = NICE_STEPS.find((step) => n <= step) ?? 10;
  return nice * pow;
}

/** Where the gridlines sit, as a fraction of the axis maximum, topmost first. */
export const AREA_CHART_TICK_RATIOS: readonly number[] = [1, 0.75, 0.5, 0.25, 0];

function niceMax(value: number): number {
  return areaChartMax([value]);
}

/** x in viewBox units for point `index` of `count`. */
function xAt(index: number, count: number): number {
  const span = VB_WIDTH - VB_INSET * 2;
  return VB_INSET + (count > 1 ? (span / (count - 1)) * index : span / 2);
}

/** y in viewBox units for a value, clamped to the plot. */
function yAt(value: number, max: number): number {
  const ratio = max > 0 ? Math.max(0, Math.min(value, max)) / max : 0;
  return VB_BASELINE - ratio * PLOT_HEIGHT;
}

/** Position as a percentage of the drawn chart box, for CSS-positioned overlays. */
function percentX(index: number, count: number): number {
  return (xAt(index, count) / VB_WIDTH) * 100;
}

/** Width of one hover column, so adjacent columns tile the plot exactly. */
function percentStep(count: number): number {
  if (count <= 1) return 100;
  return ((VB_WIDTH - VB_INSET * 2) / (count - 1) / VB_WIDTH) * 100;
}

function percentY(value: number, max: number): number {
  return (yAt(value, max) / VB_HEIGHT) * 100;
}

/**
 * Builds an area path for a series.
 *
 * Control points sit one third of the span either side of each vertex at the
 * vertex's own y, so every join has a horizontal tangent: the curve is smooth
 * but can never overshoot into a value the data does not contain.
 */
function areaPath(values: readonly number[], max: number, close: boolean): string {
  if (values.length === 0) return '';

  const coords = values.map((value, index) => ({
    x: xAt(index, values.length),
    y: yAt(value, max),
  }));

  let d = `M ${coords[0].x} ${coords[0].y}`;
  for (let i = 1; i < coords.length; i += 1) {
    const from = coords[i - 1];
    const to = coords[i];
    const handle = (to.x - from.x) / 3;
    d += ` C ${from.x + handle} ${from.y} ${to.x - handle} ${to.y} ${to.x} ${to.y}`;
  }

  if (!close) return d;

  const last = coords[coords.length - 1];
  return `${d} L ${last.x} ${VB_BASELINE} L ${coords[0].x} ${VB_BASELINE} Z`;
}

/**
 * A two-layer area chart with a CSS-only hover readout.
 *
 * The comparison layer is the prior period at reduced opacity — same hue, same
 * geometry, no second axis, no second stroke. Because the hue is shared,
 * "which line is this?" is answered by the legend, not by colour.
 */
export function ComparisonAreaChart({
  points,
  comparison,
  comparisonLabel = 'Previous period',
  seriesLabel = 'This period',
  ticks,
  xLabels,
  series = 1,
  emptyLabel = 'Nothing recorded in this period',
  class: className,
  ...props
}: ComparisonAreaChartProps): VNode {
  const gradientId = useId();
  const hasComparison = (comparison?.length ?? 0) > 1;

  if (points.length === 0) {
    return (
      <div {...props} class={cn('ns-areachart', className)}>
        <div class='ns-areachart__frame ns-areachart__frame--empty'>
          <p class='ns-areachart__empty'>{emptyLabel}</p>
        </div>
      </div>
    );
  }

  const max = niceMax(
    Math.max(
      0,
      ...points.map((point) => point.value),
      ...(comparison ?? []).map((point) => point.value),
    ),
  );
  const values = points.map((point) => point.value);
  const comparisonValues = hasComparison ? comparison!.map((point) => point.value) : null;
  const labels = xLabels ?? points.map((point) => point.label);

  return (
    <div {...props} class={cn('ns-areachart', className)}>
      {ticks && ticks.length > 0 && (
        <ul class='ns-areachart__yaxis' aria-hidden='true'>
          {ticks.map((tick, index) => (
            <li
              class='ns-areachart__ytick'
              style={{
                top: `${percentY(max * (1 - index / (ticks.length - 1 || 1)), max)}%`,
              }}
            >
              {tick}
            </li>
          ))}
        </ul>
      )}

      <div class='ns-areachart__frame'>
        <svg
          class='ns-areachart__svg'
          viewBox={`0 0 ${VB_WIDTH} ${VB_HEIGHT}`}
          role='img'
          aria-label={`${seriesLabel} against ${comparisonLabel}, ${points.length} periods`}
        >
          <defs>
            <linearGradient id={gradientId} x1='0' y1='0' x2='0' y2='1'>
              <stop class='ns-areachart__stop-top' data-series={series} offset='0%' />
              <stop class='ns-areachart__stop-bottom' data-series={series} offset='100%' />
            </linearGradient>
          </defs>

          <g class='ns-areachart__grid' aria-hidden='true'>
            {Array.from({ length: GRID_LINES }, (_, i) => {
              const y = yAt(max * ((GRID_LINES - i) / GRID_LINES), max);
              return (
                <line
                  key={i}
                  class='ns-areachart__gridline'
                  x1={VB_INSET}
                  y1={y}
                  x2={VB_WIDTH - VB_INSET}
                  y2={y}
                />
              );
            })}
            <line
              class='ns-areachart__baseline'
              x1='0'
              y1={VB_BASELINE}
              x2={VB_WIDTH}
              y2={VB_BASELINE}
            />
          </g>

          {comparisonValues && (
            <path
              class='ns-areachart__comparison'
              data-series={series}
              d={areaPath(comparisonValues, max, true)}
            />
          )}

          <path
            class='ns-areachart__area'
            data-series={series}
            d={areaPath(values, max, true)}
            fill={`url(#${gradientId})`}
          />
          <path
            class='ns-areachart__line'
            data-series={series}
            d={areaPath(values, max, false)}
            fill='none'
          />
        </svg>

        {
          /* The readout is a hover layer over the geometry, not part of it:
            crosshair, point marker and tooltip reveal on :hover with no script
            and no first-paint mismatch (H4). */
        }
        <div class='ns-areachart__hits' aria-hidden='true'>
          {points.map((point, index) => (
            <span
              key={point.label}
              class='ns-areachart__hit'
              style={{
                left: `${percentX(index, points.length)}%`,
                width: `${percentStep(points.length)}%`,
                '--hit-dot': `${percentY(point.value, max)}%`,
              } as JSX.CSSProperties}
            >
              <span class='ns-areachart__crosshair' />
              <span class='ns-areachart__dot' data-series={series} />
              <span class='ns-areachart__tip'>
                <span class='ns-areachart__tip-label'>{point.label}</span>
                <span class='ns-areachart__tip-value'>{point.display}</span>
              </span>
            </span>
          ))}
        </div>
      </div>

      <ul class='ns-areachart__xaxis' aria-hidden='true'>
        {labels.map((label, index) => (
          <li
            class='ns-areachart__xtick'
            style={{ left: `${percentX(index, labels.length)}%` }}
          >
            {label}
          </li>
        ))}
      </ul>

      {hasComparison && (
        <ul class='ns-areachart__legend'>
          <li class='ns-areachart__legend-row'>
            <span class='ns-areachart__swatch' data-series={series} aria-hidden='true' />
            {seriesLabel}
          </li>
          <li class='ns-areachart__legend-row'>
            <span
              class='ns-areachart__swatch ns-areachart__swatch--ghost'
              data-series={series}
              aria-hidden='true'
            />
            {comparisonLabel}
          </li>
        </ul>
      )}

      {
        /* The readout is pointer-only by construction (H4), so the same facts
          are available to a screen reader as text. */
      }
      <ul class='sr-only'>
        {points.map((point) => <li key={point.label}>{point.label}: {point.display}</li>)}
      </ul>
    </div>
  );
}
