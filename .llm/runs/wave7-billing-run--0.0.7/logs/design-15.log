Deno.test('a ratio with no supportable denominator is null, not zero', () => {
  assertEquals(ratio('50', '0'), null);
  assertEquals(ratio('50', null), null);
  assertEquals(ratio(null, '100'), null);
  assertEquals(ratio('50', '100'), 0.5);
});

Deno.test('percentages render an em dash for an undefined rate', () => {
  assertEquals(formatPercent(null), ABSENT);
  assertEquals(formatPercent(ratio('50', '0')), ABSENT);
  assertEquals(formatPercent(0.942), '94.2%');
  assertEquals(formatPercent(0.5, { signed: true }), '+50.0%');
});

Deno.test('compact money keeps the sign and degrades to the em dash', () => {
  // One decimal below 10k, none from 10k up, one again in millions.
  assertEquals(formatMoneyCompact('1240', { currency: 'USD' }), '$1.2k');
  assertEquals(formatMoneyCompact('12400', { currency: 'USD' }), '$12k');
  assertEquals(formatMoneyCompact('2400000', { currency: 'USD' }), '$2.4M');
  // Sub-thousand amounts stay whole — compact is for ticks, not for cells.
  assertEquals(formatMoneyCompact('940', { currency: 'USD' }), '$940.00');
  assertEquals(formatMoneyCompact('-12400', { currency: 'USD' }), '-$12k');
  assertEquals(formatMoneyCompact('0', { currency: 'USD' }), '$0.00');
  assertEquals(formatMoneyCompact(null), ABSENT);
});

