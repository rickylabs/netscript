import re
src = open('assets/tokens.css').read()
light, dark = src.split("[data-theme='dark']")

def oklch_rgb(L,C,H):
    L=L/100.0; C=C
    h=H*3.141592653589793/180.0
    a=C*__import__('math').cos(h); b=C*__import__('math').sin(h)
    l_=L+0.3963377774*a+0.2158037573*b
    m_=L-0.1055613458*a-0.0638541728*b
    s_=L-0.0894841775*a-1.2914855480*b
    l=l_**3; m=m_**3; s=s_**3
    r= 4.0767416621*l -3.3077115913*m +0.2309699292*s
    g=-1.2684380046*l +2.6097574011*m -0.3413193965*s
    bl=-0.0041960863*l -0.7034186147*m +1.7076147010*s
    def f(x):
        x=max(0.0,min(1.0,x))
        return 12.92*x if x<=0.0031308 else 1.055*(x**(1/2.4))-0.055
    return (f(r),f(g),f(bl))

def lum(rgb):
    def ch(c): return c/12.92 if c<=0.03928 else ((c+0.055)/1.055)**2.4
    r,g,b=[ch(c) for c in rgb]
    return 0.2126*r+0.7152*g+0.0722*b

def contrast(a,b):
    la,lb=lum(a),lum(b)
    hi,lo=max(la,lb),min(la,lb)
    return (hi+0.05)/(lo+0.05)

def resolve(var, block):
    seen=0
    while True:
        m=re.search(r'--ns-'+re.escape(var)+r':\s*([^;]+);', block)
        if not m: return None
        v=m.group(1).strip()
        mv=re.fullmatch(r'var\(--ns-([a-z0-9-]+)\)', v)
        if mv: var=mv.group(1); seen+=1
        else: return v
        if seen>10: return None

def color(v, block):
    if v is None: return None
    if v.startswith('#'):
        h=v[1:]
        return tuple(int(h[i:i+2],16)/255 for i in (0,2,4))
    m=re.fullmatch(r'oklch\(([\d.]+)%\s+([\d.]+)\s+([\d.]+)\)', v)
    if m: return oklch_rgb(float(m.group(1)),float(m.group(2)),float(m.group(3)))
    m=re.fullmatch(r'rgba\((\d+),\s*(\d+),\s*(\d+),\s*([\d.]+)\)', v)
    if m:
        rgb=(int(m.group(1))/255,int(m.group(2))/255,int(m.group(3))/255)
        a=float(m.group(4))
        return tuple(c*a for c in rgb)
    return None

for label, block, grounds in (("LIGHT", light, ['paper-1','card']), ("DARK", dark, ['paper-1','card'])):
    print(f"--- {label} ---")
    grounds_c={g: color(resolve(g,block),block) for g in grounds}
    for tok in ['fg','muted-fg','absent','money-pos','money-neg','money-flat','series-1','series-2']:
        c=color(resolve(tok,block),block)
        if c is None: print(f"  {tok:11} unresolved"); continue
        for g,gc in grounds_c.items():
            print(f"  {tok:11} on {g:8} {contrast(c,gc):5.2f}:1")
