+  const css = await read('./assets/tokens.css');
+  const [root, darkBlock] = css.split("[data-theme='dark']");
+  assert(root !== undefined && darkBlock !== undefined);
+
+  /** Resolves a `var(--ns-x)` chain within one block, falling back to `:root`. */
+  function resolve(name: string, block: string): string {
+    let current = name;
+    for (let hop = 0; hop < 8; hop += 1) {
+      const declared = new RegExp(`--ns-${current}:\\s*([^;]+);`).exec(block) ??
+        new RegExp(`--ns-${current}:\\s*([^;]+);`).exec(root);
+      assert(declared !== null, `--ns-${current} is not declared in tokens.css`);
+      const value = declared[1].trim();
+      const reference = /^var\(--ns-([a-z0-9-]+)\)$/.exec(value);
+      if (!reference) return value;
+      current = reference[1];
+    }
+    throw new Error(`--ns-${name} resolves in a cycle`);
+  }
