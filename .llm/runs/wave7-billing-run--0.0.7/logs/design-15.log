+    // absence stands in for an amount, so it must never out-shout a real one.
+    assert(
+      absent < money,
+      `--ns-absent (${absent.toFixed(2)}:1) is louder than --ns-money-pos (${
+        money.toFixed(2)
+      }:1) in ${name} — absence is quieter than the value it replaces`,
+    );
+  }
+});
