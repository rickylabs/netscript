    if v is None: return None
    if v.startswith('#'):
        h=v[1:]; return tuple(int(h[i:i+2],16)/255 for i in (0,2,4))
    m=re.fullmatch(r'oklch\(([\d.]+)%\s+([\d.]+)\s+([\d.]+)\)',v)
