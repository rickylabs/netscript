import math
def oklch_rgb(L,C,H):
    L/=100.0; h=math.radians(H)
    a=C*math.cos(h); b=C*math.sin(h)
    l_=L+0.3963377774*a+0.2158037573*b
    m_=L-0.1055613458*a-0.0638541728*b
    s_=L-0.0894841775*a-1.2914855480*b
    l,m,s=l_**3,m_**3,s_**3
    r= 4.0767416621*l -3.3077115913*m +0.2309699292*s
    g=-1.2684380046*l +2.6097574011*m -0.3413193965*s
    bl=-0.0041960863*l -0.7034186147*m +1.7076147010*s
    f=lambda x:(12.92*x if x<=0.0031308 else 1.055*(x**(1/2.4))-0.055)
    return tuple(f(max(0,min(1,c))) for c in (r,g,bl))
def lum(c):
    ch=lambda x: x/12.92 if x<=0.04045 else ((x+0.055)/1.055)**2.4
    r,g,b=[ch(x) for x in c]; return 0.2126*r+0.7152*g+0.0722*b
def ct(a,b):
    la,lb=lum(a),lum(b); hi,lo=max(la,lb),min(la,lb); return (hi+0.05)/(lo+0.05)
