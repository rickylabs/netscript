src=open('assets/tokens.css').read(); light,dark=src.split("[data-theme='dark']")
def val(name, block, root):
    m=re.search(r'--ns-'+re.escape(name)+r':\s*([^;]+);', block)
    return m.group(1).strip() if m else None
def resolve(v, block, root):
    for _ in range(8):
        m=re.fullmatch(r'var\(--ns-([a-z0-9-]+)\)', v.strip())
        if not m: return v
        nxt = val(m.group(1), block, root) or val(m.group(1), root, root)
        if nxt is None: return None
        v=nxt
    return v
