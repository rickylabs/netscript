import { Badge, Button, Card, PageHeader, StatsGrid } from '@app/components/ui/mod.ts';

interface RouteCard {
  readonly title: string;
  readonly href: string;
  readonly description: string;
  readonly cta: string;
  readonly badge: string;
}

interface HomeViewProps {
  readonly projectName: string;
  readonly appName: string;
  readonly designHref: string;
  readonly compositionHref: string;
  readonly routesHref: string;
  readonly routes: readonly RouteCard[];
}

export default function HomeView(
  { projectName, appName, designHref, compositionHref, routes, routesHref }: HomeViewProps,
) {
  return (
    <main class='ns-shell ns-section ns-stack ns-stack--lg'>
      <PageHeader>
        <PageHeader.Main>
          <PageHeader.Badges>
            <Badge variant='primary'>Fresh app</Badge>
            <Badge variant='muted'>{appName}</Badge>
          </PageHeader.Badges>
          <PageHeader.Intro>
            <h1>{projectName}</h1>
            <p class='ns-lede'>
Billing runs you can inspect, pause and resume. Every number settles or stays
              provisional — the console makes the month defensible.
            </p>
          </PageHeader.Intro>
          <PageHeader.Actions>
            <Button type='link' href={routesHref}>Open the run console</Button>
            <Button type='link' href={designHref} variant='outline'>
              Browse design
            </Button>
            <Button type='link' href={compositionHref} variant='ghost'>
              Composition guide
            </Button>
          </PageHeader.Actions>
        </PageHeader.Main>
      </PageHeader>

      <StatsGrid>
        {
          /* The route count is derived, never hardcoded: a literal here went
            stale the moment the scaffold routes were deleted. */
        }
        <StatsGrid.Card
          label='Run lifecycle'
          value='draft → issued'
          detail='Compute, decide per item, then issue — with compensation on failure'
        />
        <StatsGrid.Card
          label='UI source'
          value='app-owned'
          detail='Installed from @netscript/fresh-ui registry'
        />
        <StatsGrid.Card
          label='Theme'
          value='paper & ink'
          detail='Hand-maintained token source (see RECORD.md)'
        />
        <StatsGrid.Card
          label='Money rule'
          value='em dash, never 0.00'
          detail='Absence is not zero in a ledger'
        />
      </StatsGrid>

      <div class='ns-grid ns-grid--3'>
        {routes.map((route) => (
          <Card key={route.href}>
            <Card.Header>
              <div class='ns-cluster ns-cluster--between'>
                <Card.Title>{route.title}</Card.Title>
                <Badge variant='secondary'>{route.badge}</Badge>
              </div>
              <Card.Description>{route.description}</Card.Description>
            </Card.Header>
            <Card.Footer>
              <Button type='link' href={route.href} variant='outline'>{route.cta}</Button>
            </Card.Footer>
          </Card>
        ))}
      </div>
    </main>
  );
}
