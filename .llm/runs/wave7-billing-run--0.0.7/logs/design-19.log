/**
 * Invoice list — `/invoices`.
 *
 * Typed search (status filter + pagination) through the pagination contract;
 * the read is a server resource calling the billing client's `invoices.list`
 * action directly (the billing contract is nested, so query factories don't
 * apply). Failures render as data — never a thrown 500.
 */

import { paginationSearchSchema } from '@netscript/fresh/route';
import { z } from 'zod';
import { definePage } from '@app/utils.ts';
import { billingClient } from '@app/lib/billing.ts';
import { readService } from '@app/lib/service-auth.ts';
import InvoiceList, { InvoiceListSkeleton } from './(_components)/invoice-list.tsx';
import { routePatterns } from '@app/.generated/manifest.ts';

const INVOICE_STATUSES = ['DRAFT', 'OPEN', 'PAID', 'VOID', 'UNCOLLECTIBLE'] as const;

const INVOICES_SEARCH_SCHEMA = paginationSearchSchema({
  defaultSort: 'issuedAt',
  defaultOrder: 'desc',
}).extend({
  status: z.enum(INVOICE_STATUSES).optional().catch(undefined),
});

export const invoicesIndexPage = definePage()
  .withRouteContract({ $route: routePatterns.invoices.$route, searchSchema: INVOICES_SEARCH_SCHEMA })
  .withMeta(() => ({
    title: 'Invoices — ledgerline',
    description: 'Invoice ledger: issued, paid, and void invoices.',
  }))
  .withResource('invoices', async (ctx) => {
    const result = await readService(() =>
      billingClient.invoices.list({
        limit: Math.min(ctx.search.limit, 100),
        offset: ctx.search.offset,
        status: ctx.search.status,
      })
    );
    return result.ok
      ? { items: result.data.items, total: result.data.total, unavailable: false, denied: false }
      : { items: [], total: 0, unavailable: true, denied: result.denied };
  })
  .withLayer('list', InvoiceList, {
    loader: (ctx) => {
      const entry = ctx.resource('invoices');
      return {
        items: entry.items,
        total: entry.total,
        unavailable: entry.unavailable,
        denied: entry.denied,
        status: ctx.search.status,
        page: ctx.search.page,
        limit: ctx.search.limit,
      };
    },
    fallback: <InvoiceListSkeleton />,
    staleTime: 15_000,
    staleReloadMode: 'background',
  })
  .withLayout((slots) => slots.list())
  .build();

export const { default: page } = invoicesIndexPage;
export { page as default };
