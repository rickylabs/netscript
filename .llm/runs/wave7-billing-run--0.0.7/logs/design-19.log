===CUSTOMER LEDGER===
/**
 * Customer ledger — server component for the customer detail `ledger` layer.
 *
 * The three detail projections: credit ledger sum, open-invoice total, and
 * subscription count. Credit entries and invoices default to USD across the
 * billing schema, so the money projections render with that domain default
 * currency; subscription count is a plain figure.
 */

import { MoneyText, Skeleton, StatsGrid } from '@app/components/ui/mod.ts';
import type { VNode } from 'preact';

export interface CustomerLedgerProps {
  state: 'found' | 'not-found' | 'unavailable' | 'denied';
  creditBalance?: string;
  openInvoiceTotal?: string;
  subscriptionCount?: number;
}

export function CustomerLedgerSkeleton(): VNode {
  return <Skeleton variant='stats' cards={3} />;
}

export default function CustomerLedger(
  { state, creditBalance, openInvoiceTotal, subscriptionCount }: CustomerLedgerProps,
): VNode {
  if (state !== 'found' || creditBalance === undefined) return <CustomerLedgerSkeleton />;

  return (
    <StatsGrid>
      <StatsGrid.Card
        label='Credit balance'
        value={<MoneyText value={creditBalance} currency='USD' />}
        detail='Sum of the append-only credit ledger'
      />
      <StatsGrid.Card
        label='Open invoices'
        value={<MoneyText value={openInvoiceTotal} currency='USD' />}
        detail='Unpaid invoice totals'
      />
      <StatsGrid.Card
        label='Subscriptions'
        value={<span class='tabular-nums'>{subscriptionCount ?? 0}</span>}
        detail='Active subscription records'
      />
    </StatsGrid>
  );
}
