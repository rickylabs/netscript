Deno.test('R1 — every component module is exported from the barrel', async () => {
  const barrel = await read('./components/ui/mod.ts');
  for (const name of await componentModules()) {
    const stem = name.replace(/\.tsx$/, '');
    assert(
      barrel.includes(`'./${name}'`),
      `components/ui/${name} is not exported from components/ui/mod.ts — it is invisible`,
    );
    assert(stem.length > 0);
  }
});

Deno.test('R3 — every Ledgerline catalogue entry has a gallery demo', async () => {
  const registry = await read('./routes/(design)/design/(_shared)/registry.ts');
  const gallery = await read('./routes/(design)/design/(_components)/components-view.tsx');

  const catalog = registry.split('ledgerlineCatalog')[1] ?? '';
  const names = [...catalog.matchAll(/^\s{4}name: '([a-z-]+)',$/gm)].map((match) => match[1]);
  assertEquals(names.length > 0, true, 'ledgerlineCatalog must declare entries');

  for (const name of names) {
    assert(
      gallery.includes(`case '${name}':`),
      `${name} is catalogued but has no renderDemo case — unregistered work does not exist`,
    );
  }
});

Deno.test('R3 — the upstream registry count is not inflated by app-owned widgets', async () => {
  const registry = await read('./routes/(design)/design/(_shared)/registry.ts');
  const declared = /total:\s*(\d+),\s*\n\} as const;/.exec(registry.split('registryMeta')[1]);
  assert(declared !== null, 'registryMeta must declare a total');

  const upstream = registry
    .split('export const registryCatalog')[1]
    .split('export const registryCollections')[0];
  const itemCount = [...upstream.matchAll(/^\s{4}name: '/gm)].length;
  assertEquals(
    Number(declared[1]),
    itemCount,
    'registryMeta.total must equal the number of upstream items, not the app-owned ones',
  );
});

