/**
 * Invoice list table — server component for the `/invoices` list layer.
 *
 * Renders through the registry DataGrid (import-only — the grid is a package
 * runtime component, never ui:add'd). Money columns use the `num` cell
 * variant plus MoneyText's `data-money` marker; absence is an em dash.
 */

import { DataGrid } from '@netscript/fresh-ui';
import {
  Badge,
  Card,
  EmptyState,
  InlineNotice,
  MoneyText,
  Pagination,
  Skeleton,
  StatusBadge,
} from '@app/components/ui/mod.ts';
import { routes } from '@app/router.ts';
import type { InvoiceV1 } from '@ledgerline/contracts';
import type { VNode } from 'preact';

export interface InvoiceListProps {
  items: readonly InvoiceV1[];
  total: number;
  unavailable?: boolean;
  denied?: boolean;
  status?: 'DRAFT' | 'OPEN' | 'PAID' | 'VOID' | 'UNCOLLECTIBLE';
  page: number;
  limit: number;
}

export function InvoiceListSkeleton(): VNode {
  return (
    <Card>
      <Card.Body class='ns-stack ns-stack--md'>
        <Skeleton variant='table' rows={8} columns={6} />
      </Card.Body>
    </Card>
  );
}

function formatDate(iso: string | null): string {
  return iso ? iso.slice(0, 10) : '—';
}

function pageHref(page: number, status: InvoiceListProps['status']): string {
  const params = new URLSearchParams({ page: String(page) });
  if (status) params.set('status', status);
  return `/invoices?${params.toString()}`;
}

const INVOICE_STATUSES = ['DRAFT', 'OPEN', 'PAID', 'VOID', 'UNCOLLECTIBLE'] as const;

function statusHref(status?: string): string {
  return status ? `/invoices?status=${status}` : '/invoices';
}

/** Status filter row — every chip is a reachable URL state of the page. */
function InvoiceStatusFilter({ active }: { active?: string }): VNode {
  return (
    <nav
      class='ns-cluster ns-cluster--sm'
      aria-label='Filter invoices by status'
      data-invoice-filter
    >
      <a
        href={statusHref()}
        f-client-nav
        class='text-xs'
        aria-current={active === undefined ? 'true' : undefined}
      >
        All
      </a>
      {INVOICE_STATUSES.map((status) => (
        <a
          key={status}
          href={statusHref(status)}
          f-client-nav
          class='text-xs'
          aria-current={active === status ? 'true' : undefined}
        >
          {status.toLowerCase()}
        </a>
      ))}
    </nav>
  );
}

export default function InvoiceList(
  { items, total, unavailable, denied, status, page, limit }: InvoiceListProps,
): VNode {
  if (denied) {
    return (
      <Card>
        <Card.Body>
          <InlineNotice title='Permission denied' variant='destructive'>
            The console's service token does not carry the billing:read scope.
          </InlineNotice>
        </Card.Body>
      </Card>
    );
  }

  if (unavailable) {
    return (
      <Card>
        <Card.Body>
          <InlineNotice title='Billing service unavailable' variant='destructive'>
            The billing service did not answer. The invoice ledger stays read-only until it is back.
          </InlineNotice>
        </Card.Body>
      </Card>
    );
  }

  if (items.length === 0) {
    return (
      <Card>
        <Card.Body>
          <EmptyState heading='No invoices'>
            {status
              ? `No ${status.toLowerCase()} invoices in the ledger yet.`
              : 'No invoices in the ledger yet — issue a billing run to create them.'}
          </EmptyState>
        </Card.Body>
      </Card>
    );
  }

  const first = (page - 1) * limit + 1;
  const last = (page - 1) * limit + items.length;
  const hasPrev = page > 1;
  const hasNext = last < total;

  return (
    <div class='ns-stack ns-stack--md'>
      <InvoiceStatusFilter active={status} />
      <Card>
        <DataGrid
          label='Invoice ledger'
          columns={[
            {
              key: 'number',
              header: 'Number',
              cell: 'strong',
              render: (invoice) => <span class='font-mono text-xs'>{invoice.number}</span>,
            },
            {
              key: 'customerId',
              header: 'Customer',
              render: (invoice) => (
                <span class='font-mono text-xs text-ns-muted-fg'>{invoice.customerId}</span>
              ),
            },
            {
              key: 'status',
              header: 'Status',
              render: (invoice) => <StatusBadge status={invoice.status} />,
            },
            {
              key: 'period',
              header: 'Period',
              render: (invoice) => (
                <span class='text-xs text-ns-muted-fg'>
                  {formatDate(invoice.periodStart)} → {formatDate(invoice.periodEnd)}
                </span>
              ),
            },
            {
              key: 'total',
              header: 'Total',
              cell: 'num',
              render: (invoice) => <MoneyText value={invoice.total} currency={invoice.currency} />,
            },
            {
              key: 'issuedAt',
              header: 'Issued',
              render: (invoice) => (
                <span class='font-mono text-xs text-ns-muted-fg'>
                  {formatDate(invoice.issuedAt)}
                </span>
              ),
            },
            {
              key: 'dueAt',
              header: 'Due',
              render: (invoice) => (
                <span class='font-mono text-xs text-ns-muted-fg'>{formatDate(invoice.dueAt)}</span>
              ),
            },
          ]}
          rows={items.map((invoice) => ({
            id: invoice.id,
            data: invoice,
            href: routes.invoices.$id.$route.href({ path: { id: invoice.id } }),
          }))}
          data-money=''
        />
        <Pagination>
          <Pagination.Meta>
            <Badge variant='muted'>
              {first}–{last} of {total}
            </Badge>
          </Pagination.Meta>
          <Pagination.Actions>
            {hasPrev && (
              <a href={pageHref(page - 1, status)} f-client-nav class='text-xs text-ns-fg'>
                ← Previous
              </a>
            )}
