/**
 * Money contract tests.
 *
 * These assert the two rules DESIGN.md states as testable, plus the
 * string-decimal discipline the wire schema (`MoneySchemaV1`) demands:
 *
 *   1. Absence renders as an em dash, never a zero.
 *   2. Amounts are formatted from the decimal string, never through a float,
 *      so a metered unit price keeps its real precision.
 */

import { assertEquals } from '@std/assert';

