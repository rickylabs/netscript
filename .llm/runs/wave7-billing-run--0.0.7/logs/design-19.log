/* InvoiceDetail — the invoice as a ledger object (blocks layer, L4).

   The block composes the five-band widget card. Its only bespoke parts are the
   header glyph, the hero caption, and the evidence list: the payments and
   credit notes that produced the figures above them. In finance, showing the
   rows behind a number is what turns a total into a claim a reader can check,
   so this list is the surface, not a detail panel. */

.ns-invoice__glyph {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  inline-size: var(--ns-space-6);
  block-size: var(--ns-space-6);
  border-radius: var(--ns-radius-full);
  background: color-mix(in srgb, var(--ns-series-1) 14%, transparent);
  color: var(--ns-series-1);
  font-size: var(--ns-text-sm);
  line-height: 1;
}

.ns-invoice__sub {
  font-weight: 400;
  font-size: var(--ns-text-sm);
  color: var(--ns-muted-fg);
}

.ns-invoice__caption {
  margin: 0;
  padding-inline: var(--ns-space-6);
  padding-block-end: var(--ns-space-4);
  font-size: var(--ns-text-sm);
  color: var(--ns-muted-fg);
}

/* The evidence list. Rows are hairline-separated rather than boxed: the
   invoice already sits in a card, and nesting boxes inside a card is what
   makes a dense screen read as a spreadsheet. */
.ns-invoice__evidence {
  display: flex;
  flex-direction: column;
  margin: 0;
  padding: 0;
  list-style: none;
}

.ns-invoice__event {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
