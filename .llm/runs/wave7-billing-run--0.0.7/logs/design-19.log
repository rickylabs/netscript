Deno.test('the balance is a subtraction, so it stays a money value', () => {
  assertEquals(subtractMoney('1240.00', '800.00'), '440.00');
  // Collecting more than was invoiced is an overpayment, not an error.
  assertEquals(subtractMoney('1240.00', '1300.00'), '-60.00');
  // Fully paid leaves a real zero, which is a fact and not absence.
  assertEquals(subtractMoney('1240.00', '1240.00'), '0.00');
  // Either side unmeasured and the balance is unmeasured, not the other side.
  assertEquals(subtractMoney('1240.00', null), null);
  assertEquals(subtractMoney(null, '800.00'), null);
  // Cent arithmetic, where a float would drift.
  assertEquals(subtractMoney('0.30', '0.10'), '0.20');
});

Deno.test('rounding is half-up on the decimal digits, never float-dependent', () => {
  // `(2.675).toFixed(2)` is '2.67' in JS; billing must round the digits given.
  assertEquals(formatMoney('2.675', { precision: 2 }), '2.68');
  assertEquals(formatMoney('2.674', { precision: 2 }), '2.67');
  assertEquals(formatMoney('0.005', { precision: 2 }), '0.01');
  // Rounding carries through the integer part and its separators.
  assertEquals(formatMoney('999.999', { precision: 2 }), '1,000.00');
  // …and a value that rounds to zero is zero, not a signed zero.
  assertEquals(moneyParts('-0.004', { precision: 2 }).direction, 'flat');
  assertEquals(formatMoney('-0.004', { precision: 2 }), '0.00');
});
