/**
 * Run summary header — server component for the run detail `summary` layer.
 *
 * Shows period, status, and the console totals. Missing totals render as em
 * dashes; a failed console read degrades the stats section, never the header.
 */

import {
  Card,
  DeltaChip,
  EmptyState,
  FooterColumns,
  InlineNotice,
  MoneyText,
  SemicircularGauge,
  Skeleton,
  StatsGrid,
  StatusBadge,
  WidgetCard,
} from '@app/components/ui/mod.ts';
import { formatMoney, parseMoney } from '@app/lib/money.ts';
import type { RunConsoleV1, RunV1 } from '@ledgerline/contracts';
import type { VNode } from 'preact';

export interface RunSummaryProps {
  state: 'found' | 'not-found' | 'unavailable' | 'denied';
  run?: RunV1;
  totals?: RunConsoleV1['totals'];
}

export function RunSummarySkeleton(): VNode {
  return (
    <div class='ns-stack ns-stack--md'>
      <Card>
        <Card.Body class='ns-stack ns-stack--sm'>
          <Skeleton variant='detail' rows={2} />
        </Card.Body>
      </Card>
      <Skeleton variant='stats' cards={4} />
    </div>
  );
}

function formatPeriod(run: RunV1): string {
  return `${run.periodStart.slice(0, 10)} → ${run.periodEnd.slice(0, 10)}`;
}

export default function RunSummary({ state, run, totals }: RunSummaryProps): VNode {
  if (state === 'not-found') {
    return (
      <Card>
        <Card.Body>
          <EmptyState heading='Run not found'>
            The run id does not exist (or was created before the console's data window).
          </EmptyState>
        </Card.Body>
      </Card>
    );
  }

  if (state === 'denied') {
    return (
      <Card>
        <Card.Body>
          <InlineNotice title='Permission denied' variant='destructive'>
            The console's service token does not carry the runs:read scope.
          </InlineNotice>
        </Card.Body>
      </Card>
    );
  }

  if (state === 'unavailable' || !run) {
    return (
      <Card>
        <Card.Body>
          <InlineNotice title='Runs service unavailable' variant='destructive'>
            The runs service did not answer. Retry in a moment.
          </InlineNotice>
        </Card.Body>
      </Card>
    );
  }

  return (
    <div class='ns-stack ns-stack--md'>
      <Card>
        <Card.Body class='ns-stack ns-stack--sm'>
          <div class='ns-cluster ns-cluster--sm'>
            <span class='font-mono text-xs text-ns-muted-fg'>{run.id}</span>
            <StatusBadge status={run.status === 'ISSUING' ? 'in-flight' : run.status} />
            {run.notes && <span class='text-xs text-ns-muted-fg'>{run.notes}</span>}
          </div>
          <h1 class='text-lg font-medium text-ns-fg'>{formatPeriod(run)}</h1>
        </Card.Body>
      </Card>
      {totals
        ? (
          <WidgetCard>
            <WidgetCard.Header>
              <WidgetCard.Title>Run progress</WidgetCard.Title>
              <WidgetCard.Action>
                <span class='font-mono text-xs text-ns-muted-fg'>{run.id}</span>
              </WidgetCard.Action>
            </WidgetCard.Header>
            <WidgetCard.Body>
              <SemicircularGauge
                label='ISSUED'
                value={formatMoney(totals.issued, { currency: 'USD' })}
                caption={`${run.issuedCount} of ${run.expectedCount} items`}
                segments={[
                  {
                    value: run.issuedCount,
                    label: 'Issued',
                    display: formatMoney(totals.issued, { currency: 'USD' }),
                    series: 'primary',
                  },
                  {
                    value: run.failedCount,
                    label: 'Failed',
                    display: String(run.failedCount),
                    series: 'destructive',
                  },
                ]}
                total={run.expectedCount}
              />
            </WidgetCard.Body>
            <WidgetCard.Footer>
              <FooterColumns
                columns={[
                  {
                    label: 'APPROVED',
                    value: formatMoney(totals.issued, { currency: 'USD' }),
                    direction: 'in',
                  },
                  {
                    label: 'EXCEPTIONS',
                    value: String(run.failedCount),
                    direction: 'out',
                  },
                  {
                    label: 'REMAINING',
                    value: String(
                      Math.max(0, run.expectedCount - run.issuedCount - run.failedCount),
                    ),
                    direction: 'flat',
                  },
                ]}
              />
            </WidgetCard.Footer>
          </WidgetCard>
        )
        : (
          <InlineNotice title='Console totals unavailable' variant='warning'>
            The run loaded but its console projection did not answer, so totals are shown as em
            dashes until the service recovers.        : (
          <InlineNotice title='Console totals unavailable' variant='warning'>
            The run loaded but its console projection did not answer, so totals are shown as em
            dashes until the service recovers.        : (
          <InlineNotice title='Console totals unavailable' variant='warning'>
            The run loaded but its console projection did not answer, so totals are shown as em
            dashes until the service recovers.
          </InlineNotice>
        )}
    </div>
  );
}
