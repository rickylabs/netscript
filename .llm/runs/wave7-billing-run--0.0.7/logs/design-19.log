export function ratio(numerator: MoneyValue, denominator: MoneyValue): number | null {
  const top = moneyParts(numerator).value;
  const bottom = moneyParts(denominator).value;
  if (top === null || bottom === null || bottom === 0) return null;
  return top / bottom;
}

/**
 * Flips the sign of a value without touching its digits. A value that does not
 * parse comes back unchanged, so a subtraction involving an unmeasured amount
 * degrades to "not measured" instead of inventing a term.
 */
function negate(value: MoneyValue): MoneyValue {
  const parsed = parseDecimal(value);
  if (!parsed) return value;

  const magnitude = `${parsed.int}${parsed.frac ? `.${parsed.frac}` : ''}`;
  const isZero = /^0*$/.test(parsed.int) && /^0*$/.test(parsed.frac);
  if (isZero) return magnitude;
  return parsed.negative ? magnitude : `-${magnitude}`;
}

/**
 * The balance: what is still owed.
 *
 * Expressed as a subtraction rather than a comparison so the result is a real
 * `MoneyValue` — a balance that renders through `MoneyText` carries the same
 * two-decimal, em-dash, never-a-float guarantees as every other amount.
 */
export function subtractMoney(
  minuend: MoneyValue,
  subtrahend: MoneyValue,
): string | null {
  // An unmeasured term makes the balance unmeasured. Summing would silently
  // drop it and report the whole invoiced total as still owed, which is the
  // one answer a billing screen must never invent.
  if (parseDecimal(minuend) === null || parseDecimal(subtrahend) === null) {
    return null;
  }
  return sumMoney([minuend, negate(subtrahend)]);
}

/**
 * Adds money values on their digit strings.
 *
 * Billing needs sums a component cannot fake: whether an invoice is part-paid
 * depends on how much of it actually arrived, and "how much" is a total over
 * payments. The addition happens on integers scaled to one common fraction
 * width, so no value passes through a float at any point.
 *
 * Returns a string-encoded decimal — a `MoneyValue`, ready to hand straight
 * back to `MoneyText` — because summing is not formatting. Values that do not
 * parse are **skipped, not treated as zero**: a `null` in the list means
 * "not measured", and silently folding it in as `0.00` would understate a
 * collected total, which is the one error a billing product cannot make. An
 * empty (or entirely absent) list sums to `null`, which renders as the em
 * dash rather than a confident `0.00`.
 */
export function sumMoney(values: readonly MoneyValue[]): string | null {
  const parsed = values
    .map(parseDecimal)
    .filter((value): value is ParsedDecimal => value !== null);

  if (parsed.length === 0) return null;

  const scale = Math.min(
    MAX_PRECISION,
    parsed.reduce((widest, value) => Math.max(widest, value.frac.length), 0),
  );

  let total = 0n;
  for (const value of parsed) {
    const digits = `${value.int}${value.frac.padEnd(scale, '0').slice(0, scale)}`;
    total += BigInt(digits) * (value.negative ? -1n : 1n);
  }

  const negative = total < 0n;
  const digits = (negative ? -total : total).toString().padStart(scale + 1, '0');
  const split = digits.length - scale;
  const int = digits.slice(0, split);
  const frac = digits.slice(split);

  // `-0.00` is not a fact. A total that nets to nothing is `0.00`.
  const isZero = /^0*$/.test(int) && /^0*$/.test(frac);
  const sign = isZero ? '' : negative ? '-' : '';
  return `${sign}${int}${scale > 0 ? `.${frac}` : ''}`;
}

/**
 * Formats a ratio as a percentage. `null` renders as the em dash.
 */
export function formatPercent(
  value: number | null | undefined,
  options: { precision?: number; signed?: boolean } = {},
): string {
  if (value === null || value === undefined || !Number.isFinite(value)) return ABSENT;
  const precision = options.precision ?? 1;
  const sign = options.signed && value > 0 ? '+' : '';
  return `${sign}${(value * 100).toFixed(precision)}%`;
}

/** Moves the decimal point left by `shift` digits, on the digit string. */
function shiftLeft(parsed: ParsedDecimal, shift: number): ParsedDecimal {
  if (shift === 0) return parsed;
  let digits = `${parsed.int}${parsed.frac}`;
  let point = parsed.int.length - shift;
  if (point <= 0) {
    digits = `${'0'.repeat(1 - point)}${digits}`;
    point = 1;
  }
  return { negative: parsed.negative, int: digits.slice(0, point), frac: digits.slice(point) };
}

/**
