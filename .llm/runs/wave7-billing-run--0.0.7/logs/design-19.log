/**
 * `/runs` — the run console list.
 *
 * Typed search via the pagination contract (status filter + page/limit).
 * The `list` layer is a deferred partial: the page loader renders from the
 * query cache (`getCachedEntry`) and the `/partials/runs/list` route carries
 * the authoritative read in the background (`staleReloadMode: 'background'`).
 * A cache miss renders the layer's fallback skeleton, never a blocked page.
 */

import { paginationSearchSchema } from '@netscript/fresh/route';
import { z } from 'zod';
import { definePage } from '@app/utils.ts';
import { runsClient, runsQueries } from '@app/lib/runs.ts';
import CreateRunForm from './(_components)/create-run-form.tsx';
import RunsTable, { RunsTableSkeleton } from './(_components)/runs-table.tsx';
