function currencyPrefix(currency: string | undefined, locale: string): string | null {
  if (!currency) return null;
  const parts = new Intl.NumberFormat(locale, {
    style: 'currency',
    currency,
    currencyDisplay: 'narrowSymbol',
  }).formatToParts(0);
  const symbol = parts.find((part) => part.type === 'currency')?.value ?? currency;
  return symbol;
}

/** A fully resolved, ready-to-render money value. */
export interface MoneyParts {
  /** Direction, for token selection. */
  readonly direction: MoneyDirection;
  /** `'-'`, or `'+'` when signed and towards us, or `''`. */
  readonly sign: string;
  /** Grouped magnitude with no sign, e.g. `1,240.00`. The em dash when absent. */
  readonly magnitude: string;
  /** Currency symbol without the amount, or `null` when rendering bare. */
  readonly currency: string | null;
  /** Sign + magnitude, or the em dash. The default thing to render. */
  readonly text: string;
  /** True when the input meant "not measured". */
  readonly absent: boolean;
  /** Parsed numeric value for chart math, or `null` when absent. */
  readonly value: number | null;
}

/**
 * Resolves a money value into every part a component needs: sign, magnitude,
 * direction and the rendered string. Absent in, em dash out.
 */
export function moneyParts(value: MoneyValue, options: MoneyFormatOptions = {}): MoneyParts {
  const parsed = parseDecimal(value);
  const locale = options.locale ?? 'en-US';

  if (!parsed) {
    return {
      direction: 'absent',
      sign: '',
      magnitude: ABSENT,
      currency: null,
      text: ABSENT,
      absent: true,
      value: null,
    };
  }

  const precision = precisionFor(parsed.frac, options);
  const rounded = roundToPrecision(parsed.int, parsed.frac, precision);
  const magnitude = precision > 0
    ? `${groupInteger(rounded.int, locale)}.${rounded.frac}`
    : groupInteger(rounded.int, locale);

  // Zero is decided after rounding: -0.004 at two digits is 0.00, not -0.00.
  const isZero = /^0*$/.test(rounded.int) && /^0*$/.test(rounded.frac);
  const direction: MoneyDirection = isZero ? 'flat' : parsed.negative ? 'out' : 'in';
  const sign = direction === 'out' ? '-' : direction === 'in' && options.signed ? '+' : '';

  return {
    direction,
    sign,
    magnitude,
    currency: currencyPrefix(options.currency, locale),
    text: `${sign}${magnitude}`,
    absent: false,
    value: Number(`${parsed.negative ? '-' : ''}${parsed.int}.${parsed.frac || '0'}`),
  };
}

/**
 * Formats a money amount. Returns the em dash for any value that is not a
 * usable amount — never `0.00`.
 */
export function formatMoney(value: MoneyValue, options: MoneyFormatOptions = {}): string {
  return moneyParts(value, options).text;
}

/** The direction of an amount, for token selection without formatting. */
export function moneyDirection(value: MoneyValue): MoneyDirection {
  return moneyParts(value).direction;
}

