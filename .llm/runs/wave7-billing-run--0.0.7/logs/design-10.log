Deno.test('M8 — only lib/money turns a decimal into text', async () => {
  const formatters = /\bNumber\s*\(|\.toFixed\s*\(|\bIntl\.NumberFormat/;
  const moneyModule = await read('./lib/money.ts');
  const allowed = new Set(['money-text.tsx']);

  for (const name of await componentModules()) {
    if (allowed.has(name)) continue;
    const source = await read(`./components/ui/${name}`);
    assert(
      !formatters.test(source),
      `components/ui/${name} formats a value itself; render it through MoneyText instead`,
    );
  }

  // The product layer renders money too, so it is under the same rule. This is
  // where the defect actually lived: `components/product/money-text.tsx` used to
  // call `Number(text)` and `Intl.NumberFormat` with a dynamic fraction count,
  // which printed `$100` where the contract requires `$100.00`.
  for (const name of await productComponentModules()) {
    const source = await read(`./components/product/${name}`);
    assert(
      !formatters.test(source),
      `components/product/${name} formats a value itself; render it through lib/money instead`,
    );
  }

  // And the one component that is allowed to touch money must not format either.
  const moneyText = await read('./components/product/money-text.tsx');
  assert(
    !formatters.test(moneyText),
    'money-text.tsx must not call Number/toFixed/Intl — it resolves through moneyParts()',
  );
  // …but it must actually use the module, not shadow it.
  assert(moneyText.includes('moneyParts'), 'money-text.tsx must resolve values through moneyParts');
  assert(moneyModule.includes('export function moneyParts'));
});

