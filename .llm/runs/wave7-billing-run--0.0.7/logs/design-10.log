import { defineScheduledTrigger, enqueueJob } from '@netscript/plugin-triggers-core/builders';
import type {
  ScheduledTriggerDefinition,
  ScheduledTriggerPayload,
  TriggerContext,
  TriggerEvent,
} from '@netscript/plugin-triggers-core/domain';
import type { JobDefinition } from '@netscript/plugin-workers-core';

/** The job definition this trigger enqueues (workers/jobs/period-close-check.ts). */
const periodCloseCheckJob = {
  id: 'period-close-check' as JobDefinition<'period-close-check'>['id'],
  name: 'Period close check',
  topic: 'default',
} satisfies JobDefinition<'period-close-check'>;

/**
 * The unattended close guard: a billing product whose period never closes on
 * its own has no product. This scheduled trigger enqueues the
 * `period-close-check` job nightly; the job is idempotent and bounded.
 */
export const dailyMaintenanceTrigger: ScheduledTriggerDefinition<
  'daily-maintenance',
  TriggerEvent<'scheduled', ScheduledTriggerPayload>,
  TriggerContext
> = defineScheduledTrigger(
  async () => {
    return [
      enqueueJob<'period-close-check', Record<string, never>>(periodCloseCheckJob, {
        payload: {},
        priority: 50,
      }),
    ];
  },
  {
    id: 'daily-maintenance',
    cron: '0 3 * * *',
  },
);

export default dailyMaintenanceTrigger;
