=== billed-summary.tsx ===
/**
 * Billed this period — the run console's headline.
 *
 * The console exists to answer "is the book growing or shrinking?", and that
 * is a comparison, not a number: the latest run's total stated against the run
 * that preceded it. A figure with nothing beside it invites the reader to
 * supply the trend from memory.
 *
 * One run is not a flat movement. With no prior run there is nothing to
 * measure against, so the chip renders absent rather than `+0.0%` — a run that
 * has not been compared has not held steady (M1).
 */

import { DeltaChip, MoneyText, WidgetCard } from '@app/components/ui/mod.ts';
import { movement } from '@app/lib/money.ts';
import type { RunV1 } from '@ledgerline/contracts';
import type { VNode } from 'preact';

/** Run money is USD: the billing schema's domain default, not a display guess. */
const CURRENCY = 'USD';

export interface BilledSummaryProps {
  /** Newest first, as the runs list is sorted. */
  runs: readonly RunV1[];
  class?: string;
}

/** `2026-07-01` — the day a run's period opens. */
function periodOf(run: RunV1): string {
  return run.periodStart.slice(0, 10);
}

export default function BilledSummary(
  { runs, class: className }: BilledSummaryProps,
): VNode | null {
  const latest = runs[0];
  if (!latest) return null;

  const prior = runs[1];
  const change = movement(latest.total, prior?.total ?? null);
  const opens = periodOf(latest);

  return (
    <WidgetCard class={className}>
      <WidgetCard.Header>
        <WidgetCard.Title>Billed this period</WidgetCard.Title>
      </WidgetCard.Header>
      <WidgetCard.Hero>
        <MoneyText value={latest.total} currency={CURRENCY} />
        <DeltaChip
          value={change.label}
          direction={change.direction}
          note={prior ? `vs the ${periodOf(prior)} run` : 'no prior run'}
        />
      </WidgetCard.Hero>
      <WidgetCard.Body>
        <p class='text-sm text-ns-muted-fg'>
          Run {latest.id} opens {opens}. {latest.issuedCount} of {latest.expectedCount}{' '}
          items issued.
        </p>
      </WidgetCard.Body>
    </WidgetCard>
  );
}
