/* ns-exception-badge — components/product/exception-badge.tsx
   Rust-tinted chip for a run item's exception bucket. Presence and absence
   are distinguished by the data-exception attribute: 'none' renders the em
   dash so "no exception" never reads like a flagged item. */

.ns-exception-badge[data-exception]:not([data-exception='none']) {
  color: var(--ns-rust-6);
  background: color-mix(in srgb, var(--ns-rust-6) 10%, transparent);
