const VB_BASELINE = 120;
/** Horizontal inset so an end-point marker stays inside the frame. */
const VB_INSET = 6;
const GRID_LINES = 4;

const PLOT_HEIGHT = VB_BASELINE - VB_TOP;

/** Axis steps worth landing on. Denser than 1/2/5 so a peak keeps headroom. */
const NICE_STEPS = [1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 9, 10] as const;

/**
 * The axis maximum a chart will scale to for these values.
 *
 * Exported because a caller has to build its own tick labels from the same
 * number the gridlines sit on — a tick that disagrees with its gridline is a
 * lie about the scale — while still doing all the formatting itself (H2).
 */
export function areaChartMax(values: readonly number[]): number {
  const value = Math.max(0, ...values);
