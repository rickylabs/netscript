/** Series slot in the fixed `--ns-series-1..6` cycle (H3). */
export type AreaSeries = 1 | 2 | 3 | 4 | 5 | 6;

/**
 * One plotted point.
 *
 * `value` is geometry and is never rendered; `display` is the preformatted
 * string the readout shows (H2). The chart never formats a number.
 */
export interface AreaChartPoint {
  readonly value: number;
  /** Point name for the readout and, by default, the x-axis. */
  readonly label: string;
  /** Preformatted value for the readout. */
  readonly display: string;
}

