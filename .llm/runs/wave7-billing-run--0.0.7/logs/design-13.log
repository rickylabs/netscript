=== delta-chip.css ===
/* DeltaChip — one component for every "versus last period" in the product (C3).

   It is a pill sitting *beside* the number it qualifies, optically centred on
   it, not a badge parked in the card header. The tinted background is a
   `color-mix` of the money token so dark mode re-tints without a second rule. */

.ns-delta-chip {
  display: inline-flex;
  align-items: baseline;
  gap: var(--ns-space-2);
  /* Optically centred on a hero number rather than box-centred: the pill rides
     the cap height of the figure next to it. */
  vertical-align: middle;
}

.ns-delta-chip__pill {
  display: inline-flex;
  align-items: center;
  gap: var(--ns-space-1);
  padding: var(--ns-space-0-5) var(--ns-space-2);
  border-radius: var(--ns-radius-full);
  font-family: var(--ns-font-sans);
  font-size: var(--ns-text-xs);
  font-weight: 600;
  line-height: 1.35;
  white-space: nowrap;
  font-variant-numeric: var(--ns-numeric-tabular);
}

.ns-delta-chip__glyph {
  font-size: 0.875em;
  line-height: 1;
}

.ns-delta-chip__note {
  font-size: var(--ns-text-xs);
  color: var(--ns-muted-fg);
  white-space: nowrap;
}

.ns-delta-chip__pill[data-direction='up'] {
  color: var(--ns-money-pos);
  background: color-mix(in srgb, var(--ns-money-pos) 12%, transparent);
}

.ns-delta-chip__pill[data-direction='down'] {
  color: var(--ns-money-neg);
  background: color-mix(in srgb, var(--ns-money-neg) 12%, transparent);
}

.ns-delta-chip__pill[data-direction='flat'] {
  color: var(--ns-money-flat);
  background: color-mix(in srgb, var(--ns-money-flat) 12%, transparent);
}

/* M1 for movements: no prior period is not a 0.0% movement. */
.ns-delta-chip__pill[data-direction='absent'] {
  color: var(--ns-absent);
  background: color-mix(in srgb, var(--ns-absent) 12%, transparent);
}
