/**
 * @component SegmentedControl
 * @layer 2
 * @depends theme-seed
 * @description Range selection as one full-width capsule: N equal cells, the
 * selected one a filled pill. Never a border change (C4). Renders as buttons
 * for client-side selection, or as links when the range is a route.
 */

import type { JSX, VNode } from 'preact';
import { cn } from '../../lib/cn.ts';

export interface SegmentedControlOption {
  /** Range key — `1D`, `1W`, `1M`, `3M`, `1Y`, or a product range id. */
  readonly value: string;
  /** Preformatted cell label. */
  readonly label: string;
  /** Render the cell as a link, so the range lives in the URL. */
  readonly href?: string;
  readonly disabled?: boolean;
}

export interface SegmentedControlProps
  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children' | 'onSelect'> {
  /** Accessible name for the group, e.g. `Billing period`. */
  label: string;
  options: readonly SegmentedControlOption[];
  /** The selected option's `value`. Omit only when nothing is selected. */
  value?: string | null;
  /** Called with the chosen `value`. Required unless every option has an `href`. */
  onSelect?: (value: string) => void;
  size?: 'sm' | 'md';
  /** Stretch to the container width. The reference control is full-width. */
  block?: boolean;
  class?: string;
}

/**
 * A segmented range control.
 *
 * Link options turn the group into navigation and drop the tab semantics,
 * because a link is not a tab; selection is then announced with
 * `aria-current`. Link and button options are not mixed — the first option
 * decides the whole control's mode.
 */
export function SegmentedControl({
  label,
  options,
  value = null,
  onSelect,
  size = 'md',
  block = true,
  class: className,
  ...props
}: SegmentedControlProps): VNode {
  const asLinks = options.length > 0 && options.every((option) => option.href !== undefined);

  return (
    <div
      {...props}
      class={cn(
        'ns-segmented',
        size === 'sm' && 'ns-segmented--sm',
        block && 'ns-segmented--block',
        className,
      )}
      role={asLinks ? 'group' : 'tablist'}
      aria-label={label}
    >
      {options.map((option) => {
        const selected = option.value === value;
        const cellClass = cn('ns-segmented__cell', selected && 'is-selected');

        if (asLinks) {
          return (
            <a
              key={option.value}
              class={cellClass}
              href={option.href}
              aria-current={selected ? 'true' : undefined}
              aria-disabled={option.disabled ? 'true' : undefined}
            >
              {option.label}
            </a>
          );
        }

        return (
          <button
            key={option.value}
            type='button'
            class={cellClass}
            role='tab'
            // Explicit "true"/"false" rather than a boolean: an empty
            // aria-selected reads as false to assistive tech, which would leave
            // the control with no selected tab at all.
            aria-selected={selected ? 'true' : 'false'}
            disabled={option.disabled}
            onClick={() => onSelect?.(option.value)}
          >
            {option.label}
          </button>
        );
      })}
    </div>
  );
}
=========== FOOTER COLUMNS ===========
/**
 * @component FooterColumns
 * @layer 2
 * @depends theme-seed, lib/money
 * @description The bottom band of a widget card: N equal columns of label and
 * amount, divided by hairline rules. Gaps alone do not separate columns (C5).
 */

import type { JSX, VNode } from 'preact';
import { cn } from '../../lib/cn.ts';
import { ABSENT, type MoneyDirection } from '../../lib/money.ts';
import type { Renderable } from '../../lib/public-types.ts';

export interface FooterColumn {
  /** Quiet uppercase label, e.g. `APPROVED`. */
  readonly label: string;
  /** Preformatted amount. `null` renders the em dash (M1). */
  readonly value: string | null;
  /**
   * Direction of the amount, which is a domain fact — approved is towards us,
   * excepted is away — and never a colour decision at the call site (M5).
   * Omitted leaves the amount in the surface's own foreground.
   */
  readonly direction?: MoneyDirection;
  /** Optional tinted icon tile above the amount. */
  readonly glyph?: Renderable;
}

export interface FooterColumnsProps
  extends Omit<JSX.HTMLAttributes<HTMLDivElement>, 'class' | 'children'> {
  columns: readonly FooterColumn[];
  class?: string;
}

/**
 * A hairline-divided footer strip.
 *
 * A column whose value is `null` is a fact that was not measured, so it renders
 * the em dash in the absent tone — the footer is exactly where a fabricated
 * `0.00` would do the most damage.
 */
export function FooterColumns({ columns, class: className, ...props }: FooterColumnsProps): VNode {
  if (columns.length === 0) return <div {...props} class={cn('ns-footer-cols', className)} />;

  return (
    <div {...props} class={cn('ns-footer-cols', className)}>
      {columns.map((column) => {
        const absent = column.value === null || column.direction === 'absent';
        return (
          <div
            key={column.label}
            class='ns-footer-cols__col'
            // `absent` wins over a caller-supplied direction: once the value is
            // null there is no amount for a direction to qualify, and the em
            // dash has to land in the absent tone or it reads as data.
            data-direction={absent ? 'absent' : (column.direction ?? 'inherit')}
          >
            {column.glyph && <span class='ns-footer-cols__glyph'>{column.glyph}</span>}
            <span class='ns-footer-cols__label'>{column.label}</span>
            <span class='ns-footer-cols__value'>
              {absent
                ? (
                  <>
                    <span aria-hidden='true'>{ABSENT}</span>
                    <span class='sr-only'>not recorded</span>
                  </>
                )
                : column.value}
            </span>
          </div>
        );
      })}
    </div>
  );
}
