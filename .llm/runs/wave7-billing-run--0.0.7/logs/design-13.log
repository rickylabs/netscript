/**
 * Run progress — the run console's hero widget.
 *
 * The gauge answers "how much of this run has settled". Geometry is item
 * counts, because that is the only honest denominator a run has: an item is
 * either settled, excepted, or still open. Money is what the reader is then
 * told about that shape — the centre carries the issued figure and the footer
 * carries what each outcome is worth.
 *
 * There is no range band. A run is one point in time, not a window, and a
 * control that pretends otherwise would be decoration.
 *
 * This file formats nothing: every amount is resolved by `lib/money` (M8).
 */

import {
  Button,
  type FooterColumn,
  FooterColumns,
  type GaugeSegment,
  SemicircularGauge,
  Skeleton,
  WidgetCard,
} from '@app/components/ui/mod.ts';
import {
  formatMoneyWithCurrency,
  type MoneyDirection,
  moneyDirection,
  type MoneyValue,
  sumMoney,
} from '@app/lib/money.ts';
import type { RunConsoleV1, RunItemV1 } from '@ledgerline/contracts';
import type { VNode } from 'preact';

/** Run money is USD: the billing schema's domain default, not a display guess. */
const CURRENCY = 'USD';

/** An item that reached its customer as a finalised invoice. */
const SETTLED: ReadonlySet<RunItemV1['status']> = new Set(['ISSUED']);

/** A terminal failure: an item the run could not settle without a decision. */
const EXCEPTED: ReadonlySet<RunItemV1['status']> = new Set(['FAILED']);

interface Partition {
  readonly settled: readonly RunItemV1[];
  readonly excepted: readonly RunItemV1[];
  readonly open: readonly RunItemV1[];
}

/** One footer column: an outcome, the items in it, and which way its money moves. */
interface RunOutcome {
  readonly label: string;
  readonly items: readonly RunItemV1[];
  readonly direction: MoneyDirection;
}

/**
 * Splits the run's items by terminal outcome.
 *
 * Every status lands in exactly one bucket, so the three counts always add up
 * to the run's whole — the gauge's track is the remainder by construction, not
 * by subtraction.
 */
function partition(items: readonly RunItemV1[]): Partition {
  const settled: RunItemV1[] = [];
  const excepted: RunItemV1[] = [];
  const open: RunItemV1[] = [];

  for (const item of items) {
    if (SETTLED.has(item.status)) settled.push(item);
    else if (EXCEPTED.has(item.status)) excepted.push(item);
    else open.push(item);
  }

  return { settled, excepted, open };
}

/**
 * The money a group of items carries, or `null` when it was never computed.
 *
 * An empty group is a real zero — no item failed — not an unmeasured amount.
 * Only a group whose items never had an amount computed earns `null`, which is
 * the difference between "$0.00 was excepted" and "we do not know yet" (M1).
 */
function groupTotal(items: readonly RunItemV1[]): MoneyValue {
  if (items.length === 0) return '0';
  return sumMoney(items.map((item) => item.computedTotal));
}

export interface RunProgressProps {
  items: readonly RunItemV1[];
  totals: RunConsoleV1['totals'];
  class?: string;
}

export function RunProgressSkeleton(): VNode {
  return (
    <WidgetCard>
      <WidgetCard.Header>
        <WidgetCard.Title>Run progress</WidgetCard.Title>
      </WidgetCard.Header>
      <WidgetCard.Body>
        <Skeleton variant='detail' rows={3} />
      </WidgetCard.Body>
    </WidgetCard>
  );
}

/** `1 item`, `2 items`. A count in a legend is read as a sentence. */
function itemCount(count: number): string {
  return `${count} item${count === 1 ? '' : 's'}`;
}

export default function RunProgress({ items, totals, class: className }: RunProgressProps): VNode {
  const { settled, excepted, open } = partition(items);

  const segments: readonly GaugeSegment[] = [
    { label: 'Issued', value: settled.length, display: itemCount(settled.length), series: 1 },
    { label: 'Exceptions', value: excepted.length, display: itemCount(excepted.length), series: 4 },
  ];

  // Each outcome carries its own direction as a domain fact — issued money
  // moves towards us, excepted money does not — rather than as a colour the
  // card decides (M5). Zero and unmeasured override it: a column reading
  // `$0.00` is not a movement in either direction, and one that was never
  // computed is not a zero.
  const groups: readonly RunOutcome[] = [
    { label: 'Issued', items: settled, direction: 'in' },
    { label: 'Excepted', items: excepted, direction: 'out' },
    { label: 'Open', items: open, direction: 'flat' },
  ];

  const columns: readonly FooterColumn[] = groups.map(
    ({ label, items: group, direction: declared }) => {
      const amount = groupTotal(group);
      const resolved = moneyDirection(amount);
      return {
        label,
        value: formatMoneyWithCurrency(amount, { currency: CURRENCY }),
        direction: resolved === 'absent' || resolved === 'flat' ? resolved : declared,
      };
    },
  );

  return (
    <WidgetCard class={className}>
      <WidgetCard.Header>
        <WidgetCard.Title>Run progress</WidgetCard.Title>
        <WidgetCard.Action>
          <Button type='link' href='/invoices' variant='pill' size='sm'>
            Invoices
          </Button>
        </WidgetCard.Action>
      </WidgetCard.Header>
      <WidgetCard.Body>
        <SemicircularGauge
          label='Issued'
          value={formatMoneyWithCurrency(totals.issued, { currency: CURRENCY })}
          caption={`${settled.length} of ${items.length} items`}
          total={items.length}
          segments={segments}
        />
      </WidgetCard.Body>
      <WidgetCard.Footer>
        <FooterColumns columns={columns} />
      </WidgetCard.Footer>
    </WidgetCard>
  );
}
