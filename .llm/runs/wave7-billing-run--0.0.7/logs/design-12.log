/* Band 3 — hero amount and its delta chip share one baseline.

   The hero's size belongs to this band, not to the amount component: any
   amount dropped in here becomes the card's answer, so a caller does not
   repeat a size prop at every call site. Roughly 3x the band's own label —
   a hero the same size as the title above it is what makes a widget read as a
   list item rather than a card (C2). */
.ns-widget__hero .ns-money-text {
  font-size: var(--ns-text-4xl);
  font-weight: 600;
  line-height: var(--ns-leading-tight);
  letter-spacing: var(--ns-tracking-tight);
}

/* M9 — a hero states a balance, not a movement, so it does not take the
   direction colour. In the reference cards the hero number is plain and only
   the delta beside it is green; colouring the figure green *because it is
   positive* is the failure this rule names. The DeltaChip on the same baseline
   is what carries direction. */
.ns-widget__hero .ns-money-text[data-money-sign] {
  color: var(--ns-fg);
}

/* Band 4 */
.ns-widget__body {
  padding-block: var(--ns-space-2) var(--ns-space-5);
}

.ns-widget__body:empty {
  display: none;
}
