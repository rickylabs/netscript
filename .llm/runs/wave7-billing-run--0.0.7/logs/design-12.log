export type MoneyTone = 'inherit' | 'direction';

/** Type sizes an amount is rendered at, from table cell to card hero. */
export type MoneyTextSize = 'sm' | 'md' | 'lg' | 'hero';

export interface MoneyTextProps
  extends Omit<JSX.HTMLAttributes<HTMLSpanElement>, 'class' | 'children'> {
  /** String-encoded decimal, or a number for already-normalised derived values. */
  value: MoneyValue;
  /** ISO 4217 code. Omitted leaves the amount bare — see M7, currency once per surface. */
  currency?: string;
  /** Render an explicit `+` on amounts towards us. Deltas want this; cells do not. */
  signed?: boolean;
  /** Force a fraction-digit count. Derived precision already guarantees at least 2. */
  precision?: number;
  /** Compact form for dense surfaces and chart ticks: `$12.4k`. */
  compact?: boolean;
  /** BCP-47 locale for grouping and separators. Defaults to `en-US`. */
  locale?: string;
  /** Colour treatment. Defaults to `inherit`; see {@link MoneyTone}. */
  tone?: MoneyTone;
  size?: MoneyTextSize;
  class?: string;
}

const SIZE_CLASSES: Record<MoneyTextSize, string | undefined> = {
  sm: 'ns-money--sm',
  md: undefined,
  lg: 'ns-money--lg',
  hero: 'ns-money--hero',
};

/**
 * Renders a money amount: currency, sign, grouped digits, and direction.
 *
 * The component never formats and never decides an amount's sign. It resolves
 * the value once through `moneyParts` and renders the parts it is handed, so
 * there is exactly one place in the product where a decimal becomes text.
 */
export function MoneyText({
  value,
  currency,
  signed = false,
  precision,
  compact = false,
  locale,
  tone = 'inherit',
  size = 'md',
  class: className,
  ...props
}: MoneyTextProps): VNode {
  const options: MoneyFormatOptions = {
    currency,
    signed,
    locale,
    ...(precision === undefined ? {} : { precision }),
  };
  const parts = moneyParts(value, options);

  return (
    <span
      {...props}
      class={cn('ns-money', SIZE_CLASSES[size], className)}
      data-direction={parts.direction}
      data-tone={tone}
    >
      {compact ? <span class='ns-money__amount'>{formatMoneyCompact(value, options)}</span> : (
        <>
          {parts.currency !== null && <span class='ns-money__currency'>{parts.currency}</span>}
          <span class='ns-money__amount'>
            {parts.absent
              ? (
                <>
                  <span aria-hidden='true'>{ABSENT}</span>
                  <span class='sr-only'>not recorded</span>
                </>
              )
              : parts.text}
          </span>
        </>
      )}
