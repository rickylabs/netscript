/**
 * Band 1. The header is a row — glyph and title left, one action pinned right.
 * The base card header is a column built for a title plus a description;
 * `assets/blocks/widget-card.css` is imported after `surface-styles.css` and
 * restores the row on the `.ns-widget__header` seam (T4).
 */
function WidgetCardHeader({ children, class: className, ...props }: BandProps): VNode {
  return (
    <Card.Header {...props} class={cn('ns-widget__header', className)}>
      {children}
    </Card.Header>
  );
}

function WidgetCardTitle({ children, class: className, ...props }: TitleProps): VNode {
  return <Card.Title {...props} class={cn('ns-widget__title', className)}>{children}</Card.Title>;
}

function WidgetCardAction({ children, class: className, ...props }: BandProps): VNode {
  return <div {...props} class={cn('ns-widget__action', className)}>{children}</div>;
}

/** Band 2. The range control, when the card has one. */
function WidgetCardRange({ children, class: className, ...props }: BandProps): VNode {
  return <div {...props} class={cn('ns-widget__range', className)}>{children}</div>;
}

/**
 * Band 3. The hero row: the amount and its delta chip on one baseline, so the
 * chip is optically centred on the figure rather than parked in a corner.
 */
function WidgetCardHero({ children, size = 'md', class: className, ...props }: HeroProps): VNode {
  return (
    <div
      {...props}
      class={cn('ns-widget__hero', size === 'lg' && 'ns-widget__hero--lg', className)}
    >
      {children}
    </div>
  );
}

/** Band 4. The visualisation. */
function WidgetCardBody({ children, class: className, ...props }: BandProps): VNode {
  return <Card.Body {...props} class={cn('ns-widget__body', className)}>{children}</Card.Body>;
}

/** Band 5. Footer columns, a full-width CTA, or a note. */
function WidgetCardFooter({ children, class: className, ...props }: BandProps): VNode {
  return <Card.Footer {...props} class={cn('ns-widget__footer', className)}>{children}
  </Card.Footer>;
}

/**
 * A composed widget card with one slot per band, in document order.
 */
export const WidgetCard: WidgetCardComponent = Object.assign(WidgetCardRoot, {
  Header: WidgetCardHeader,
  Title: WidgetCardTitle,
  Action: WidgetCardAction,
  Range: WidgetCardRange,
  Hero: WidgetCardHero,
  Body: WidgetCardBody,
