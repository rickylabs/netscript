diff --git a/apps/ledgerline-web/components/ui/comparison-area-chart.tsx b/apps/ledgerline-web/components/ui/comparison-area-chart.tsx
index e882359..18f2488 100644
--- a/apps/ledgerline-web/components/ui/comparison-area-chart.tsx
+++ b/apps/ledgerline-web/components/ui/comparison-area-chart.tsx
@@ -114,6 +114,26 @@ function percentStep(count: number): number {
   return ((VB_WIDTH - VB_INSET * 2) / (count - 1) / VB_WIDTH) * 100;
 }
 
+/**
+ * The hover band for point `index`, as percentages of the drawn frame.
+ *
+ * The band is centred on its point but clipped to the frame, and it carries the
+ * point's own x back out as `x` (a percentage of the band) for `--hit-x`. Both
+ * halves matter: an unclipped end band hangs outside the frame by half a step,
+ * which is far enough that hovering the y-axis gutter pops the first readout,
+ * while a clipped band whose marker still sat at `50%` would draw the dot and
+ * the crosshair off the point they name. Clipping is safe for tiling because
+ * adjacent bands still meet exactly at the midpoint between their points.
+ */
+function hitBand(index: number, count: number): { left: number; width: number; x: number } {
+  const centre = percentX(index, count);
+  const half = percentStep(count) / 2;
+  const left = Math.max(0, centre - half);
+  const right = Math.min(100, centre + half);
+  const width = right - left;
+  return { left, width, x: width > 0 ? ((centre - left) / width) * 100 : 50 };
+}
+
 function percentY(value: number, max: number): number {
   return (yAt(value, max) / VB_HEIGHT) * 100;
 }
