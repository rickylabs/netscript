/**
 * Billing trigger client for the runs service.
 *
 * The run pipeline drafts invoices through the billing service's typed
 * contract client — the framework's service-boundary way, resolved via
 * Aspire service discovery (`services__billing__http__0`).
 */

import { createServiceClient } from '@netscript/sdk/client';
import { BillingContractV1 } from '@ledgerline/contracts';
import { serviceBearer } from '../../../_shared/service-auth.ts';

export const billingClient = createServiceClient<
  typeof BillingContractV1,
  readonly [typeof serviceBearer]
>({
  contract: BillingContractV1,
  serviceName: 'billing',
  routerName: 'billing',
  contributions: [serviceBearer] as const,
});
/**
 * Health check router — implements the Runs service's
 * v1 health contract.
 */

import { v1 } from '@ledgerline/contracts';

const startTime = Date.now();

export const health = {
  check: v1.runs.health.check.handler(() => ({
    status: 'healthy' as const,
    service: 'runs',
    version: '1.0.0',
    timestamp: new Date().toISOString(),
    uptime: Math.floor((Date.now() - startTime) / 1000),
  })),
};
