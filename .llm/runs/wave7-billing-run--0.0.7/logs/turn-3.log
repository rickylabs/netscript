/**
 * PostgreSQL database module.
 *
 * @module
 */

import { enablePrismaTracing } from '@netscript/database/tracing';
import { PrismaPg } from '@prisma/adapter-pg';
import { PrismaClient as PostgresClient } from './schema/.generated/client.server.ts';

if (Deno.env.get('OTEL_DENO') === 'true') {
  enablePrismaTracing();
}

let client: PostgresClient | null = null;

function getClientSync(): PostgresClient {
  if (!client) {
    const connectionString = resolveConnectionString('POSTGRES_URI');
    if (!connectionString) {
      throw new Error('PostgreSQL connection string not found.');
    }
    Deno.env.set('POSTGRES_URI', connectionString);
    Deno.env.set('DATABASE_URL', connectionString);
    client = new PostgresClient({
      adapter: new PrismaPg({ connectionString }),
    });
  }
  return client;
}

/** Get the PostgreSQL Prisma client. */
export function getPostgres(): Promise<PostgresClient> {
  return Promise.resolve(getClientSync());
}

/** Unified database facade for this workspace. */
export const db = {
  get postgres(): PostgresClient {
    return getClientSync();
  },

  get client(): PostgresClient {
    return getClientSync();
  },

  getClient(): Promise<PostgresClient> {
    return Promise.resolve(getClientSync());
  },

  async disconnect(): Promise<void> {
    if (client) {
      await client.$disconnect();
      client = null;
    }
  },

  async healthCheck(): Promise<Record<string, boolean>> {
    try {
      await getClientSync().$queryRawUnsafe('SELECT 1');
      return { postgres: true };
    } catch {
      return { postgres: false };
    }
  },
};

function resolveConnectionString(
  envKey: string,
  fallback?: string,
): string | undefined {
  const rawValue = Deno.env.get(envKey) ?? Deno.env.get('DATABASE_URL') ?? fallback;
  if (!rawValue) {
    return undefined;
  }

  return normalizeDatabaseUrl(rawValue);
}

function normalizeDatabaseUrl(value: string): string {
  return normalizePostgresUrl(value.trim());
}

function normalizePostgresUrl(value: string): string {
  if (/^(postgres|postgresql):\/\//i.test(value)) {
    return value;
  }

  const parts = parseConnectionParts(value);
  const username = encodeURIComponent(
    readConnectionPart(parts, ['username', 'user id', 'uid'], 'postgres'),
  );
  const password = encodeURIComponent(readConnectionPart(parts, ['password', 'pwd'], ''));
  const host = readConnectionPart(parts, ['host', 'server'], 'localhost');
  const port = readConnectionPart(parts, ['port'], '5432');
  const database = readConnectionPart(parts, ['database'], 'postgres');
  return `postgres://${username}:${password}@${host}:${port}/${database}`;
}

function parseConnectionParts(value: string): Record<string, string> {
  const parts: Record<string, string> = {};
  for (const segment of value.split(';')) {
    const trimmed = segment.trim();
    if (!trimmed) continue;
    const separatorIndex = trimmed.indexOf('=');
    if (separatorIndex < 0) continue;
    parts[trimmed.slice(0, separatorIndex).trim().toLowerCase()] = trimmed
      .slice(separatorIndex + 1)
      .trim();
  }
  return parts;
}

function readConnectionPart(
  parts: Record<string, string>,
  keys: readonly string[],
  fallback: string,
): string {
  for (const key of keys) {
    const value = parts[key];
    if (value) return value;
  }
  return fallback;
}

export * from './schema/.generated/client.server.ts';

/** Database client map for typed service contexts. */
export type DB = {
  readonly postgres: PostgresClient;
  readonly client: PostgresClient;
};

export { PostgresClient };
export default db;
