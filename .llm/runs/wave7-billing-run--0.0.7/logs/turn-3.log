        status: 409,
        message: 'Concurrent duplicate request',
        data: z.object({ reason: z.string() }),
      },
    })
    .meta({ access: { authentication: 'required' } }),
} as const;
const impl = implement(C);
void impl.pay.handler(({ input, errors }) => {
  throw errors.CONFLICT({ data: { reason: `key conflict on ${input.id}` } });
});
EOF
