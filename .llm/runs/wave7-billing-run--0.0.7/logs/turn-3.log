# subscriptions domain: createSubscription helper (moved from the router)
s = open('services/billing/src/domain/subscriptions.ts').read()
addition = '''
export async function createSubscription(
  client: PostgresClient,
  input: {
    customerId: string;
    planVersionId: string;
    billingAnchor?: string | undefined;
    actorId: string;
  },
) {
  const planVersion = await client.planVersion.findUnique({
    where: { id: input.planVersionId },
  });
  if (!planVersion || planVersion.status !== 'ACTIVE') {
    throw new DomainStateError('target plan version is not active');
  }
  const customer = await client.customer.findUnique({ where: { id: input.customerId } });
  if (!customer) throw new NotFoundError('customer', input.customerId);
  return await withTransaction(client, async (tx) => {
    const row = await tx.subscription.create({
      data: {
        customerId: input.customerId,
        planVersionId: input.planVersionId,
        status: 'ACTIVE',
        billingAnchor: input.billingAnchor ? new Date(input.billingAnchor) : new Date(),
      },
    });
    await tx.auditEvent.create({
      data: {
        actorId: input.actorId,
        action: 'subscription.created',
        target: `subscription:${row.id}`,
      },
    });
    return row;
  });
}
'''
s = s.rstrip() + '\n' + addition
open('services/billing/src/domain/subscriptions.ts','w').write(s)
print('ok')
EOF
