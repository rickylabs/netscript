import { baseContract } from '@netscript/contracts';
import { z } from 'zod';
import { implement } from '@orpc/server';

const C = {
  pay: baseContract
    .route({ method: 'POST', path: '/probe/{id}/pay' })
    .input(z.object({ id: z.string() }))
    .output(z.object({ id: z.string() }))
    .errors({
