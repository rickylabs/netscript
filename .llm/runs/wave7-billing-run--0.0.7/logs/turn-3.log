// ---------------------------------------------------------------------------
// Reads
// ---------------------------------------------------------------------------

export async function listSubscriptions(
  client: PostgresClient,
  input: { limit: number; offset?: number | undefined; customerId?: string | undefined; status?: 'TRIALING' | 'ACTIVE' | 'PAST_DUE' | 'CANCELED' | 'ENDED' | undefined },
) {
  const where = {
    ...(input.customerId ? { customerId: input.customerId } : {}),
    ...(input.status ? { status: input.status } : {}),
  };
  const [rows, total] = await Promise.all([
    client.subscription.findMany({
      where,
      orderBy: { startedAt: 'asc' },
      take: input.limit,
      skip: input.offset ?? 0,
      include: { changes: { where: { appliedAt: null } } },
    }),
    client.subscription.count({ where }),
  ]);
  return { items: rows, total };
}

export async function getSubscription(client: PostgresClient, id: string) {
  const row = await client.subscription.findUnique({
    where: { id },
    include: { changes: { where: { appliedAt: null } } },
  });
  if (!row) throw new NotFoundError('subscription', id);
  return row;
}
EOF
