[0m$ [0mcat >> services/billing/src/domain/invoices.ts <<'EOF'

// ---------------------------------------------------------------------------
// Reads
// ---------------------------------------------------------------------------

export async function listInvoices(
  client: PostgresClient,
  input: { limit: number; offset?: number | undefined; customerId?: string | undefined; status?: 'DRAFT' | 'OPEN' | 'PAID' | 'VOID' | 'UNCOLLECTIBLE' | undefined },
) {
  const where = {
    ...(input.customerId ? { customerId: input.customerId } : {}),
    ...(input.status ? { status: input.status } : {}),
  };
  const [rows, total] = await Promise.all([
    client.invoice.findMany({
      where,
      orderBy: { periodStart: 'desc' },
      take: input.limit,
      skip: input.offset ?? 0,
    }),
    client.invoice.count({ where }),
  ]);
  return { items: rows, total };
}

/** Load an invoice with its lines, payments and credit notes (detail read). */
export async function getInvoiceDetail(client: PostgresClient, id: string) {
  const row = await client.invoice.findUnique({
    where: { id },
    include: { lines: true, payments: true, creditNotes: true },
  });
  if (!row) throw new NotFoundError('invoice', id);
  return row;
}
EOF
