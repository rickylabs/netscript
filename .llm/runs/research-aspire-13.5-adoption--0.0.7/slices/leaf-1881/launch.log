urface.ts:201:  README_QUICKSTART_DB_INIT: 'readme.quickstart.08-db-init',\npackages/cli/e2e/src/domain/cli-surface.ts:202:  README_QUICKSTART_DB_GENERATE: 'readme.quickstart.09-db-generate',\npackages/cli/e2e/src/domain/cli-surface.ts:203:  README_QUICKSTART_DB_SEED: 'readme.quickstart.10-db-seed',\npackages/cli/e2e/src/domain/cli-surface.ts:204:  README_QUICKSTART_CURL_HEALTH: 'readme.quickstart.11-curl-health',\npackages/cli/e2e/src/domain/cli-surface.ts:227:export type QuickstartSuiteId = typeof QUICKSTART[keyof typeof QUICKSTART];\npackages/cli/e2e/tests/presentation/suite-registry_test.ts:6:  QUICKSTART,\npackages/cli/e2e/tests/presentation/suite-registry_test.ts:38:    QUICKSTART.WALK,\npackages/cli/e2e/tests/presentation/suite-registry_test.ts:39:    QUICKSTART.README,\npackages/cli/e2e/tests/presentation/suite-registry_test.ts:270:    [QUICKSTART.WALK]: [],\npackages/cli/e2e/tests/presentation/suite-registry_test.ts:271:    [QUICKSTART.README]: [],\npackages/cli/e2e/tests/presentation/suite-registry_test.ts:640:    [QUICKSTART.WALK, { ...common, packageSource: PACKAGE_SOURCE.JSR }],\npackages/cli/e2e/tests/presentation/suite-registry_test.ts:641:    [QUICKSTART.README, {\n","exitCode":0,"durationMs":0},"threadId":"01a06491-c069-7610-999b-e4f3efa4096f","turnId":"01a06491-c0b5-7811-a584-1b84e145973e","completedAtMs":1788394720194},"emittedAtMs":1788394720197}
