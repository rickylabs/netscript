t argv = command.split(/\\s+/).filter((part) => part.length > 0);\n+  if (argv.length === 0) throw new Error(`README line ${line} is empty.`);\n+  return Object.freeze(argv);\n+}\n+\n+/** Select the first explicit HTTP(S) service port from an Aspire describe receipt. */\n+export function explicitServicePort(urls: readonly string[]): number {\n+  for (const candidate of urls) {\n+    const url = new URL(candidate);\n+    if ((url.protocol !== 'http:' && url.protocol !== 'https:') || url.port === '') continue;\n+    const port = Number(url.port);\n+    if (Number.isSafeInteger(port) && port > 0 && port <= 65_535) return port;\n+  }\n+  throw new Error(`service receipt contained no explicit HTTP port: ${urls.join(', ')}`);\n+}\n+\n function markerIndex(lines: readonly string[], marker: string): number {\n"},{"path":"/home/agent/projects/netscript/worktrees/007-aspire-leaf-1881/packages/cli/e2e/suites/quickstart/readme-quickstart-suite.ts","kind":{"type":"update","move_path":null},"diff":"@@ -53,3 +53,2 @@\n   };\n-  const repoRoot = options.repoRoot;\n   return Object.freeze({\n@@ -62,3 +61,2 @@\n       projectName: 'my-app',\n-      smokeRoot: repoRoot,\n     }),\n@@ -110,2 +108,4 @@\n     context.project.repoRoot,\n+    context.project.smokeRoot,\n+    context.project.appHost,\n     String(index),\n"},{"path":"/home/agent/projects/netscript/worktrees/007-aspire-leaf-1881/packages/cli/e2e/tests/presentation/readme-quickstart-suite_test.ts","kind":{"type":"update","move_path":null},"diff":"@@ -16,3 +16,3 @@\n   assertEquals(suite.defaultOptions.projectName, 'my-app');\n-  assertEquals(suite.defaultOptions.smokeRoot, '/repo');\n+  assertEquals(suite.defaultOptions.smokeRoot.endsWith('/.llm/tmp/cli-e2e'), true);\n   assertEquals(suite.gates.map((gate) => gate.id), [\n"}],"status":"inProgress"},"threadId":"01a06491-c069-7610-999b-e4f3efa4096f","turnId":"01a06491-c0b5-7811-a584-1b84e145973e","startedAtMs":1788395197654},"emittedAtMs":1788395197654}
