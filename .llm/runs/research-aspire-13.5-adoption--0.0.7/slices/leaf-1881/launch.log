{"method":"item/completed","params":{"item":{"type":"commandExecution","id":"exec-32e0435d-b923-486a-99b9-929f7019a66c","pluginId":null,"scriptPath":null,"command":"/bin/bash -lc \"sed -n '1,300p' .github/workflows/e2e-cli-prod.yml\nsed -n '300,620p' .github/workflows/e2e-cli-prod.yml\ngit status --short\ngit log --oneline -3\"","cwd":"/home/agent/projects/netscript/worktrees/007-aspire-leaf-1881","processId":"98862","source":"unifiedExecStartup","status":"completed","commandActions":[{"type":"unknown","command":"sed -n '1,300p' .github/workflows/e2e-cli-prod.yml\nsed -n '300,620p' .github/workflows/e2e-cli-prod.yml\ngit status --short\ngit log --oneline -3"}],"aggregatedOutput":"name: e2e-cli-prod\n\non:\n  workflow_run:\n    workflows: [\"publish\"]\n    types: [completed]\n  workflow_dispatch:\n    inputs:\n      published-version:\n        description: Published @netscript/cli version to validate\n        required: true\n        type: string\n\npermissions:\n  actions: read\n  contents: read\n\nconcurrency:\n  group: e2e-cli-prod-${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: false\n\njobs:\n  scaffold-runtime-jsr:\n    name: scaffold-runtime (published JSR CLI)\n    if: ${{ github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 75\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v5\n\n      - name: Setup Deno\n        uses: denoland/setup-deno@v2\n        with:\n          deno-version: '2.9.5'\n\n      - name: Setup .NET\n        uses: actions/setup-dotnet@v5\n        with:\n          dotnet-version: '10.0.x'\n\n      - name: Restore pinned Aspire NuGet package cache\n        uses: actions/cache@v4\n        with:\n          path: ~/.nuget/packages\n          key: nuget-aspire-${{ runner.os }}-13.5.3-v1\n\n      - name: Install Aspire CLI\n        run: |\n          dotnet tool install Aspire.Cli --tool-path \"$HOME/.aspire/bin\" --version 13.5.3\n          echo \"$HOME/.aspire/bin\" >> \"$GITHUB_PATH\"\n\n      - name: Aspire CLI preflight\n        run: |\n          aspire_version=\"$(aspire --version)\"\n          echo \"$aspire_version\"\n          case \"$aspire_version\" in\n            13.5.*) ;;\n            *) echo \"Expected Aspire CLI 13.5.x, got $aspire_version\" >&2; exit 1 ;;\n          esac\n          aspire doctor --non-interactive --nologo\n\n      - name: Download published version\n        if: github.event_name == 'workflow_run'\n        uses: actions/download-artifact@v5\n        with:\n          name: netscript-published-version-${{ github.event.workflow_run.id }}\n          run-id: ${{ github.event.workflow_run.id }}\n          github-token: ${{ github.token }}\n          path: .llm/tmp/published-version\n\n      - name: Resolve published version\n        id: version\n        env:\n          DISPATCH_VERSION: ${{ github.event.inputs['published-version'] }}\n          VERSION_FILE: .llm/tmp/published-version/version.txt\n        run: |\n          version=\"${DISPATCH_VERSION:-}\"\n          if [ -z \"$version\" ] && [ -f \"$VERSION_FILE\" ]; then\n            version=\"$(cat \"$VERSION_FILE\")\"\n          fi\n          if [ -z \"$version\" ]; then\n            echo \"A published version is required.\" >&2\n            exit 1\n          fi\n          echo \"version=$version\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Wait for JSR propagation\n        run: |\n          echo \"sleeping 120s so just-published @netscript/cli@${{ steps.version.outputs.version }} and deps become resolvable on JSR before install.\"\n          sleep 120\n\n      - name: Install published CLI from JSR\n        id: install_published_cli\n        run: |\n          echo \"$HOME/.deno/bin\" >> \"$GITHUB_PATH\"\n          deno install -g -A --minimum-dependency-age=0 -n netscript \"jsr:@netscript/cli@${{ steps.version.outputs.version }}\"\n          netscript --help\n\n      - name: Install workspace dependencies\n        id: install_workspace_dependencies\n        run: deno install\n\n      - name: Public init smoke from JSR CLI\n        run: |\n          rm -rf .llm/tmp/cli-prod-init-smoke\n          netscript init cli-prod-init-smoke \\\n            --path .llm/tmp \\\n            --ci \\\n            --yes \\\n            --no-git \\\n            --no-aspire \\\n            --force\n          test -f .llm/tmp/cli-prod-init-smoke/deno.json\n\n      - name: Full scaffold runtime E2E (published CLI, one pass)\n        run: |\n          deno task e2e:cli run scaffold.runtime \\\n            --source jsr \\\n            --cli \"jsr:@netscript/cli@${{ steps.version.outputs.version }}\" \\\n            --cleanup \\\n            --format pretty \\\n            --report .llm/tmp/cli-e2e-prod-report.json \\\n            --log-file .llm/tmp/cli-e2e-prod.ndjson\n\n      - name: Quickstart walk E2E (published CLI, seven verdicts)\n        if: ${{ always() && steps.install_published_cli.outcome == 'success' && steps.install_workspace_dependencies.outcome == 'success' }}\n        run: |\n          deno task e2e:cli run quickstart.walk \\\n            --source jsr \\\n            --cli \"jsr:@netscript/cli@${{ steps.version.outputs.version }}\" \\\n            --cleanup \\\n            --format pretty \\\n            --report .llm/tmp/quickstart-walk-prod-report.json \\\n            --log-file .llm/tmp/quickstart-walk-prod.ndjson\n\n      - name: Report production E2E failure\n        if: failure()\n        run: |\n          found=false\n          for report in .llm/tmp/cli-e2e-prod-report.json .llm/tmp/quickstart-walk-prod-report.json; do\n            if [ -f \"$report\" ]; then\n              found=true\n              deno run --allow-read --allow-env=GITHUB_STEP_SUMMARY --allow-write=\"$GITHUB_STEP_SUMMARY\" \\\n                .llm/tools/e2e/print-failed-report-steps.ts --github \"$report\" || true\n            fi\n          done\n          if [ \"$found\" = false ]; then\n            message=\"Production CLI E2E failed for @netscript/cli@${{ steps.version.outputs.version }}; no JSON report was produced.\"\n            echo \"::error::$message\"\n            printf '## Production CLI E2E failure\\n\\n%s\\n' \"$message\" >> \"$GITHUB_STEP_SUMMARY\"\n          fi\n\n      - name: Upload production E2E artifacts\n        if: always()\n        uses: actions/upload-artifact@v5\n        with:\n          name: e2e-cli-prod-${{ steps.version.outputs.version }}\n          path: |\n            .llm/tmp/cli-e2e-prod-report.json\n            .llm/tmp/cli-e2e-prod.ndjson\n            .llm/tmp/quickstart-walk-prod-report.json\n            .llm/tmp/quickstart-walk-prod.ndjson\n            ~/.aspire/logs/cli_*.log\n          if-no-files-found: ignore\n7729b9aa0 test(e2e): execute root README quickstart once\n75c41ee15 test(e2e): lock README quickstart walk design\n79adb103b fix(e2e): resolve live database endpoint deterministically (#1962)\n","exitCode":0,"durationMs":0},"threadId":"01a06491-c069-7610-999b-e4f3efa4096f","turnId":"01a06491-c0b5-7811-a584-1b84e145973e","completedAtMs":1788395483094},"emittedAtMs":1788395483096}
