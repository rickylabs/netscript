ns[0].argv, EXPECTED_INSTALL_ARGV);\n    assertEquals(spawns[0].argv.includes('-f'), false);\n    assertEquals(\n      spawns[0].argv.filter((token) => token === '--minimum-dependency-age=0').length,\n      1,\n    );\n    assertEquals(spawns[0].env?.DENO_INSTALL_ROOT, denoInstallRoot);\n    assertEquals(spawns[0].env?.PATH?.startsWith(`${pathPrepend}${DELIMITER}`), true);\n    assertEquals(spawns[1].env, spawns[0].env);\n    const receipt = JSON.parse(\n      await Deno.readTextFile(resolve(temporaryRoot, 'receipts', '01.json')),\n    );\n    assertEquals(\n      receipt.sourceCommand.split('--minimum-dependency-age=0').length - 1,\n      1,\n    );\n    assertEquals(receipt.environment, { denoInstallRoot, pathPrepend });\n  } finally {\n    await Deno.remove(temporaryRoot, { recursive: true });\n  }\n});\n=== arch-debt delta\n(empty means unchanged)","is_error":false}]},"parent_tool_use_id":null,"session_id":"b67d4969-52f8-4250-a60d-12f95d855ad9","uuid":"2f6a56d8-5f02-4be5-a449-6d162da63ea9","timestamp":"2026-09-03T03:13:26.971Z","tool_use_result":{"stdout":"=== usages\npackages/cli/e2e/src/application/gates/quickstart/readme-command.ts:5:  README_QUICKSTART_EXPECTED_COMMANDS,\npackages/cli/e2e/src/application/gates/quickstart/readme-command.ts:36:  readonly sourceCommand: string;\npackages/cli/e2e/src/application/gates/quickstart/readme-command.ts:121:    sourceCommand: entry.command,\npackages/cli/e2e/src/application/gates/quickstart/readme-command.ts:206:  if (actual.length !== README_QUICKSTART_EXPECTED_COMMANDS.length) {\npackages/cli/e2e/src/application/gates/quickstart/readme-command.ts:209:        `readme.quickstart expects ${README_QUICKSTART_EXPECTED_COMMANDS.length}.`,\npackages/cli/e2e/src/application/gates/quickstart/readme-command.ts:213:    if (actual[index] !== README_QUICKSTART_EXPECTED_COMMANDS[index]) {\npackages/cli/e2e/src/application/gates/quickstart/readme-command.ts:216:          `${JSON.stringify(README_QUICKSTART_EXPECTED_COMMANDS[index])