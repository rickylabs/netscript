string,\n54\t  runRoot: string,\n55\t  appHost: string,\n56\t  index: number,\n57\t  cliSpecifier: string,\n58\t  statePath: string,\n59\t  timeoutMs: number,\n60\t  spawn: AspireCommandRunner = runAspireCommand,\n61\t): Promise<number> {\n62\t  const readme = await Deno.readTextFile(resolve(repoRoot, 'README.md'));\n63\t  const commands = parseReadmeQuickstartCommands(readme);\n64\t  assertExpectedCommands(commands.map((entry) => entry.command));\n65\t  const entry = commands[index];\n66\t  if (!entry) throw new Error(`README Quickstart command index ${index} does not exist.`);\n67\t\n68\t  const version = publishedVersion(cliSpecifier, entry.line);\n69\t  const state = index === 0\n70\t    ? await initializeState(runRoot, statePath)\n71\t    : await readState(statePath, entry.line);\n72\t  if (state.nextIndex !== index) {\n73\t    throw new Error(\n74\t      `README line ${entry.line} cannot run out of order: expected command index ` +\n75\t        `${state.nextIndex}, received ${index}.`,\n76\t    );\n77\t  }\n78\t\n79\t  if (\n80\t    entry.command.includes('<port>') && state.servicePort === undefined && state.servicePortError\n81\t  ) {\n82\t    throw new Error(\n83\t      `README line ${entry.line} cannot substitute <port>: ${state.servicePortError}.`,\n84\t    );\n85\t  }\n86\t  const substituted = substituteReadmeQuickstartCommand(\n87\t    entry.command,\n88\t    { version, port: state.servicePort },\n89\t    entry.line,\n90\t  );\n91\t  const argv = readmeQuickstartArgv(substituted, entry.line);\n92\t  const environment = readmeCommandEnvironment(state.denoInstallRoot);\n93\t  const started = performance.now();\n94\t  const result = argv[0] === 'cd'\n95\t    ? await changeDirectory(argv, state.cwd, entry.line)\n96\t    : await runCommand(argv, state.cwd, timeoutMs, environment.env, spawn);\n97\t  const durationMs = Math.round(performance.now() - started);\n98\t  let nextState: ReadmeWalkState = state;\n99\t  if (result.code === 0 && !result.timedOut) {\n100\t    nextState = {\n101\t      ...state,\n102\t      cwd: argv[0] === 'cd' ? resolve(state.cwd, argv[1]) : state.cwd,\n103\t      nextIndex: index + 1,\n104\t    };\n105\t    if (entry.command.startsWith('aspire wait ')) {\n106\t      nextState = await captureServicePort(nextState, appHost);\n107\t    }\n108\t    await writeState(statePath, nextState);\n109\t  }\n110\t\n111\t  const receipt: ReadmeCommandReceipt = Object.freeze({\n112\t    argv,\n113\t    cwd: state.cwd,\n114\t    durationMs,\n115\t    environment: Object.freeze({\n116\t      denoInstallRoot: state.denoInstallRoot,\n117\t      pathPrepend: environment.pathPrepend,\n118\t    }),\n119\t    exitCode: result.code,\n120\t    readmeLine: entry.line,\n121\t    sourceCommand: entry.command,\n122\t    stderrTail: tail(result.stderr),\n123\t    stdoutTail: tail(result.stdout),\n124\t    substitutions: Object.freeze({\n125\t      ...(entry.command.includes('<version>') ? { version } : {}),\n126\t      ...(entry.command.includes('<port>') && state.servicePort !== undefined\n127\t        ? { port: state.servicePort }\n128\t        : {}),\n129\t    }),\n130\t    ...(entry.command.startsWith('aspire wait ') &&\n131\t        (nextState.servicePort !== undefined || nextState.servicePortError !== undefined)\n132\t      ? {\n133\t        evidence: {\n134\t          ...(nextState.servicePort === undefined ? {} : { servicePort: nextState.servicePort }),\n135\t          ...(nextState.servicePortSource === undefined\n136\t            ? {}\n137\t            : { source: nextState.servicePortSource }),\n138\t          ...(nextState.servicePortError === undefined\n139\t            ? {}\n140\t            : { error: nextState.servicePortError }),\n141\t        },\n142\t      }\n143\t      : {}),\n144\t    timedOut: result.timedOut,\n145\t  });\n146\t  await writeReceipt(statePath, index, receipt);\n147\t  console.info(JSON.stringify(receipt));\n148\t  if (result.code !== 0 || result.timedOut) {\n149\t    console.error(\n150\t      `README line ${entry.line} failed exactly as printed: ${entry.command}`,\n151\t    );\n152\t  }\n153\t  return result.code;\n154\t}\n155\t\n156\tasync function runCommand(\n157\t  argv: readonly string[],\n158\t  cwd: string,\n159\t  timeoutMs: number,\n160\t  env: Record<string, string>,\n161\t  spawn: AspireCommandRunner,\n162\t): Promise<{ code: number; stdout: string; stderr: string; timedOut: boolean }> {\n163\t  try {\n164\t    return await spawn(argv, cwd, timeoutMs, env);\n165\t  } catch (error) {\n166\t    return {\n167\t      code: 1,\n168\t      stdout: '',\n169\t      stderr: `Command could not start: ${errorMessage(error)}`,\n170\t      timedOut: false,\n171\t    };\n172\t  }\n173\t}\n174\t\n175\tasync function initializeState(runRoot: string, statePath: string): Promise<ReadmeWalkState> {\n176\t  await Deno.mkdir(runRoot, { recursive: true });\n177\t  const denoInstallRoot = resolve(runRoot, DENO_INSTALL_DIRECTORY);\n178\t  try {\n179\t    await Deno.remove(denoInstallRoot, { recursive: true });\n180\t  } catch (error) {\n181\t    if (!(error instanceof Deno.errors.NotFound)) throw error;\n182\t  }\n183\t  await Deno.mkdir(denoInstallRoot, { recursive: true });\n184\t  try {\n185\t    await Deno.remove(resolve(dirname(statePath), 'receipts'), { recursive: true });\n186\t  } catch (error) {\n187\t    if (!(error instanceof Deno.errors.NotFound)) throw error;\n188\t  }\n189\t  return Object.freeze({ cwd: runRoot, denoInstallRoot, nextIndex: 0 });\n190\t}\n191\t\n192\tfunction readmeCommandEnvironment(\n193\t  denoInstallRoot: string,\n194\t): { env: Record<string, string>; pathPrepend: string } {\n195\t  const pathPrepend = resolve(denoInstallRoot, 'bin');\n196\t  return {\n197\t    env: {\n198\t      DENO_INSTALL_ROOT: denoInstallRoot,\n199\t      PATH: `${pathPrepend}${DELIMITER}${Deno.env.get('PATH') ?? ''}`,\n200\t    },\n201\t    pathPrepend,\n202\t  };\n203\t}\n204\t\n205\tfunction assertExpectedCommands(actual: readonly string[]): void {\n206\t  if (actual.length !== README_QUICKSTART_EXPECTED_COMMANDS.length) {\n207\t    throw new Error(\n208\t      `README Quickstart contains ${actual.length} commands; ` +\n209\t        `readme.quickstart expects ${README_QUICKSTART_EXPECTED_COMMANDS.length}.`,\n210\t    );\n211\t  }\n212\t  for (let index = 0; index < actual.length; index++) {\n213\t    if (actual[index] !== README_QUICKSTART_EXPECTED_COMMANDS[index]) {\n214\t      throw new Error(\n215\t        `README Quickstart command ${index + 1} diverged: expected ` +\n216\t          `${JSON.stringify(README_QUICKSTART_EXPECTED_COMMANDS[index])}, received ` +\n217\t          `${JSON.stringify(actual[index])}.`,\n218\t      );\n219\t    }\n220\t  }\n221\t}\n222\t\n223\tfunction publishedVersion(specifier: string, line: number): string {\n224\t  if (!specifier.startsWith(JSR_CLI_PREFIX)) {\n225\t    throw new Error(\n226\t      `README line ${line} requires --source jsr and --cli ${JSR_CLI_PREFIX}<version>.`,\n227\t    );\n228\t  }\n229\t  const version = specifier.slice(JSR_CLI_PREFIX.length);\n230\t  if (!version || /\\s/.test(version)) {\n231\t    throw new Error(`README line ${line} received an invalid published CLI version.`);\n232\t  }\n233\t  return version;\n234\t}\n235\t\n236\tasync function changeDirectory(\n237\t  argv: readonly string[],\n238\t  cwd: string,\n239\t  line: number,\n240\t): Promise<{ code: number; stdout: string; stderr: string; timedOut: boolean }> {\n241\t  if (argv.length !== 2) {\n242\t    return {\n243\t      code: 2,\n244\t      stdout: '',\n245\t      stderr: `README line ${line} has an unsupported cd shape.`,\n246\t      timedOut: false,\n247\t    };\n248\t  }\n249\t  const target = resolve(cwd, argv[1]);\n250\t  try {\n251\t    const info = await Deno.stat(target);\n252\t    if (!info.isDirectory) throw new Error('target is not a directory');\n253\t    return { code: 0, stdout: '', stderr: '', timedOut: false };\n254\t  } catch (error) {\n255\t    return {\n256\t      code: 1,\n257\t      stdout: '',\n258\t      stderr: `README line ${line} cd ${argv[1]} failed: ${errorMessage(error)}`,\n259\t      timedOut: false,\n260\t    };\n261\t  }\n262\t}\n263\t\n264\tasync function captureServicePort(\n265\t  state: ReadmeWalkState,\n266\t  appHost: string,\n267\t): Promise<ReadmeWalkState> {\n268\t  try {\n269\t    const urls = await resolveResourceUrlsFromAppHost(appHost, SERVICE_RESOURCE);\n270\t    const port = explicitServicePort(urls);\n271\t    return Object.freeze({\n272\t      ...state,\n273\t      servicePort: port,\n274\t      servicePortSource: `aspire describe ${SERVICE_RESOURCE} run receipt`,\n275\t    });\n276\t  } catch (error) {\n277\t    return Object.freeze({\n278\t      ...state,\n279\t      servicePortError: `service-port receipt failed: ${errorMessage(error)}`,\n280\t    });\n281\t  }\n282\t}\n283\t\n284\tasync function readState(path: string, line: number): Promise<ReadmeWalkState> {\n285\t  let parsed: unknown;\n286\t  try {\n287\t    parsed = JSON.parse(await Deno.readTextFile(path));\n288\t  } catch (error) {\n289\t    throw new Error(`README line ${line} cannot read prior run receipt: ${errorMessage(error)}.`);\n290\t  }\n291\t  if (\n292\t    !isRecord(parsed) || typeof parsed.cwd !== 'string' ||\n293\t    typeof parsed.denoInstallRoot !== 'string' ||\n294\t    typeof parsed.nextIndex !== 'number'\n295\t  ) {\n296\t    throw new Error(`README line ${line} found a malformed prior run receipt.`);\n297\t  }\n298\t  const servicePort = parsed.servicePort;\n299\t  const servicePortSource = parsed.servicePortSource;\n300\t  const servicePortError = parsed.servicePortError;\n301\t  if (servicePort !== undefined && typeof servicePort !== 'number') {\n302\t    throw new Error(`README line ${line} found a malformed service port receipt.`);\n303\t  }\n304\t  if (servicePortSource !== undefined && typeof servicePortSource !== 'string') {\n305\t    throw new Error(`README line ${line} found a malformed service port source.`);\n306\t  }\n307\t  if (servicePortError !== undefined && typeof servicePortError !== 'string') {\n308\t    throw new Error(`README line ${line} found a malformed service port error.`);\n309\t  }\n310\t  return Object.freeze({\n311\t    cwd: parsed.cwd,\n312\t    denoInstallRoot: parsed.denoInstallRoot,\n313\t    nextIndex: parsed.nextIndex,\n314\t    ...(servicePort === undefined ? {} : { servicePort }),\n315\t    ...(servicePortSource === undefined ? {} : { servicePortSource }),\n316\t    ...(servicePortError === undefined ? {} : { servicePortError }),\n317\t  });\n318\t}\n319\t\n320\tasync function writeState(path: string, state: ReadmeWalkState): Promise<void> {\n321\t  await Deno.mkdir(dirname(path), { recursive: true });\n322\t  const temporary = `${path}.tmp`;\n323\t  await Deno.writeTextFile(temporary, `${JSON.stringify(state, null, 2)}\\n`);\n324\t  await Deno.rename(temporary, path);\n325\t}\n326\t\n327\tasync function writeReceipt(\n328\t  statePath: string,\n329\t  index: number,\n330\t  receipt: ReadmeCommandReceipt,\n331\t): Promise<void> {\n332\t  const path = resolve(\n333\t    dirname(statePath),\n334\t    'receipts',\n335\t    `${String(index + 1).padStart(2, '0')}.json`,\n336\t  );\n337\t  await Deno.mkdir(dirname(path), { recursive: true });\n338\t  await Deno.writeTextFile(path, `${JSON.stringify(receipt, null, 2)}\\n`);\n339\t}\n340\t\n341\tfunction isRecord(value: unknown): value is Record<string, unknown> {\n342\t  return typeof value === 'object' && value !== null && !Array.isArray(value);\n343\t}\n344\t\n345\tfunction errorMessage(error: unknown): string {\n346\t  return error instanceof Error ? error.message : String(error);\n347\t}\n348\t\n349\tfunction tail(text: string): string {\n350\t  return text.length > RECEIPT_TAIL_LENGTH ? text.slice(-RECEIPT_TAIL_LENGTH) : text;\n351\t}\n352\t\n353\tif (import.meta.main) {\n354\t  const [repoRoot, runRoot, appHost, rawIndex, cliSpecifier, statePath, rawTimeout] = Deno.args;\n355\t  const index = Number(rawIndex);\n356\t  const timeoutMs = Number(rawTimeout);\n357\t  if (\n358\t    !repoRoot || !runRoot || !appHost || !Number.isSafeInteger(index) || !cliSpecifier ||\n359\t    !statePath ||\n360\t    !Number.isSafeInteger(timeoutMs) || timeoutMs <= 0\n361\t  ) {\n362\t    throw new Error(\n363\t      'repo root, run root, AppHost, command index, CLI specifier, state path, and timeout are required',\n364\t    );\n365\t  }\n366\t  try {\n367\t    Deno.exitCode = await executeReadmeQuickstartCommand(\n368\t      repoRoot,\n369\t      runRoot,\n370\t      appHost,\n371\t      index,\n372\t      cliSpecifier,\n373\t      statePath,\n374\t      timeoutMs,\n375\t    );\n376\t  } catch (error) {\n377\t    console.error(errorMessage(error));\n378\t    Deno.exitCode = 1;\n379\t  }\n380\t}\n381\t"}]},"parent_tool_use_id":null,"session_id":"229add02-ca41-444b-82ba-387aaf5372ff","uuid":"4c6b9a21-2c05-4565-ae2f-d13242c48f8c","timestamp":"2026-09-03T02:23:31.104Z","tool_use_result":{"type":"text","file":{"filePath":"/home/agent/projects/netscript/worktrees/007-aspire-leaf-1881-fix-eval/packages/cli/e2e/src/application/gates/quickstart/readme-command.ts","content":"import { DELIMITER, dirname, resolve } from '@std/path';\nimport {\n  explicitServicePort,\n  parseReadmeQuickstartCommands,\n  README_QUICKSTART_EXPECTED_COMMANDS,\n  readmeQuickstartArgv,\n  substituteReadmeQuickstartCommand,\n} from '../../../domain/readme-quickstart.ts';\nimport { resolveResourceUrlsFromAppHost } from '../scaffold/generated-app-endpoint.ts';\nimport { type AspireCommandRunner, runAspireCommand } from './aspire-walk.ts';\n\nconst JSR_CLI_PREFIX = 'jsr:@netscript/cli@';\nconst SERVICE_RESOURCE = 'users';\nconst RECEIPT_TAIL_LENGTH = 4_000;\nconst DENO_INSTALL_DIRECTORY = '.deno-install';\n\ninterface ReadmeWalkState {\n  readonly cwd: string;\n  readonly denoInstallRoot: string;\n  readonly nextIndex: number;\n  readonly servicePort?: number;\n  readonly servicePortSource?: string;\n  readonly servicePortError?: string;\n}\n\ninterface ReadmeCommandReceipt {\n  readonly argv: readonly string[];\n  readonly cwd: string;\n  readonly durationMs: number;\n  readonly environment: {\n    readonly denoInstallRoot: string;\n    readonly pathPrepend: string;\n  };\n  readonly exitCode: number;\n  readonly readmeLine: number;\n  readonly sourceCommand: string;\n  readonly stderrTail: string;\n  readonly stdoutTail: string;\n  readonly substitutions: {\n    readonly port?: number;\n    readonly version?: string;\n  };\n  readonly evidence?: {\n    readonly error?: string;\n    readonly servicePort?: number;\n    readonly source?: string;\n  };\n  readonly timedOut: boolean;\n}\n\n/** Execute one indexed root README Quickstart command and emit its child receipt. */\nexport async function executeReadmeQuickstartCommand(\n  repoRoot: string,\n  runRoot: string,\n  appHost: string,\n  index: number,\n  cliSpecifier: string,\n  statePath: string,\n  timeoutMs: number,\n  spawn: AspireCommandRunner = runAspireCommand,\n): Promise<number> {\n  const readme = await Deno.readTextFile(resolve(repoRoot, 'README.md'));\n  const commands = parseReadmeQuickstartCommands(readme);\n  assertExpectedCommands(commands.map((entry) => entry.command));\n  const entry = commands[index];\n  if (!entry) throw new Error(`README Quickstart command index ${index} does not exist.`);\n\n  const version = publishedVersion(cliSpecifier, entry.line);\n  const state = index === 0\n    ? await initializeState(runRoot, statePath)\n    : await readState(statePath, entry.line);\n  if (state.nextIndex !== index) {\n    throw new Error(\n      `README line ${entry.line} cannot run out of order: expected command index ` +\n        `${state.nextIndex}, received ${index}.`,\n    );\n  }\n\n  if (\n    entry.command.includes('<port>') && state.servicePort === undefined && state.servicePortError\n  ) {\n    throw new Error(\n      `README line ${entry.line} cannot substitute <port>: ${state.servicePortError}.`,\n    );\n  }\n  const substituted = substituteReadmeQuickstartCommand(\n    entry.command,\n    { version, port: state.servicePort },\n    entry.line,\n  );\n  const argv = readmeQuickstartArgv(substituted, entry.line);\n  const environment = readmeCommandEnvironment(state.denoInstallRoot);\n  const started = performance.now();\n  const result = argv[0] === 'cd'\n    ? await changeDirectory(argv, state.cwd, entry.line)\n    : await runCommand(argv, state.cwd, timeoutMs, environment.env, spawn);\n  const durationMs = Math.round(performance.now() - started);\n  let nextState: ReadmeWalkState = state;\n  if (result.code === 0 && !result.timedOut) {\n    nextState = {\n      ...state,\n      cwd: argv[0] === 'cd' ? resolve(state.cwd, argv[1]) : state.cwd,\n      nextIndex: index + 1,\n    };\n    if (entry.command.startsWith('aspire wait ')) {\n      nextState = await captureServicePort(nextState, appHost);\n    }\n    await writeState(statePath, nextState);\n  }\n\n  const receipt: ReadmeCommandReceipt = Object.freeze({\n    argv,\n    cwd: state.cwd,\n    durationMs,\n    environment: Object.freeze({\n      denoInstallRoot: state.denoInstallRoot,\n      pathPrepend: environment.pathPrepend,\n    }),\n    exitCode: result.code,\n    readmeLine: entry.line,\n    sourceCommand: entry.command,\n    stderrTail: tail(result.stderr),\n    stdoutTail: tail(result.stdout),\n    substitutions: Object.freeze({\n      ...(entry.command.includes('<version>') ? { version } : {}),\n      ...(entry.command.includes('<port>') && state.servicePort !== undefined\n        ? { port: state.servicePort }\n        : {}),\n    }),\n    ...(entry.command.startsWith('aspire wait ') &&\n        (nextState.servicePort !== undefined || nextState.servicePortError !== undefined)\n      ? {\n        evidence: {\n          ...(nextState.servicePort === undefined ? {} : { servicePort: nextState.servicePort }),\n          ...(nextState.servicePortSource === undefined\n            ? {}\n            : { source: nextState.servicePortSource }),\n          ...(nextState.servicePortError === undefined\n            ? {}\n            : { error: nextState.servicePortError }),\n        },\n      }\n      : {}),\n    timedOut: result.timedOut,\n  });\n  await writeReceipt(statePath, index, receipt);\n  console.info(JSON.stringify(receipt));\n  if (result.code !== 0 || result.timedOut) {\n    console.error(\n      `README line ${entry.line} failed exactly as printed: ${entry.command}`,\n    );\n  }\n  return result.code;\n}\n\nasync function runCommand(\n  argv: readonly string[],\n  cwd: string,\n  timeoutMs: number,\n  env: Record<string, string>,\n  spawn: AspireCommandRunner,\n): Promise<{ code: number; stdout: string; stderr: string; timedOut: boolean }> {\n  try {\n    return await spawn(argv, cwd, timeoutMs, env);\n  } catch (error) {\n    return {\n      code: 1,\n      stdout: '',\n      stderr: `Command could not start: ${errorMessage(error)}`,\n      timedOut: false,\n    };\n  }\n}\n\nasync function initializeState(runRoot: string, statePath: string): Promise<ReadmeWalkState> {\n  await Deno.mkdir(runRoot, { recursive: true });\n  const denoInstallRoot = resolve(runRoot, DENO_INSTALL_DIRECTORY);\n  try {\n    await Deno.remove(denoInstallRoot, { recursive: true });\n  } catch (error) {\n    if (!(error instanceof Deno.errors.NotFound)) throw error;\n  }\n  await Deno.mkdir(denoInstallRoot, { recursive: true });\n  try {\n    await Deno.remove(resolve(dirname(statePath), 'receipts'), { recursive: true });\n  } catch (error) {\n    if (!(error instanceof Deno.errors.NotFound)) throw error;\n  }\n  return Object.freeze({ cwd: runRoot, denoInstallRoot, nextIndex: 0 });\n}\n\nfunction readmeCommandEnvironment(\n  denoInstallRoot: string,\n): { env: Record<string, string>; pathPrepend: string } {\n  const pathPrepend = resolve(denoInstallRoot, 'bin');\n  return {\n    env: {\n      DENO_INSTALL_ROOT: denoInstallRoot,\n      PATH: `${pathPrepend}${DELIMITER}${Deno.env.get('PATH') ?? ''}`,\n    },\n    pathPrepend,\n  };\n}\n\nfunction assertExpectedCommands(actual: readonly string[]): void {\n  if (actual.length !== README_QUICKSTART_EXPECTED_COMMANDS.length) {\n    throw new Error(\n      `README Quickstart contains ${actual.length} commands; ` +\n        `readme.quickstart expects ${README_QUICKSTART_EXPECTED_COMMANDS.length}.`,\n    );\n  }\n  for (let index = 0; index < actual.length; index++) {\n    if (actual[index] !== README_QUICKSTART_EXPECTED_COMMANDS[index]) {\n      throw new Error(\n        `README Quickstart command ${index + 1} diverged: expected ` +\n          `${JSON.stringify(README_QUICKSTART_EXPECTED_COMMANDS[index])}, received ` +\n          `${JSON.stringify(actual[index])}.`,\n      );\n    }\n  }\n}\n\nfunction publishedVersion(specifier: string, line: number): string {\n  if (!specifier.startsWith(JSR_CLI_PREFIX)) {\n    throw new Error(\n      `README line ${line} requires --source jsr and --cli ${JSR_CLI_PREFIX}<version>.`,\n    );\n  }\n  const version = specifier.slice(JSR_CLI_PREFIX.length);\n  if (!version || /\\s/.test(version)) {\n    throw new Error(`README line ${line} received an invalid published CLI version.`);\n  }\n  return version;\n}\n\nasync function changeDirectory(\n  argv: readonly string[],\n  cwd: string,\n  line: number,\n): Promise<{ code: number; stdout: string; stderr: string; timedOut: boolean }> {\n  if (argv.length !== 2) {\n    return {\n      code: 2,\n      stdout: '',\n      stderr: `README line ${line} has an unsupported cd shape.`,\n      timedOut: false,\n    };\n  }\n  const target = resolve(cwd, argv[1]);\n  try {\n    const info = await Deno.stat(target);\n    if (!info.isDirectory) throw new Error('target is not a directory');\n    return { code: 0, stdout: '', stderr: '', timedOut: false };\n  } catch (error) {\n    return {\n      code: 1,\n      stdout: '',\n      stderr: `README line ${line} cd ${argv[1]} failed: ${errorMessage(error)}`,\n      timedOut: false,\n    };\n  }\n}\n\nasync function captureServicePort(\n  state: ReadmeWalkState,\n  appHost: string,\n): Promise<ReadmeWalkState> {\n  try {\n    const urls = await resolveResourceUrlsFromAppHost(appHost, SERVICE_RESOURCE);\n    const port = explicitServicePort(urls);\n    return Object.freeze({\n      ...state,\n      servicePort: port,\n      servicePortSource: `aspire describe ${SERVICE_RESOURCE} run receipt`,\n    });\n  } catch (error) {\n    return Object.freeze({\n      ...state,\n      servicePortError: `service-port receipt failed: ${errorMessage(error)}`,\n    });\n  }\n}\n\nasync function readState(path: string, line: number): Promise<ReadmeWalkState> {\n  let parsed: unknown;\n  try {\n    parsed = JSON.parse(await Deno.readTextFile(path));\n  } catch (error) {\n    throw new Error(`README line ${line} cannot read prior run receipt: ${errorMessage(error)}.`);\n  }\n  if (\n    !isRecord(parsed) || typeof parsed.cwd !== 'string' ||\n    typeof parsed.denoInstallRoot !== 'string' ||\n    typeof parsed.nextIndex !== 'number'\n  ) {\n    throw new Error(`README line ${line} found a malformed prior run receipt.`);\n  }\n  const servicePort = parsed.servicePort;\n  const servicePortSource = parsed.servicePortSource;\n  const servicePortError = parsed.servicePortError;\n  if (servicePort !== undefined && typeof servicePort !== 'number') {\n    throw new Error(`README line ${line} found a malformed service port receipt.`);\n  }\n  if (servicePortSource !== undefined && typeof servicePortSource !== 'string') {\n    throw new Error(`README line ${line} found a malformed service port source.`);\n  }\n  if (servicePortError !== undefined && typeof servicePortError !== 'string') {\n    throw new Error(`README line ${line} found a malformed service port error.`);\n  }\n  return Object.freeze({\n    cwd: parsed.cwd,\n    denoInstallRoot: parsed.denoInstallRoot,\n    nextIndex: parsed.nextIndex,\n    ...(servicePort === undefined ? {} : { servicePort }),\n    ...(servicePortSource === undefined ? {} : { servicePortSource }),\n    ...(servicePortError === undefined ? {} : { servicePortError }),\n  });\n}\n\nasync function writeState(path: string, state: ReadmeWalkState): Promise<void> {\n  await Deno.mkdir(dirname(path), { recursive: true });\n  const temporary = `${path}.tmp`;\n  await Deno.writeTextFile(temporary, `${JSON.stringify(state, null, 2)}\\n`);\n  await Deno.rename(temporary, path);\n}\n\nasync function writeReceipt(\n  statePath: string,\n  index: number,\n  receipt: ReadmeCommandReceipt,\n): Promise<void> {\n  const path = resolve(\n    dirname(statePath),\n    'receipts',\n    `${String(index + 1).padStart(2, '0')}.json`,\n  );\n  await Deno.mkdir(dirname(path), { recursive: true });\n  await Deno.writeTextFile(path, `${JSON.stringify(receipt, null, 2)}\\n`);\n}\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return typeof value === 'object' && value !== null && !Array.isArray(value);\n}\n\nfunction errorMessage(error: unknown): string {\n  return error instanceof Error ? error.message : String(error);\n}\n\nfunction tail(text: string): string {\n  return text.length > RECEIPT_TAIL_LENGTH ? text.slice(-RECEIPT_TAIL_LENGTH) : text;\n}\n\nif (import.meta.main) {\n  const [repoRoot, runRoot, appHost, rawIndex, cliSpecifier, statePath, rawTimeout] = Deno.args;\n  const index = Number(rawIndex);\n  const timeoutMs = Number(rawTimeout);\n  if (\n    !repoRoot || !runRoot || !appHost || !Number.isSafeInteger(index) || !cliSpecifier ||\n    !statePath ||\n    !Number.isSafeInteger(timeoutMs) || timeoutMs <= 0\n  ) {\n    throw new Error(\n      'repo root, run root, AppHost, command index, CLI specifier, state path, and timeout are required',\n    );\n  }\n  try {\n    Deno.exitCode = await executeReadmeQuickstartCommand(\n      repoRoot,\n      runRoot,\n      appHost,\n      index,\n      cliSpecifier,\n      statePath,\n      timeoutMs,\n    );\n  } catch (error) {\n    console.error(errorMessage(error));\n    Deno.exitCode = 1;\n  }\n}\n","numLines":381,"startLine":1,"totalLines":381}}}
