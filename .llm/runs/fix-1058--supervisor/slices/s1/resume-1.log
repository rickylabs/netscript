-import { guardPrismaSchemaFragment } from './prisma-schema-collision-guard.ts';
+import {
+  isPrismaTrivia,
+  type PrismaDeclaration,
+  removePrismaDeclarations,
+  scanPrismaDeclarations,
+} from './prisma-declaration-scanner.ts';
+
