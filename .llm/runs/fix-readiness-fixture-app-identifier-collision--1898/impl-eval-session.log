: false, detail: \"host has no return marker\" };\n  if (!injected.startsWith(host.slice(0, idx))) {\n    return { ok: false, detail: \"host text before injection point was modified\" };\n  }\n  const tailLen = host.length - idx;\n  if (injected.slice(injected.length - tailLen) !== host.slice(idx)) {\n    return { ok: false, detail: \"host text from return marker onward was modified\" };\n  }\n  const inserted = injected.slice(idx, injected.length - tailLen);\n  if (inserted.includes(\"  return apps;\")) {\n    return { ok: false, detail: \"inserted text contains a return marker\" };\n  }\n  const foreign = inserted.split(\"\\n\").filter((line) =>\n    line.trim() !== \"\" && line.trim() !== \"}\" && line.trim() !== \"  }\" &&\n    !line.trim().startsWith(\"//\") &&\n    !FIXTURE_TOKENS.some((token) => line.includes(token))\n  );\n  return {\n    ok: foreign.length === 0,\n    detail: foreign.length === 0\n      ? `pure insertion of ${inserted.length} chars before first return marker`\n      : `non-fixture inserted lines: ${JSON.stringify(foreign.slice(0, 3))}`,\n  };\n}","originalFile":"// IMPL-EVAL probe for PR #1899 — F2/F3/F4/F5/F6 over the post-fix injector.\n// Scratch evaluator tooling; not part of the repo's product or test surface.\nimport { generateRegisterApps } from \"../../../packages/cli/src/kernel/templates/aspire/helpers/register/generate-register-apps.ts\";\nimport { injectReadinessFixtureApps } from \"../../../packages/cli/e2e/src/application/gates/scaffold/runtime/prepare-readiness-fixture.ts\";\n\nlet failures = 0;\nfunction check(label: string, ok: boolean, detail = \"\"): void {\n  console.log(`${ok ? \"OK  \" : \"FAIL\"} ${label}${detail ? ` :: ${detail}` : \"\"}`);\n  if (!ok) failures++;\n}\nfunction assertThrowsFn(label: string, fn: () => unknown, needle: string): void {\n  try {\n    fn();\n    check(label, false, \"expected throw, none thrown\");\n  } catch (error) {\n    const message = error instanceof Error ? error.message : String(error);\n    check(label, message.includes(needle), message.split(\"\\n\")[0]);\n  }\n}\n\n/** Simple (non-destructuring) const/let/var declarations — the redeclaration class. */\nfunction simpleDeclarations(source: string): string[] {\n  return [...source.matchAll(/\\b(?:const|let|var)\\s+([A-Za-z_$][\\w$]*)\\s*[=;]/gu)].map((m) => m[1]);\n}\nfunction duplicateDeclarations(source: string): string[] {\n  const all = simpleDeclarations(source);\n  return [...new Set(all.filter((n, i) => all.indexOf(n) !== i))];\n}\n/** F3: every referenced readiness_fixture_* identifier must also be declared. */\nfunction danglingFixtureReferences(source: string): string[] {\n  const declared = new Set(\n    [...source.matchAll(/\\bconst\\s+(readiness_fixture_[\\w$]*)/gu)].map((m) => m[1]),\n  );\n  const referenced = new Set<string>();\n  for (const m of source.matchAll(/(?<![\\w$])(readiness_fixture_[\\w$]*)/gu)) {\n    // Skip the declaration position itself.\n    const before = source.slice(Math.max(0, (m.index ?? 0) - 7), m.index);\n    if (/const\\s$/.test(before)) continue;\n    referenced.add(m[1]);\n  }\n  return [...referenced].filter((name) => !declared.has(name));\n}\n\nconst FIXTURE_TOKENS = [\"readiness_fixture\", \"readiness-dead-port\", \"listener-fault-controller\"];\n/** F5 host integrity: dropping injected lines must reconstruct the host byte-for-byte. */\nfunction hostLinesPreserved(host: string, injected: string): { ok: boolean; detail: string } {\n  const keptHost = host.split(\"\\n\").filter((line) =>\n    !FIXTURE_TOKENS.some((token) => line.includes(token))\n  );\n  const keptInjected = injected.split(\"\\n\").filter((line) =>\n    !FIXTURE_TOKENS.some((token) => line.includes(token))\n  );\n  return {\n    ok: keptHost.join(\"\\n\") === keptInjected.join(\"\\n\"),\n    detail: keptHost.length === keptInjected.length\n      ? \"line counts match\"\n      : `host kept ${keptHost.length} lines vs injected kept ${keptInjected.length}`,\n  };\n}\n\nasync function denoCheck(source: string, extraResource = false): Promise<{ code: number; log: string }> {\n  const root = await Deno.makeTempDir({ prefix: \"eval1898-probe-\" });\n  try {\n    const helpers = `${root}/aspire/.helpers`;\n    const modules = `${root}/aspire/.aspire/modules`;\n    await Deno.mkdir(helpers, { recursive: true });\n    await Deno.mkdir(modules, { recursive: true });\n    await Deno.writeTextFile(`${helpers}/register-apps.mts`, source);\n    await Deno.writeTextFile(\n      `${modules}/aspire.mts`,\n      `export interface ExecutableResource {\n  withEnvironment(key: string, value: string): Promise<void>;\n  withOtlpExporter(options: { protocol: string }): Promise<void>;\n  withHttpEndpoint(options: unknown): Promise<void>;\n  withBrowserLogs(): Promise<void>;\n  withHttpHealthCheck(options: unknown): Promise<void>;\n  waitForCompletion(other: ExecutableResource): Promise<void>;\n}\nexport interface DistributedApplicationBuilder {\n  addExecutable(name: string, command: string, workdir: string, args: string[]): ExecutableResource;\n}\nexport const OtlpProtocol = { HttpProtobuf: 'http-protobuf' } as const;\n`,\n    );\n    await Deno.writeTextFile(\n      `${helpers}/_aspire-compat.mts`,\n      `import type { ExecutableResource } from '../.aspire/modules/aspire.mts';\nexport interface NetScriptConfig {\n  Apps: Record<string, { Enabled?: boolean }>;\n  Version: string;\n}\nexport function buildOtelEnvVars(\n  _name: string,\n  _version: string,\n  _kind: string,\n): Record<string, string> {\n  return {};\n}\nexport function buildViteEnvVarName(_name: string): { full: string; shorthand: string } {\n  return { full: '', shorthand: '' };\n}\nexport function resolveWorkspacePath(_root: string, path: string): string {\n  return path;\n}\nexport async function withCacheReference(\n  _resource: ExecutableResource,\n  _cache: unknown,\n): Promise<void> {}\n`,\n    );\n    await Deno.writeTextFile(\n      `${helpers}/register-infrastructure.mts`,\n      'export inte