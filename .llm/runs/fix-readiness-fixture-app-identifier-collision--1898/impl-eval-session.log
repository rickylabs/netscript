{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c5ec1f0c34654633a79f719c","type":"tool_result","content":"1\t/**\n2\t * @module\n3\t *\n4\t * Generator for `.helpers/register-apps.mts` — registers application resources\n5\t * (web apps, Tauri apps, Deno Desktop apps, and task-based apps) with the Aspire SDK\n6\t * builder.\n7\t *\n8\t * Four registration modes are supported:\n9\t *\n10\t * | Type    | Method             | VITE Injection |\n11\t * |---------|-------------------|----------------|\n12\t * | `app`   | `addExecutable()`  | ✅ Yes          |\n13\t * | `tauri` | `addExecutable()`  | ❌ No           |\n14\t * | `desktop` | `addExecutable()` | ❌ No          |\n15\t * | `task`  | `addExecutable()`  | ❌ No           |\n16\t *\n17\t * The `app` type uses the Aspire SDK's `addExecutable()` and\n18\t * injects three flavours of service-discovery env vars per reference:\n19\t * - `VITE_services__{name}__http__0` (full isomorphic)\n20\t * - `VITE_{NAME}_URL` (shorthand)\n21\t * - `services__{name}__http__0` (server-side discovery)\n22\t *\n23\t * All types receive executable-mode OTEL telemetry and optional\n24\t * KV cache dependency injection.\n25\t *\n26\t * Every endpoint-bearing executable additionally gets an HTTP health probe.\n27\t * Aspire falls back to \"process is Running means ready\" for a resource with no\n28\t * registered health check. Set `HealthCheckPath: false` to opt out, or to a path\n29\t * string to probe a different route.\n30\t */\n31\t\n32\timport type { RegisterAppsOptions } from '../types.ts';\n33\timport { RESOURCE_DEFAULTS } from '@netscript/aspire/constants';\n34\timport { fileHeader } from '../_utils.ts';\n35\timport { SCAFFOLD_ASPIRE_MODULES } from '../../../../constants/scaffold/scaffold-aspire.ts';\n36\timport { SCAFFOLD_DIRS } from '../../../../constants/scaffold/scaffold-dirs.ts';\n37\timport { TEMPLATE_KEYS } from '../../../../assets/manifest.ts';\n38\timport { renderTemplateAssetSync } from '../../../../adapters/templates/template-asset.ts';\n39\timport { renderHttpEndpointCall, resolveHostPort } from './render-http-endpoint.ts';\n40\timport type { AppEntry, HostPortEntry } from '@netscript/aspire/types';\n41\t\n42\t/**\n43\t * Whether an app entry should receive a `withHttpEndpoint(...)` registration.\n44\t *\n45\t * `app` entries are web servers and always need one. `tauri` and `task` entries\n46\t * may be neither, so they opt in by configuring a host port. `desktop` entries\n47\t * never expose an endpoint.\n48\t */\n49\tfunction needsHttpEndpoint(type: AppEntry['Type'], entry: HostPortEntry): boolean {\n50\t  if (type === 'desktop') return false;\n51\t  if (type === 'app') return true;\n52\t  return resolveHostPort(entry) !== undefined;\n53\t}\n54\t\n55\t/**\n56\t * Generates the register-apps.mts file content.\n57\t *\n58\t * @param options - App entries, version, and Deno defaults from parsed config\n59\t * @returns Generated TypeScript source as a string\n60\t */\n61\texport function generateRegisterApps(options: RegisterAppsOptions): string {\n62\t  const { apps, version: _version } = options;\n63\t  const entries = Object.entries(apps);\n64\t\n65\t  const registrationBlocks: string[] = [];\n66\t\n67\t  for (const [appIndex, [name, entry]] of entries.entries()) {\n68\t    const id = `app_${appIndex}`;\n69\t    const type = entry.Type ?? 'app';\n70\t    const workdir = entry.Workdir ?? `${SCAFFOLD_DIRS.APPS}/${name}`;\n71\t    const lines: string[] = [];\n72\t    lines.push(`  // --- app ${appIndex} ---`);\n73\t\n74\t    // Skip disabled entries\n75\t    const enabledCondition = type === 'desktop' ? '=== true' : '!== false';\n76\t    lines.push(\n77\t      `  if (config.Apps[${JSON.stringify(name)}]?.Enabled ${enabledCondition}) {`,\n78\t    );\n79\t\n80\t    if (type === 'app') {\n81\t      buildAppBlock(lines, id, name, entry, workdir);\n82\t    } else if (type === 'tauri') {\n83\t      buildTauriBlock(lines, id, name, entry, workdir);\n84\t    } else if (type === 'desktop') {\n85\t      buildDesktopBlock(lines, id, name, entry, workdir);\n86\t    } else {\n87\t      // task\n88\t      buildTaskBlock(lines, id, name, entry, workdir);\n89\t    }\n90\t\n91\t    // --- Common: OTEL telemetry (all types) ---\n92\t    lines.push(``);\n93\t    lines.push(`    // OTEL telemetry (full executable env set)`);\n94\t    lines.push(\n95\t      `    const ${id}_otel = buildOtelEnvVars(${\n96\t        JSON.stringify(name)\n97\t      }, config.Version, 'executable');`,\n98\t    );\n99\t    lines.push(`    for (const [key, value] of Object.entries(${id}_otel)) {`);\n100\t    lines.push(`      await ${id}.withEnvironment(key, value);`);\n101\t    lines.push(`    }`);\n102\t    lines.push(\n103\t      `    await ${id}.withOtlpExporter({ protocol: OtlpProtocol.HttpProtobuf });`,\n104\t    );\n105\t\n106\t    // --- Common: HTTP endpoint ---\n107\t    // A web `app` always serves HTTP, so it always gets an endpoint — Aspire\n108\t    // allocates the ports unless the entry pins a host port. `tauri` and `task`\n109\t    // entries are not necessarily HTTP servers, so they keep the historical\n110\t    // behaviour of getting an endpoint only when one is configured. `desktop`\n111\t    // entries never expose one.\n112\t    if (needsHttpEndpoint(type, entry)) {\n113\t      lines.push(``);\n114\t      lines.push(`    // HTTP endpoint`);\n115\t      lines.push(`    await ${id}.${renderHttpEndpointCall(entry)};`);\n116\t\n117\t      // Browser diagnostics are a frontend-app default. Keep the app-type and\n118\t      // endpoint predicates together so task/desktop executables cannot gain a\n119\t      // browser child without a browseable HTTP/HTTPS parent.\n120\t      if (type === 'app') {\n121\t        lines.push(`    await ${id}.withBrowserLogs();`);\n122\t      }\n123\t    }\n124\t\n125\t    // --- Endpoint readiness probe ---\n126\t    // Registered after the endpoint it derives its base address from. Without a\n127\t    // probe Aspire equates a running executable with a ready server.\n128\t    if (needsHttpEndpoint(type, entry)) {\n129\t      buildHealthProbeBlock(lines, id, entry);\n130\t    }\n131\t\n132\t    // --- desktop type: server-side discovery only ---\n133\t    if (type === 'desktop') {\n134\t      const serviceRefs = entry.ServiceReferences ?? [];\n135\t      const pluginRefs = entry.PluginReferences ?? [];\n136\t\n137\t      if (serviceRefs.length > 0 || pluginRefs.length > 0) {\n138\t        lines.push(``);\n139\t        lines.push(`    // Server-side service-discovery injection`);\n140\t      }\n141\t\n142\t      for (const ref of serviceRefs) {\n143\t        lines.push(`    {`);\n144\t        lines.push(\n145\t          `      const endpoint = await getResourceEndpoint(_services.get(${\n146\t            JSON.stringify(ref)\n147\t          }), 'http');`,\n148\t        );\n149\t        lines.push(`      if (endpoint) {`);\n150\t        lines.push(\n151\t          `        await ${id}.withEnvironment(${\n152\t            JSON.stringify(`services__${ref}__http__0`)\n153\t          }, endpoint);`,\n154\t        );\n155\t        lines.push(`      }`);\n156\t        lines.push(`    }`);\n157\t      }\n158\t\n159\t      for (const ref of pluginRefs) {\n160\t        lines.push(`    {`);\n161\t        lines.push(\n162\t          `      const endpoint = await getResourceEndpoint(_plugins.get(${\n163\t            JSON.stringify(ref)\n164\t          }), 'http');`,\n165\t        );\n166\t        lines.push(`      if (endpoint) {`);\n167\t        lines.push(\n168\t          `        await ${id}.withEnvironment(${\n169\t            JSON.stringify(`services__${ref}__http__0`)\n170\t          }, endpoint);`,\n171\t        );\n172\t        lines.push(`      }`);\n173\t        lines.push(`    }`);\n174\t      }\n175\t    }\n176\t\n177\t    // --- Common: KV cache dependency ---\n178\t    if (entry.RequiresKv) {\n179\t      lines.push(``);\n180\t      lines.push(`    // KV cache dependency`);\n181\t      lines.push(`    await _withCacheReference(${id}, _infrastructure.primaryCacheWiring);`);\n182\t    }\n183\t\n184\t    // --- app type: VITE injection ---\n185\t    if (type === 'app') {\n186\t      const serviceRefs = entry.ServiceReferences ?? [];\n187\t      const pluginRefs = entry.PluginReferences ?? [];\n188\t\n189\t      if (serviceRefs.length > 0 || pluginRefs.length > 0) {\n190\t        lines.push(``);\n191\t        lines.push(`    // VITE service-discovery injection`);\n192\t      }\n193\t\n194\t      for (const ref of serviceRefs) {\n195\t        lines.push(`    {`);\n196\t        lines.push(`      const vite = buildViteEnvVarName(${JSON.stringify(ref)});`);\n197\t        lines.push(\n198\t          `      const endpoint = await getResourceEndpoint(_services.get(${\n199\t            JSON.stringify(ref)\n200\t          }), 'http');`,\n201\t        );\n202\t        lines.push(`      if (endpoint) {`);\n203\t        lines.push(`        await ${id}.withEnvironment(vite.full, endpoint);`);\n204\t        lines.push(`        await ${id}.withEnvironment(vite.shorthand, endpoint);`);\n205\t        lines.push(\n206\t          `        await ${id}.withEnvironment(${\n207\t            JSON.stringify(`services__${ref}__http__0`)\n208\t          }, endpoint);`,\n209\t        );\n210\t        lines.push(`      }`);\n211\t        lines.push(`    }`);\n212\t      }\n213\t\n214\t      for (const ref of pluginRefs) {\n215\t        lines.push(`    {`);\n216\t        lines.push(`      const vite = buildViteEnvVarName(${JSON.stringify(ref)});`);\n217\t        lines.push(\n218\t          `      const endpoint = await getResourceEndpoint(_plugins.get(${\n219\t            JSON.stringify(ref)\n220\t          }), 'http');`,\n221\t        );\n222\t        lines.push(`      if (endpoint) {`);\n223\t        lines.push(`        await ${id}.withEnvironment(vite.full, endpoint);`);\n224\t        lines.push(`        await ${id}.withEnvironment(vite.shorthand, endpoint);`);\n225\t        lines.push(\n226\t          `        await ${id}.withEnvironment(${\n227\t            JSON.stringify(`services__${ref}__http__0`)\n228\t          }, endpoint);`,\n229\t        );\n230\t        lines.push(`      }`);\n231\t        lines.push(`    }`);\n232\t      }\n233\t\n234\t      // Prebuild TODO comment\n235\t      if (entry.Prebuild) {\n236\t        lines.push(``);\n237\t        lines.push(\n238\t          `    // TODO: Configured prebuild requires bridge NuGet — see ts-apphost-bridge-nuget.md`,\n239\t        );\n240\t      }\n241\t    }\n242\t\n243\t    // --- tauri type: remote app reference ---\n244\t    if (type === 'tauri' && entry.Remote) {\n245\t      const remoteId = `app_remote_${appIndex}`;\n246\t      lines.push(``);\n247\t      lines.push(`    // Remote app reference — wired via endpoint env var`);\n248\t      lines.push(`    {`);\n249\t      lines.push(\n250\t        `      const ${remoteId}Endpoint = await getResourceEndpoint(apps.get(${\n251\t          JSON.stringify(entry.Remote)\n252\t        }), 'http');`,\n253\t      );\n254\t      lines.push(`      if (${remoteId}Endpoint) {`);\n255\t      lines.push(\n256\t        `        await ${id}.withEnvironment(${\n257\t          JSON.stringify(`services__${entry.Remote}__http__0`)\n258\t        }, ${remoteId}Endpoint);`,\n259\t      );\n260\t      lines.push(`      }`);\n261\t      lines.push(`    }`);\n262\t    }\n263\t\n264\t    lines.push(``);\n265\t    lines.push(`    apps.set(${JSON.stringify(name)}, ${id});`);\n266\t    lines.push(`  }`);\n267\t\n268\t    registrationBlocks.push(lines.join('\\n'));\n269\t  }\n270\t\n271\t  return renderTemplateAssetSync(TEMPLATE_KEYS.generatedAspireHelpersGenerateRegisterApps1, {\n272\t    __slot0__: String(fileHeader('register-apps.mts')),\n273\t    __slot1__: String(SCAFFOLD_ASPIRE_MODULES.SDK_IMPORT_FROM_HELPERS),\n274\t    __slot2__: String(SCAFFOLD_ASPIRE_MODULES.ASPIRE_COMPAT_IMPORT),\n275\t    __slot3__: String(SCAFFOLD_ASPIRE_MODULES.ASPIRE_COMPAT_IMPORT),\n276\t    __slot4__: String(\n277\t      registrationBlocks.length > 0 ? registrationBlocks.join('\\n\\n') : '  // No apps configured',\n278\t    ),\n279\t  });\n280\t}\n281\t\n282\t// ---------------------------------------------------------------------------\n283\t// Block builders — each appends lines for a specific app type\n284\t// ---------------------------------------------------------------------------\n285\t\n286\t/**\n287\t * Appends the HTTP health probe registration for an `app` entry.\n288\t *\n289\t * Aspire only treats a resource as healthy once its registered health checks pass; a resource\n290\t * with no health check at all is considered ready as soon as its process reaches `Running`.\n291\t * That fallback is what let a generated Fresh app report `Healthy` while every request failed\n292\t * during SSR. The probe targets the app's own server-rendered health route, so a broken\n293\t * render pipeline surfaces as `Unhealthy` instead of green-and-500.\n294\t */\n295\tfunction buildHealthProbeBlock(\n296\t  lines: string[],\n297\t  id: string,\n298\t  entry: { readonly HealthCheckPath?: string | false },\n299\t): void {\n300\t  const path = resolveHealthCheckPath(entry);\n301\t  if (!path) return;\n302\t\n303\t  lines.push(``);\n304\t  lines.push(`    // HTTP health probe — a listening socket alone is not \"healthy\".`);\n305\t  lines.push(\n306\t    `    await ${id}.withHttpHealthCheck({ path: ${\n307\t      JSON.stringify(path)\n308\t    }, endpointName: '${RESOURCE_DEFAULTS.HttpEndpointName}' });`,\n309\t  );\n310\t}\n311\t\n312\t/**\n313\t * Resolves the health probe path for an app entry, or `undefined` when the app opted out\n314\t * with `HealthCheckPath: false`.\n315\t */\n316\tfunction resolveHealthCheckPath(\n317\t  entry: { readonly HealthCheckPath?: string | false },\n318\t): string | undefined {\n319\t  if (entry.HealthCheckPath === false) return undefined;\n320\t  return entry.HealthCheckPath ?? RESOURCE_DEFAULTS.AppHealthCheckPath;\n321\t}\n322\t\n323\t/**\n324\t * Builds registration lines for an `app` type entry.\n325\t * Uses `addExecutable()` with resolved permissions and working directory.\n326\t */\n327\tfunction buildAppBlock(\n328\t  lines: string[],\n329\t  id: string,\n330\t  name: string,\n331\t  entry: { readonly TaskName?: string },\n332\t  workdir: string,\n333\t): void {\n334\t  const taskName = entry.TaskName ?? 'dev';\n335\t\n336\t  // Resolve working directory\n337\t  lines.push(\n338\t    `    const ${id}_workdir = resolveWorkspacePath(appHostDir, ${JSON.stringify(workdir)});`,\n339\t  );\n340\t\n341\t  // Register via addExecutable — Vite dev server started via deno task\n342\t  lines.push(\n343\t    `    const ${id} = builder.addExecutable(${\n344\t      JSON.stringify(name)\n345\t    }, 'deno', ${id}_workdir, ['task', ${JSON.stringify(taskName)}]);`,\n346\t  );\n347\t}\n348\t\n349\t/**\n350\t * Builds registration lines for a `tauri` type entry.\n351\t * Uses `addExecutable()` with resolved task name.\n352\t */\n353\tfunction buildTauriBlock(\n354\t  lines: string[],\n355\t  id: string,\n356\t  name: string,\n357\t  entry: { readonly TaskName?: string },\n358\t  workdir: string,\n359\t): void {\n360\t  const taskName = entry.TaskName ?? `dev:${name}`;\n361\t\n362\t  lines.push(\n363\t    `    const ${id}_workdir = resolveWorkspacePath(appHostDir, ${JSON.stringify(workdir)});`,\n364\t  );\n365\t  lines.push(\n366\t    `    const ${id} = builder.addExecutable(${\n367\t      JSON.stringify(name)\n368\t    }, 'deno', ${id}_workdir, ['task', ${JSON.stringify(taskName)}]);`,\n369\t  );\n370\t}\n371\t\n372\t/**\n373\t * Builds registration lines for a `desktop` type entry.\n374\t * The window waits for a successful Fresh build before Aspire launches it.\n375\t */\n376\tfunction buildDesktopBlock(\n377\t  lines: string[],\n378\t  id: string,\n379\t  name: string,\n380\t  entry: { readonly Prebuild?: string; readonly TaskName?: string },\n381\t  workdir: string,\n382\t): void {\n383\t  const buildTaskName = entry.Prebuild ?? 'build';\n384\t  const taskName = entry.TaskName ?? 'desktop:predev';\n385\t\n386\t  lines.push(\n387\t    `    const ${id}_workdir = resolveWorkspacePath(appHostDir, ${JSON.stringify(workdir)});`,\n388\t  );\n389\t  lines.push(\n390\t    `    const ${id}_build = builder.addExecutable(${\n391\t      JSON.stringify(`${name}-build`)\n392\t    }, 'deno', ${id}_workdir, ['task', ${JSON.stringify(buildTaskName)}]);`,\n393\t  );\n394\t  lines.push(\n395\t    `    const ${id} = builder.addExecutable(${\n396\t      JSON.stringify(name)\n397\t    }, 'deno', ${id}_workdir, ['task', ${JSON.stringify(taskName)}, '--backend', 'cef']);`,\n398\t  );\n399\t  lines.push(`    await ${id}.waitForCompletion(${id}_build);`);\n400\t}\n401\t\n402\t/**\n403\t * Builds registration lines for a `task` type entry.\n404\t * Uses `addExecutable()` with resolved task name — simple registration, no VITE.\n405\t */\n406\tfunction buildTaskBlock(\n407\t  lines: string[],\n408\t  id: string,\n409\t  name: string,\n410\t  entry: { readonly TaskName?: string },\n411\t  workdir: string,\n412\t): void {\n413\t  const taskName = entry.TaskName ?? `dev:${name}`;\n414\t\n415\t  lines.push(\n416\t    `    const ${id}_workdir = resolveWorkspacePath(appHostDir, ${JSON.stringify(workdir)});`,\n417\t  );\n418\t  lines.push(\n419\t    `    const ${id} = builder.addExecutable(${\n420\t      JSON.stringify(name)\n421\t    }, 'deno', ${id}_workdir, ['task', ${JSON.stringify(taskName)}]);`,\n422\t  );\n423\t}\n424\t"}]},"parent_tool_use_id":null,"session_id":"cdb5a58b-f1c0-4dee-9493-e77a27dbfa08","uuid":"62161513-322c-401d-8f8f-e5e7cd80dda6","timestamp":"2026-09-01T20:24:05.404Z","tool_use_result":{"type":"text","file":{"filePath":"/home/agent/projects/netscript/worktrees/007-eval-1898/packages/cli/src/kernel/templates/aspire/helpers/register/generate-register-apps.ts","content":"/**\n * @module\n *\n * Generator for `.helpers/register-apps.mts` — registers application resources\n * (web apps, Tauri apps, Deno Desktop apps, and task-based apps) with the Aspire SDK\n * builder.\n *\n * Four registration modes are supported:\n *\n * | Type    | Method             | VITE Injection |\n * |---------|-------------------|----------------|\n * | `app`   | `addExecutable()`  | ✅ Yes          |\n * | `tauri` | `addExecutable()`  | ❌ No           |\n * | `desktop` | `addExecutable()` | ❌ No          |\n * | `task`  | `addExecutable()`  | ❌ No           |\n *\n * The `app` type uses the Aspire SDK's `addExecutable()` and\n * injects three flavours of service-discovery env vars per reference:\n * - `VITE_services__{name}__http__0` (full isomorphic)\n * - `VITE_{NAME}_URL` (shorthand)\n * - `services__{name}__http__0` (server-side discovery)\n *\n * All types receive executable-mode OTEL telemetry and optional\n * KV cache dependency injection.\n *\n * Every endpoint-bearing executable additionally gets an HTTP health probe.\n * Aspire falls back to \"process is Running means ready\" for a resource with no\n * registered health check. Set `HealthCheckPath: false` to opt out, or to a path\n * string to probe a different route.\n */\n\nimport type { RegisterAppsOptions } from '../types.ts';\nimport { RESOURCE_DEFAULTS } from '@netscript/aspire/constants';\nimport { fileHeader } from '../_utils.ts';\nimport { SCAFFOLD_ASPIRE_MODULES } from '../../../../constants/scaffold/scaffold-aspire.ts';\nimport { SCAFFOLD_DIRS } from '../../../../constants/scaffold/scaffold-dirs.ts';\nimport { TEMPLATE_KEYS } from '../../../../assets/manifest.ts';\nimport { renderTemplateAssetSync } from '../../../../adapters/templates/template-asset.ts';\nimport { renderHttpEndpointCall, resolveHostPort } from './render-http-endpoint.ts';\nimport type { AppEntry, HostPortEntry } from '@netscript/aspire/types';\n\n/**\n * Whether an app entry should receive a `withHttpEndpoint(...)` registration.\n *\n * `app` entries are web servers and always need one. `tauri` and `task` entries\n * may be neither, so they opt in by configuring a host port. `desktop` entries\n * never expose an endpoint.\n */\nfunction needsHttpEndpoint(type: AppEntry['Type'], entry: HostPortEntry): boolean {\n  if (type === 'desktop') return false;\n  if (type === 'app') return true;\n  return resolveHostPort(entry) !== undefined;\n}\n\n/**\n * Generates the register-apps.mts file content.\n *\n * @param options - App entries, version, and Deno defaults from parsed config\n * @returns Generated TypeScript source as a string\n */\nexport function generateRegisterApps(options: RegisterAppsOptions): string {\n  const { apps, version: _version } = options;\n  const entries = Object.entries(apps);\n\n  const registrationBlocks: string[] = [];\n\n  for (const [appIndex, [name, entry]] of entries.entries()) {\n    const id = `app_${appIndex}`;\n    const type = entry.Type ?? 'app';\n    const workdir = entry.Workdir ?? `${SCAFFOLD_DIRS.APPS}/${name}`;\n    const lines: string[] = [];\n    lines.push(`  // --- app ${appIndex} ---`);\n\n    // Skip disabled entries\n    const enabledCondition = type === 'desktop' ? '=== true' : '!== false';\n    lines.push(\n      `  if (config.Apps[${JSON.stringify(name)}]?.Enabled ${enabledCondition}) {`,\n    );\n\n    if (type === 'app') {\n      buildAppBlock(lines, id, name, entry, workdir);\n    } else if (type === 'tauri') {\n      buildTauriBlock(lines, id, name, entry, workdir);\n    } else if (type === 'desktop') {\n      buildDesktopBlock(lines, id, name, entry, workdir);\n    } else {\n      // task\n      buildTaskBlock(lines, id, name, entry, workdir);\n    }\n\n    // --- Common: OTEL telemetry (all types) ---\n    lines.push(``);\n    lines.push(`    // OTEL telemetry (full executable env set)`);\n    lines.push(\n      `    const ${id}_otel = buildOtelEnvVars(${\n        JSON.stringify(name)\n      }, config.Version, 'executable');`,\n    );\n    lines.push(`    for (const [key, value] of Object.entries(${id}_otel)) {`);\n    lines.push(`      await ${id}.withEnvironment(key, value);`);\n    lines.push(`    }`);\n    lines.push(\n      `    await ${id}.withOtlpExporter({ protocol: OtlpProtocol.HttpProtobuf });`,\n    );\n\n    // --- Common: HTTP endpoint ---\n    // A web `app` always serves HTTP, so it always gets an endpoint — Aspire\n    // allocates the ports unless the entry pins a host port. `tauri` and `task`\n    // entries are not necessarily HTTP servers, so they keep the historical\n    // behaviour of getting an endpoint only when one is configured. `desktop`\n    // entries never expose one.\n    if (needsHttpEndpoint(type, entry)) {\n      lines.push(``);\n      lines.push(`    // HTTP endpoint`);\n      lines.push(`    await ${id}.${renderHttpEndpointCall(entry)};`);\n\n      // Browser diagnostics are a frontend-app default. Keep the app-type and\n      // endpoint predicates together so task/desktop executables cannot gain a\n      // browser child without a browseable HTTP/HTTPS parent.\n      if (type === 'app') {\n        lines.push(`    await ${id}.withBrowserLogs();`);\n      }\n    }\n\n    // --- Endpoint readiness probe ---\n    // Registered after the endpoint it derives its base address from. Without a\n    // probe Aspire equates a running executable with a ready server.\n    if (needsHttpEndpoint(type, entry)) {\n      buildHealthProbeBlock(lines, id, entry);\n    }\n\n    // --- desktop type: server-side discovery only ---\n    if (type === 'desktop') {\n      const serviceRefs = entry.ServiceReferences ?? [];\n      const pluginRefs = entry.PluginReferences ?? [];\n\n      if (serviceRefs.length > 0 || pluginRefs.length > 0) {\n        lines.push(``);\n        lines.push(`    // Server-side service-discovery injection`);\n      }\n\n      for (const ref of serviceRefs) {\n        lines.push(`    {`);\n        lines.push(\n          `      const endpoint = await getResourceEndpoint(_services.get(${\n            JSON.stringify(ref)\n          }), 'http');`,\n        );\n        lines.push(`      if (endpoint) {`);\n        lines.push(\n          `        await ${id}.withEnvironment(${\n            JSON.stringify(`services__${ref}__http__0`)\n          }, endpoint);`,\n        );\n        lines.push(`      }`);\n        lines.push(`    }`);\n      }\n\n      for (const ref of pluginRefs) {\n        lines.push(`    {`);\n        lines.push(\n          `      const endpoint = await getResourceEndpoint(_plugins.get(${\n            JSON.stringify(ref)\n          }), 'http');`,\n        );\n        lines.push(`      if (endpoint) {`);\n        lines.push(\n          `        await ${id}.withEnvironment(${\n            JSON.stringify(`services__${ref}__http__0`)\n          }, endpoint);`,\n        );\n        lines.push(`      }`);\n        lines.push(`    }`);\n      }\n    }\n\n    // --- Common: KV cache dependency ---\n    if (entry.RequiresKv) {\n      lines.push(``);\n      lines.push(`    // KV cache dependency`);\n      lines.push(`    await _withCacheReference(${id}, _infrastructure.primaryCacheWiring);`);\n    }\n\n    // --- app type: VITE injection ---\n    if (type === 'app') {\n      const serviceRefs = entry.ServiceReferences ?? [];\n      const pluginRefs = entry.PluginReferences ?? [];\n\n      if (serviceRefs.length > 0 || pluginRefs.length > 0) {\n        lines.push(``);\n        lines.push(`    // VITE service-discovery injection`);\n      }\n\n      for (const ref of serviceRefs) {\n        lines.push(`    {`);\n        lines.push(`      const vite = buildViteEnvVarName(${JSON.stringify(ref)});`);\n        lines.push(\n          `      const endpoint = await getResourceEndpoint(_services.get(${\n            JSON.stringify(ref)\n          }), 'http');`,\n        );\n        lines.push(`      if (endpoint) {`);\n        lines.push(`        await ${id}.withEnvironment(vite.full, endpoint);`);\n        lines.push(`        await ${id}.withEnvironment(vite.shorthand, endpoint);`);\n        lines.push(\n          `        await ${id}.withEnvironment(${\n            JSON.stringify(`services__${ref}__http__0`)\n          }, endpoint);`,\n        );\n        lines.push(`      }`);\n        lines.push(`    }`);\n      }\n\n      for (const ref of pluginRefs) {\n        lines.push(`    {`);\n        lines.push(`      const vite = buildViteEnvVarName(${JSON.stringify(ref)});`);\n        lines.push(\n          `      const endpoint = await getResourceEndpoint(_plugins.get(${\n            JSON.stringify(ref)\n          }), 'http');`,\n        );\n        lines.push(`      if (endpoint) {`);\n        lines.push(`        await ${id}.withEnvironment(vite.full, endpoint);`);\n        lines.push(`        await ${id}.withEnvironment(vite.shorthand, endpoint);`);\n        lines.push(\n          `        await ${id}.withEnvironment(${\n            JSON.stringify(`services__${ref}__http__0`)\n          }, endpoint);`,\n        );\n        lines.push(`      }`);\n        lines.push(`    }`);\n      }\n\n      // Prebuild TODO comment\n      if (entry.Prebuild) {\n        lines.push(``);\n        lines.push(\n          `    // TODO: Configured prebuild requires bridge NuGet — see ts-apphost-bridge-nuget.md`,\n        );\n      }\n    }\n\n    // --- tauri type: remote app reference ---\n    if (type === 'tauri' && entry.Remote) {\n      const remoteId = `app_remote_${appIndex}`;\n      lines.push(``);\n      lines.push(`    // Remote app reference — wired via endpoint env var`);\n      lines.push(`    {`);\n      lines.push(\n        `      const ${remoteId}Endpoint = await getResourceEndpoint(apps.get(${\n          JSON.stringify(entry.Remote)\n        }), 'http');`,\n      );\n      lines.push(`      if (${remoteId}Endpoint) {`);\n      lines.push(\n        `        await ${id}.withEnvironment(${\n          JSON.stringify(`services__${entry.Remote}__http__0`)\n        }, ${remoteId}Endpoint);`,\n      );\n      lines.push(`      }`);\n      lines.push(`    }`);\n    }\n\n    lines.push(``);\n    lines.push(`    apps.set(${JSON.stringify(name)}, ${id});`);\n    lines.push(`  }`);\n\n    registrationBlocks.push(lines.join('\\n'));\n  }\n\n  return renderTemplateAssetSync(TEMPLATE_KEYS.generatedAspireHelpersGenerateRegisterApps1, {\n    __slot0__: String(fileHeader('register-apps.mts')),\n    __slot1__: String(SCAFFOLD_ASPIRE_MODULES.SDK_IMPORT_FROM_HELPERS),\n    __slot2__: String(SCAFFOLD_ASPIRE_MODULES.ASPIRE_COMPAT_IMPORT),\n    __slot3__: String(SCAFFOLD_ASPIRE_MODULES.ASPIRE_COMPAT_IMPORT),\n    __slot4__: String(\n      registrationBlocks.length > 0 ? registrationBlocks.join('\\n\\n') : '  // No apps configured',\n    ),\n  });\n}\n\n// ---------------------------------------------------------------------------\n// Block builders — each appends lines for a specific app type\n// ---------------------------------------------------------------------------\n\n/**\n * Appends the HTTP health probe registration for an `app` entry.\n *\n * Aspire only treats a resource as healthy once its registered health checks pass; a resource\n * with no health check at all is considered ready as soon as its process reaches `Running`.\n * That fallback is what let a generated Fresh app report `Healthy` while every request failed\n * during SSR. The probe targets the app's own server-rendered health route, so a broken\n * render pipeline surfaces as `Unhealthy` instead of green-and-500.\n */\nfunction buildHealthProbeBlock(\n  lines: string[],\n  id: string,\n  entry: { readonly HealthCheckPath?: string | false },\n): void {\n  const path = resolveHealthCheckPath(entry);\n  if (!path) return;\n\n  lines.push(``);\n  lines.push(`    // HTTP health probe — a listening socket alone is not \"healthy\".`);\n  lines.push(\n    `    await ${id}.withHttpHealthCheck({ path: ${\n      JSON.stringify(path)\n    }, endpointName: '${RESOURCE_DEFAULTS.HttpEndpointName}' });`,\n  );\n}\n\n/**\n * Resolves the health probe path for an app entry, or `undefined` when the app opted out\n * with `HealthCheckPath: false`.\n */\nfunction resolveHealthCheckPath(\n  entry: { readonly HealthCheckPath?: string | false },\n): string | undefined {\n  if (entry.HealthCheckPath === false) return undefined;\n  return entry.HealthCheckPath ?? RESOURCE_DEFAULTS.AppHealthCheckPath;\n}\n\n/**\n * Builds registration lines for an `app` type entry.\n * Uses `addExecutable()` with resolved permissions and working directory.\n */\nfunction buildAppBlock(\n  lines: string[],\n  id: string,\n  name: string,\n  entry: { readonly TaskName?: string },\n  workdir: string,\n): void {\n  const taskName = entry.TaskName ?? 'dev';\n\n  // Resolve working directory\n  lines.push(\n    `    const ${id}_workdir = resolveWorkspacePath(appHostDir, ${JSON.stringify(workdir)});`,\n  );\n\n  // Register via addExecutable — Vite dev server started via deno task\n  lines.push(\n    `    const ${id} = builder.addExecutable(${\n      JSON.stringify(name)\n    }, 'deno', ${id}_workdir, ['task', ${JSON.stringify(taskName)}]);`,\n  );\n}\n\n/**\n * Builds registration lines for a `tauri` type entry.\n * Uses `addExecutable()` with resolved task name.\n */\nfunction buildTauriBlock(\n  lines: string[],\n  id: string,\n  name: string,\n  entry: { readonly TaskName?: string },\n  workdir: string,\n): void {\n  const taskName = entry.TaskName ?? `dev:${name}`;\n\n  lines.push(\n    `    const ${id}_workdir = resolveWorkspacePath(appHostDir, ${JSON.stringify(workdir)});`,\n  );\n  lines.push(\n    `    const ${id} = builder.addExecutable(${\n      JSON.stringify(name)\n    }, 'deno', ${id}_workdir, ['task', ${JSON.stringify(taskName)}]);`,\n  );\n}\n\n/**\n * Builds registration lines for a `desktop` type entry.\n * The window waits for a successful Fresh build before Aspire launches it.\n */\nfunction buildDesktopBlock(\n  lines: string[],\n  id: string,\n  name: string,\n  entry: { readonly Prebuild?: string; readonly TaskName?: string },\n  workdir: string,\n): void {\n  const buildTaskName = entry.Prebuild ?? 'build';\n  const taskName = entry.TaskName ?? 'desktop:predev';\n\n  lines.push(\n    `    const ${id}_workdir = resolveWorkspacePath(appHostDir, ${JSON.stringify(workdir)});`,\n  );\n  lines.push(\n    `    const ${id}_build = builder.addExecutable(${\n      JSON.stringify(`${name}-build`)\n    }, 'deno', ${id}_workdir, ['task', ${JSON.stringify(buildTaskName)}]);`,\n  );\n  lines.push(\n    `    const ${id} = builder.addExecutable(${\n      JSON.stringify(name)\n    }, 'deno', ${id}_workdir, ['task', ${JSON.stringify(taskName)}, '--backend', 'cef']);`,\n  );\n  lines.push(`    await ${id}.waitForCompletion(${id}_build);`);\n}\n\n/**\n * Builds registration lines for a `task` type entry.\n * Uses `addExecutable()` with resolved task name — simple registration, no VITE.\n */\nfunction buildTaskBlock(\n  lines: string[],\n  id: string,\n  name: string,\n  entry: { readonly TaskName?: string },\n  workdir: string,\n): void {\n  const taskName = entry.TaskName ?? `dev:${name}`;\n\n  lines.push(\n    `    const ${id}_workdir = resolveWorkspacePath(appHostDir, ${JSON.stringify(workdir)});`,\n  );\n  lines.push(\n    `    const ${id} = builder.addExecutable(${\n      JSON.stringify(name)\n    }, 'deno', ${id}_workdir, ['task', ${JSON.stringify(taskName)}]);`,\n  );\n}\n","numLines":424,"startLine":1,"totalLines":424}}}
