e(\n      `${modules}/aspire.mts`,\n      `export interface ExecutableResource {\n  withEnvironment(key: string, value: string): Promise<void>;\n  withOtlpExporter(options: { protocol: string }): Promise<void>;\n  withHttpEndpoint(options: unknown): Promise<void>;\n  withBrowserLogs(): Promise<void>;\n  withHttpHealthCheck(options: unknown): Promise<void>;\n  waitForCompletion(other: ExecutableResource): Promise<void>;\n}\nexport interface DistributedApplicationBuilder {\n  addExecutable(name: string, command: string, workdir: string, args: string[]): ExecutableResource;\n}\nexport const OtlpProtocol = { HttpProtobuf: 'http-protobuf' } as const;\n`,\n    );\n    await Deno.writeTextFile(\n      `${helpers}/_aspire-compat.mts`,\n      `import type { ExecutableResource } from '../.aspire/modules/aspire.mts';\nexport interface NetScriptConfig {\n  Apps: Record<string, { Enabled?: boolean }>;\n  Version: string;\n}\nexport function buildOtelEnvVars(\n  _name: string,\n  _version: string,\n  _kind: string,\n): Record<string, string> {\n  return {};\n}\nexport function buildViteEnvVarName(_name: string): { full: string; shorthand: string } {\n  return { full: '', shorthand: '' };\n}\nexport function resolveWorkspacePath(_root: string, path: string): string {\n  return path;\n}\nexport async function withCacheReference(\n  _resource: ExecutableResource,\n  _cache: unknown,\n): Promise<void> {}\n`,\n    );\n    await Deno.writeTextFile(\n      `${helpers}/register-infrastructure.mts`,\n      'export interface InfrastructureContext { readonly primaryCacheWiring?: unknown; }\\n',\n    );\n    const output = await new Deno.Command(Deno.execPath(), {\n      args: [\"check\", \"--no-config\", `${helpers}/register-apps.mts`],\n      stdout: \"piped\",\n      stderr: \"piped\",\n    }).output();\n    return {\n      code: output.code,\n      log: new TextDecoder().decode(output.stderr) || new TextDecoder().decode(output.stdout),\n    };\n  } finally {\n    await Deno.remove(root, { recursive: true });\n  }\n}\n\n// --- Host A: three diverse apps (app + task + desktop), real generator, multiple derived ids ---\nconst hostA = generateRegisterApps({\n  apps: {\n    api: {\n      Enabled: true,\n      Runtime: \"deno\",\n      Type: \"app\",\n      Workdir: \"apps/api\",\n      TaskName: \"start\",\n      ServiceReferences: [\"worker\"],\n      WatchMode: false,\n      RequiresKv: false,\n    },\n    worker: {\n      Enabled: true,\n      Runtime: \"deno\",\n      Type: \"task\",\n      Workdir: \"apps/worker\",\n      TaskName: \"start\",\n      WatchMode: false,\n      RequiresKv: true,\n    },\n    shell: {\n      Enabled: true,\n      Runtime: \"deno\",\n      Type: \"desktop\",\n      Workdir: \"apps/shell\",\n      Prebuild: \"build\",\n      TaskName: \"start\",\n      WatchMode: false,\n      RequiresKv: false,\n    },\n  },\n  version: \"e2e\",\n  denoDefaults: { Permissions: [], WatchMode: false },\n});\nconsole.log(\"=== Host A: app+task+desktop (3 apps) ===\");\ncheck(\n  \"A0 host declares app_0/app_1/app_2 (+derived _workdir/_otel/_build)\",\n  hostA.includes(\"const app_0 \") && hostA.includes(\"const app_1 \") &&\n    hostA.includes(\"const app_2 \") && hostA.includes(\"const app_2_build \"),\n);\nconst injectedA = injectReadinessFixtureApps(hostA);\ncheck(\"A1 zero duplicate const/let/var declarations of ANY name\", duplicateDeclarations(injectedA).length === 0, `dups=${JSON.stringify(duplicateDeclarations(injectedA))}`);\ncheck(\"A2 no dangling readiness_fixture_* reference\", danglingFixtureReferences(injectedA).length === 0, `dangling=${JSON.stringify(danglingFixtureReferences(injectedA))}`);\ncheck(\"A3 registration readiness-dead-port → readiness_fixture_app_0\", injectedA.includes('apps.set(\"readiness-dead-port\", readiness_fixture_app_0);'));\ncheck(\"A4 registration listener-fault-controller → readiness_fixture_app_1\", injectedA.includes('apps.set(\"listener-fault-controller\", readiness_fixture_app_1);'));\ncheck(\"A5 host registrations intact\", injectedA.includes('apps.set(\"api\", app_0);') && injectedA.includes('apps.set(\"worker\", app_1);') && injectedA.includes('apps.set(\"shell\", app_2);'));\nconst integrityA = hostLinesPreserved(hostA, injectedA);\ncheck(\"A6 host lines byte-identical (fixture tokens filtered)\", integrityA.ok, integrityA.detail);\nassertThrowsFn(\n  \"A7 re-injecting raw injected output throws (fail-closed)\",\n  () => injectReadinessFixtureApps(injectedA),\n  \"readiness-dead-port fixture was already registered\",\n);\nassertThrowsFn(\n  \"A8 re-injecting without controller still throws (fail-closed)\",\n  () => injectReadinessFixtureApps(injectedA, false),\n  \"readiness-dead-port fixture was already registered\",\n);\nconst checkA = await denoCheck(injectedA);\ncheck(\"A9 emitted module passes deno check (parse + type)\", checkA.code === 0, checkA.log.slice(0, 600));\n\n// --- Host B: eleven task apps → host declares app_0..app_10 (two-digit boundary) ---\nconst appsB: Record<string, Record<string, unknown>> = {};\nfor (let i = 0; i < 11; i++) {\n  appsB[`svc${i}`] = {\n    Enabled: true,\n    Runtime: \"deno\",\n    Type: \"task\",\n    Workdir: `apps/svc${i}`,\n    TaskName: \"start\",\n    WatchMode: false,\n    RequiresKv: false,\n  };\n}\nconst hostB = generateRegisterApps({ apps: appsB as never, version: \"e2e\", denoDefaults: { Permissions: [], WatchMode: false } });\nconsole.log(\"=== Host B: 11 task apps (host app_0..app_10) ===\");\ncheck(\"B0 host declares two-digit app_10\", hostB.includes(\"const app_10 \"));\nconst injectedB = injectReadinessFixtureApps(hostB);\ncheck(\"B1 zero duplicate const/let/var declarations of ANY name\", duplicateDeclarations(injectedB).length === 0, `dups=${JSON.stringify(duplicateDeclarations(injectedB))}`);\ncheck(\"B2 no dangling readiness_fixture_* reference\", danglingFixtureReferences(injectedB).length === 0);\ncheck(\"B3 both fixture registrations bound to renamed ids\", injectedB.includes('apps.set(\"readiness-dead-port\", readiness_fixture_app_0);') && injectedB.includes('apps.set(\"listener-fault-controller\", readiness_fixture_app_1);'));\nconst integrityB = hostLinesPreserved(hostB, injectedB);\ncheck(\"B4 host lines byte-identical\", integrityB.ok, integrityB.detail);\nconst checkB = await denoCheck(injectedB);\ncheck(\"B5 emitted module passes deno check\", checkB.code === 0, checkB.log.slice(0, 600));\n\n// --- Host C: an app literally named readiness-dead-port must fail closed ---\nconsole.log(\"=== Host C: adversarial host app named readiness-dead-port ===\");\nconst hostC = generateRegisterApps({\n  apps: {\n    \"readiness-dead-port\": { Enabled: true, Runtime: \"deno\", Type: \"task\", Workdir: \"apps/x\", TaskName: \"start\", WatchMode: false, RequiresKv: false },\n    other: { Enabled: true, Runtime: \"deno\", Type: \"task\", Workdir: \"apps/y\", TaskName: \"start\", WatchMode: false, RequiresKv: false },\n  },\n  version: \"e2e\",\n  denoDefaults: { Permissions: [], WatchMode: false },\n});\nassertThrowsFn(\"C1 injection into colliding-name host throws\", () => injectReadinessFixtureApps(hostC), \"readiness-dead-port fixture was already registered\");\n\n// --- Host D: zero-app host (still must inject + parse) ---\nconsole.log(\"=== Host D: zero-app host ===\");\nconst hostD = generateRegisterApps({ apps: {}, version: \"e2e\", denoDefaults: { Permissions: [], WatchMode: false } });\nconst injectedD = injectReadinessFixtureApps(hostD);\ncheck(\"D1 zero duplicate declarations\", duplicateDeclarations(injectedD).length === 0, `dups=${JSON.stringify(duplicateDeclarations(injectedD))}`);\ncheck(\"D2 no dangling fixture reference\", danglingFixtureReferences(injectedD).length === 0);\nconst checkD = await denoCheck(injectedD);\ncheck(\"D3 emitted module passes deno check\", checkD.code === 0, checkD.log.slice(0, 600));\n\nconsole.log(failures === 0 ? \"\\nALL PROBE CHECKS PASSED\" : `\\n${failures} PROBE CHECK(S) FAILED`);\nDeno.exit(failures === 0 ? 0 : 1);\n","structuredPatch":[],"originalFile":null,"userModified":false}}
