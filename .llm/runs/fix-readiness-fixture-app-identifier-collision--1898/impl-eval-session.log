fixed references un-renamed.\nconst partial = host.replace(/  return apps;/, `\n  // --- app 0 ---\n  if (config.Apps[\"readiness-dead-port\"]?.Enabled !== false) {\n    const app_0_workdir = resolveWorkspacePath(appHostDir, '.netscript/e2e/readiness-dead-port');\n    const readiness_fixture_app_0 = builder.addExecutable(\"readiness-dead-port\", 'deno', app_0_workdir, ['task', \"start\"]);\n    const app_0_otel = buildOtelEnvVars(\"readiness-dead-port\", config.Version, 'executable');\n    for (const [key, value] of Object.entries(app_0_otel)) {\n      await readiness_fixture_app_0.withEnvironment(key, value);\n    }\n    await readiness_fixture_app_0.withOtlpExporter({ protocol: OtlpProtocol.HttpProtobuf });\n    apps.set(\"readiness-dead-port\", readiness_fixture_app_0);\n  }\n\n  return apps;`);\n\nconsole.log(\n  \"partial-rename module still contains undeclared app_0_otel / app_0_workdir refs:\",\n  partial.includes(\"app_0_otel\"),\n);\n\nconst root = await Deno.makeTempDir({ prefix: \"eval1898-mut-\" });\ntry {\n  const helpers = `${root}/aspire/.helpers`;\n  const modules = `${root}/aspire/.aspire/modules`;\n  await Deno.mkdir(helpers, { recursive: true });\n  await Deno.mkdir(modules, { recursive: true });\n  await Deno.writeTextFile(`${helpers}/register-apps.mts`, partial);\n  await Deno.writeTextFile(\n    `${modules}/aspire.mts`,\n    `export interface ExecutableResource {\n  withEnvironment(key: string, value: string): Promise<void>;\n  withOtlpExporter(options: { protocol: string }): Promise<void>;\n  withHttpEndpoint(options: unknown): Promise<void>;\n  withBrowserLogs(): Promise<void>;\n  withHttpHealthCheck(options: unknown): Promise<void>;\n}\nexport interface DistributedApplicationBuilder {\n  addExecutable(name: string, command: string, workdir: string, args: string[]): ExecutableResource;\n}\nexport const OtlpProtocol = { HttpProtobuf: 'http-protobuf' } as const;\n`,\n  );\n  await Deno.writeTextFile(\n    `${helpers}/_aspire-compat.mts`,\n    `