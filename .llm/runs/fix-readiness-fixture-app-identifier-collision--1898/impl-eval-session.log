 `${projectRoot}/aspire/.helpers/register-apps.mts`;\n39\t  const registerApps = await Deno.readTextFile(registerAppsPath);\n40\t  await Deno.writeTextFile(registerAppsPath, injectReadinessFixtureApps(registerApps));\n41\t\n42\t  await Deno.writeTextFile(\n43\t    registerInfrastructurePath,\n44\t    injectListenerFaultHealthChecks(registerInfrastructure, database),\n45\t  );\n46\t}\n47\t\n48\t/** Attach the two test-only checks at boundaries derived from the real infrastructure generator. */\n49\texport function injectListenerFaultHealthChecks(\n50\t  source: string,\n51\t  database: DatabaseEngine = DATABASE.POSTGRES,\n52\t): string {\n53\t  if (\n54\t    source.includes(TEST_ONLY_POSTGRES_HEALTH_KEY) ||\n55\t    source.includes(TEST_ONLY_GARNET_HEALTH_KEY)\n56\t  ) {\n57\t    throw new Error('test-only listener health checks were already registered');\n58\t  }\n59\t\n60\t  const reference = listenerInfrastructureReference();\n61\t  assertGeneratedHealthAttachment(reference, GARNET_REAL_HEALTH_KEY);\n62\t  const garnetAttachments = healthAttachments(source, GARNET_REAL_HEALTH_KEY);\n63\t  if (garnetAttachments.length === 0) {\n64\t    throw new Error(\n65\t      'generated register-infrastructure helper has no garnet health-check attachment',\n66\t    );\n67\t  }\n68\t  const includePostgres = listenerFaultExpectations(database).some((expectation) =>\n69\t    expectation.controllerListener === 'postgres'\n70\t  );\n71\t  let withPostgres = source;\n72\t  if (includePostgres) {\n73\t    assertGeneratedHealthAttachment(reference, POSTGRES_REAL_HEALTH_KEY);\n74\t    const postgresAttachments = healthAttachments(source, POSTGRES_REAL_HEALTH_KEY);\n75\t    if (postgresAttachments.length === 0) {\n76\t      throw new Error(\n77\t        'generated register-infrastructure helper has no postgres health-check attachment',\n78\t      );\n79\t    }\n80\t    withPostgres = injectAtHealthAttachments(\n81\t      source,\n82\t      postgresAttachments,\n83\t      (attachment, indentation) =>\n84\t        `${indentation}builder.addHealthCheck('${TEST_ONLY_POSTGRES_HEALTH_KEY}', createListenerReadinessCheck({ kind: 'tcp', host: 'localhost', port: ${POSTGRES_TEST_LISTENER_PORT} }));\n85\t${indentation}await ${attachment.resourceBinding}.withHealthCheck('${TEST_ONLY_POSTGRES_HEALTH_KEY}');`,\n86\t    );\n87\t  }\n88\t\n89\t  return injectAtHealthAttachments(\n90\t    withPostgres,\n91\t    healthAttachments(withPostgres, GARNET_REAL_HEALTH_KEY),\n92\t    (attachment, indentation) =>\n93\t      `${indentation}builder.addHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}', createRespPingCheck({ host: 'localhost', port: ${GARNET_TEST_LISTENER_PORT} }));\n94\t${indentation}await ${attachment.resourceBinding}.withHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}');`,\n95\t  );\n96\t}\n97\t\n98\t/** Inject the existing dead-port app plus the Aspire-managed listener controller task. */\n99\texport function injectReadinessFixtureApps(\n100\t  source: string,\n101\t  includeListenerFaultController = true,\n102\t): string {\n103\t  if (!source.includes(RETURN_APPS_MARKER)) {\n104\t    throw new Error('generated register-apps helper has no return marker');\n105\t  }\n106\t\n107\t  const generated = generateRegisterApps({\n108\t    apps: {\n109\t      'readiness-dead-port': {\n110\t        Enabled: true,\n111\t        Runtime: 'deno',\n112\t        Type: 'task',\n113\t        Workdir: '.netscript/e2e/readiness-dead-port',\n114\t        TaskName: 'start',\n115\t        Port: 18_997,\n116\t        WatchMode: false,\n117\t        RequiresKv: false,\n118\t      },\n119\t      'listener-fault-controller': {\n120\t        Enabled: true,\n121\t        Runtime: 'deno',\n122\t        Type: 'task',\n123\t        Workdir: LISTENER_FAULT_CONTROLLER_DIR,\n124\t        TaskName: 'start',\n125\t        WatchMode: false,\n126\t        RequiresKv: false,\n127\t      },\n128\t    },\n129\t    version: 'e2e',\n130\t    denoDefaults: { Permissions: [], WatchMode: false },\n131\t  });\n132\t\n133\t  let injected = source;\n134\t  const fixtureNames = includeListenerFaultController\n135\t    ? ['readiness-dead-port', 'listener-fault-controller']\n136\t    : ['readiness-dead-port'];\n137\t  for (const name of fixtureNames) {\n138\t    if (appRegistrations(injected, name).length > 0) {\n139\t      throw new Error(`${name} fixture was already registered`);\n140\t    }\n141\t    injected = injected.replace(RETURN_APPS_MARKER, appBlock(generated, name) + RETURN_APPS_MARKER);\n142\t  }\n143\t  return injected;\n144\t}\n145\t\n146\tfunction listenerInfrastructureReference(): string {\n147\t  return generateRegisterInfrastructure({\n148\t    databases: {\n149\t      postgres: {\n150\t        Enabled: true,\n151\t        Engine: 'Postgres',\n152\t        Mode: 'Container',\n153\t        Persistent: false,\n154\t      },\n155\t    },\n156\t    caches: {\n157\t      garnet: {\n158\t        Enabled: true,\n159\t        Engine: 'Garnet',\n160\t        Mode: 'Container',\n161\t      },\n162\t    },\n163\t    primaryDatabase: 'postgres',\n164\t    primaryCache: 'garnet',\n165\t  });\n166\t}\n167\t\n168\tinterface HealthAttachment {\n169\t  readonly endOffset: number;\n170\t  readonly healthCheckKey: string;\n171\t  readonly resourceBinding: string;\n172\t  readonly startOffset: number;\n173\t  readonly statement: string;\n174\t}\n175\t\n176\tconst HEALTH_ATTACHMENT_PATTERN =\n177\t  /^[ \\t]*await[ \\t]+([A-Za-z_$][\\w$]*)\\.withHealthCheck\\((?:\"((?:\\\\.|[^\"\\\\])*)\"|'((?:\\\\.|[^'\\\\])*)')\\);[ \\t]*$/gm;\n178\t\n179\tconst APP_REGISTRATION_PATTERN =\n180\t  /^[ \\t]*apps\\.set\\((?:\"((?:\\\\.|[^\"\\\\])*)\"|'((?:\\\\.|[^'\\\\])*)'),[ \\t]*([A-Za-z_$][\\w$]*)\\);[ \\t]*$/gm;\n181\t\n182\tfunction healthAttachments(source: string, key: string): readonly HealthAttachment[] {\n183\t  const attachments: HealthAttachment[] = [];\n184\t  for (const match of source.matchAll(HEALTH_ATTACHMENT_PATTERN)) {\n185\t    const healthCheckKey = match[2] ?? match[3];\n186\t    const resourceBinding = match[1];\n187\t    const startOffset = match.index;\n188\t    if (healthCheckKey === key && resourceBinding && startOffset !== undefined) {\n189\t      attachments.push({\n190\t        endOffset: startOffset + match[0].length,\n191\t        healthCheckKey,\n192\t        resourceBinding,\n193\t        startOffset,\n194\t        statement: match[0],\n195\t      });\n196\t    }\n197\t  }\n198\t  return attachments;\n199\t}\n200\t\n201\tfunction assertGeneratedHealthAttachment(source: string, key: string): void {\n202\t  const attachments = healthAttachments(source, key);\n203\t  if (attachments.length === 0) {\n204\t    throw new Error(`infrastructure generator omitted ${key} attachment marker`);\n205\t  }\n206\t}\n207\t\n208\tfunction injectAtHealthAttachments(\n209\t  source: string,\n210\t  attachments: readonly HealthAttachment[],\n211\t  injectedBlock: (attachment: HealthAttachment, indentation: string) => string,\n212\t): string {\n213\t  let injected = source;\n214\t  const descendingAttachments = [...attachments].sort((left, right) =>\n215\t    right.startOffset - left.startOffset\n216\t  );\n217\t  for (const attachment of descendingAttachments) {\n218\t    const indentation = attachment.statement.match(/^[ \\t]*/u)?.[0] ?? '';\n219\t    injected = `${injected.slice(0, attachment.endOffset)}\\n${\n220\t      injectedBlock(attachment, indentation)\n221\t    }${injected.slice(attachment.endOffset)}`;\n222\t  }\n223\t  return injected;\n224\t}\n225\t\n226\tfunction appRegistrations(source: string, name: string): readonly RegExpMatchArray[] {\n227\t  return [...source.matchAll(APP_REGISTRATION_PATTERN)].filter((match) =>\n228\t    (match[1] ?? match[2]) === name\n229\t  );\n230\t}\n231\t\n232\tfunction appBlock(generated: string, name: string): string {\n233\t  const registrations = appRegistrations(generated, name);\n234\t  if (registrations.length !== 1) {\n235\t    throw new Error(`generator did not emit ${name} fixture block`);\n236\t  }\n237\t  const registrationIndex = registrations[0].index;\n238\t  if (registrationIndex === undefined) {\n239\t    throw new Error(`generator did not emit ${name} fixture block`);\n240\t  }\n241\t  const blockStart = generated.lastIndexOf('  // --- app ', registrationIndex);\n242\t  const nextBlock = generated.indexOf('\\n\\n  // --- app ', registrationIndex);\n243\t  const returnIndex = generated.indexOf(RETURN_APPS_MARKER, blockStart);\n244\t  const blockEnd = nextBlock >= 0 && nextBlock < returnIndex ? nextBlock + 2 : returnIndex;\n245\t  if (blockStart < 0 || blockEnd < 0) {\n246\t    throw new Error(`generator did not emit ${name} fixture block`);\n247\t  }\n248\t  const block = generated.slice(blockStart, blockEnd);\n249\t  const generatedBinding = registrations[0][3];\n250\t  if (!generatedBinding) {\n251\t    throw new Error(`generator did not emit ${name} fixture binding`);\n252\t  }\n253\t  return namespaceFixtureAppBinding(block, generatedBinding);\n254\t}\n255\t\n256\tfunction namespaceFixtureAppBinding(block: string, generatedBinding: string): string {\n257\t  const escapedBinding = generatedBinding.replace(/[.*+?^${}()|[\\]\\\\]/gu, '\\\\$&');\n258\t  const bindingPrefix = new RegExp(\n259\t    `(?<![\\\\w$])${escapedBinding}(?=_|[^\\\\w$]|$)`,\n260\t    'gu',\n261\t  );\n262\t  return block.replaceAll(\n263\t    bindingPrefix,\n264\t    `${FIXTURE_APP_IDENTIFIER_PREFIX}${generatedBinding}`,\n265\t  );\n266\t}\n267\t\n268\tasync function writeControllerFixture(projectRoot: string): Promise<void> {\n269\t  const fixtureDir = `${projectRoot}/${LISTENER_FAULT_CONTROLLER_DIR}`;\n270\t  await Deno.mkdir(fixtureDir, { recursive: true });\n271\t  const controllerSource = await Deno.readTextFile(\n272\t    new URL('./listener-fault-controller.ts', import.meta.url),\n273\t  );\n274\t  await Deno.writeTextFile(`${fixtureDir}/main.ts`, controllerSource);\n275\t  await Deno.writeTextFile(\n276\t    `${fixtureDir}/deno.json`,\n277\t    `${\n278\t      JSON.stringify(\n279\t        {\n280\t          tasks: { start: 'deno run --allow-net --allow-read --allow-write main.ts' },\n281\t        },\n282\t        null,\n283\t        2,\n284\t      )\n285\t    }\\n`,\n286\t  );\n287\t  await Deno.writeTextFile(\n288\t    `${projectRoot}/${LISTENER_FAULT_STATE_FILE}`,\n289\t    `${JSON.stringify({ revision: 0, postgresOpen: true, garnetOpen: true }, null, 2)}\\n`,\n290\t  );\n291\t  try {\n292\t    await Deno.remove(`${projectRoot}/${LISTENER_FAULT_ACK_FILE}`);\n293\t  } catch (error) {\n294\t    if (!(error instanceof Deno.errors.NotFound)) throw error;\n295\t  }\n296\t}\n297\t\n298\tasync function writeDeadPortFixture(projectRoot: string): Promise<void> {\n299\t  const fixtureDir = `${projectRoot}/.netscript/e2e/readiness-dead-port`;\n300\t  await Deno.mkdir(fixtureDir, { recursive: true });\n301\t  await Deno.writeTextFile(\n302\t    `${fixtureDir}/main.ts`,\n303\t    '// Deliberately stays alive without binding the advertised endpoint.\\nawait new Promise(() => {});\\n',\n304\t  );\n305\t  await Deno.writeTextFile(\n306\t    `${fixtureDir}/deno.json`,\n307\t    `${JSON.stringify({ tasks: { start: 'deno run main.ts' } }, null, 2)}\\n`,\n308\t  );\n309\t}\n310\t\n311\tif (import.meta.main) {\n312\t  const projectRoot = Deno.args[0];\n313\t  const database = Deno.args[1];\n314\t  if (!projectRoot) throw new Error('project root argument is required');\n315\t  if (!database) throw new Error('database argument is required');\n316\t  await prepareReadinessFixture(projectRoot, parseListenerFaultDatabase(database));\n317\t}\n318\t"}]},"parent_tool_use_id":null,"session_id":"cdb5a58b-f1c0-4dee-9493-e77a27dbfa08","uuid":"0c2a2a04-47bf-4dce-8e40-9be9132c1f2b","timestamp":"2026-09-01T20:19:41.936Z","tool_use_result":{"type":"text","file":{"filePath":"/home/agent/projects/netscript/worktrees/007-eval-1898/packages/cli/e2e/src/application/gates/scaffold/runtime/prepare-readiness-fixture.ts","content":"import { DEFAULT_TEMPLATE_REGISTRY } fr