d during startup/preflight; status=${startupOutcome.status.code}`,\n43\t      );\n44\t    }\n45\t  }\n46\t  if (!startupComplete) {\n47\t    throw new Error(\n48\t      `Generated dev startup/preflight timed out after ${startupBudgetMs}ms; status=running`,\n49\t    );\n50\t  }\n51\t\n52\t  const httpReadinessBudgetMs = options.httpReadinessBudgetMs ??\n53\t    FRESH_HTTP_READINESS_BUDGET_MS;\n54\t  const deadline = options.now() + httpReadinessBudgetMs;\n55\t  let lastError = 'server did not answer';\n56\t\n57\t  while (options.now() < deadline) {\n58\t    const attempt = await Promise.race([\n59\t      options.fetchRoot().then(\n60\t        (response) => ({ kind: 'response', response }) as const,\n61\t        (error) => ({ kind: 'fetch-error', error }) as const,\n62\t      ),\n63\t      options.childStatus.then((status) => ({ kind: 'exited', status }) as const),\n64\t    ]);\n65\t\n66\t    if (attempt.kind === 'exited') {\n67\t      throw new Error(\n68\t        `Fresh dev server exited after startup under hostile parent tsconfig; status=${attempt.status.code}`,\n69\t      );\n70\t    }\n71\t    if (attempt.kind === 'response') {\n72\t      if (attempt.response.ok) return attempt.response;\n73\t      lastError = `HTTP ${attempt.response.status}`;\n74\t    } else {\n75\t      lastError = attempt.error instanceof Error ? attempt.error.message : String(attempt.error);\n76\t    }\n77\t\n78\t    const remainingMs = deadline - options.now();\n79\t    if (remainingMs <= 0) break;\n80\t    const retryOutcome = await Promise.race([\n81\t      options.childStatus.then((status) => ({ kind: 'exited', status }) as const),\n82\t      options.sleep(Math.min(HTTP_POLL_INTERVAL_MS, remainingMs)).then(() =>\n83\t        ({ kind: 'retry' }) as const\n84\t      ),\n85\t    ]);\n86\t    if (retryOutcome.kind === 'exited') {\n87\t      throw new Error(\n88\t        `Fresh dev server exited after startup under hostile parent tsconfig; status=${retryOutcome.status.code}`,\n89\t      );\n90\t    }\n91\t  }\n92\t\n93\t  throw new Error(\n94\t    `Fresh dev server failed under hostile parent tsconfig after startup: ${lastError}; status=running`,\n95\t  );\n96\t}\n97\t\n98\tasync function runProbe(projectRoot: string, appName: string): Promise<void> {\n99\t  const port = 5199;\n100\t  const appRoot = `${projectRoot}/apps/${appName}`;\n101\t  const child = new Deno.Command(Deno.execPath(), {\n102\t    args: [\n103\t      'task',\n104\t      '--cwd',\n105\t      appRoot,\n106\t      'dev',\n107\t      '--host',\n108\t      '127.0.0.1',\n109\t      '--port',\n110\t      String(port),\n111\t      '--strictPort',\n112\t    ],\n113\t    cwd: projectRoot,\n114\t    stdin: 'null',\n115\t    stdout: 'piped',\n116\t    stderr: 'piped',\n117\t  }).spawn();\n118\t  let childExited = false;\n119\t  const childStatus = child.status.then((status) => {\n120\t    childExited = true;\n121\t    return status;\n122\t  });\n123\t  const startup = Promise.withResolvers<void>();\n124\t  const outputPumps = [\n125\t    mirrorOutput(child.stdout, Deno.stdout.writable, startup.resolve),\n126\t    mirrorOutput(child.stderr, Deno.stderr.writable, startup.resolve),\n127\t  ];\n128\t\n129\t  try {\n130\t    const response = await waitForFreshDevServer({\n131\t      startupSignal: startup.promise,\n132\t      childStatus,\n133\t      fetchRoot: () => fetch(`http://127.0.0.1:${port}/`),\n134\t      now: Date.now,\n135\t      sleep: (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds)),\n136\t    });\n137\t    console.info(`Fresh dev server answered ${response.status} with hostile parent tsconfig`);\n138\t  } finally {\n139\t    await stopChild(child, childExited);\n140\t    await Promise.all(outputPumps);\n141\t  }\n142\t}\n143\t\n144\tasync function mirrorOutput(\n145\t  stream: ReadableStream<Uint8Array>,\n146\t  target: WritableStream<Uint8Array>,\n147\t  signalStartup: () => void,\n148\t): Promise<void> {\n149\t  const reader = stream.getReader();\n150\t  const writer = target.getWriter();\n151\t  const decoder = new TextDecoder();\n152\t  let scanTail = '';\n153\t  try {\n154\t    while (true) {\n155\t      const { done, value } = await reader.read();\n156\t      if (done) break;\n157\t      await writer.write(value);\n158\t      scanTail = `${scanTail}${decoder.decode(value, { stream: true })}`.slice(-4_096);\n159\t      if (scanTail.includes(VITE_READY_MARKER)) signalStartup();\n160\t    }\n161\t  } finally {\n162\t    reader.releaseLock();\n163\t    writer.releaseLock();\n164\t  }\n165\t}\n166\t\n167\tasync function stopChild(child: Deno.ChildProcess, childExited: boolean): Promise<void> {\n168\t  if (!childExited) {\n169\t    try {\n170\t      child.kill('SIGTERM');\n171\t    } catch (error) {\n172\t      if (!(error instanceof Deno.errors.NotFound)) throw error;\n173\t    }\n174\t  }\n175\t  await child.status.catch(() => undefined);\n176\t}\n177\t\n178\tif (import.meta.main) {\n179\t  const [projectRoot, appName] = Deno.args;\n180\t  if (!projectRoot || !appName) {\n181\t    throw new Error('generated project root and app name are required');\n182\t  }\n183\t  await runProbe(projectRoot, appName);\n184\t}\n185\t"}]},"parent_tool_use_id":null,"session_id":"578bc6cf-ec9d-4aea-ae50-b5b4f29f7a32","uuid":"b75c6650-b4fb-45e4-b8cd-e6be5a42398a","timestamp":"2026-09-01T17:39:22.266Z","tool_use_result":{"type":"text","file":{"filePath":"/home/agent/projects/netscript/worktrees/007-eval-1883/packages/cli/e2e/src/application/gates/scaffold/probe-project-boundary-dev.ts","content":"/** Host-tolerant budget for dependency preflight and Vite startup. */\nexport const DEV_STARTUP_BUDGET_MS = 180_000;\n\n/** HTTP readiness budget reserved until after Vite reports its local address. */\nexport const FRESH_HTTP_READINESS_BUDGET_MS = 60_000;\n\nconst HTTP_POLL_INTERVAL_MS = 250;\nconst VITE_READY_MARKER = 'Local:';\n\nexport interface FreshDevServerWaitOptions {\n  readonly startupSignal: Promise<void>;\n  readonly childStatus: Promise<Deno.CommandStatus>;\n  readonly fetchRoot: () => Promise<Response>;\n  readonly now: () => number;\n  readonly sleep: (milliseconds: number) => Promise<void>;\n  readonly startupBudgetMs?: number;\n  readonly httpReadinessBudgetMs?: number;\n}\n\n/** Waits for startup/preflight and HTTP readiness under independent budgets. */\nexport async function waitForFreshDevServer(\n  options: FreshDevServerWaitOptions,\n): Promise<Response> {\n  const startupBudgetMs = options.startupBudgetMs ?? DEV_STARTUP_BUDGET_MS;\n  const startupDeadline = options.now() + startupBudgetMs;\n  let startupComplete = false;\n  while (options.now() < startupDeadline) {\n    const remainingMs = startupDeadline - options.now();\n    const startupOutcome = await Promise.race([\n      options.startupSignal.then(() => ({ kind: 'started' }) as const),\n      options.childStatus.then((status) => ({ kind: 'exited', status }) as const),\n      options.sleep(Math.min(HTTP_POLL_INTERVAL_MS, remainingMs)).then(() =>\n        ({ kind: 'retry' }) as const\n      ),\n    ]);\n    if (startupOutcome.kind === 'started') {\n      startupComplete = true;\n      break;\n    }\n    if (startupOutcome.kind === 'exited') {\n      throw new Error(\n        `Generated dev process exited during startup/preflight; status=${startupOutcome.status.code}`,\n      );\n    }\n  }\n  if (!startupComplete) {\n    throw new Error(\n      `Generated dev startup/preflight timed out after ${startupBudgetMs}ms; status=running`,\n    );\n  }\n\n  const httpReadinessBudgetMs = options.httpReadinessBudgetMs ??\n    FRESH_HTTP_READINESS_BUDGET_MS;\n  const deadline = options.now() + httpReadinessBudgetMs;\n  let lastError = 'server did not answer';\n\n  while (options.now() < deadline) {\n    const attempt = await Promise.race([\n      options.fetchRoot().then(\n        (response) => ({ kind: 'response', response }) as const,\n        (error) => ({ kind: 'fetch-error', error }) as const,\n      ),\n      options.childStatus.then((status) => ({ kind: 'exited', status }) as const),\n    ]);\n\n    if (attempt.kind === 'exited') {\n      throw new Error(\n        `Fresh dev server exited after startup under hostile parent tsconfig; status=${attempt.status.code}`,\n      );\n    }\n    if (attempt.kind === 'response') {\n      if (attempt.response.ok) return attempt.response;\n      lastError = `HTTP ${attempt.response.status}`;\n    } else {\n      lastError = attempt.error instanceof Error ? attempt.error.message : String(attempt.error);\n    }\n\n    const remainingMs = deadline - options.now();\n    if (remainingMs <= 0) break;\n    const retryOutcome = await Promise.race([\n      options.childStatus.then((status) => ({ kind: 'exited', status }) as const),\n      options.sleep(Math.min(HTTP_POLL_INTERVAL_MS, remainingMs)).then(() =>\n        ({ kind: 'retry' }) as const\n      ),\n    ]);\n    if (retryOutcome.kind === 'exited') {\n      throw new Error(\n        `Fresh dev server exited after startup under hostile parent tsconfig; status=${retryOutcome.status.code}`,\n      );\n    }\n  }\n\n  throw new Error(\n    `Fresh dev server failed under hostile parent tsconfig after startup: ${lastError}; status=running`,\n  );\n}\n\nasync function runProbe(projectRoot: string, appName: string): Promise<void> {\n  const port = 5199;\n  const appRoot = `${projectRoot}/apps/${appName}`;\n  const child = new Deno.Command(Deno.execPath(), {\n    args: [\n      'task',\n      '--cwd',\n      appRoot,\n      'dev',\n      '--host',\n      '127.0.0.1',\n      '--port',\n      String(port),\n      '--strictPort',\n    ],\n    cwd: projectRoot,\n    stdin: 'null',\n    stdout: 'piped',\n    stderr: 'piped',\n  }).spawn();\n  let childExited = false;\n  const childStatus = child.status.then((status) => {\n    childExited = true;\n    return status;\n  });\n  const startup = Promise.withResolvers<void>();\n  const outputPumps = [\n    mirrorOutput(child.stdout, Deno.stdout.writable, startup.resolve),\n    mirrorOutput(child.stderr, Deno.stderr.writable, startup.resolve),\n  ];\n\n  try {\n    const response = await waitForFreshDevServer({\n      startupSignal: startup.promise,\n      childStatus,\n      fetchRoot: () => fetch(`http://127.0.0.1:${port}/`),\n      now: Date.now,\n      sleep: (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds)),\n    });\n    console.info(`Fresh dev server answered ${response.status} with hostile parent tsconfig`);\n  } finally {\n    await stopChild(child, childExited);\n    await Promise.all(outputPumps);\n  }\n}\n\nasync function mirrorOutput(\n  stream: ReadableStream<Uint8Array>,\n  target: WritableStream<Uint8Array>,\n  signalStartup: () => void,\n): Promise<void> {\n  const reader = stream.getReader();\n  const writer = target.getWriter();\n  const decoder = new TextDecoder();\n  let scanTail = '';\n  try {\n    while (true) {\n      const { done, value } = await reader.read();\n      if (done) break;\n      await writer.write(value);\n      scanTail = `${scanTail}${decoder.decode(value, { stream: true })}`.slice(-4_096);\n      if (scanTail.includes(VITE_READY_MARKER)) signalStartup();\n    }\n  } finally {\n    reader.releaseLock();\n    writer.releaseLock();\n  }\n}\n\nasync function stopChild(child: Deno.ChildProcess, childExited: boolean): Promise<void> {\n  if (!childExited) {\n    try {\n      child.kill('SIGTERM');\n    } catch (error) {\n      if (!(error instanceof Deno.errors.NotFound)) throw error;\n    }\n  }\n  await child.status.catch(() => undefined);\n}\n\nif (import.meta.main) {\n  const [projectRoot, appName] = Deno.args;\n  if (!projectRoot || !appName) {\n    throw new Error('generated project root and app name are required');\n  }\n  await runProbe(projectRoot, appName);\n}\n","numLines":185,"startLine":1,"totalLines":185}}}
