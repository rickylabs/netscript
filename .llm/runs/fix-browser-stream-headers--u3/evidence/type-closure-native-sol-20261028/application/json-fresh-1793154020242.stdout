  "nodes": {
    "file:///C:/Users/ericc/source/repos/netscript-browser-stream-headers-008/packages/fresh/src/runtime/streams/mod.ts": {
      "module_doc": {
        "doc": "`@netscript/fresh/streams` — Client SDK for E2E durable streams.\n\nThis subpath provides:\n- `createNetScriptStreamDB()` — generic TanStack DB-backed StreamDB factory\n  (wraps `@durable-streams/state` with NetScript URL resolution + auth)\n- `createNetScriptStreamEventSourceV1()` — named-event, v1-schema-validated\n  native SSE binding with explicit replay state\n- `useLiveQuery` / `useLiveSuspenseQuery` from `@tanstack/react-db`\n  (works via `preact/compat` in Fresh islands)\n- Re-exports of useful types from `@durable-streams/state`\n\nPlugin-specific factories (`createWorkersStreamDB`, etc.) live in their\nrespective plugin packages; this subpath provides the generic stream factory.\n",
        "tags": [
          {
            "kind": "module"
          }
        ]
      },
      "imports": [
        {
          "importedName": "useTanStackLiveQuery",
          "originalName": "useLiveQuery",
          "src": "file:///C:/Users/ericc/source/repos/netscript-native-host-policy-008/.llm/tmp/native-host-policy-preflight/cache/npm/registry.npmjs.org/@tanstack/react-db/0.5.8/dist/esm/index.d.ts"
        },
