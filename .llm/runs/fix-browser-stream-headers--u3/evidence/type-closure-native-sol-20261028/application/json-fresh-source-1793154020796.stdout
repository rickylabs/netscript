    "file:///C:/Users/ericc/source/repos/netscript-browser-stream-headers-008/packages/fresh/src/runtime/streams/create-stream-db.ts": {
      "module_doc": {
        "doc": "Generic NetScript StreamDB factory.\n\n`createNetScriptStreamDB()` is the framework-level generic factory for\ncreating TanStack DB-backed stream databases.  It wraps\n`@durable-streams/state` `createStreamDB()` with NetScript's automatic\nURL resolution and auth header injection.\n\nPlugin-specific factories (`createWorkersStreamDB`, `createSagasStreamDB`,\n`createTriggersStreamDB`) live in their own plugin packages. Use this generic\nfactory for other compatible stream schemas.\n",
        "tags": [
          {
            "kind": "module"
          }
        ]
      },
      "imports": [
        {
          "importedName": "abortable",
          "originalName": "abortable",
          "src": "https://jsr.io/@std/async/1.5.1/abortable.ts",
          "jsDoc": {
            "doc": "Generic NetScript StreamDB factory.\n\n`createNetScriptStreamDB()` is the framework-level generic factory for\ncreating TanStack DB-backed stream databases.  It wraps\n`@durable-streams/state` `createStreamDB()` with NetScript's automatic\nURL resolution and auth header injection.\n\nPlugin-specific factories (`createWorkersStreamDB`, `createSagasStreamDB`,\n`createTriggersStreamDB`) live in their own plugin packages. Use this generic\nfactory for other compatible stream schemas.\n",
            "tags": [
              {
                "kind": "module"
              }
            ]
          }
