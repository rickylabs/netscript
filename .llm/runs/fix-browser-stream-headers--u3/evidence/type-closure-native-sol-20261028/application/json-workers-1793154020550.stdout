        {
          "name": "HeadersRecord",
          "declarations": [
            {
              "location": {
                "filename": "file:///C:/Users/ericc/source/repos/netscript-native-host-policy-008/.llm/tmp/native-host-policy-preflight/cache/npm/registry.npmjs.org/@durable-streams/client/0.2.7/dist/index.d.ts",
                "line": 153,
                "col": 0,
                "byteIndex": 5113
              },
              "declarationKind": "export",
              "jsDoc": {
                "doc": "Headers record where values can be static strings or async functions.\nFollowing the @electric-sql/client pattern for dynamic headers.\n\n**Important**: Functions are called **for each request**, not once per session.\nIn live mode with long-polling, the same function may be called many times\nto fetch fresh values (e.g., refreshed auth tokens) for each poll.\n",
                "tags": [
                  {
                    "kind": "example",
                    "doc": "```typescript\nheaders: {\n  Authorization: `Bearer ${token}`,           // Static - same for all requests\n  'X-Tenant-Id': () => getCurrentTenant(),    // Called per-request\n  'X-Auth': async () => await refreshToken()  // Called per-request (can refresh)\n}\n```"
                  }
                ]
              },
              "kind": "typeAlias",
              "def": {
                "tsType": {
                  "kind": "typeLiteral",
                  "value": {
