        {
          "name": "createWorkersStreamDB",
          "declarations": [
            {
              "location": {
                "filename": "file:///C:/Users/ericc/source/repos/netscript-browser-stream-headers-008/plugins/workers/streams/factory.ts",
                "line": 58,
                "col": 0,
                "byteIndex": 2074
              },
              "declarationKind": "export",
              "jsDoc": {
                "doc": "Create a TanStack DB-backed StreamDB for worker execution and job entities.\n\nThe returned `StreamDB` has `.collections.execution` and `.collections.job`\nwhich are live TanStack DB `Collection` instances.  Use them with\n`useLiveQuery` from `@tanstack/react-db`.\n",
                "tags": [
                  {
                    "kind": "example",
                    "doc": "```ts\nimport { createWorkersStreamDB } from '@netscript/plugin-workers/streams';\nimport { useLiveQuery } from '@tanstack/react-db';\n\ndeclare const streamsServiceUrl: string;\n\nconst workersDb = createWorkersStreamDB({ baseUrl: streamsServiceUrl });\n\n// Call inside a React component or custom hook.\nfunction useWorkersRows() {\n  const result = useLiveQuery((q) => q.from({ item: workersDb.collections.execution }));\n  const entityStates = result.data.map((item) => item.status);\n  return { rows: result.data, state: result.state, status: result.status, entityStates };\n}\nvoid useWorkersRows;\n```"
                  }
                ]
              },
              "kind": "function",
