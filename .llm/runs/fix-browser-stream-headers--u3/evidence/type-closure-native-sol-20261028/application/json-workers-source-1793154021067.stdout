      "module_doc": {
        "doc": "Client-side StreamDB factory for the Workers plugin.\n\nReturns a TanStack DB-backed `StreamDB` with typed `.collections` for\nworker executions and jobs. Connect it to the Aspire-discovered durable streams\nservice via `@durable-streams/state`.\n",
        "tags": [
          {
            "kind": "module"
          }
        ]
      },
