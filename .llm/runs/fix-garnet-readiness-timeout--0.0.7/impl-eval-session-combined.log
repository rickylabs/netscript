ord<string, unknown>): ExecutableResourcePromise;\n  withHttpEndpoint(options: unknown): ExecutableResourcePromise;\n  withBrowserLogs(): ExecutableResourcePromise;\n  withHttpHealthCheck(options: unknown): ExecutableResourcePromise;\n  withHealthCheck(key: string): Promise<void>;\n  withArgs(args: readonly string[]): ExecutableResourcePromise;\n  getEndpoint(scheme: string): EndpointReferencePromise;\n  waitFor(resource: ExecutableResource): PromiseLike<ExecutableResource>;\n}\nexport interface ExecutableResourcePromise extends ExecutableResource, PromiseLike<ExecutableResource> {}\n\nexport interface ContainerResource {\n  withEndpoint(options: Record<string, unknown>): ContainerResourcePromise;\n  withBindMount(source: string, target: string): ContainerResourcePromise;\n  withContainerRuntimeArgs(args: readonly string[]): ContainerResourcePromise;\n  withArgs(args: readonly string[]): ContainerResourcePromise;\n  withEnvironment(key: string, value: string): ContainerResourcePromise;\n  withHealthCheck(key: string): Promise<void>;\n  getEndpoint(scheme: string): EndpointReferencePromise;\n  waitFor(resource: ExecutableResource): PromiseLike<ExecutableResource>;\n}\nexport interface ContainerResourcePromise extends ContainerResource, PromiseLike<ContainerResource> {}\n\nexport interface PostgresServerResource {\n  withLifetime(lifetime: ContainerLifetime): PostgresServerResourcePromise;\n  withDataBindMount(path: string): PostgresServerResourcePromise;\n  withImage(image: string): PostgresServerResourcePromise;\n  withImageTag(tag: string): PostgresServerResourcePromise;\n  withEnvironment(key: string, value: string): PostgresServerResourcePromise;\n  withHealthCheck(key: string): Promise<void>;\n  getEndpoint(scheme: string): EndpointReferencePromise;\n  addDatabase(name: string): PromiseLike<ExecutableResource>;\n  waitFor(resource: ExecutableResource): PromiseLike<ExecutableResource>;\n}\nexport interface PostgresServerResourcePromise extends PostgresServerResource, PromiseLike<PostgresServerResource> {}\n\nexport interface ParameterResource { readonly name: string; }\nexport interface Configuration { getConfigValue(key: string): PromiseLike<string | undefined>; }\n\nexport interface DistributedApplicationBuilder {\n  addExecutable(name: string, command: string, workdir: string, args: readonly string[]): ExecutableResourcePromise;\n  addContainer(name: string, image: string): ContainerResourcePromise;\n  addPostgres(name: string, options: { port?: number; password?: ParameterResource }): PostgresServerResourcePromise;\n  addParameter(name: string, options: { value: string; secret?: boolean }): PromiseLike<ParameterResource>;\n  addConnectionString(name: string): PromiseLike<ExecutableResource>;\n  addHealthCheck(key: string, check: () => HealthCheckResult | Promise<HealthCheckResult>): void;\n  getConfiguration(): Configuration;\n}\nexport const OtlpProtocol = { HttpProtobuf: 'http-protobuf' } as const;\n```\n\nConcern: `AspireResource = Parameters<ReturnType<DAB['addExecutable']>['waitFor']>[0]` → ExecutableResource. `databases.set(name, db_0)` where db_0 is PostgresServerResource (from `const db_0 = db_0_server` awaited) — Map<string, AspireResource>. ExecutableResource requires withEndpoint, withOtlpExporter, withHttpEndpoint, withBrowserLogs, withHttpHealthCheck, withArgs, waitFor(resource: ExecutableResource)... PostgresServerResource doesn't have withEndpoint/withOtlpExporter etc → NOT assignable → type error! In the real aspire.mts, the resource types are probably broader (all resources share a common base). To avoid stub-induced failures, make the resource interfaces share a common base with ALL methods (each returning its own promise type or a common one)? TS assignability with methods: parameters are bivariant for methods, so `waitFor(resource: ExecutableResource)` vs `waitFor(resource: PostgresServerResource)`... \n\nSimplest correct approach mirroring the real SDK: the real SDK has a single `IResourceBuilder<T>