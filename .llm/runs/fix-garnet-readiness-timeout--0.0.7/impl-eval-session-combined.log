{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-a22bb6cd6a14711a","type":"tool_result","content":"1\t/**\n2\t * @module\n3\t *\n4\t * Generator for `.helpers/register-infrastructure.mts` — registers databases\n5\t * and caches with the Aspire SDK builder. Handles engine dispatch, container\n6\t * vs external mode, persistent lifetime, data bind mounts, and primary\n7\t * resource resolution.\n8\t */\n9\t\n10\timport type { CacheEntry } from '@netscript/aspire/types'\n11\timport type { RegisterInfrastructureOptions } from '../types.ts'\n12\timport { fileHeader } from '../_utils.ts'\n13\timport { SCAFFOLD_ASPIRE_MODULES } from '../../../../constants/scaffold/scaffold-aspire.ts'\n14\timport { SCAFFOLD_VERSIONS } from '../../../../constants/scaffold/scaffold-versions.ts'\n15\timport { TEMPLATE_KEYS } from '../../../../assets/manifest.ts'\n16\timport { renderTemplateAssetSync } from '../../../../adapters/templates/template-asset.ts'\n17\t\n18\t/** Maps database engine names to SDK builder method names. */\n19\tconst DB_ENGINE_METHODS: Record<string, string> = {\n20\t  Postgres: 'addPostgres',\n21\t  Mysql: 'addMySql',\n22\t  Mssql: 'addSqlServer',\n23\t}\n24\t\n25\tconst MSSQL_CONTAINER_IMAGE = 'mssql/server'\n26\tconst MSSQL_CONTAINER_TAG = '2022-latest'\n27\tconst MSSQL_SA_PASSWORD = 'NetscriptE2e!Sql2026'\n28\t\n29\t/** Default Redis-compatible cache container images. */\n30\tconst CACHE_CONTAINER_IMAGES: Record<\n31\t  string,\n32\t  { readonly image: string; readonly tag: string }\n33\t> = {\n34\t  Redis: { image: 'docker.io/library/redis', tag: '7' },\n35\t  Garnet: { image: 'ghcr.io/microsoft/garnet', tag: '1.1.10' },\n36\t}\n37\t\n38\t/** Default Redis-compatible TCP port. */\n39\tconst CACHE_DEFAULT_PORT = 6379\n40\t\n41\t/** Deno KV Connect container image (shared KV over HTTP). */\n42\tconst DENOKV_CONTAINER = {\n43\t  image: 'ghcr.io/denoland/denokv',\n44\t  tag: '0.11.0',\n45\t} as const\n46\t\n47\t/** Deno KV Connect HTTP port inside the container. */\n48\tconst DENOKV_HTTP_PORT = 4512\n49\t\n50\t/**\n51\t * Generates the register-infrastructure.mts file content.\n52\t *\n53\t * @param options - Database and cache entries from parsed config\n54\t * @returns Generated TypeScript source as a string\n55\t */\n56\texport function generateRegisterInfrastructure(\n57\t  options: RegisterInfrastructureOptions,\n58\t): string {\n59\t  const { databases, caches, primaryDatabase, primaryCache } = options\n60\t  const dbEntries = Object.entries(databases)\n61\t  const cacheEntries = Object.entries(caches)\n62\t  const usesDenoKvContainer = cacheEntries.some(([, entry]) =>\n63\t    entry.Engine === 'DenoKv' &&\n64\t    !['External', 'Local'].includes(entry.Mode ?? 'Container')\n65\t  )\n66\t  const hasPersistentContainerDatabase = dbEntries.some(([, entry]) =>\n67\t    entry.Engine !== 'Sqlite' &&\n68\t    (entry.Mode ?? 'Container') === 'Container' &&\n69\t    entry.Persistent === true\n70\t  )\n71\t  const usesDatabaseListenerReadiness = dbEntries.some(([, entry]) =>\n72\t    ['Postgres', 'Mysql', 'Mssql'].includes(entry.Engine) &&\n73\t    (entry.Mode ?? 'Container') === 'Container'\n74\t  )\n75\t  const usesRespReadiness = cacheEntries.some(([, entry]) =>\n76\t    ['Redis', 'Garnet'].includes(entry.Engine) &&\n77\t    !['External', 'Local'].includes(entry.Mode ?? 'Container')\n78\t  )\n79\t  const sdkValueImports = [\n80\t    ...(hasPersistentContainerDatabase ? ['ContainerLifetime'] : []),\n81\t    ...(cacheEntries.some(([, entry]) => !['External', 'Local'].includes(entry.Mode ?? 'Container'))\n82\t      ? ['EndpointProperty']\n83\t      : []),\n84\t  ]\n85\t  const compatImports = [\n86\t    'type CacheWiring',\n87\t    ...(usesDatabaseListenerReadiness ? ['createListenerReadinessCheck'] : []),\n88\t    ...(usesRespReadiness ? ['createRespPingCheck'] : []),\n89\t    ...(dbEntries.some(([, entry]) =>\n90\t        ['Postgres', 'Mysql'].includes(entry.Engine) &&\n91\t        (entry.Mode ?? 'Container') === 'Container'\n92\t      )\n93\t      ? ['ensureDatabasePassword']\n94\t      : []),\n95\t    ...(cacheEntries.some(([, entry]) =>\n96\t        entry.Mode === 'Auto' ||\n97\t        (entry.Engine === 'Garnet' && entry.Mode === 'Executable')\n98\t      )\n99\t      ? ['ensureGarnetToolManifest']\n100\t      : []),\n101\t    ...(usesDenoKvContainer ? ['generateAccessToken as _generateAccessToken'] : []),\n102\t    ...(usesResolvedDataPath(dbEntries, cacheEntries) ? ['resolveDataPath'] : []),\n103\t    ...(cacheEntries.some(([, entry]) => entry.Mode === 'Auto') ? ['shouldUseContainerCache'] : []),\n104\t  ]\n105\t\n106\t  // Build database registration blocks\n107\t  const dbBlocks: string[] = []\n108\t  for (const [databaseIndex, [name, entry]] of dbEntries.entries()) {\n109\t    const id = `db_${databaseIndex}`\n110\t    const mode = entry.Mode ?? 'Container'\n111\t\n112\t    if (entry.Engine === 'Sqlite') {\n113\t      const sqlitePath = entry.DataPath ?? entry.DatabaseName ?? `${name}.sqlite`\n114\t      dbBlocks.push(`  // database ${databaseIndex} (Sqlite, resolved file-backed resource)\n115\t  const ${id} = await builder.addParameter(${JSON.stringify(name)}, {\n116\t    value: resolveDataPath(appHostDir, ${JSON.stringify(sqlitePath)}, ${JSON.stringify(name)}),\n117\t    secret: false,\n118\t  });\n119\t  databases.set(${JSON.stringify(name)}, ${id});`)\n120\t      continue\n121\t    }\n122\t\n123\t    if (mode === 'External') {\n124\t      dbBlocks.push(`  // database ${databaseIndex} (External)\n125\t  const ${id} = await builder.addConnectionString(${JSON.stringify(name)});\n126\t  databases.set(${JSON.stringify(name)}, ${id});`)\n127\t      continue\n128\t    }\n129\t\n130\t    const method = DB_ENGINE_METHODS[entry.Engine] ?? 'addConnectionString'\n131\t    const lines: string[] = []\n132\t\n133\t    lines.push(`  // database ${databaseIndex} (Container)`)\n134\t    // TypeScript Aspire SDK: every `builder.addXxx(...)` and `.addDatabase(...)`\n135\t    // returns a ResourcePromise. The chained configuration methods\n136\t    // (`withLifetime`, `withDataBindMount`, …) are defined on the promise,\n137\t    // but the stored value passed to `.withReference(...)` later MUST be the\n138\t    // resolved resource — otherwise the runtime rejects with\n139\t    // \"Argument 'source' is a Promise-like value\". So we `await` the entire\n140\t    // chain here.\n141\t    if (entry.Engine === 'Postgres' || entry.Engine === 'Mysql') {\n142\t      lines.push(\n143\t        `  const ${id}_password = await builder.addParameter(${\n144\t          JSON.stringify(`${name}-password`)\n145\t        }, {`,\n146\t      )\n147\t      lines.push(`    value: ensureDatabasePassword(appHostDir, ${JSON.stringify(name)}),`)\n148\t      lines.push(`    secret: true,`)\n149\t      lines.push(`  });`)\n150\t      lines.push(`  const ${id}_server = await builder.${method}(${JSON.stringify(name)}, {`)\n151\t      if (entry.Port !== undefined) {\n152\t        lines.push(`    port: ${entry.Port},`)\n153\t      }\n154\t      lines.push(`    password: ${id}_password,`)\n155\t      lines.push(`  })`)\n156\t    } else if (entry.Engine === 'Mssql') {\n157\t      lines.push(\n158\t        `  const ${id}_password = await builder.addParameter(${\n159\t          JSON.stringify(`${name}-password`)\n160\t        }, {`,\n161\t      )\n162\t      lines.push(`    value: '${MSSQL_SA_PASSWORD}',`)\n163\t      lines.push(`    secret: true,`)\n164\t      lines.push(`  });`)\n165\t      lines.push(`  const ${id}_server = await builder.${method}(${JSON.stringify(name)}, {`)\n166\t      if (entry.Port !== undefined) {\n167\t        lines.push(`    port: ${entry.Port},`)\n168\t      }\n169\t      lines.push(`    password: ${id}_password,`)\n170\t      lines.push(`  })`)\n171\t    } else {\n172\t      lines.push(`  const ${id}_server = await builder.${method}(${JSON.stringify(name)})`)\n173\t    }\n174\t\n175\t    if (entry.Persistent) {\n176\t      lines.push(\n177\t        `    // Isolated starts randomize ports, so a configured-persistent container must remain session-scoped.`,\n178\t      )\n179\t      lines.push(\n180\t        `    .withLifetime(isolatedStart ? ContainerLifetime.Session : ContainerLifetime.Persistent)`,\n181\t      )\n182\t    }\n183\t    if (entry.DataPath) {\n184\t      lines.push(\n185\t        `    .withDataBindMount(resolveDataPath(appHostDir, ${JSON.stringify(entry.DataPath)}, ${\n186\t          JSON.stringify(name)\n187\t        }))`,\n188\t      )\n189\t    }\n190\t    if (entry.Engine === 'Mssql') {\n191\t      lines.push(`    .withImage('${MSSQL_CONTAINER_IMAGE}')`)\n192\t      lines.push(\n193\t        `    .withImageTag(${JSON.stringify(entry.ImageTag ?? MSSQL_CONTAINER_TAG)})`,\n194\t      )\n195\t      lines.push(`    .withEnvironment('ACCEPT_EULA', 'Y')`)\n196\t      lines.push(`    .withEnvironment('SA_PASSWORD', '${MSSQL_SA_PASSWORD}')`)\n197\t      lines.push(\n198\t        `    .withEnvironment('MSSQL_SA_PASSWORD', '${MSSQL_SA_PASSWORD}')`,\n199\t      )\n200\t    }\n201\t\n202\t    // Close the server chain with semicolon\n203\t    const lastIdx = lines.length - 1\n204\t    lines[lastIdx] = lines[lastIdx] + ';'\n205\t\n206\t    if (['Postgres', 'Mysql', 'Mssql'].includes(entry.Engine)) {\n207\t      const healthCheckKey = `${name}_listener`\n208\t      lines.push(`  builder.addHealthCheck(${JSON.stringify(healthCheckKey)}, async () => {`)\n209\t      lines.push(`    const endpoint = await ${id}_server.getEndpoint('tcp');`)\n210\t      lines.push(`    const host = await endpoint.host();`)\n211\t      lines.push(`    const port = await endpoint.port();`)\n212\t      lines.push(\n213\t        `    return createListenerReadinessCheck({ kind: ${\n214\t          JSON.stringify(entry.Engine.toLowerCase())\n215\t        }, host, port })();`,\n216\t      )\n217\t      lines.push(`  });`)\n218\t      lines.push(`  await ${id}_server.withHealthCheck(${JSON.stringify(healthCheckKey)});`)\n219\t    }\n220\t\n221\t    // Add database child resource if DatabaseName is specified\n222\t    if (entry.DatabaseName) {\n223\t      lines.push(\n224\t        `  const ${id} = await ${id}_server.addDatabase(${JSON.stringify(entry.DatabaseName)});`,\n225\t      )\n226\t    } else {\n227\t      lines.push(`  const ${id} = ${id}_server;`)\n228\t    }\n229\t\n230\t    lines.push(`  databases.set(${JSON.stringify(name)}, ${id});`)\n231\t    dbBlocks.push(lines.join('\\n'))\n232\t  }\n233\t\n234\t  // Build cache registration blocks\n235\t  const cacheBlocks: string[] = []\n236\t  for (const [cacheIndex, [name, entry]] of cacheEntries.entries()) {\n237\t    const id = `cache_${cacheIndex}`\n238\t    const mode = entry.Mode ?? 'Container'\n239\t\n240\t    // DenoKv Local — in-process Deno.openKv(), no Aspire resource.\n241\t    if (entry.Engine === 'DenoKv' && mode === 'Local') {\n242\t      cacheBlocks.push(\n243\t        `  // cache ${cacheIndex} (DenoKv, Local — in-process Deno.openKv(), no Aspire resource)\\n` +\n244\t          `  cacheWiring.set(${\n245\t            JSON.stringify(name)\n246\t          }, { resource: null, reference: null, env: {}, local: true });`,\n247\t      )\n248\t      continue\n249\t    }\n250\t\n251\t    // External — connection-string resource; consumer wires by reference only.\n252\t    if (mode === 'External') {\n253\t      cacheBlocks.push(`  // cache ${cacheIndex} (External)\n254\t  const ${id} = await builder.addConnectionString(${JSON.stringify(name)});\n255\t  caches.set(${JSON.stringify(name)}, ${id});\n256\t  cacheWiring.set(${\n257\t        JSON.stringify(name)\n258\t      }, { resource: ${id}, reference: ${id}, env: {}, local: false });`)\n259\t      continue\n260\t    }\n261\t\n262\t    // Auto — environment-aware at apphost runtime (D5/D6). Docker present →\n263\t    // the configured container backend (DenoKv Connect for DenoKv, else the\n264\t    // Redis-compatible Garnet/Redis container). Docker absent → the Garnet\n265\t    // dotnet-tool executable (cross-fallback for the Docker-less bare-metal\n266\t    // host, #372). Both branches emit inline so the generated apphost decides\n267\t    // at `aspire start` without regeneration.\n268\t    if (mode === 'Auto') {\n269\t      const container = entry.Engine === 'DenoKv'\n270\t        ? denokvContainerSetup(id, name, entry)\n271\t        : redisGarnetContainerSetup(id, name, entry)\n272\t      const executable = garnetExecutableSetup(id, name, entry)\n273\t      const lines: string[] = []\n274\t\n275\t      lines.push(\n276\t        `  // cache ${cacheIndex} (Auto — Docker container; Docker-less Garnet executable)`,\n277\t      )\n278\t      lines.push(`  let ${id}_wiring: CacheWiring;`)\n279\t      lines.push(`  if (shouldUseContainerCache()) {`)\n280\t      for (const line of container.lines) lines.push(`  ${line}`)\n281\t      lines.push(`    ${id}_wiring = ${container.wiring};`)\n282\t      lines.push(`  } else {`)\n283\t      for (const line of executable.lines) lines.push(`  ${line}`)\n284\t      lines.push(`    ${id}_wiring = ${executable.wiring};`)\n285\t      lines.push(`  }`)\n286\t      lines.push(`  cacheWiring.set(${JSON.stringify(name)}, ${id}_wiring);`)\n287\t      cacheBlocks.push(lines.join('\\n'))\n288\t      continue\n289\t    }\n290\t\n291\t    // DenoKv Container — Deno KV Connect over HTTP with an access token.\n292\t    if (entry.Engine === 'DenoKv') {\n293\t      const setup = denokvContainerSetup(id, name, entry)\n294\t      const lines = [\n295\t        `  // cache ${cacheIndex} (DenoKv, Container — Deno KV Connect)`,\n296\t        ...setup.lines,\n297\t        `  cacheWiring.set(${JSON.stringify(name)}, ${setup.wiring});`,\n298\t      ]\n299\t      cacheBlocks.push(lines.join('\\n'))\n300\t      continue\n301\t    }\n302\t\n303\t    // Garnet Executable — Docker-less self-provisioned dotnet tool (#372).\n304\t    if (entry.Engine === 'Garnet' && mode === 'Executable') {\n305\t      const setup = garnetExecutableSetup(id, name, entry)\n306\t      const lines = [\n307\t        `  // cache ${cacheIndex} (Garnet, Executable — Docker-less dotnet tool)`,\n308\t        ...setup.lines,\n309\t        `  cacheWiring.set(${JSON.stringify(name)}, ${setup.wiring});`,\n310\t      ]\n311\t      cacheBlocks.push(lines.join('\\n'))\n312\t      continue\n313\t    }\n314\t\n315\t    // Redis / Garnet Container — Redis-compatible TCP endpoint.\n316\t    const setup = redisGarnetContainerSetup(id, name, entry)\n317\t    const lines = [\n318\t      `  // cache ${cacheIndex} (Container)`,\n319\t      ...setup.lines,\n320\t      `  cacheWiring.set(${JSON.stringify(name)}, ${setup.wiring});`,\n321\t    ]\n322\t    cacheBlocks.push(lines.join('\\n'))\n323\t  }\n324\t\n325\t  // Primary resolution\n326\t  const primaryDbLine = primaryDatabase\n327\t    ? `  const primaryDatabase = databases.get(${JSON.stringify(primaryDatabase)}) ?? null;`\n328\t    : `  const primaryDatabase = null;`\n329\t  const primaryCacheLine = primaryCache\n330\t    ? `  const primaryCache = caches.get(${JSON.stringify(primaryCache)}) ?? null;`\n331\t    : `  const primaryCache = null;`\n332\t  const primaryCacheEndpointLine = primaryCache\n333\t    ? `  const primaryCacheEndpoint = cacheEndpoints.get(${JSON.stringify(primaryCache)}) ?? null;`\n334\t    : `  const primaryCacheEndpoint = null;`\n335\t  const primaryCacheWiringLine = primaryCache\n336\t    ? `  const primaryCacheWiring = cacheWiring.get(${JSON.stringify(primaryCache)}) ?? null;`\n337\t    : `  const primaryCacheWiring = null;`\n338\t\n339\t  return renderTemplateAssetSync(\n340\t    TEMPLATE_KEYS.generatedAspireHelpersGenerateRegisterInfrastructure1,\n341\t    {\n342\t      __slot0__: String(fileHeader('register-infrastructure.mts')),\n343\t      __slot1__: String(SCAFFOLD_ASPIRE_MODULES.SDK_IMPORT_FROM_HELPERS),\n344\t      __slot2__: String(\n345\t        sdkValueImports.length > 0\n346\t          ? `import { ${\n347\t            sdkValueImports.join(', ')\n348\t          } } from '${SCAFFOLD_ASPIRE_MODULES.SDK_IMPORT_FROM_HELPERS}';`\n349\t          : '',\n350\t      ),\n351\t      __slot3__: String(\n352\t        `import { ${\n353\t          compatImports.join(', ')\n354\t        } } from '${SCAFFOLD_ASPIRE_MODULES.ASPIRE_COMPAT_IMPORT}';`,\n355\t      ),\n356\t      __slot4__: String(SCAFFOLD_ASPIRE_MODULES.ASPIRE_COMPAT_IMPORT),\n357\t      __slot5__: String(\n358\t        dbBlocks.length > 0 ? dbBlocks.join('\\n\\n') : '  // No databases configured',\n359\t      ),\n360\t      __slot6__: String(\n361\t        cacheBlocks.length > 0 ? cacheBlocks.join('\\n\\n') : '  // No caches configured',\n362\t      ),\n363\t      __slot7__: String(primaryDbLine),\n364\t      __slot8__: String(primaryCacheLine),\n365\t      __slot9__: String(primaryCacheEndpointLine),\n366\t      __slot10__: String(primaryCacheWiringLine),\n367\t      __slot11__: String(\n368\t        hasPersistentContainerDatabase\n369\t          ? `  const isolatedStart = (await builder.getConfiguration()\\n    .getConfigValue('DcpPublisher:RandomizePorts'))?.toLowerCase() === 'true';`\n370\t          : '',\n371\t      ),\n372\t    },\n373\t  )\n374\t}\n375\t\n376\tfunction usesResolvedDataPath(\n377\t  dbEntries: ReadonlyArray<readonly [string, RegisterInfrastructureOptions['databases'][string]]>,\n378\t  cacheEntries: ReadonlyArray<readonly [string, CacheEntry]>,\n379\t): boolean {\n380\t  return dbEntries.some(([, entry]) =>\n381\t    entry.Engine === 'Sqlite' ||\n382\t    ((entry.Mode ?? 'Container') === 'Container' && entry.DataPath !== undefined)\n383\t  ) || cacheEntries.some(([, entry]) =>\n384\t    entry.DataPath !== undefined &&\n385\t    !['External', 'Local'].includes(entry.Mode ?? 'Container') &&\n386\t    !(entry.Engine === 'Garnet' && entry.Mode === 'Executable')\n387\t  )\n388\t}\n389\t\n390\t/**\n391\t * Emits the DenoKv Connect container setup lines (shared by the Container arm\n392\t * and the Docker branch of the Auto arm). Returns the setup lines plus the\n393\t * `CacheWiring` object-literal expression so callers control where it is stored\n394\t * (direct `cacheWiring.set` vs. an Auto `let`-binding).\n395\t */\n396\tfunction denokvContainerSetup(\n397\t  id: string,\n398\t  name: string,\n399\t  entry: CacheEntry,\n400\t): { lines: string[]; wiring: string } {\n401\t  const tag = entry.ImageTag ?? DENOKV_CONTAINER.tag\n402\t  const imageRef = `${DENOKV_CONTAINER.image}:${tag}`\n403\t  const lines: string[] = []\n404\t\n405\t  lines.push(`  const ${id}_token = _generateAccessToken();`)\n406\t  lines.push(\n407\t    `  const ${id} = await builder.addContainer(${JSON.stringify(name)}, ${\n408\t      JSON.stringify(imageRef)\n409\t    })`,\n410\t  )\n411\t  lines.push(\n412\t    `    .withEndpoint({ name: 'http', targetPort: ${DENOKV_HTTP_PORT}, scheme: 'http' })`,\n413\t  )\n414\t  lines.push(`    .withContainerRuntimeArgs(['--init'])`)\n415\t  lines.push(`    .withArgs(['--sqlite-path', '/data/denokv.sqlite', 'serve'])`)\n416\t  lines.push(`    .withEnvironment('DENO_KV_ACCESS_TOKEN', ${id}_token)`)\n417\t  if (entry.DataPath) {\n418\t    lines.push(\n419\t      `    .withBindMount(resolveDataPath(appHostDir, ${JSON.stringify(entry.DataPath)}, ${\n420\t        JSON.stringify(name)\n421\t      }), '/data')`,\n422\t    )\n423\t  }\n424\t\n425\t  const lastIdx = lines.length - 1\n426\t  lines[lastIdx] = lines[lastIdx] + ';'\n427\t\n428\t  lines.push(`  const ${id}_httpEndpoint = await ${id}.getEndpoint('http');`)\n429\t  lines.push(\n430\t    `  const ${id}_httpUrl = ${id}_httpEndpoint.property(EndpointProperty.Url);`,\n431\t  )\n432\t  lines.push(`  caches.set(${JSON.stringify(name)}, ${id});`)\n433\t  lines.push(`  cacheEndpoints.set(${JSON.stringify(name)}, ${id}_httpEndpoint);`)\n434\t\n435\t  // DENO_KV_URL is injected explicitly (scheme-complete, via EndpointProperty.Url)\n436\t  // so the consumer's autoDetectProvider() resolves the KV Connect URL from an env\n437\t  // key regardless of the resource name — mirroring how the Redis/Garnet arms inject\n438\t  // GARNET_URI/REDIS_URI. Without it, auto-detect only finds a DenoKv URL when the\n439\t  // resource is literally named 'kv' (services__kv__http__0), silently falling back\n440\t  // to in-process Deno.openKv() otherwise.\n441\t  const wiring =\n442\t    `{ resource: ${id}, reference: ${id}_httpEndpoint, env: { DENO_KV_URL: ${id}_httpUrl, DENO_KV_ACCESS_TOKEN: ${id}_token, CACHE_PROVIDER: 'denokv' }, local: false }`\n443\t  return { lines, wiring }\n444\t}\n445\t\n446\t/**\n447\t * Emits the Garnet executable setup lines (shared by the Executable arm and the\n448\t * Docker-less branch of the Auto arm). Runs `garnet-server` as a self-provisioned\n449\t * dotnet tool (no Docker) over a Redis-compatible TCP endpoint. The tool\n450\t * version pins from `CacheEntry.ToolVersion`, falling back to the scaffold pin.\n451\t */\n452\tfunction garnetExecutableSetup(\n453\t  id: string,\n454\t  name: string,\n455\t  entry: CacheEntry,\n456\t): { lines: string[]; wiring: string } {\n457\t  const version = entry.ToolVersion ?? SCAFFOLD_VERSIONS.GARNET_TOOL\n458\t  const lines: string[] = []\n459\t\n460\t  lines.push(\n461\t    `  const ${id}_workdir = ensureGarnetToolManifest(appHostDir, ${JSON.stringify(version)});`,\n462\t  )\n463\t  lines.push(\n464\t    `  const ${id} = await builder.addExecutable(${\n465\t      JSON.stringify(name)\n466\t    }, 'dotnet', ${id}_workdir, ['tool', 'run', 'garnet-server', '--port', '${CACHE_DEFAULT_PORT}'])`,\n467\t  )\n468\t  lines.push(\n469\t    `    .withEndpoint(${cacheEndpointOptions(entry.Port)});`,\n470\t  )\n471\t  lines.push(`  const ${id}_tcpEndpoint = await ${id}.getEndpoint('tcp');`)\n472\t  lines.push(\n473\t    `  const ${id}_hostPort = ${id}_tcpEndpoint.property(EndpointProperty.HostAndPort);`,\n474\t  )\n475\t  if (['Redis', 'Garnet'].includes(entry.Engine)) {\n476\t    appendRespReadinessLines(lines, id, name)\n477\t  }\n478\t  lines.push(`  caches.set(${JSON.stringify(name)}, ${id});`)\n479\t  lines.push(`  cacheEndpoints.set(${JSON.stringify(name)}, ${id}_tcpEndpoint);`)\n480\t\n481\t  const wiring =\n482\t    `{ resource: ${id}, reference: ${id}_tcpEndpoint, env: { GARNET_URI: ${id}_hostPort, REDIS_URI: ${id}_hostPort, CACHE_PROVIDER: 'garnet' }, local: false }`\n483\t  return { lines, wiring }\n484\t}\n485\t\n486\t/**\n487\t * Emits the Redis-compatible container setup lines for Redis/Garnet (shared by\n488\t * the Container arm and the Docker branch of a Redis/Garnet Auto arm). Wires a\n489\t * `GARNET_URI`/`REDIS_URI` host:port pair plus the provider tag.\n490\t */\n491\tfunction redisGarnetContainerSetup(\n492\t  id: string,\n493\t  name: string,\n494\t  entry: CacheEntry,\n495\t): { lines: string[]; wiring: string } {\n496\t  const image = CACHE_CONTAINER_IMAGES[entry.Engine] ??\n497\t    CACHE_CONTAINER_IMAGES.Redis\n498\t  const tag = entry.ImageTag ?? image.tag\n499\t  const imageRef = `${image.image}:${tag}`\n500\t  const provider = entry.Engine === 'Garnet' ? 'garnet' : 'redis'\n501\t  const lines: string[] = []\n502\t\n503\t  lines.push(\n504\t    `  const ${id} = await builder.addContainer(${JSON.stringify(name)}, ${\n505\t      JSON.stringify(imageRef)\n506\t    })`,\n507\t  )\n508\t  lines.push(`    .withEndpoint(${cacheEndpointOptions(entry.Port)})`)\n509\t  if (entry.DataPath) {\n510\t    lines.push(\n511\t      `    .withBindMount(resolveDataPath(appHostDir, ${JSON.stringify(entry.DataPath)}, ${\n512\t        JSON.stringify(name)\n513\t      }), '/data')`,\n514\t    )\n515\t  }\n516\t\n517\t  const lastIdx = lines.length - 1\n518\t  lines[lastIdx] = lines[lastIdx] + ';'\n519\t\n520\t  lines.push(`  const ${id}_tcpEndpoint = await ${id}.getEndpoint('tcp');`)\n521\t  lines.push(\n522\t    `  const ${id}_hostPort = ${id}_tcpEndpoint.property(EndpointProperty.HostAndPort);`,\n523\t  )\n524\t  if (['Redis', 'Garnet'].includes(entry.Engine)) {\n525\t    appendRespReadinessLines(lines, id, name)\n526\t  }\n527\t  lines.push(`  caches.set(${JSON.stringify(name)}, ${id});`)\n528\t  lines.push(`  cacheEndpoints.set(${JSON.stringify(name)}, ${id}_tcpEndpoint);`)\n529\t\n530\t  const wiring =\n531\t    `{ resource: ${id}, reference: ${id}_tcpEndpoint, env: { GARNET_URI: ${id}_hostPort, REDIS_URI: ${id}_hostPort, CACHE_PROVIDER: ${\n532\t      JSON.stringify(provider)\n533\t    } }, local: false }`\n534\t  return { lines, wiring }\n535\t}\n536\t\n537\tfunction appendRespReadinessLines(lines: string[], id: string, name: string): void {\n538\t  const healthCheckKey = `${name}_resp`\n539\t  lines.push(`  builder.addHealthCheck(${JSON.stringify(healthCheckKey)}, async () => {`)\n540\t  lines.push(`    const endpoint = await ${id}.getEndpoint('tcp');`)\n541\t  lines.push(`    const host = await endpoint.host();`)\n542\t  lines.push(`    const port = await endpoint.port();`)\n543\t  lines.push(`    return createRespPingCheck({ host, port })();`)\n544\t  lines.push(`  });`)\n545\t  lines.push(`  await ${id}.withHealthCheck(${JSON.stringify(healthCheckKey)});`)\n546\t}\n547\t\n548\tfunction cacheEndpointOptions(port: number | undefined): string {\n549\t  const options = [\n550\t    \"name: 'tcp'\",\n551\t    `targetPort: ${CACHE_DEFAULT_PORT}`,\n552\t    \"scheme: 'tcp'\",\n553\t  ]\n554\t  if (port !== undefined) {\n555\t    options.unshift(`port: ${port}`)\n556\t  }\n557\t  return `{ ${options.join(', ')} }`\n558\t}\n559\t"}]},"parent_tool_use_id":null,"session_id":"c1ca789b-c4ca-4f53-b9ac-092eb2e122d5","uuid":"d5e74e18-2883-477d-ae02-6bc81343c817","timestamp":"2026-09-01T21:23:29.460Z","tool_use_result":{"type":"text","file":{"filePath":"/home/agent/projects/netscript/worktrees/007-eval-combined/packages/cli/src/kernel/templates/aspire/helpers/register/generate-register-infrastructure.ts","content":"/**\n * @module\n *\n * Generator for `.helpers/register-infrastructure.mts` — registers databases\n * and caches with the Aspire SDK builder. Handles engine dispatch, container\n * vs external mode, persistent lifetime, data bind mounts, and primary\n * resource resolution.\n */\n\nimport type { CacheEntry } from '@netscript/aspire/types'\nimport type { RegisterInfrastructureOptions } from '../types.ts'\nimport { fileHeader } from '../_utils.ts'\nimport { SCAFFOLD_ASPIRE_MODULES } from '../../../../constants/scaffold/scaffold-aspire.ts'\nimport { SCAFFOLD_VERSIONS } from '../../../../constants/scaffold/scaffold-versions.ts'\nimport { TEMPLATE_KEYS } from '../../../../assets/manifest.ts'\nimport { renderTemplateAssetSync } from '../../../../adapters/templates/template-asset.ts'\n\n/** Maps database engine names to SDK builder method names. */\nconst DB_ENGINE_METHODS: Record<string, string> = {\n  Postgres: 'addPostgres',\n  Mysql: 'addMySql',\n  Mssql: 'addSqlServer',\n}\n\nconst MSSQL_CONTAINER_IMAGE = 'mssql/server'\nconst MSSQL_CONTAINER_TAG = '2022-latest'\nconst MSSQL_SA_PASSWORD = 'NetscriptE2e!Sql2026'\n\n/** Default Redis-compatible cache container images. */\nconst CACHE_CONTAINER_IMAGES: Record<\n  string,\n  { readonly image: string; readonly tag: string }\n> = {\n  Redis: { image: 'docker.io/library/redis', tag: '7' },\n  Garnet: { image: 'ghcr.io/microsoft/garnet', tag: '1.1.10' },\n}\n\n/** Default Redis-compatible TCP port. */\nconst CACHE_DEFAULT_PORT = 6379\n\n/** Deno KV Connect container image (shared KV over HTTP). */\nconst DENOKV_CONTAINER = {\n  image: 'ghcr.io/denoland/denokv',\n  tag: '0.11.0',\n} as const\n\n/** Deno KV Connect HTTP port inside the container. */\nconst DENOKV_HTTP_PORT = 4512\n\n/**\n * Generates the register-infrastructure.mts file content.\n *\n * @param options - Database and cache entries from parsed config\n * @returns Generated TypeScript source as a string\n */\nexport function generateRegisterInfrastructure(\n  options: RegisterInfrastructureOptions,\n): string {\n  const { databases, caches, primaryDatabase, primaryCache } = options\n  const dbEntries = Object.entries(databases)\n  const cacheEntries = Object.entries(caches)\n  const usesDenoKvContainer = cacheEntries.some(([, entry]) =>\n    entry.Engine === 'DenoKv' &&\n    !['External', 'Local'].includes(entry.Mode ?? 'Container')\n  )\n  const hasPersistentContainerDatabase = dbEntries.some(([, entry]) =>\n    entry.Engine !== 'Sqlite' &&\n    (entry.Mode ?? 'Container') === 'Container' &&\n    entry.Persistent === true\n  )\n  const usesDatabaseListenerReadiness = dbEntries.some(([, entry]) =>\n    ['Postgres', 'Mysql', 'Mssql'].includes(entry.Engine) &&\n    (entry.Mode ?? 'Container') === 'Container'\n  )\n  const usesRespReadiness = cacheEntries.some(([, entry]) =>\n    ['Redis', 'Garnet'].includes(entry.Engine) &&\n    !['External', 'Local'].includes(entry.Mode ?? 'Container')\n  )\n  const sdkValueImports = [\n    ...(hasPersistentContainerDatabase ? ['ContainerLifetime'] : []),\n    ...(cacheEntries.some(([, entry]) => !['External', 'Local'].includes(entry.Mode ?? 'Container'))\n      ? ['EndpointProperty']\n      : []),\n  ]\n  const compatImports = [\n    'type CacheWiring',\n    ...(usesDatabaseListenerReadiness ? ['createListenerReadinessCheck'] : []),\n    ...(usesRespReadiness ? ['createRespPingCheck'] : []),\n    ...(dbEntries.some(([, entry]) =>\n        ['Postgres', 'Mysql'].includes(entry.Engine) &&\n        (entry.Mode ?? 'Container') === 'Container'\n      )\n      ? ['ensureDatabasePassword']\n      : []),\n    ...(cacheEntries.some(([, entry]) =>\n        entry.Mode === 'Auto' ||\n        (entry.Engine === 'Garnet' && entry.Mode === 'Executable')\n      )\n      ? ['ensureGarnetToolManifest']\n      : []),\n    ...(usesDenoKvContainer ? ['generateAccessToken as _generateAccessToken'] : []),\n    ...(usesResolvedDataPath(dbEntries, cacheEntries) ? ['resolveDataPath'] : []),\n    ...(cacheEntries.some(([, entry]) => entry.Mode === 'Auto') ? ['shouldUseContainerCache'] : []),\n  ]\n\n  // Build database registration blocks\n  const dbBlocks: string[] = []\n  for (const [databaseIndex, [name, entry]] of dbEntries.entries()) {\n    const id = `db_${databaseIndex}`\n    const mode = entry.Mode ?? 'Container'\n\n    if (entry.Engine === 'Sqlite') {\n      const sqlitePath = entry.DataPath ?? entry.DatabaseName ?? `${name}.sqlite`\n      dbBlocks.push(`  // database ${databaseIndex} (Sqlite, resolved file-backed resource)\n  const ${id} = await builder.addParameter(${JSON.stringify(name)}, {\n    value: resolveDataPath(appHostDir, ${JSON.stringify(sqlitePath)}, ${JSON.stringify(name)}),\n    secret: false,\n  });\n  databases.set(${JSON.stringify(name)}, ${id});`)\n      continue\n    }\n\n    if (mode === 'External') {\n      dbBlocks.push(`  // database ${databaseIndex} (External)\n  const ${id} = await builder.addConnectionString(${JSON.stringify(name)});\n  databases.set(${JSON.stringify(name)}, ${id});`)\n      continue\n    }\n\n    const method = DB_ENGINE_METHODS[entry.Engine] ?? 'addConnectionString'\n    const lines: string[] = []\n\n    lines.push(`  // database ${databaseIndex} (Container)`)\n    // TypeScript Aspire SDK: every `builder.addXxx(...)` and `.addDatabase(...)`\n    // returns a ResourcePromise. The chained configuration methods\n    // (`withLifetime`, `withDataBindMount`, …) are defined on the promise,\n    // but the stored value passed to `.withReference(...)` later MUST be the\n    // resolved resource — otherwise the runtime rejects with\n    // \"Argument 'source' is a Promise-like value\". So we `await` the entire\n    // chain here.\n    if (entry.Engine === 'Postgres' || entry.Engine === 'Mysql') {\n      lines.push(\n        `  const ${id}_password = await builder.addParameter(${\n          JSON.stringify(`${name}-password`)\n        }, {`,\n      )\n      lines.push(`    value: ensureDatabasePassword(appHostDir, ${JSON.stringify(name)}),`)\n      lines.push(`    secret: true,`)\n      lines.push(`  });`)\n      lines.push(`  const ${id}_server = await builder.${method}(${JSON.stringify(name)}, {`)\n      if (entry.Port !== undefined) {\n        lines.push(`    port: ${entry.Port},`)\n      }\n      lines.push(`    password: ${id}_password,`)\n      lines.push(`  })`)\n    } else if (entry.Engine === 'Mssql') {\n      lines.push(\n        `  const ${id}_password = await builder.addParameter(${\n          JSON.stringify(`${name}-password`)\n        }, {`,\n      )\n      lines.push(`    value: '${MSSQL_SA_PASSWORD}',`)\n      lines.push(`    secret: true,`)\n      lines.push(`  });`)\n      lines.push(`  const ${id}_server = await builder.${method}(${JSON.stringify(name)}, {`)\n      if (entry.Port !== undefined) {\n        lines.push(`    port: ${entry.Port},`)\n      }\n      lines.push(`    password: ${id}_password,`)\n      lines.push(`  })`)\n    } else {\n      lines.push(`  const ${id}_server = await builder.${method}(${JSON.stringify(name)})`)\n    }\n\n    if (entry.Persistent) {\n      lines.push(\n        `    // Isolated starts randomize ports, so a configured-persistent container must remain session-scoped.`,\n      )\n      lines.push(\n        `    .withLifetime(isolatedStart ? ContainerLifetime.Session : ContainerLifetime.Persistent)`,\n      )\n    }\n    if (entry.DataPath) {\n      lines.push(\n        `    .withDataBindMount(resolveDataPath(appHostDir, ${JSON.stringify(entry.DataPath)}, ${\n          JSON.stringify(name)\n        }))`,\n      )\n    }\n    if (entry.Engine === 'Mssql') {\n      lines.push(`    .withImage('${MSSQL_CONTAINER_IMAGE}')`)\n      lines.push(\n        `    .withImageTag(${JSON.stringify(entry.ImageTag ?? MSSQL_CONTAINER_TAG)})`,\n      )\n      lines.push(`    .withEnvironment('ACCEPT_EULA', 'Y')`)\n      lines.push(`    .withEnvironment('SA_PASSWORD', '${MSSQL_SA_PASSWORD}')`)\n      lines.push(\n        `    .withEnvironment('MSSQL_SA_PASSWORD', '${MSSQL_SA_PASSWORD}')`,\n      )\n    }\n\n    // Close the server chain with semicolon\n    const lastIdx = lines.length - 1\n    lines[lastIdx] = lines[lastIdx] + ';'\n\n    if (['Postgres', 'Mysql', 'Mssql'].includes(entry.Engine)) {\n      const healthCheckKey = `${name}_listener`\n      lines.push(`  builder.addHealthCheck(${JSON.stringify(healthCheckKey)}, async () => {`)\n      lines.push(`    const endpoint = await ${id}_server.getEndpoint('tcp');`)\n      lines.push(`    const host = await endpoint.host();`)\n      lines.push(`    const port = await endpoint.port();`)\n      lines.push(\n        `    return createListenerReadinessCheck({ kind: ${\n          JSON.stringify(entry.Engine.toLowerCase())\n        }, host, port })();`,\n      )\n      lines.push(`  });`)\n      lines.push(`  await ${id}_server.withHealthCheck(${JSON.stringify(healthCheckKey)});`)\n    }\n\n    // Add database child resource if DatabaseName is specified\n    if (entry.DatabaseName) {\n      lines.push(\n        `  const ${id} = await ${id}_server.addDatabase(${JSON.stringify(entry.DatabaseName)});`,\n      )\n    } else {\n      lines.push(`  const ${id} = ${id}_server;`)\n    }\n\n    lines.push(`  databases.set(${JSON.stringify(name)}, ${id});`)\n    dbBlocks.push(lines.join('\\n'))\n  }\n\n  // Build cache registration blocks\n  const cacheBlocks: string[] = []\n  for (const [cacheIndex, [name, entry]] of cacheEntries.entries()) {\n    const id = `cache_${cacheIndex}`\n    const mode = entry.Mode ?? 'Container'\n\n    // DenoKv Local — in-process Deno.openKv(), no Aspire resource.\n    if (entry.Engine === 'DenoKv' && mode === 'Local') {\n      cacheBlocks.push(\n        `  // cache ${cacheIndex} (DenoKv, Local — in-process Deno.openKv(), no Aspire resource)\\n` +\n          `  cacheWiring.set(${\n            JSON.stringify(name)\n          }, { resource: null, reference: null, env: {}, local: true });`,\n      )\n      continue\n    }\n\n    // External — connection-string resource; consumer wires by reference only.\n    if (mode === 'External') {\n      cacheBlocks.push(`  // cache ${cacheIndex} (External)\n  const ${id} = await builder.addConnectionString(${JSON.stringify(name)});\n  caches.set(${JSON.stringify(name)}, ${id});\n  cacheWiring.set(${\n        JSON.stringify(name)\n      }, { resource: ${id}, reference: ${id}, env: {}, local: false });`)\n      continue\n    }\n\n    // Auto — environment-aware at apphost runtime (D5/D6). Docker present →\n    // the configured container backend (DenoKv Connect for DenoKv, else the\n    // Redis-compatible Garnet/Redis container). Docker absent → the Garnet\n    // dotnet-tool executable (cross-fallback for the Docker-less bare-metal\n    // host, #372). Both branches emit inline so the generated apphost decides\n    // at `aspire start` without regeneration.\n    if (mode === 'Auto') {\n      const container = entry.Engine === 'DenoKv'\n        ? denokvContainerSetup(id, name, entry)\n        : redisGarnetContainerSetup(id, name, entry)\n      const executable = garnetExecutableSetup(id, name, entry)\n      const lines: string[] = []\n\n      lines.push(\n        `  // cache ${cacheIndex} (Auto — Docker container; Docker-less Garnet executable)`,\n      )\n      lines.push(`  let ${id}_wiring: CacheWiring;`)\n      lines.push(`  if (shouldUseContainerCache()) {`)\n      for (const line of container.lines) lines.push(`  ${line}`)\n      lines.push(`    ${id}_wiring = ${container.wiring};`)\n      lines.push(`  } else {`)\n      for (const line of executable.lines) lines.push(`  ${line}`)\n      lines.push(`    ${id}_wiring = ${executable.wiring};`)\n      lines.push(`  }`)\n      lines.push(`  cacheWiring.set(${JSON.stringify(name)}, ${id}_wiring);`)\n      cacheBlocks.push(lines.join('\\n'))\n      continue\n    }\n\n    // DenoKv Container — Deno KV Connect over HTTP with an access token.\n    if (entry.Engine === 'DenoKv') {\n      const setup = denokvContainerSetup(id, name, entry)\n      const lines = [\n        `  // cache ${cacheIndex} (DenoKv, Container — Deno KV Connect)`,\n        ...setup.lines,\n        `  cacheWiring.set(${JSON.stringify(name)}, ${setup.wiring});`,\n      ]\n      cacheBlocks.push(lines.join('\\n'))\n      continue\n    }\n\n    // Garnet Executable — Docker-less self-provisioned dotnet tool (#372).\n    if (entry.Engine === 'Garnet' && mode === 'Executable') {\n      const setup = garnetExecutableSetup(id, name, entry)\n      const lines = [\n        `  // cache ${cacheIndex} (Garnet, Executable — Docker-less dotnet tool)`,\n        ...setup.lines,\n        `  cacheWiring.set(${JSON.stringify(name)}, ${setup.wiring});`,\n      ]\n      cacheBlocks.push(lines.join('\\n'))\n      continue\n    }\n\n    // Redis / Garnet Container — Redis-compatible TCP endpoint.\n    const setup = redisGarnetContainerSetup(id, name, entry)\n    const lines = [\n      `  // cache ${cacheIndex} (Container)`,\n      ...setup.lines,\n      `  cacheWiring.set(${JSON.stringify(name)}, ${setup.wiring});`,\n    ]\n    cacheBlocks.push(lines.join('\\n'))\n  }\n\n  // Primary resolution\n  const primaryDbLine = primaryDatabase\n    ? `  const primaryDatabase = databases.get(${JSON.stringify(primaryDatabase)}) ?? null;`\n    : `  const primaryDatabase = null;`\n  const primaryCacheLine = primaryCache\n    ? `  const primaryCache = caches.get(${JSON.stringify(primaryCache)}) ?? null;`\n    : `  const primaryCache = null;`\n  const primaryCacheEndpointLine = primaryCache\n    ? `  const primaryCacheEndpoint = cacheEndpoints.get(${JSON.stringify(primaryCache)}) ?? null;`\n    : `  const primaryCacheEndpoint = null;`\n  const primaryCacheWiringLine = primaryCache\n    ? `  const primaryCacheWiring = cacheWiring.get(${JSON.stringify(primaryCache)}) ?? null;`\n    : `  const primaryCacheWiring = null;`\n\n  return renderTemplateAssetSync(\n    TEMPLATE_KEYS.generatedAspireHelpersGenerateRegisterInfrastructure1,\n    {\n      __slot0__: String(fileHeader('register-infrastructure.mts')),\n      __slot1__: String(SCAFFOLD_ASPIRE_MODULES.SDK_IMPORT_FROM_HELPERS),\n      __slot2__: String(\n        sdkValueImports.length > 0\n          ? `import { ${\n            sdkValueImports.join(', ')\n          } } from '${SCAFFOLD_ASPIRE_MODULES.SDK_IMPORT_FROM_HELPERS}';`\n          : '',\n      ),\n      __slot3__: String(\n        `import { ${\n          compatImports.join(', ')\n        } } from '${SCAFFOLD_ASPIRE_MODULES.ASPIRE_COMPAT_IMPORT}';`,\n      ),\n      __slot4__: String(SCAFFOLD_ASPIRE_MODULES.ASPIRE_COMPAT_IMPORT),\n      __slot5__: String(\n        dbBlocks.length > 0 ? dbBlocks.join('\\n\\n') : '  // No databases configured',\n      ),\n      __slot6__: String(\n        cacheBlocks.length > 0 ? cacheBlocks.join('\\n\\n') : '  // No caches configured',\n      ),\n      __slot7__: String(primaryDbLine),\n      __slot8__: String(primaryCacheLine),\n      __slot9__: String(primaryCacheEndpointLine),\n      __slot10__: String(primaryCacheWiringLine),\n      __slot11__: String(\n        hasPersistentContainerDatabase\n          ? `  const isolatedStart = (await builder.getConfiguration()\\n    .getConfigValue('DcpPublisher:RandomizePorts'))?.toLowerCase() === 'true';`\n          : '',\n      ),\n    },\n  )\n}\n\nfunction usesResolvedDataPath(\n  dbEntries: ReadonlyArray<readonly [string, RegisterInfrastructureOptions['databases'][string]]>,\n  cacheEntries: ReadonlyArray<readonly [string, CacheEntry]>,\n): boolean {\n  return dbEntries.some(([, entry]) =>\n    entry.Engine === 'Sqlite' ||\n    ((entry.Mode ?? 'Container') === 'Container' && entry.DataPath !== undefined)\n  ) || cacheEntries.some(([, entry]) =>\n    entry.DataPath !== undefined &&\n    !['External', 'Local'].includes(entry.Mode ?? 'Container') &&\n    !(entry.Engine === 'Garnet' && entry.Mode === 'Executable')\n  )\n}\n\n/**\n * Emits the DenoKv Connect container setup lines (shared by the Container arm\n * and the Docker branch of the Auto arm). Returns the setup lines plus the\n * `CacheWiring` object-literal expression so callers control where it is stored\n * (direct `cacheWiring.set` vs. an Auto `let`-binding).\n */\nfunction denokvContainerSetup(\n  id: string,\n  name: string,\n  entry: CacheEntry,\n): { lines: string[]; wiring: string } {\n  const tag = entry.ImageTag ?? DENOKV_CONTAINER.tag\n  const imageRef = `${DENOKV_CONTAINER.image}:${tag}`\n  const lines: string[] = []\n\n  lines.push(`  const ${id}_token = _generateAccessToken();`)\n  lines.push(\n    `  const ${id} = await builder.addContainer(${JSON.stringify(name)}, ${\n      JSON.stringify(imageRef)\n    })`,\n  )\n  lines.push(\n    `    .withEndpoint({ name: 'http', targetPort: ${DENOKV_HTTP_PORT}, scheme: 'http' })`,\n  )\n  lines.push(`    .withContainerRuntimeArgs(['--init'])`)\n  lines.push(`    .withArgs(['--sqlite-path', '/data/denokv.sqlite', 'serve'])`)\n  lines.push(`    .withEnvironment('DENO_KV_ACCESS_TOKEN', ${id}_token)`)\n  if (entry.DataPath) {\n    lines.push(\n      `    .withBindMount(resolveDataPath(appHostDir, ${JSON.stringify(entry.DataPath)}, ${\n        JSON.stringify(name)\n      }), '/data')`,\n    )\n  }\n\n  const lastIdx = lines.length - 1\n  lines[lastIdx] = lines[lastIdx] + ';'\n\n  lines.push(`  const ${id}_httpEndpoint = await ${id}.getEndpoint('http');`)\n  lines.push(\n    `  const ${id}_httpUrl = ${id}_httpEndpoint.property(EndpointProperty.Url);`,\n  )\n  lines.push(`  caches.set(${JSON.stringify(name)}, ${id});`)\n  lines.push(`  cacheEndpoints.set(${JSON.stringify(name)}, ${id}_httpEndpoint);`)\n\n  // DENO_KV_URL is injected explicitly (scheme-complete, via EndpointProperty.Url)\n  // so the consumer's autoDetectProvider() resolves the KV Connect URL from an env\n  // key regardless of the resource name — mirroring how the Redis/Garnet arms inject\n  // GARNET_URI/REDIS_URI. Without it, auto-detect only finds a DenoKv URL when the\n  // resource is literally named 'kv' (services__kv__http__0), silently falling back\n  // to in-process Deno.openKv() otherwise.\n  const wiring =\n    `{ resource: ${id}, reference: ${id}_httpEndpoint, env: { DENO_KV_URL: ${id}_httpUrl, DENO_KV_ACCESS_TOKEN: ${id}_token, CACHE_PROVIDER: 'denokv' }, local: false }`\n  return { lines, wiring }\n}\n\n/**\n * Emits the Garnet executable setup lines (shared by the Executable arm and the\n * Docker-less branch of the Auto arm). Runs `garnet-server` as a self-provisioned\n * dotnet tool (no Docker) over a Redis-compatible TCP endpoint. The tool\n * version pins from `CacheEntry.ToolVersion`, falling back to the scaffold pin.\n */\nfunction garnetExecutableSetup(\n  id: string,\n  name: string,\n  entry: CacheEntry,\n): { lines: string[]; wiring: string } {\n  const version = entry.ToolVersion ?? SCAFFOLD_VERSIONS.GARNET_TOOL\n  const lines: string[] = []\n\n  lines.push(\n    `  const ${id}_workdir = ensureGarnetToolManifest(appHostDir, ${JSON.stringify(version)});`,\n  )\n  lines.push(\n    `  const ${id} = await builder.addExecutable(${\n      JSON.stringify(name)\n    }, 'dotnet', ${id}_workdir, ['tool', 'run', 'garnet-server', '--port', '${CACHE_DEFAULT_PORT}'])`,\n  )\n  lines.push(\n    `    .withEndpoint(${cacheEndpointOptions(entry.Port)});`,\n  )\n  lines.push(`  const ${id}_tcpEndpoint = await ${id}.getEndpoint('tcp');`)\n  lines.push(\n    `  const ${id}_hostPort = ${id}_tcpEndpoint.property(EndpointProperty.HostAndPort);`,\n  )\n  if (['Redis', 'Garnet'].includes(entry.Engine)) {\n    appendRespReadinessLines(lines, id, name)\n  }\n  lines.push(`  caches.set(${JSON.stringify(name)}, ${id});`)\n  lines.push(`  cacheEndpoints.set(${JSON.stringify(name)}, ${id}_tcpEndpoint);`)\n\n  const wiring =\n    `{ resource: ${id}, reference: ${id}_tcpEndpoint, env: { GARNET_URI: ${id}_hostPort, REDIS_URI: ${id}_hostPort, CACHE_PROVIDER: 'garnet' }, local: false }`\n  return { lines, wiring }\n}\n\n/**\n * Emits the Redis-compatible container setup lines for Redis/Garnet (shared by\n * the Container arm and the Docker branch of a Redis/Garnet Auto arm). Wires a\n * `GARNET_URI`/`REDIS_URI` host:port pair plus the provider tag.\n */\nfunction redisGarnetContainerSetup(\n  id: string,\n  name: string,\n  entry: CacheEntry,\n): { lines: string[]; wiring: string } {\n  const image = CACHE_CONTAINER_IMAGES[entry.Engine] ??\n    CACHE_CONTAINER_IMAGES.Redis\n  const tag = entry.ImageTag ?? image.tag\n  const imageRef = `${image.image}:${tag}`\n  const provider = entry.Engine === 'Garnet' ? 'garnet' : 'redis'\n  const lines: string[] = []\n\n  lines.push(\n    `  const ${id} = await builder.addContainer(${JSON.stringify(name)}, ${\n      JSON.stringify(imageRef)\n    })`,\n  )\n  lines.push(`    .withEndpoint(${cacheEndpointOptions(entry.Port)})`)\n  if (entry.DataPath) {\n    lines.push(\n      `    .withBindMount(resolveDataPath(appHostDir, ${JSON.stringify(entry.DataPath)}, ${\n        JSON.stringify(name)\n      }), '/data')`,\n    )\n  }\n\n  const lastIdx = lines.length - 1\n  lines[lastIdx] = lines[lastIdx] + ';'\n\n  lines.push(`  const ${id}_tcpEndpoint = await ${id}.getEndpoint('tcp');`)\n  lines.push(\n    `  const ${id}_hostPort = ${id}_tcpEndpoint.property(EndpointProperty.HostAndPort);`,\n  )\n  if (['Redis', 'Garnet'].includes(entry.Engine)) {\n    appendRespReadinessLines(lines, id, name)\n  }\n  lines.push(`  caches.set(${JSON.stringify(name)}, ${id});`)\n  lines.push(`  cacheEndpoints.set(${JSON.stringify(name)}, ${id}_tcpEndpoint);`)\n\n  const wiring =\n    `{ resource: ${id}, reference: ${id}_tcpEndpoint, env: { GARNET_URI: ${id}_hostPort, REDIS_URI: ${id}_hostPort, CACHE_PROVIDER: ${\n      JSON.stringify(provider)\n    } }, local: false }`\n  return { lines, wiring }\n}\n\nfunction appendRespReadinessLines(lines: string[], id: string, name: string): void {\n  const healthCheckKey = `${name}_resp`\n  lines.push(`  builder.addHealthCheck(${JSON.stringify(healthCheckKey)}, async () => {`)\n  lines.push(`    const endpoint = await ${id}.getEndpoint('tcp');`)\n  lines.push(`    const host = await endpoint.host();`)\n  lines.push(`    const port = await endpoint.port();`)\n  lines.push(`    return createRespPingCheck({ host, port })();`)\n  lines.push(`  });`)\n  lines.push(`  await ${id}.withHealthCheck(${JSON.stringify(healthCheckKey)});`)\n}\n\nfunction cacheEndpointOptions(port: number | undefined): string {\n  const options = [\n    \"name: 'tcp'\",\n    `targetPort: ${CACHE_DEFAULT_PORT}`,\n    \"scheme: 'tcp'\",\n  ]\n  if (port !== undefined) {\n    options.unshift(`port: ${port}`)\n  }\n  return `{ ${options.join(', ')} }`\n}\n","numLines":559,"startLine":1,"totalLines":559}}}
