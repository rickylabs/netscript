{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-be8501e23f944719","type":"tool_result","content":"1\timport { assertEquals, assertStringIncludes, assertThrows } from '@std/assert';\n2\t\n3\timport { generateRegisterInfrastructure } from '../../../../src/kernel/templates/aspire/helpers/register/generate-register-infrastructure.ts';\n4\timport { generateRegisterApps } from '../../../../src/kernel/templates/aspire/helpers/register/generate-register-apps.ts';\n5\timport { buildCacheBlock } from '../../../../src/kernel/templates/aspire/generate-appsettings.ts';\n6\timport { DATABASE } from '../../../src/domain/extension-axes.ts';\n7\timport {\n8\t  injectListenerFaultHealthChecks,\n9\t  injectReadinessFixtureApps,\n10\t  TEST_ONLY_GARNET_HEALTH_KEY,\n11\t  TEST_ONLY_POSTGRES_HEALTH_KEY,\n12\t} from '../../../src/application/gates/scaffold/runtime/prepare-readiness-fixture.ts';\n13\t\n14\tDeno.test('listener fault splice accepts the E2E two-cache Auto generator output', () => {\n15\t  const redis = buildCacheBlock('redis');\n16\t  const garnet = buildCacheBlock('garnet');\n17\t  const source = generateRegisterInfrastructure({\n18\t    databases: {},\n19\t    caches: {\n20\t      [redis.key]: { ...redis.block, Enabled: true },\n21\t      [garnet.key]: { ...garnet.block, Enabled: true, Mode: 'Auto' },\n22\t    },\n23\t    primaryCache: garnet.key,\n24\t  });\n25\t\n26\t  assertEquals(healthAttachmentCount(source, 'redis_resp'), 1);\n27\t  assertEquals(healthAttachmentCount(source, 'garnet_resp'), 2);\n28\t  const injected = injectListenerFaultHealthChecks(source, DATABASE.SQLITE);\n29\t  assertEquals(healthAttachmentCount(injected, TEST_ONLY_GARNET_HEALTH_KEY), 2);\n30\t  assertAutoBranchInjectionPlacement(injected);\n31\t});\n32\t\n33\tDeno.test('listener fault splice attaches test-only checks at generator-derived markers', () => {\n34\t  const source = generatedInfrastructure();\n35\t  const cases = [\n36\t    { source, postgresBinding: 'db_0_server', garnetBinding: 'cache_0' },\n37\t    {\n38\t      source: withSingleQuotedHealthKeys(source),\n39\t      postgresBinding: 'db_0_server',\n40\t      garnetBinding: 'cache_0',\n41\t    },\n42\t    {\n43\t      source: source.replaceAll('db_0_server', 'db_7_server').replaceAll('cache_0', 'cache_3'),\n44\t      postgresBinding: 'db_7_server',\n45\t      garnetBinding: 'cache_3',\n46\t    },\n47\t  ];\n48\t\n49\t  for (const { source, postgresBinding, garnetBinding } of cases) {\n50\t    const injected = injectListenerFaultHealthChecks(source);\n51\t    assertStringIncludes(\n52\t      injected,\n53\t      `builder.addHealthCheck('${TEST_ONLY_POSTGRES_HEALTH_KEY}', createListenerReadinessCheck({ kind: 'tcp', host: 'localhost', port: 18998 }));`,\n54\t    );\n55\t    assertStringIncludes(\n56\t      injected,\n57\t      `await ${postgresBinding}.withHealthCheck('${TEST_ONLY_POSTGRES_HEALTH_KEY}');`,\n58\t    );\n59\t    assertStringIncludes(\n60\t      injected,\n61\t      `builder.addHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}', createRespPingCheck({ host: 'localhost', port: 18999 }));`,\n62\t    );\n63\t    assertStringIncludes(\n64\t      injected,\n65\t      `await ${garnetBinding}.withHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}');`,\n66\t    );\n67\t  }\n68\t});\n69\t\n70\tDeno.test('readiness app splice namespaces fixture bindings in a real generated host', async () => {\n71\t  const source = generateRegisterApps({\n72\t    apps: {\n73\t      app: {\n74\t        Enabled: true,\n75\t        Runtime: 'deno',\n76\t        Type: 'task',\n77\t        Workdir: 'apps/app',\n78\t        TaskName: 'start',\n79\t        WatchMode: false,\n80\t        RequiresKv: false,\n81\t      },\n82\t    },\n83\t    version: 'e2e',\n84\t    denoDefaults: { Permissions: [], WatchMode: false },\n85\t  });\n86\t  const injected = injectReadinessFixtureApps(source);\n87\t\n88\t  assertEquals(duplicateConstBindings(injected), []);\n89\t  await assertGeneratedModuleChecks(injected);\n90\t  assertStringIncludes(injected, 'const readiness_fixture_app_0_workdir');\n91\t  assertStringIncludes(injected, 'const readiness_fixture_app_0_otel');\n92\t  assertStringIncludes(injected, 'const readiness_fixture_app_1_workdir');\n93\t  assertStringIncludes(injected, 'const readiness_fixture_app_1_otel');\n94\t  assertStringIncludes(injected, 'apps.set(\"readiness-dead-port\"');\n95\t  assertStringIncludes(injected, 'apps.set(\"listener-fault-controller\"');\n96\t  assertThrows(\n97\t    () => injectReadinessFixtureApps(withSingleQuotedAppNames(injected)),\n98\t    Error,\n99\t    'readiness-dead-port fixture was already registered',\n100\t  );\n101\t  assertThrows(\n102\t    () => injectReadinessFixtureApps(source.replace('  return apps;', '')),\n103\t    Error,\n104\t    'generated register-apps helper has no return marker',\n105\t  );\n106\t});\n107\t\n108\tDeno.test('listener fault splice fails closed on missing markers and double registration', () => {\n109\t  const source = generatedInfrastructure();\n110\t  assertThrows(\n111\t    () => injectListenerFaultHealthChecks(withoutHealthAttachment(source, 'garnet_resp')),\n112\t    Error,\n113\t    'generated register-infrastructure helper has no garnet health-check attachment',\n114\t  );\n115\t  assertThrows(\n116\t    () => injectListenerFaultHealthChecks(withoutHealthAttachment(source, 'postgres_listener')),\n117\t    Error,\n118\t    'generated register-infrastructure helper has no postgres health-check attachment',\n119\t  );\n120\t\n121\t  const injected = injectListenerFaultHealthChecks(source);\n122\t  assertThrows(\n123\t    () => injectListenerFaultHealthChecks(injected),\n124\t    Error,\n125\t    'test-only listener health checks were already registered',\n126\t  );\n127\t});\n128\t\n129\tDeno.test('listener fault splice supports one Garnet container attachment without Postgres', () => {\n130\t  const source = generateRegisterInfrastructure({\n131\t    databases: {},\n132\t    caches: {\n133\t      garnet: {\n134\t        Enabled: true,\n135\t        Engine: 'Garnet',\n136\t        Mode: 'Container',\n137\t      },\n138\t    },\n139\t    primaryCache: 'garnet',\n140\t  });\n141\t  const injected = injectListenerFaultHealthChecks(source, DATABASE.SQLITE);\n142\t\n143\t  assertStringIncludes(injected, TEST_ONLY_GARNET_HEALTH_KEY);\n144\t  if (injected.includes(TEST_ONLY_POSTGRES_HEALTH_KEY)) {\n145\t    throw new Error('Garnet-only injection unexpectedly registered the Postgres test key');\n146\t  }\n147\t});\n148\t\n149\tfunction generatedInfrastructure(): string {\n150\t  return generateRegisterInfrastructure({\n151\t    databases: {\n152\t      postgres: {\n153\t        Enabled: true,\n154\t        Engine: 'Postgres',\n155\t        Mode: 'Container',\n156\t        Persistent: false,\n157\t      },\n158\t    },\n159\t    caches: {\n160\t      garnet: {\n161\t        Enabled: true,\n162\t        Engine: 'Garnet',\n163\t        Mode: 'Container',\n164\t      },\n165\t    },\n166\t    primaryDatabase: 'postgres',\n167\t    primaryCache: 'garnet',\n168\t  });\n169\t}\n170\t\n171\tfunction withSingleQuotedHealthKeys(source: string): string {\n172\t  return source\n173\t    .replaceAll('\"postgres_listener\"', \"'postgres_listener'\")\n174\t    .replaceAll('\"garnet_resp\"', \"'garnet_resp'\");\n175\t}\n176\t\n177\tfunction withSingleQuotedAppNames(source: string): string {\n178\t  return source\n179\t    .replaceAll('\"readiness-dead-port\"', \"'readiness-dead-port'\")\n180\t    .replaceAll('\"listener-fault-controller\"', \"'listener-fault-controller'\");\n181\t}\n182\t\n183\tfunction withoutHealthAttachment(source: string, key: string): string {\n184\t  const lines = source.split('\\n');\n185\t  const matches = lines.filter((line) => line.includes('.withHealthCheck(') && line.includes(key));\n186\t  assertEquals(matches.length, 1, `expected one generated ${key} attachment`);\n187\t  return lines.filter((line) => line !== matches[0]).join('\\n');\n188\t}\n189\t\n190\tfunction healthAttachmentCount(source: string, key: string): number {\n191\t  return source.split('\\n').filter((line) =>\n192\t    line.includes('.withHealthCheck(') && line.includes(key)\n193\t  ).length;\n194\t}\n195\t\n196\tfunction duplicateConstBindings(source: string): readonly string[] {\n197\t  const bindings = [...source.matchAll(/\\bconst\\s+([A-Za-z_$][\\w$]*)\\s*=/gu)].map((match) =>\n198\t    match[1]\n199\t  );\n200\t  return [...new Set(bindings.filter((binding, index) => bindings.indexOf(binding) !== index))];\n201\t}\n202\t\n203\tasync function assertGeneratedModuleChecks(source: string): Promise<void> {\n204\t  const root = await Deno.makeTempDir({ prefix: 'netscript-readiness-fixture-' });\n205\t  try {\n206\t    const helpers = `${root}/aspire/.helpers`;\n207\t    const modules = `${root}/aspire/.aspire/modules`;\n208\t    await Deno.mkdir(helpers, { recursive: true });\n209\t    await Deno.mkdir(modules, { recursive: true });\n210\t    await Deno.writeTextFile(`${helpers}/register-apps.mts`, source);\n211\t    // Mirror the generated module's local imports so this stays a compile check, not a runtime test.\n212\t    await Deno.writeTextFile(\n213\t      `${modules}/aspire.mts`,\n214\t      `export interface ExecutableResource {\n215\t  withEnvironment(key: string, value: string): Promise<void>;\n216\t  withOtlpExporter(options: { protocol: string }): Promise<void>;\n217\t  withHttpEndpoint(options: unknown): Promise<void>;\n218\t  withBrowserLogs(): Promise<void>;\n219\t  withHttpHealthCheck(options: unknown): Promise<void>;\n220\t}\n221\texport interface DistributedApplicationBuilder {\n222\t  addExecutable(name: string, command: string, workdir: string, args: string[]): ExecutableResource;\n223\t}\n224\texport const OtlpProtocol = { HttpProtobuf: 'http-protobuf' } as const;\n225\t`,\n226\t    );\n227\t    await Deno.writeTextFile(\n228\t      `${helpers}/_aspire-compat.mts`,\n229\t      `import type { ExecutableResource } from '../.aspire/modules/aspire.mts';\n230\texport interface NetScriptConfig {\n231\t  Apps: Record<string, { Enabled?: boolean }>;\n232\t  Version: string;\n233\t}\n234\texport function buildOtelEnvVars(\n235\t  _name: string,\n236\t  _version: string,\n237\t  _kind: string,\n238\t): Record<string, string> {\n239\t  return {};\n240\t}\n241\texport function buildViteEnvVarName(_name: string): { full: string; shorthand: string } {\n242\t  return { full: '', shorthand: '' };\n243\t}\n244\texport function resolveWorkspacePath(_root: string, path: string): string {\n245\t  return path;\n246\t}\n247\texport async function withCacheReference(\n248\t  _resource: ExecutableResource,\n249\t  _cache: unknown,\n250\t): Promise<void> {}\n251\t`,\n252\t    );\n253\t    await Deno.writeTextFile(\n254\t      `${helpers}/register-infrastructure.mts`,\n255\t      'export interface InfrastructureContext { readonly primaryCacheWiring?: unknown; }\\n',\n256\t    );\n257\t\n258\t    const output = await new Deno.Command(Deno.execPath(), {\n259\t      args: ['check', '--no-config', `${helpers}/register-apps.mts`],\n260\t      stdout: 'piped',\n261\t      stderr: 'piped',\n262\t    }).output();\n263\t    assertEquals(\n264\t      output.code,\n265\t      0,\n266\t      new TextDecoder().decode(output.stderr) || new TextDecoder().decode(output.stdout),\n267\t    );\n268\t  } finally {\n269\t    await Deno.remove(root, { recursive: true });\n270\t  }\n271\t}\n272\t\n273\tfunction assertAutoBranchInjectionPlacement(source: string): void {\n274\t  const lines = source.split('\\n');\n275\t  const realAttachmentLines = lines.flatMap((line, index) =>\n276\t    line.includes('.withHealthCheck(\"garnet_resp\")') ? [index] : []\n277\t  );\n278\t  assertEquals(realAttachmentLines.length, 2);\n279\t\n280\t  for (const realAttachmentLine of realAttachmentLines) {\n281\t    assertStringIncludes(\n282\t      lines[realAttachmentLine + 1],\n283\t      `builder.addHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}'`,\n284\t    );\n285\t    assertStringIncludes(\n286\t      lines[realAttachmentLine + 2],\n287\t      `await cache_1.withHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}');`,\n288\t    );\n289\t  }\n290\t\n291\t  const elseLine = lines.findIndex((line, index) =>\n292\t    index > realAttachmentLines[0] && line.trim() === '} else {'\n293\t  );\n294\t  assertEquals(elseLine > realAttachmentLines[0], true);\n295\t  assertEquals(realAttachmentLines[1] > elseLine, true);\n296\t  assertEquals(\n297\t    lines.slice(elseLine, realAttachmentLines[1] + 3).filter((line) =>\n298\t      line.includes(`builder.addHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}'`)\n299\t    ).length,\n300\t    1,\n301\t  );\n302\t}\n303\t"}]},"parent_tool_use_id":null,"session_id":"c1ca789b-c4ca-4f53-b9ac-092eb2e122d5","uuid":"52ba1775-646f-4099-9176-bbe145fdf724","timestamp":"2026-09-01T21:21:34.347Z","tool_use_result":{"type":"text","file":{"filePath":"/home/agent/projects/netscript/worktrees/007-eval-combined/packages/cli/e2e/tests/application/gates/prepare-readiness-fixture_test.ts","content":"import { assertEquals, assertStringIncludes, assertThrows } from '@std/assert';\n\nimport { generateRegisterInfrastructure } from '../../../../src/kernel/templates/aspire/helpers/register/generate-register-infrastructure.ts';\nimport { generateRegisterApps } from '../../../../src/kernel/templates/aspire/helpers/register/generate-register-apps.ts';\nimport { buildCacheBlock } from '../../../../src/kernel/templates/aspire/generate-appsettings.ts';\nimport { DATABASE } from '../../../src/domain/extension-axes.ts';\nimport {\n  injectListenerFaultHealthChecks,\n  injectReadinessFixtureApps,\n  TEST_ONLY_GARNET_HEALTH_KEY,\n  TEST_ONLY_POSTGRES_HEALTH_KEY,\n} from '../../../src/application/gates/scaffold/runtime/prepare-readiness-fixture.ts';\n\nDeno.test('listener fault splice accepts the E2E two-cache Auto generator output', () => {\n  const redis = buildCacheBlock('redis');\n  const garnet = buildCacheBlock('garnet');\n  const source = generateRegisterInfrastructure({\n    databases: {},\n    caches: {\n      [redis.key]: { ...redis.block, Enabled: true },\n      [garnet.key]: { ...garnet.block, Enabled: true, Mode: 'Auto' },\n    },\n    primaryCache: garnet.key,\n  });\n\n  assertEquals(healthAttachmentCount(source, 'redis_resp'), 1);\n  assertEquals(healthAttachmentCount(source, 'garnet_resp'), 2);\n  const injected = injectListenerFaultHealthChecks(source, DATABASE.SQLITE);\n  assertEquals(healthAttachmentCount(injected, TEST_ONLY_GARNET_HEALTH_KEY), 2);\n  assertAutoBranchInjectionPlacement(injected);\n});\n\nDeno.test('listener fault splice attaches test-only checks at generator-derived markers', () => {\n  const source = generatedInfrastructure();\n  const cases = [\n    { source, postgresBinding: 'db_0_server', garnetBinding: 'cache_0' },\n    {\n      source: withSingleQuotedHealthKeys(source),\n      postgresBinding: 'db_0_server',\n      garnetBinding: 'cache_0',\n    },\n    {\n      source: source.replaceAll('db_0_server', 'db_7_server').replaceAll('cache_0', 'cache_3'),\n      postgresBinding: 'db_7_server',\n      garnetBinding: 'cache_3',\n    },\n  ];\n\n  for (const { source, postgresBinding, garnetBinding } of cases) {\n    const injected = injectListenerFaultHealthChecks(source);\n    assertStringIncludes(\n      injected,\n      `builder.addHealthCheck('${TEST_ONLY_POSTGRES_HEALTH_KEY}', createListenerReadinessCheck({ kind: 'tcp', host: 'localhost', port: 18998 }));`,\n    );\n    assertStringIncludes(\n      injected,\n      `await ${postgresBinding}.withHealthCheck('${TEST_ONLY_POSTGRES_HEALTH_KEY}');`,\n    );\n    assertStringIncludes(\n      injected,\n      `builder.addHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}', createRespPingCheck({ host: 'localhost', port: 18999 }));`,\n    );\n    assertStringIncludes(\n      injected,\n      `await ${garnetBinding}.withHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}');`,\n    );\n  }\n});\n\nDeno.test('readiness app splice namespaces fixture bindings in a real generated host', async () => {\n  const source = generateRegisterApps({\n    apps: {\n      app: {\n        Enabled: true,\n        Runtime: 'deno',\n        Type: 'task',\n        Workdir: 'apps/app',\n        TaskName: 'start',\n        WatchMode: false,\n        RequiresKv: false,\n      },\n    },\n    version: 'e2e',\n    denoDefaults: { Permissions: [], WatchMode: false },\n  });\n  const injected = injectReadinessFixtureApps(source);\n\n  assertEquals(duplicateConstBindings(injected), []);\n  await assertGeneratedModuleChecks(injected);\n  assertStringIncludes(injected, 'const readiness_fixture_app_0_workdir');\n  assertStringIncludes(injected, 'const readiness_fixture_app_0_otel');\n  assertStringIncludes(injected, 'const readiness_fixture_app_1_workdir');\n  assertStringIncludes(injected, 'const readiness_fixture_app_1_otel');\n  assertStringIncludes(injected, 'apps.set(\"readiness-dead-port\"');\n  assertStringIncludes(injected, 'apps.set(\"listener-fault-controller\"');\n  assertThrows(\n    () => injectReadinessFixtureApps(withSingleQuotedAppNames(injected)),\n    Error,\n    'readiness-dead-port fixture was already registered',\n  );\n  assertThrows(\n    () => injectReadinessFixtureApps(source.replace('  return apps;', '')),\n    Error,\n    'generated register-apps helper has no return marker',\n  );\n});\n\nDeno.test('listener fault splice fails closed on missing markers and double registration', () => {\n  const source = generatedInfrastructure();\n  assertThrows(\n    () => injectListenerFaultHealthChecks(withoutHealthAttachment(source, 'garnet_resp')),\n    Error,\n    'generated register-infrastructure helper has no garnet health-check attachment',\n  );\n  assertThrows(\n    () => injectListenerFaultHealthChecks(withoutHealthAttachment(source, 'postgres_listener')),\n    Error,\n    'generated register-infrastructure helper has no postgres health-check attachment',\n  );\n\n  const injected = injectListenerFaultHealthChecks(source);\n  assertThrows(\n    () => injectListenerFaultHealthChecks(injected),\n    Error,\n    'test-only listener health checks were already registered',\n  );\n});\n\nDeno.test('listener fault splice supports one Garnet container attachment without Postgres', () => {\n  const source = generateRegisterInfrastructure({\n    databases: {},\n    caches: {\n      garnet: {\n        Enabled: true,\n        Engine: 'Garnet',\n        Mode: 'Container',\n      },\n    },\n    primaryCache: 'garnet',\n  });\n  const injected = injectListenerFaultHealthChecks(source, DATABASE.SQLITE);\n\n  assertStringIncludes(injected, TEST_ONLY_GARNET_HEALTH_KEY);\n  if (injected.includes(TEST_ONLY_POSTGRES_HEALTH_KEY)) {\n    throw new Error('Garnet-only injection unexpectedly registered the Postgres test key');\n  }\n});\n\nfunction generatedInfrastructure(): string {\n  return generateRegisterInfrastructure({\n    databases: {\n      postgres: {\n        Enabled: true,\n        Engine: 'Postgres',\n        Mode: 'Container',\n        Persistent: false,\n      },\n    },\n    caches: {\n      garnet: {\n        Enabled: true,\n        Engine: 'Garnet',\n        Mode: 'Container',\n      },\n    },\n    primaryDatabase: 'postgres',\n    primaryCache: 'garnet',\n  });\n}\n\nfunction withSingleQuotedHealthKeys(source: string): string {\n  return source\n    .replaceAll('\"postgres_listener\"', \"'postgres_listener'\")\n    .replaceAll('\"garnet_resp\"', \"'garnet_resp'\");\n}\n\nfunction withSingleQuotedAppNames(source: string): string {\n  return source\n    .replaceAll('\"readiness-dead-port\"', \"'readiness-dead-port'\")\n    .replaceAll('\"listener-fault-controller\"', \"'listener-fault-controller'\");\n}\n\nfunction withoutHealthAttachment(source: string, key: string): string {\n  const lines = source.split('\\n');\n  const matches = lines.filter((line) => line.includes('.withHealthCheck(') && line.includes(key));\n  assertEquals(matches.length, 1, `expected one generated ${key} attachment`);\n  return lines.filter((line) => line !== matches[0]).join('\\n');\n}\n\nfunction healthAttachmentCount(source: string, key: string): number {\n  return source.split('\\n').filter((line) =>\n    line.includes('.withHealthCheck(') && line.includes(key)\n  ).length;\n}\n\nfunction duplicateConstBindings(source: string): readonly string[] {\n  const bindings = [...source.matchAll(/\\bconst\\s+([A-Za-z_$][\\w$]*)\\s*=/gu)].map((match) =>\n    match[1]\n  );\n  return [...new Set(bindings.filter((binding, index) => bindings.indexOf(binding) !== index))];\n}\n\nasync function assertGeneratedModuleChecks(source: string): Promise<void> {\n  const root = await Deno.makeTempDir({ prefix: 'netscript-readiness-fixture-' });\n  try {\n    const helpers = `${root}/aspire/.helpers`;\n    const modules = `${root}/aspire/.aspire/modules`;\n    await Deno.mkdir(helpers, { recursive: true });\n    await Deno.mkdir(modules, { recursive: true });\n    await Deno.writeTextFile(`${helpers}/register-apps.mts`, source);\n    // Mirror the generated module's local imports so this stays a compile check, not a runtime test.\n    await Deno.writeTextFile(\n      `${modules}/aspire.mts`,\n      `export interface ExecutableResource {\n  withEnvironment(key: string, value: string): Promise<void>;\n  withOtlpExporter(options: { protocol: string }): Promise<void>;\n  withHttpEndpoint(options: unknown): Promise<void>;\n  withBrowserLogs(): Promise<void>;\n  withHttpHealthCheck(options: unknown): Promise<void>;\n}\nexport interface DistributedApplicationBuilder {\n  addExecutable(name: string, command: string, workdir: string, args: string[]): ExecutableResource;\n}\nexport const OtlpProtocol = { HttpProtobuf: 'http-protobuf' } as const;\n`,\n    );\n    await Deno.writeTextFile(\n      `${helpers}/_aspire-compat.mts`,\n      `import type { ExecutableResource } from '../.aspire/modules/aspire.mts';\nexport interface NetScriptConfig {\n  Apps: Record<string, { Enabled?: boolean }>;\n  Version: string;\n}\nexport function buildOtelEnvVars(\n  _name: string,\n  _version: string,\n  _kind: string,\n): Record<string, string> {\n  return {};\n}\nexport function buildViteEnvVarName(_name: string): { full: string; shorthand: string } {\n  return { full: '', shorthand: '' };\n}\nexport function resolveWorkspacePath(_root: string, path: string): string {\n  return path;\n}\nexport async function withCacheReference(\n  _resource: ExecutableResource,\n  _cache: unknown,\n): Promise<void> {}\n`,\n    );\n    await Deno.writeTextFile(\n      `${helpers}/register-infrastructure.mts`,\n      'export interface InfrastructureContext { readonly primaryCacheWiring?: unknown; }\\n',\n    );\n\n    const output = await new Deno.Command(Deno.execPath(), {\n      args: ['check', '--no-config', `${helpers}/register-apps.mts`],\n      stdout: 'piped',\n      stderr: 'piped',\n    }).output();\n    assertEquals(\n      output.code,\n      0,\n      new TextDecoder().decode(output.stderr) || new TextDecoder().decode(output.stdout),\n    );\n  } finally {\n    await Deno.remove(root, { recursive: true });\n  }\n}\n\nfunction assertAutoBranchInjectionPlacement(source: string): void {\n  const lines = source.split('\\n');\n  const realAttachmentLines = lines.flatMap((line, index) =>\n    line.includes('.withHealthCheck(\"garnet_resp\")') ? [index] : []\n  );\n  assertEquals(realAttachmentLines.length, 2);\n\n  for (const realAttachmentLine of realAttachmentLines) {\n    assertStringIncludes(\n      lines[realAttachmentLine + 1],\n      `builder.addHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}'`,\n    );\n    assertStringIncludes(\n      lines[realAttachmentLine + 2],\n      `await cache_1.withHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}');`,\n    );\n  }\n\n  const elseLine = lines.findIndex((line, index) =>\n    index > realAttachmentLines[0] && line.trim() === '} else {'\n  );\n  assertEquals(elseLine > realAttachmentLines[0], true);\n  assertEquals(realAttachmentLines[1] > elseLine, true);\n  assertEquals(\n    lines.slice(elseLine, realAttachmentLines[1] + 3).filter((line) =>\n      line.includes(`builder.addHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}'`)\n    ).length,\n    1,\n  );\n}\n","numLines":303,"startLine":1,"totalLines":303}}}
