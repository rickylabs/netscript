donly DatabaseName?: string;\n  readonly Enabled?: boolean;\n  readonly Engine?: string;\n  readonly PluginReferences?: readonly string[];\n  readonly RequiresDb?: boolean;\n  readonly RequiresKv?: boolean;\n  readonly ServiceReferences?: readonly string[];\n}\n\nexport interface ResourceDependencies {\n  readonly requiresDb: boolean;\n  readonly requiresKv: boolean;\n}\n\nexport type OtelMode = 'denoApp' | 'denoTask' | 'executable';\n\nexport interface ListenerReadinessCheckOptions {\n  readonly kind: string;\n=== createRespPingCheck return type ===\nexport function createRespPingCheck(\n  options: RespPingCheckOptions,\n): () => Promise<HealthCheckResult> {\n  return () =>\n    new Promise((resolve) => {\n      const startedAt = performance.now();\n      const port = normalizeListenerPort(options.port);\n      const socket = createConnection({ host: options.host, port });\n      let settled = false;\n      let received: Uint8Array<ArrayBufferLike> = new Uint8Array();\n\n      const finish = (result: HealthCheckResult): void => {\n        if (settled) return;\n        settled = true;\n        socket.destroy();\n        resolve(result);\n      };\n\n      socket.setTimeout(LISTENER_READINESS_TIMEOUT_MS);\n      socket.once('connect', () => {\n        socket.write(RESP_PING_COMMAND);\n      });\n      socket.on('data', (data) => {\n        received = appendRespBytes(received, data);\n        if (received.length > RESP_REPLY_LIMIT_BYTES) {\n          finish(respFailure(options.host, port, 'EPROTO', startedAt, received));","is_error":false}]},"parent_tool_use_id":null,"session_id":"c1ca789b-c4ca-4f53-b9ac-092eb2e122d5","uuid":"0bcae290-268c-4354-abbe-dc263495f4ff","timestamp":"2026-09-01T21:32:07.955Z","tool_use_result":{"stdout":"// _aspire-compat.mts — GENERATED BY @netscript/cli. DO NOT EDIT.\n// D-7 workaround: Node.js-compatible copies of @netscript/aspire helpers.\n// CommunityToolkit Deno projects into Aspire 13.5; S12 owns adoption and removal.\n// First-party 