39\t      0,\n140\t      `${new TextDecoder().decode(result.stdout)}${new TextDecoder().decode(result.stderr)}`,\n141\t    )\n142\t  })\n143\t\n144\t  it('reports a local TCP listener as Healthy', async () => {\n145\t    const server = await startServer()\n146\t    try {\n147\t      const result = await compatModule.createListenerReadinessCheck({\n148\t        kind: 'postgres',\n149\t        host: '127.0.0.1',\n150\t        port: serverPort(server),\n151\t      })()\n152\t\n153\t      assertEquals(result, {\n154\t        status: 'Healthy',\n155\t        description: `postgres listener ready on 127.0.0.1:${\n156\t          serverPort(server)\n157\t        }`,\n158\t      })\n159\t    } finally {\n160\t      await closeServer(server)\n161\t    }\n162\t  })\n163\t\n164\t  it('reports a closed local TCP port as Unhealthy with ECONNREFUSED', async () => {\n165\t    const server = await startServer()\n166\t    const port = serverPort(server)\n167\t    await closeServer(server)\n168\t\n169\t    const result = await compatModule.createListenerReadinessCheck({\n170\t      kind: 'postgres',\n171\t      host: '127.0.0.1',\n172\t      port,\n173\t    })()\n174\t\n175\t    assertEquals(result.status, 'Unhealthy')\n176\t    assertEquals(\n177\t      result.description,\n178\t      'postgres listener unreachable: ECONNREFUSED',\n179\t    )\n180\t    assertEquals(result.data.code, 'ECONNREFUSED')\n181\t    assertEquals(result.data.host, '127.0.0.1')\n182\t    assertEquals(result.data.port, String(port))\n183\t    assertMatch(result.data.elapsedMs, /^\\d+$/)\n184\t  })\n185\t\n186\t  it('bounds a black-hole TCP address at 2000 ms with ETIMEDOUT', async () => {\n187\t    const startedAt = performance.now()\n188\t    const result = await compatModule.createListenerReadinessCheck({\n189\t      kind: 'postgres',\n190\t      host: '192.0.2.1',\n191\t      port: 65_000,\n192\t    })()\n193\t    const elapsedMs = performance.now() - startedAt\n194\t\n195\t    assertEquals(result.status, 'Unhealthy')\n196\t    assertEquals(result.description, 'postgres listener unreachable: ETIMEDOUT')\n197\t    assertEquals(result.data.code, 'ETIMEDOUT')\n198\t    assertEquals(result.data.host, '192.0.2.1')\n199\t    assertEquals(result.data.port, '65000')\n200\t    assertMatch(result.data.elapsedMs, /^\\d+$/)\n201\t    assertEquals(elapsedMs >= 1_900 && elapsedMs < 3_500, true)\n202\t  })\n203\t\n204\t  it('sends an array-encoded PING and accepts one-segment +PONG', async () => {\n205\t    let request = ''\n206\t    const server = await startServer((socket) => {\n207\t      socket.once('data', (data) => {\n208\t        request = data.toString('utf8')\n209\t        socket.end('+PONG\\r\\n')\n210\t      })\n211\t    })\n212\t    const port = serverPort(server)\n213\t    try {\n214\t      const result = await compatModule.createRespPingCheck({\n215\t        host: '127.0.0.1',\n216\t        port,\n217\t      })()\n218\t\n219\t      assertEquals(request, '*1\\r\\n$4\\r\\nPING\\r\\n')\n220\t      assertEquals(result, {\n221\t        status: 'Healthy',\n222\t        description: `RESP listener ready on 127.0.0.1:${port}`,\n223\t      })\n224\t    } finally {\n225\t      await closeServer(server)\n226\t    }\n227\t  })\n228\t\n229\t  it('accumulates a split +PONG reply through CRLF', async () => {\n230\t    const server = await startServer((socket) => {\n231\t      socket.once('data', () => {\n232\t        socket.write('+PO')\n233\t        setTimeout(() => {\n234\t          if (!socket.destroyed) socket.end('NG\\r\\n')\n235\t        }, 25)\n236\t      })\n237\t    })\n238\t    const port = serverPort(server)\n239\t    try {\n240\t      const result = await compatModule.createRespPingCheck({\n241\t        host: '127.0.0.1',\n242\t        port,\n243\t      })()\n244\t\n245\t      assertEquals(result, {\n246\t        status: 'Healthy',\n247\t        description: `RESP listener ready on 127.0.0.1:${port}`,\n248\t      })\n249\t    } finally {\n250\t      await closeServer(server)\n251\t    }\n252\t  })\n253\t\n254\t  it('reports NOAUTH as Unhealthy with endpoint and received bytes', async () => {\n255\t    const result = await withRespReply('-NOAUTH Authentication required.\\r\\n')\n256\t\n257\t    assertEquals(result.status, 'Unhealthy')\n258\t    assertMatch(result.description, /RESP listener unhealthy: NOAUTH/)\n259\t    assertRespFailureData("}]},"parent_tool_use_id":null,"session_id":"c1ca789b-c4ca-4f53-b9ac-092eb2e122d5","uuid":"c1a5a3ae-0f2e-498b-9c79-b0f28d126c18","timestamp":"2026-09-01T21:30:09.056Z","tool_use_result":{"type":"text","file":{"filePath":"/home/agent/projects/netscript/worktrees/007-eval-combined/packages/cli/src/kernel/templates/aspire/helpers/tests/aspire-compat-health-checks_test.ts","content":"      useTabs: false,\n      lineWidth: 100,\n      indentWidth: 2,\n      semiColons: true,\n      singleQuote: true,\n    },\n  }, null, 2)}\\n`,\n)\nawait Deno.writeTextFile(compatPath, compatContent)\nawait Deno.writeTextFile(\n  runtimeCompatPath,\n  compatContent.replace(\"from 'zod';\", `from '${zodSpecifier}';`),\n)\nawait Deno.writeTextFile(\n  `${generatedRoot}/format-sentinel.ts`,\n  'export const formatSentinel = true;\\n',\n)\nconst compatModule = await import(\n  `${toFileUrl(runtimeCompatPath).href}?test=${crypto.randomUUID()}`\n)\n\nafterAll(async () => {\n  await Deno.remove(generatedRoot, { recursive: true })\n})\n\ndescribe('generated Aspire listener readiness helpers', () => {\n  it('type-checks the emitted helper in a generated workspace shape', async () => {\n    const result = await new Deno.Command(Deno.execPath(), {\n      args: [\n        'check',\n        '--config',\n        generatedConfigPath,\n        '--no-lock',\n        compatPath,\n      ],\n      stdout: 'piped',\n      stderr: 'piped',\n    }).output()\n\n    assertEquals(result.code, 0, new TextDecoder().decode(result.stderr))\n  })\n\n  it('formats the emitted helper as generated TypeScript', async () => {\n    const result = await new Deno.Command(Deno.execPath(), {\n      args: [\n        'fmt',\n        '--check',\n        '--config',\n        generatedConfigPath,\n        'format-sentinel.ts',\n        '.helpers/_aspire-compat.mts',\n      ],\n      cwd: generatedRoot,\n      stdout: 'piped',\n      stderr: 'piped',\n    }).output()\n\n    assertEquals(\n      result.code,\n      0,\n      `${new TextDecoder().decode(result.stdout)}${new TextDecoder().decode(result.stderr)}`,\n    )\n  })\n\n  it('reports a local TCP listener as Healthy', async () => {\n    const server = await startServer()\n    try {\n      const result = await compatModule.createListenerReadinessCheck({\n        kind: 'postgres',\n        host: '127.0.0.1',\n        port: serverPort(server),\n      })()\n\n      assertEquals(result, {\n        status: 'Healthy',\n        description: `postgres listener ready on 127.0.0.1:${\n          serverPort(server)\n        }`,\n      })\n    } finally {\n      await closeServer(server)\n    }\n  })\n\n  it('reports a closed local TCP port as Unhealthy with ECONNREFUSED', async () => {\n    const server = await startServer()\n    const port = serverPort(server)\n    await closeServer(server)\n\n    const result = await compatModule.createListenerReadinessCheck({\n      kind: 'postgres',\n      host: '127.0.0.1',\n      port,\n    })()\n\n    assertEquals(result.status, 'Unhealthy')\n    assertEquals(\n      result.description,\n      'postgres listener unreachable: ECONNREFUSED',\n    )\n    assertEquals(result.data.code, 'ECONNREFUSED')\n    assertEquals(result.data.host, '127.0.0.1')\n    assertEquals(result.data.port, String(port))\n    assertMatch(result.data.elapsedMs, /^\\d+$/)\n  })\n\n  it('bounds a black-hole TCP address at 2000 ms with ETIMEDOUT', async () => {\n    const startedAt = performance.now()\n    const result = await compatModule.createListenerReadinessCheck({\n      kind: 'postgres',\n      host: '192.0.2.1',\n      port: 65_000,\n    })()\n    const elapsedMs = performance.now() - startedAt\n\n    assertEquals(result.status, 'Unhealthy')\n    assertEquals(result.description, 'postgres listener unreachable: ETIMEDOUT')\n    assertEquals(result.data.code, 'ETIMEDOUT')\n    assertEquals(result.data.host, '192.0.2.1')\n    assertEquals(result.data.port, '65000')\n    assertMatch(result.data.elapsedMs, /^\\d+$/)\n    assertEquals(elapsedMs >= 1_900 && elapsedMs < 3_500, true)\n  })\n\n  it('sends an array-encoded PING and accepts one-segment +PONG', async () => {\n    let request = ''\n    const server = await startServer((socket) => {\n      socket.once('data', (data) => {\n        request = data.toString('utf8')\n        socket.end('+PONG\\r\\n')\n      })\n    })\n    const port = serverPort(server)\n    try {\n      const result = await compatModule.createRespPingCheck({\n        host: '127.0.0.1',\n        port,\n      })()\n\n      assertEquals(request, '*1\\r\\n$4\\r\\nPING\\r\\n')\n      assertEquals(result, {\n        status: 'Healthy',\n        description: `RESP listener ready on 127.0.0.1:${port}`,\n      })\n    } finally {\n      await closeServer(server)\n    }\n  })\n\n  it('accumulates a split +PONG reply through CRLF', async () => {\n    const server = await startServer((socket) => {\n      socket.once('data', () => {\n        socket.write('+PO')\n        setTimeout(() => {\n          if (!socket.destroyed) socket.end('NG\\r\\n')\n        }, 25)\n      })\n    })\n    const port = serverPort(server)\n    try {\n      const result = await compatModule.createRespPingCheck({\n        host: '127.0.0.1',\n        port,\n      })()\n\n      assertEquals(result, {\n        status: 'Healthy',\n        description: `RESP listener ready on 127.0.0.1:${port}`,\n      })\n    } finally {\n      await closeServer(server)\n    }\n  })\n\n  it('reports NOAUTH as Unhealthy with endpoint and received bytes', async () => {\n    const result = await withRespReply('-NOAUTH Authentication required.\\r\\n')\n\n    assertEquals(result.status, 'Unhealthy')\n    assertMatch(result.description, /RESP listener unhealthy: NOAUTH/)\n    assertRespFailureData(","numLines":180,"startLine":80,"totalLines":377}}}
