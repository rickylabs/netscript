-----\n// 1. Real generator output\n// ---------------------------------------------------------------------------\n\n// Config A: D-101 Postgres shape (Postgres Container + Garnet Auto).\nconst infraPostgres = generateRegisterInfrastructure({\n  databases: {\n    postgres: { Enabled: true, Engine: 'Postgres', Mode: 'Container', Persistent: false },\n  },\n  caches: {\n    garnet: { Enabled: true, Engine: 'Garnet', Mode: 'Auto' },\n  },\n  primaryDatabase: 'postgres',\n  primaryCache: 'garnet',\n});\n\n// Config B: E2E sqlite shape (two caches, garnet Auto).\nconst infraSqlite = generateRegisterInfrastructure({\n  databases: {},\n  caches: {\n    redis: { Enabled: true, Engine: 'Redis', Mode: 'Container' },\n    garnet: { Enabled: true, Engine: 'Garnet', Mode: 'Auto' },\n  },\n  primaryCache: 'garnet',\n});\n\n// A real app is present so fixture bindings genuinely collide by index.\nconst appsSource = generateRegisterApps({\n  apps: {\n    app: {\n      Enabled: true,\n      Runtime: 'deno',\n      Type: 'task',\n      Workdir: 'apps/app',\n      TaskName: 'start',\n      WatchMode: false,\n      RequiresKv: false,\n    },\n  },\n  version: 'e2e',\n  denoDefaults: { Permissions: [], WatchMode: false },\n});\n\nconsole.log('G3: baseline generator output');\ncheck('postgres config: 2 real garnet_resp attachments (both Auto arms)', countLines(infraPostgres, 'withHealthCheck(\"garnet_resp\")') === 2, `${countLines(infraPostgres, 'withHealthCheck(\"garnet_resp\")')}`);\ncheck('postgres config: 1 real postgres_listener attachment', countLines(infraPostgres, 'withHealthCheck(\"postgres_listener\")') === 1, `${countLines(infraPostgres, 'withHealthCheck(\"postgres_listener\")')}`);\ncheck('sqlite config: 2 real garnet_resp attachments (both Auto arms)', countLines(infraSqlite, 'withHealthCheck(\"garnet_resp\")') === 2, `${countLines(infraSqlite, 'withHealthCheck(\"garnet_resp\")')}`);\ncheck('sqlite config: 0 postgres_listener attachments', countLines(infraSqlite, 'withHealthCheck(\"postgres_listener\")') === 0);\n\n// ---------------------------------------------------------------------------\n// 2. Compose both injections exactly as prepareReadinessFixture does\n// ---------------------------------------------------------------------------\n\nconst injectedInfraPostgres = injectListenerFaultHealthChecks(infraPostgres, DATABASE.POSTGRES);\nconst injectedInfraSqlite = injectListenerFaultHealthChecks(infraSqlite, DATABASE.SQLITE);\nconst injectedApps = injectReadinessFixtureApps(appsSource);\n\n// ---------------------------------------------------------------------------\n// 2a. Health attachments land in BOTH Auto arms, exactly once per arm\n// ---------------------------------------------------------------------------\n\nconst TEST_GARNET_ADD = `builder.addHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}'`;\n\ninterface ArmProof {\n  readonly label: string;\n  readonly realAttachmentLines: readonly number[];\n  readonly elseLine: number;\n  readonly armsContainExactlyOne: readonly boolean[];\n}\n\nfunction analyzeAutoArms(source: string): ArmProof {\n  const lines = source.split('\\n');\n  const realAttachmentLines = lines.flatMap((line, index) =>\n    line.includes('withHealthCheck(\"garnet_resp\")') ? [index] : []\n  );\n  const elseLine = lines.findIndex((line, index) =>\n    index > realAttachmentLines[0] && line.trim() === '} else {'\n  );\n  const armWindows = [\n    lines.slice(realAttachmentLines[0], elseLine),\n    lines.slice(elseLine, realAttachmentLines[1] + 3),\n  ];\n  return {\n    label: '',\n    realAttachmentLines,\n    elseLine,\n    armsContainExactlyOne: armWindows.map((arm) =>\n      arm.filter((line) => line.includes(TEST_GARNET_ADD)).length === 1\n    ),\n  };\n}\n\nfor (const [label, source] of [['postgres', injectedInfraPostgres], ['sqlite', injectedInfraSqlite]] as const) {\n  const lines = source.split('\\n');\n  const realAttachmentLines = lines.flatMap((line, index) =>\n    line.includes('withHealthCheck(\"garnet_resp\")') ? [index] : []\n  );\n  const proof = analyzeAutoArms(source);\n  console.log(`G3: test-only garnet placement (${label} config)`);\n\n  check('both real Auto-arm attachments survive injection', realAttachmentLines.length === 2, `${realAttachmentLines.length}`);\n  check(\n    'real attachments straddle the } else { boundary (if-arm and else-arm)',\n    proof.elseLine > realAttachmentLines[0] && realAttachmentLines[1] > proof.elseLine,\n    `else=${proof.elseLine} real=${realAttachmentLines.join(',')}`,\n  );\n  check('file total: exactly 2 test-only garnet addHealthCheck registrations', countLines(source, TEST_GARNET_ADD) === 2, `${countLines(source, TEST_GARNET_ADD)}`);\n  check('container (if) arm: exactly one test-only registration', proof.armsContainExactlyOne[0], `${proof.armsContainExactlyOne[0]}`);\n  check('executable (else) arm: exactly one test-only registration', proof.armsContainExactlyOne[1], `${proof.armsContainExactlyOne[1]}`);\n\n  for (const realLine of realAttachmentLines) {\n    const binding = lines[realLine].match(/await ([A-Za-z_$][\\w$]*)\\.withHealthCheck\\(\"garnet_resp\"\\)/)?.[1] ?? 'UNKNOWN';\n    check(\n      `${binding} @line ${realLine + 1}: test-only addHealthCheck directly follows the real attachment`,\n      lines[realLine + 1].includes(TEST_GARNET_ADD),\n      lines[realLine + 1].trim(),\n    );\n    check(\n      `${binding} @line ${realLine + 1}: test-only withHealthCheck binds the same resource`,\n      lines[realLine + 2].trim() === `await ${binding}.withHealthCheck('${TEST_ONLY_GARNET_HEALTH_KEY}');`,\n      lines[realLine + 2].trim(),\n    );\n  }\n  check(`${label}: real garnet attachments unmodified`, countLines(source, 'withHealthCheck(\"garnet_resp\")') === 2);\n}\n\nconsole.log('G3: test-only postgres placement (postgres config)');\ncheck('exactly one test-only postgres addHealthCheck', countLines(injectedInfraPostgres, `builder.addHealthCheck('${TEST_ONLY_POSTGRES_HEALTH_KEY}'`) === 1);\ncheck('exactly one test-only postgres withHealthCheck on db_0_server', countLines(injectedInfraPostgres, `await db_0_server.withHealthCheck('${TEST_ONLY_POSTGRES_HEALTH_KEY}')`) === 1);\ncheck('sqlite config carries no postgres test key', !injectedInfraSqlite.includes(TEST_ONLY_POSTGRES_HEALTH_KEY));\n\n// ---------------------------------------------------------------------------\n// 2b. App identifiers stay collision-free in the same emitted module\n// ---------------------------------------------------------------------------\n\nconsole.log('G3: fixture app identifier isolation (register-apps.mts)');\nconst constBindings = [...injectedApps.matchAll(/\\bconst\\s+([A-Za-z_$][\\w$]*)\\s*=/gu)].map((m) => m[1]);\nconst duplicates = [...new Set(constBindings.filter((b, i) => constBindings.indexOf(b) !== i))];\ncheck('no duplicate const bindings with real app present', duplicates.length === 0, duplicates.join(','));\ncheck('real app binding app_0_workdir preserved unprefixed', /^\\s*const app_0_workdir = /m.test(injectedApps));\ncheck('real app binding app_0 preserved unprefixed', /^\\s*const app_0 = /m.test(injectedApps));\ncheck('fixture dead-port binding namespaced', injectedApps.includes('const readiness_fixture_app_0_workdir'));\ncheck('fixture controller binding namespaced', injectedApps.includes('const readiness_fixture_app_1_workdir'));\ncheck(\n  'fixture apps registered under isolated names',\n  injectedApps.includes('apps.set(\"readiness-dead-port\"') && injectedApps.includes('apps.set(\"listener-fault-controller\"'),\n);\ncheck('real app registration intact', injectedApps.includes('apps.set(\"app\"'));\n\n// Negative control: without the namespacing (pre-#1898 behaviour) the module collides.\nconst unNamespaced = injectedApps.replaceAll('readiness_fixture_', '');\nconst unNamespacedBindings = [...unNamespaced.matchAll(/\\bconst\\s+([A-Za-z_$][\\w$]*)\\s*=/gu)].map((m) => m[1]);\nconst unNamespacedDuplicates = [...new Set(unNamespacedBindings.filter((b, i) => unNamespacedBindings.indexOf(b) !== i))];\ncheck(\n  'negative control: stripping the fixture prefix reproduces the #1898 collision',\n  unNamespacedDuplicates.length > 0,\n  unNamespacedDuplicates.join(','),\n);\n\n// ---------------------------------------------------------------------------\n// 3. Emitted module validity — joint deno check of both injected modules\n// ---------------------------------------------------------------------------\n\nconst root = await Deno.makeTempDir({ prefix: 'netscript-impl-eval-composition-' });\ntry {\n  const helpers = `${root}/aspire/.helpers`;\n  const modules = `${root}/aspire/.aspire/modules`;\n  await Deno.mkdir(helpers, { recursive: true });\n  await Deno.mkdir(modules, { recursive: true });\n\n  await Deno.writeTextFile(`${helpers}/register-apps.mts`, injectedApps);\n  await Deno.writeTextFile(`${helpers}/register-infrastructure.mts`, injectedInfraPostgres);\n  await Deno.writeTextFile(\n    `${helpers}/_aspire-compat.mts`,\n    await Deno.readTextFile(\n      new URL('../../packages/cli/src/kernel/assets/aspire/helpers/_aspire-compat.ts.template', import.meta.url),\n    ),\n  );\n  await Deno.writeTextFile(`${modules}/aspire.mts`, ASPIRE_MODULE_STUB);\n  await Deno.writeTextFile(\n    `${root}/deno.json`,\n    JSON.stringify(\n      {\n        lock: false,\n        imports: { zod: 'npm:zod@4.4.3' },\n        compilerOptions: { strict: true, noImplicitAny: true, noImplicitReturns: true },\n      },\n      null,\n      2,\n    ) + '\\n',\n  );\n\n  for (const module of ['register-infrastructure.mts', 'register-apps.mts']) {\n    const result = await new Deno.Command(Deno.execPath(), {\n      args: ['check', '--config', `${root}/deno.json`, '--no-lock', `${helpers}/${module}`],\n      cwd: root,\n      stdout: 'piped',\n      stderr: 'piped',\n    }).output();\n    const decoder = new TextDecoder();\n    const details = `${decoder.decode(result.stderr)}${decoder.decode(result.stdout)}`;\n    check(`deno check ${module} (joint injected workspace)`, result.code === 0, details.slice(0, 3000));\n  }\n} finally {\n  await Deno.remove(root, { recursive: true });\n}\n\n// ---------------------------------------------------------------------------\n// aspire.mts stub — surface used by the generated helpers (Aspire 13.5.3 shape)\n// ---------------------------------------------------------------------------\n\nfunction ASPIRE_MODULE_STUB(): string {\n  return `\nexport enum HealthStatus {\n  Unhealthy = 'Unhealthy',\n  Degraded = 'Degraded',\n  Healthy = 'Healthy',\n}\nexport interface HealthCheckResult {\n  status?: HealthStatus;\n  description?: string | null;\n  data?: Record<string, string>;\n}\nexport enum EndpointProperty {\n  Url = 'Url',\n  HostAndPort = 'HostAndPort',\n}\nexport enum ContainerLifetime {\n  Session = 'Session',\n  Persistent = 'Persistent',\n}\nexport interface EndpointReference {\n  port(): Promise<number>;\n  host(): Promise<string>;\n  property(property: EndpointProperty): string;\n}\nexport interface EndpointReferencePromise extends PromiseLike<EndpointReference> {\n  port(): Promise<number>;\n  host(): Promise<string>;\n}\nexport interface AspireResourceBase {\n  withEnvironment(key: string, value: string): AspireResourceBase;\n  withHealthCheck(key: string): Promise<void>;\n  getEndpoint(scheme: string): EndpointReferencePromise;\n  waitFor(resource: AspireResourceBase): PromiseLike<AspireResourceBase>;\n}\nexport interface ExecutableResource extends AspireResourceBase {\n  withEndpoint(options: Record<string, unknown>): ExecutableResource;\n  withOtlpExporter(options: Record<string, unknown>): ExecutableResource;\n  withHttpEndpoint(options: unknown): ExecutableResource;\n  withBrowserLogs(): ExecutableResource;\n  withHttpHealthCheck(options: unknown): ExecutableResource;\n  withArgs(args: readonly string[]): ExecutableResource;\n}\nexport interface ContainerResource extends AspireResourceBase {\n  withEndpoint(options: Record<string, unknown>): ContainerResource;\n  withBindMount(source: string, target: string): ContainerResource;\n  withContainerRuntimeArgs(args: readonly string[]): ContainerResource;\n  withArgs(args: readonly string[]): ContainerResource;\n}\nexport interface PostgresServerResource extends AspireResourceBase {\n  withLifetime(lifetime: ContainerLifetime): PostgresServerResource;\n  withDataBindMount(path: string): PostgresServerResource;\n  withImage(image: string): PostgresServerResource;\n  withImageTag(tag: string): PostgresServerResource;\n  addDatabase(name: string): PromiseLike<ExecutableResource>;\n}\nexport interface ParameterResource {\n  readonly name: string;\n}\nexport interface Configuration {\n  getConfigValue(key: string): PromiseLike<string | undefined>;\n}\nexport interface DistributedApplicationBuilder {\n  addExecutable(name: string, command: string, workdir: string, args: readonly string[]): PromiseLike<ExecutableResource> & ExecutableResource;\n  addContainer(name: string, image: string): PromiseLike<ContainerResource> & ContainerResource;\n  addPostgres(name: string, options: { port?: number; password?: ParameterResource }): PromiseLike<PostgresServerResource> & PostgresServerResource;\n  addParameter(name: string, options: { value: string; secret?: boolean }): PromiseLike<ParameterResource>;\n  addConnectionString(name: string): PromiseLike<ExecutableResource>;\n  addHealthCheck(key: string, check: () => HealthCheckResult | Promise<HealthCheckResult>): void;\n  getConfiguration(): Configuration;\n}\nexport const OtlpProtocol = { HttpProtobuf: 'http-protobuf' } as const;\n`;\n}\n\nconsole.log(failures === 0 ? 'COMPOSITION PROOF: ALL CHECKS PASSED' : `COMPOSITION PROOF: ${failures} CHECK(S) FAILED`);\nif (failures > 0) Deno.exit(1);\n","structuredPatch":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":6,"lines":[" // IMPL-EVAL G3/G4 composition proof — scratch evaluator script (not product code)."," // Composes injectReadinessFixtureApps + injectListenerFaultHealthChecks on REAL generator",