/plugins/sagas/src/adapter/plugin.ts';\nimport { triggersAdapterPlugin } from '../../plugins/triggers/src/adapter/plugin.ts';\nimport { workersAdapterPlugin } from '../../plugins/workers/src/adapter/plugin.ts';\n\nfunction assert(condition: boolean, label: string): void {\n  if (!condition) throw new Error(`EVAL-FAIL: ${label}`);\n  console.log(`EVAL-OK: ${label}`);\n}\n\nasync function writeArtifacts(root: string, plugin: Parameters<typeof collectInstallArtifacts>[0]) {\n  for (const artifact of collectInstallArtifacts(plugin)) {\n    const path = `${root}/${artifact.path}`;\n    await Deno.mkdir(path.slice(0, path.lastIndexOf('/')), { recursive: true });\n    await Deno.writeTextFile(path, artifactText(artifact));\n  }\n}\n\nasync function writeUserSources(root: string): Promise<void> {\n  await Deno.mkdir(`${root}/src`, { recursive: true });\n  for (const [path, text] of Object.entries(userSources)) {\n    await Deno.writeTextFile(`${root}/${path}`, text);\n  }\n}\n\nconst userSources: Record<string, string> = {\n  'src/jobs.ts': `import { defineJob } from '@netscript/plugin-workers-core';\\n\\nexport const sendEmail = defineJob('send-email').build();\\n`,\n  'src/sagas.ts': `import { defineSaga } from '@netscript/plugin-sagas-core';\\n\\nexport default defineSaga('register-user').build();\\n`,\n  'src/webhooks.ts': `import { defineWebhook } from '@netscript/plugin-triggers-core';\\n\\nexport const newUserWebhook = defineWebhook('new-user', async () => ({}));\\n`,\n};\n\n// ---------- E3: no-arg discovery of the three official factories, production emission ----------\nconst project = await Deno.makeTempDir({ prefix: 'eval-s3-official-' });\nawait writeArtifacts(project, workersAdapterPlugin);\nawait writeArtifacts(project, sagasAdapterPlugin);\nawait writeArtifacts(project, triggersAdapterPlugin);\nfor (const [path, text] of Object.entries(userSources)) {\n  await Deno.mkdir(`${project}/src`, { recursive: true });\n  await Deno.writeTextFile(`${project}/${path}`, text);\n}\n\nconst walked = await new FilesystemWalker().walk(project);\nconst noArg = await new AstExtractor().extract(walked);\nconsole.log('no-arg contributions:', JSON.stringify(noArg, null, 2));\nassert(\n  noArg.length === 3 &&\n    noArg.some((c) => c.symbol === 'sendEmail' && c.axis === 'jobs') &&\n    noArg.some((c) => c.symbol === 'default' && c.axis === 'sagas') &&\n    noArg.some((c) => c.symbol === 'newUserWebhook' && c.axis === 'triggers'),\n  'E3 no-arg AstExtractor discovers defineJob->jobs, defineSaga->sagas, defineWebhook->triggers from walked plugin declarations',\n);\n\nconst preset = await startWalker(project);\nconsole.log(\n  'startWalker emissions:',\n  JSON.stringify(preset.map((emission) => emission.path)),\n);\nassert(\n  preset.length === 3 &&\n    preset.some((e) => e.path.endsWith('/jobs.registry.ts')) &&\n    preset.some((e) => e.path.endsWith('/sagas.registry.ts')) &&\n    preset.some((e) => e.path.endsWith('/triggers.registry.ts')),\n  'E3 startWalker(root) preset emits jobs/sagas/triggers registries end to end',\n);\n\n// ---------- E4a: factory imported + call sites, NO declaration -> throw with callee + remedy ----------\nconst broken = await Deno.makeTempDir({ prefix: 'eval-s3-broken-' });\nfor (const [path, text] of Object.entries(userSources)) {\n  await Deno.mkdir(`${broken}/src`, { recursive: true });\n  await Deno.writeTextFile(`${broken}/${path}`, text);\n}\ntry {\n  await new AstExtractor().extract(await new FilesystemWalker().walk(broken));\n  throw new Error('EVAL-FAIL: missing declaration did not throw');\n} catch (error) {\n  const message = error instanceof TypeError ? error.message : `wrong error type: ${error}`;\n  assert(\n    error instanceof TypeError && message.includes('defineJob') &&\n      message.includes('plugin sync/update') && message.includes('additionalBuilders'),\n    `E4a unmatched factory throws TypeError naming callee + both remedies :: \"${message}\"`,\n  );\n}\n\n// E4a-compat: explicit additionalBuilders is the documented compatibility path\nconst compat = await new AstExtractor({\n  additionalBuilders: [{ callee: 'defineJob', axis: 'jobs' }],\n}).extract(await new FilesystemWalker().walk(broken));\nassert(\n  compat.length === 1 && compat[0].axis === 'jobs' && compat[0].symbol === 'sendEmail',\n  'E4a additionalBuilders compatibility path works without any declaration',\n);\n\n// ---------- E4b: no factory call sites at all -> quiet empty result ----------\nconst plain = await Deno.makeTempDir({ prefix: 'eval-s3-plain-' });\nawait Deno.writeTextFile(\n  `${plain}/src/plain.ts`,\n  `export const answer = 42;\\nexport function greet(name: string): string {\\n  return \\`hello \\${name}\\`;\\n}\\n`,\n);\nconst quiet = await new AstExtractor().extract(await new FilesystemWalker().walk(plain));\nassert(quiet.length === 0, 'E4b project with no contribution call sites stays quiet (empty result)');\n\n// ---------- E4 edges ----------\nconst importOnly = await Deno.makeTempDir({ prefix: 'eval-s3-importonly-' });\nawait Deno.writeTextFile(\n  `${importOnly}/src/import-only.ts`,\n  `import { defineJob } from '@netscript/plugin-workers-core';\\n\\nexport const notACall = 'defineJob';\\n`,\n);\nconst importOnlyResult = await new AstExtractor().extract(\n  await new FilesystemWalker().walk(importOnly),\n);\nassert(\n  importOnlyResult.length === 0,\n  'E4-edge import of a factory with NO call site stays quiet (no throw)',\n);\n\nconst handlerExcluded = await Deno.makeTempDir({ prefix: 'eval-s3-handler-' });\nawait Deno.writeTextFile(\n  `${handlerExcluded}/src/handlers.ts`,\n  `import { defineJobHandler } from '@netscript/plugin-workers-core';\\n\\nexport const handler = defineJobHandler(async () => {});\\n`,\n);\nconst handlerResult = await new AstExtractor().extract(\n  await new FilesystemWalker().walk(handlerExcluded),\n);\nassert(\n  handlerResult.length === 0,\n  'E4-edge defineJobHandler (non-contribution grammar) stays quiet',\n);\n\nconst duplicate = await Deno.makeTempDir({ prefix: 'eval-s3-dup-' });\nawait Deno.writeTextFile(\n  `${duplicate}/a/plugin.ts`,\n  `export const NETSCRIPT_CONTRIBUTION_BUILDERS = [{ callee: 'defineJob', axis: 'jobs' }] as const;\\n`,\n);\nawait Deno.writeTextFile(\n  `${duplicate}/b/plugin.ts`,\n  `export const NETSCRIPT_CONTRIBUTION_BUILDERS = [{ callee: 'defineJob', axis: 'jobs-2' }] as const;\\n`,\n);\ntry {\n  await new AstExtractor().extract(await new FilesystemWalker().walk(duplicate));\n  throw new Error('EVAL-FAIL: duplicate callee did not throw');\n} catch (error) {\n  assert(\n    error instanceof TypeError && error.message.includes('Duplicate contribution builder callee'),\n    `E4-edge duplicate callee across declarations throws :: \"${error instanceof Error ? error.message : error}\"`,\n  );\n}\n\nconst malformed = await Deno.makeTempDir({ prefix: 'eval-s3-malformed-' });\nawait Deno.writeTextFile(\n  `${malformed}/plugin.ts`,\n  `export const NETSCRIPT_CONTRIBUTION_BUILDERS = [{ callee: defineJob, axis: 'jobs' }] as const;\\n`,\n);\ntry {\n  await new AstExtractor().extract(await new FilesystemWalker().walk(malformed));\n  throw new Error('EVAL-FAIL: malformed declaration did not throw');\n} catch (error) {\n  assert(\n    error instanceof TypeError && error.message.includes('Malformed NETSCRIPT_CONTRIBUTION_BUILDERS'),\n    `E4-edge present-but-malformed declaration throws (no silent skip) :: \"${error instanceof Error ? error.message : error}\"`,\n  );\n}\n\nconsole.log('ALL E3/E4 EVAL ASSERTIONS PASSED');\n","structuredPatch":[{"oldStart":84,"oldLines":9,"newStart":84,"newLines":12,"lines":[" }"," "," // E4a-compat: explicit additionalBuilders is the documented compatibility path","+const compatDir = await Deno.makeTempDir({ prefix: 'eval-s3-compat-' });","+await Deno.mkdir(`${compatDir}/src`, { recursive: true });","+await Deno.writeTextFile(`${compatDir}/src/jobs.ts`, userSources['src/jobs.ts']);"," const compat = await new AstExtractor({","   additionalBuilders: [{ callee: 'defineJob', axis: 'jobs' }],","-}).extract(await new FilesystemWalker().walk(broken));","+}).extract(await new FilesystemWalker().walk(compatDir));"," assert(","   compat.length === 1 && compat[0].axis === 'jobs' && compat[0].symbol === 'sendEmail',","   'E4a additionalBuilders compatibility path works without any declaration',"]}],"userModified":false,"replaceAll":false}}
