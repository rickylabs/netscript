+  name: 'database TCP probe retries a native refused endpoint and returns without querying',
+  sanitizeOps: true,
+  sanitizeResources: true,
+  sanitizeExit: true,
+  async fn() {
+    const reservation = Deno.listen({ hostname: '127.0.0.1', port: 0 });
