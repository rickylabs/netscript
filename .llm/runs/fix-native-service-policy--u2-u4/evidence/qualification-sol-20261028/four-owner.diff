+  name: 'database TCP probe closes its native loopback connection before querying',
+  sanitizeOps: true,
+  sanitizeResources: true,
+  sanitizeExit: true,
+  async fn() {
+    const listener = Deno.listen({ hostname: '127.0.0.1', port: 0 });
