+    checks: [{
+      name: 'configured',
+      check: () => {
+        configured++;
+        return Promise.resolve({ healthy: true });
+      },
+    }],
+  }).withHealth({
+    includeDetails: true,
+    checks: [{
+      name: 'ignored',
+      check: () => {
+        ignored++;
+        return Promise.resolve({ healthy: false });
+      },
