+test('invalid rules reject every build and serve without partial middleware or listeners', async () => {
+  for (const failAtAuthz of [false, true]) {
+    let authn = 0;
+    let authz = 0;
+    let health = 0;
+    let raw = 0;
+    let listeners = 0;
+    let reads = 0;
+    const options: AuthnOptions = {
+      protect: ['/'],
+      authenticator: {
