{
  "nodeModulesDir": "auto",
  "unstable": [
    "kv"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true
  },
  "imports": {
    "preact": "npm:preact@10.29.2",
    "preact/": "npm:/preact@10.29.2/",
    "@preact/signals": "npm:@preact/signals@2.11.3",
    "@gpuix/native": "npm:@gpuix/native@0.11.0",
    "@gpuix/native/": "npm:/@gpuix/native@0.11.0/",
    "@orpc/contract": "npm:@orpc/contract@^1.15.5",
    "@orpc/server": "npm:@orpc/server@^1.15.5",
    "zod": "npm:zod@^4.6.5",
    "@netscript/service": "jsr:@netscript/service@0.0.9",
    "@netscript/sdk/client": "jsr:@netscript/sdk@0.0.9/client",
    "@netscript/sdk/streams/consumer": "jsr:@netscript/sdk@0.0.9/streams/consumer",
    "@netscript/kv": "jsr:@netscript/kv@0.0.9",
    "gpuix-preact": "./packages/gpuix-preact/mod.ts",
    "@netscript/contracts": "jsr:@netscript/contracts@0.0.9",
    "@netscript/plugin-workers-core/contracts/v1": "jsr:@netscript/plugin-workers-core@0.0.9/contracts/v1",
    "@netscript/plugin-sagas-core/contracts/v1": "jsr:@netscript/plugin-sagas-core@0.0.9/contracts/v1",
    "@netscript/plugin-triggers-core/contracts/v1": "jsr:@netscript/plugin-triggers-core@0.0.9/contracts/v1",
    "@netscript/plugin-streams-core": "jsr:@netscript/plugin-streams-core@0.0.9",
    "@workspace/contracts": "./realstack/workspace/contracts/mod.ts",
    "@database/zod": "./realstack/workspace/database/sqlite/schema/.generated/zod/crud.ts"
  },
  "tasks": {
    "gpuix": "deno run -A app/main.gpuix.tsx",
    "check": "deno check app/main.gpuix.tsx app/main.webview.ts app/web/renderer.tsx"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true
  }
}
