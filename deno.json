{
  "version": "0.0.6",
  "workspace": [
    "packages/*",
    "packages/cli/e2e",
    "plugins/*",
    "examples/*",
    "apps/*"
  ],
  "exclude": [
    ".llm/tmp/"
  ],
  "unstable": [
    "kv",
    "temporal",
    "tsgo",
    "worker-options"
  ],
  "tasks": {
    "ci": "deno ci && deno task ci:quality && deno task coverage:functions && deno task publish:dry-run && deno task audit:critical",
    "ci:quality": {
      "dependencies": [
        "check",
        "check:emitted-samples",
        "check:streams-types",
        "lint",
        "fmt:check",
        "deps:check",
        "check:netscript-jsr-specifiers",
        "check:aspire-host-ports"
      ]
    },
    "check": {
      "command": "deno run --allow-read --allow-write --allow-run .llm/tools/run-deno-check.ts --root packages --root plugins --ext ts,tsx --exclude \"^(.*(?:^|/)\\.generated/|.*(?:^|/)node_modules/)\"",
      "files": [
        "packages/**/*.ts",
        "packages/**/*.tsx",
        "plugins/**/*.ts",
        "plugins/**/*.tsx",
        "deno.json",
        "deno.lock",
        ".llm/tools/run-deno-check.ts"
      ]
    },
    "check:emitted-samples": "deno run --allow-read --allow-write --allow-run .llm/tools/validation/check-emitted-samples.ts",
    "check:streams-types": "deno task --cwd packages/fresh check:streams-types",
    "test": "deno run --allow-read --allow-write --allow-run .llm/tools/run-deno-test.ts -- --allow-all",
    "gates:run": "deno run --allow-read --allow-write --allow-run --allow-env .llm/tools/gates/run-gate.ts",
    "gates:test": "deno test --allow-read --allow-write --allow-run --allow-env .llm/tools/gates/*_test.ts .llm/tools/run-deno-check_test.ts .llm/tools/run-deno-test_test.ts .llm/tools/run-deno-lint_test.ts .llm/tools/run-deno-fmt_test.ts .llm/tools/run-deno-doc-lint_test.ts .llm/tools/quality/changed-source-files_test.ts .github/scripts/ci-receipt-policy.test.ts",
    "quality:scan": "deno run --allow-read .llm/tools/quality/check-root-coverage.ts && deno run --allow-read --allow-net=api.github.com --allow-env=GITHUB_TOKEN,GH_TOKEN .llm/tools/quality/scan-code-quality.ts --root packages --root plugins --root docs/site --max-allow 7",
    "quality:scan:repo": "deno run --allow-read .llm/tools/quality/check-root-coverage.ts && deno run --allow-read --allow-net=api.github.com --allow-env=GITHUB_TOKEN,GH_TOKEN .llm/tools/quality/scan-code-quality.ts --root packages --root plugins --root .llm/tools/fitness --root .llm/tools/quality --root docs/site --max-allow 7",
    "quality:gate": "deno task quality:scan && deno task arch:check",
    "coverage:functions": "rm -rf .llm/tmp/coverage/functions && deno test --allow-all --coverage=.llm/tmp/coverage/functions --coverage-raw-data-only packages/contracts/tests/errors_test.ts packages/service/tests/_fixtures/readme-examples_test.ts && deno run --allow-read --allow-write .llm/tools/reporting/report-function-coverage.ts --coverage .llm/tmp/coverage/functions --out .llm/tmp/coverage/function-report.json --package packages/contracts --package packages/plugin-triggers-core --package packages/service --package packages/plugin",
    "audit:critical": "deno audit --level critical",
    "deps:latest": "deno run --allow-read --allow-net .llm/tools/deps/latest.ts --pretty --behind-only",
    "deps:outdated": "deno run --allow-read --allow-run .llm/tools/deps/outdated.ts --latest --pretty",
    "deps:why": "deno run --allow-read --allow-run .llm/tools/deps/why.ts",
    "deps:audit": "deno run --allow-read --allow-net --allow-run .llm/tools/deps/audit.ts --level low --pretty",
    "deps:prod-install": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env .llm/tools/deps/prod-install.ts --pretty",
    "deps:census": "deno run --allow-read .llm/tools/deps/census.ts",
    "deps:check": "deno run --allow-read .llm/tools/deps/scan-jsr-centralization.ts --fail-on-violation && deno run --allow-read .llm/tools/deps/audit-file-link.ts --fail-on-violation && deno run --allow-read .llm/tools/deps/scan-npm-catalog-compliance.ts && deno task deps:check:zod",
    "deps:check:zod": "deno run --allow-read .llm/tools/deps/check-zod-alignment.ts",
    "deps:check:npm-catalog": "deno run --allow-read .llm/tools/deps/scan-npm-catalog-compliance.ts",
    "deps:check:jsr-centralization": "deno run --allow-read .llm/tools/deps/scan-jsr-centralization.ts",
    "deps:audit:file-link": "deno run --allow-read .llm/tools/deps/audit-file-link.ts",
    "version:bump": "deno run --allow-read --allow-write --allow-run --allow-env .llm/tools/deps/bump-version.ts",
    "version:bump:test": "deno test --allow-read --allow-write --allow-run --allow-env .llm/tools/deps/bump-version_test.ts .llm/tools/release/cut_test.ts",
    "agentic:check-claude": "deno run --no-lock --allow-read --allow-run .llm/tools/agentic/claude/validate-claude-surface.ts --pretty",
    "harness:milestone:validate": "deno run --no-lock --allow-read .llm/tools/harness/validate-milestone-cluster.ts",
    "harness:milestone:render": "deno run --no-lock --allow-read --allow-write .llm/tools/harness/render-milestone-status.ts",
    "harness:milestone:test": "deno test --no-lock --allow-read --allow-write .llm/tools/harness/render-milestone-status_test.ts .llm/tools/harness/validate-milestone-cluster_test.ts",
    "agentic:wsl-foundation": "deno run --no-lock --allow-read --allow-write --allow-run --allow-env --allow-net=nodejs.org,registry.npmjs.org,antigravity.google .llm/tools/agentic/wsl/wsl-foundation.ts",
    "agentic:runtime": "deno run --no-lock --allow-read --allow-write --allow-run --allow-env .llm/tools/agentic/runtime/cli/agentic-runtime.ts",
    "agentic:routing-state": "deno run --no-lock --allow-read --allow-env .llm/tools/agentic/runtime/cli/routing-state.ts",
    "agentic:leak-check": "deno run --no-lock --allow-read --allow-write --allow-run .llm/tools/agentic/teardown/leak-check.ts",
    "agentic:teardown": "deno run --no-lock --allow-read --allow-write --allow-run .llm/tools/agentic/teardown/teardown.ts",
    "agentic:dogfood-skills": "deno run --no-lock --allow-read --allow-write --allow-run .llm/tools/agentic/dogfood-skills.ts",
    "agentic:dogfood-skills:check": "deno run --no-lock --allow-read --allow-write --allow-run .llm/tools/agentic/dogfood-skills.ts --check",
    "agentic:antigravity-evidence": "deno run --no-lock --allow-read --allow-write --allow-run --allow-env .llm/tools/agentic/runtime/cli/antigravity-evidence-cli.ts",
    "agentic:provider-canary": "deno run --no-lock --allow-run --allow-env .llm/tools/agentic/runtime/cli/provider-canary.ts",
    "agentic:rollout-canary": "deno run --no-lock --allow-read --allow-write --allow-run --allow-env .llm/tools/agentic/runtime/cli/rollout-canary-cli.ts",
    "design:sync": "deno run --no-lock --allow-read --allow-write --allow-run --allow-env tools/design-sync/mod.ts",
    "docs:links": "deno run --no-lock --allow-read .llm/tools/validation/check-internal-doc-links.ts --pretty",
    "docs:exports-drift": "deno run --no-lock --allow-read --allow-run=deno .llm/tools/docs/check-exports-drift.ts",
    "docs:accuracy": "deno run --no-lock --allow-read --allow-env --allow-run=deno .llm/tools/docs/check-accuracy-and-discoverability.ts",
    "docs:jsdoc-examples": "deno run --allow-read --allow-write --allow-run .llm/tools/docs/check-jsdoc-examples.ts",
    "docs:jsdoc-examples:test": "deno test --allow-read --allow-write --allow-run .llm/tools/docs/jsdoc-example-policy_test.ts .llm/tools/docs/jsdoc-example-compiler_test.ts .llm/tools/gates/jsdoc-example-workflow_test.ts",
    "docs:snippets": "deno run --allow-read --allow-write --allow-run .llm/tools/docs/check-snippets.ts",
    "docs:snippets:test": "deno test --allow-read --allow-write --allow-run .llm/tools/docs/snippet-extractor_test.ts .llm/tools/docs/snippet-compiler_test.ts .llm/tools/docs/pages-workflow_test.ts .llm/tools/docs/official-saga-publisher-sample-sync_test.ts",
    "docs:snippets:negative": "deno run --allow-read --allow-write --allow-run .llm/tools/docs/check-snippets.ts --negative",
    "docs:contract-derivation": "deno test --no-lock --allow-read --allow-write --allow-run .llm/tools/docs/check-docs-contract-derivation_test.ts && deno run --no-lock --allow-read --allow-write --allow-run .llm/tools/docs/check-docs-contract-derivation.ts",
    "docs:maintenance": "deno task docs:links && deno task docs:accuracy && deno task docs:contract-derivation && deno task agentic:check-claude",
    "agentic:smoke-claude-remote": "deno run --no-lock --allow-read --allow-run .llm/tools/agentic/claude/claude-remote-smoke.ts --env-aware --pretty",
    "agentic:claude-openrouter-gateway": "deno run --no-lock --allow-read --allow-run --allow-env --allow-sys --allow-net=127.0.0.1,api.anthropic.com,openrouter.ai .llm/tools/agentic/claude/remote-model-launcher.ts",
    "agentic:claude-hybrid": "deno run --no-lock --allow-read --allow-write=/tmp --allow-run=claude --allow-env .llm/tools/agentic/claude/hybrid-launcher.ts",
    "agentic:codex-resume": "deno run --no-lock --allow-read --allow-run .llm/tools/agentic/codex/codex-resume.ts",
    "agentic:codex-status": "deno run --no-lock --allow-read --allow-run .llm/tools/agentic/codex/codex-status.ts",
    "agentic:codex-follow": "deno run --no-lock --allow-read --allow-env .llm/tools/agentic/codex/codex-follow.ts",
    "agentic:codex-watch": "deno run --no-lock --allow-read --allow-run --allow-env .llm/tools/agentic/codex/codex-watch.ts",
    "agentic:launch-codex-slice": "deno run --no-lock --allow-read --allow-write --allow-run --allow-env .llm/tools/agentic/codex/launch-codex-slice.ts",
    "agentic:dispatch-openhands": "deno run --no-lock --allow-read --allow-env --allow-net .llm/tools/agentic/openhands/dispatch-openhands.ts",
    "agentic:openhands-status": "deno run --no-lock --allow-read --allow-env --allow-net .llm/tools/agentic/openhands/openhands-status.ts",
    "agentic:gh-pr": "deno run --no-lock --allow-read --allow-write=.llm/tmp/agentic/gh-pr --allow-env --allow-net .llm/tools/agentic/github/gh-pr.ts",
    "agentic:gh-watch": "deno run --no-lock --allow-env --allow-net .llm/tools/agentic/github/gh-watch.ts",
    "agentic:gh-token": "deno run --no-lock --allow-run --allow-env --allow-net .llm/tools/agentic/github/gh-token.ts",
    "agentic:review-threads": "deno run --no-lock --allow-read --allow-run --allow-env --allow-net=api.github.com .llm/tools/agentic/github/review-threads.ts",
    "agentic:pr-checks": "deno run --no-lock --allow-read --allow-run --allow-env --allow-net=api.github.com .llm/tools/agentic/github/pr-checks.ts",
    "agentic:claude-hook-log": "deno run --no-lock --no-prompt --allow-env=CLAUDE_PROJECT_DIR,NETSCRIPT_RUN_ID,CLAUDE_SESSION_ID --allow-write=.llm/tmp/claude/hooks .llm/tools/agentic/claude/claude-hook-log.ts",
    "agentic:claude-openrouter": "deno run --no-lock --allow-read --allow-write --allow-run --allow-env --allow-net .llm/tools/agentic/claude/openrouter-run.ts",
    "agentic:opencode": "deno run --no-lock --allow-read --allow-write --allow-run --allow-env --allow-net=127.0.0.1 .llm/tools/agentic/opencode/opencode-run.ts",
    "agentic:opencode-eval": "deno run --no-lock --allow-read --allow-run --allow-env .llm/tools/agentic/opencode/opencode-eval.ts",
    "agentic:opencode-web": "deno run --no-lock --allow-read --allow-run --allow-env .llm/tools/agentic/opencode/opencode-web.ts",
    "gen:assets-barrel": "deno run --no-lock --allow-read --allow-write --allow-run=deno .llm/tools/generate-cli-assets-barrel.ts",
    "gen:agent-docs-prose": "deno task --cwd docs/site build && deno run --no-lock --allow-read --allow-write --allow-run=git .llm/tools/docs/build-agent-docs-bundle.ts --site-dir docs/site/_site",
    "gen:mcp-export-corpus": "deno run --no-lock --allow-read --allow-write --allow-env --allow-run=deno .llm/tools/docs/generate-export-surface-corpus.ts",
    "check:mcp-export-corpus": "deno run --no-lock --allow-read --allow-env --allow-run=deno .llm/tools/docs/generate-export-surface-corpus.ts --check",
    "check:assets-barrel": "deno task gen:assets-barrel && git diff --exit-code -- packages/cli/src/kernel/assets/embedded.generated.ts packages/cli/src/kernel/assets/skills.generated.ts packages/cli/src/kernel/assets/agent-tools.generated.ts packages/cli/src/kernel/assets/agent-docs.generated.ts packages/plugin/src/kernel/assets/embedded.generated.ts packages/fresh-ui/registry.generated.ts packages/service/src/primitives/scalar.generated.ts",
    "check:agent-docs-prose": "deno task gen:agent-docs-prose --check",
    "gen:publish-assets": "deno run --no-lock --allow-read --allow-write --allow-run=deno .llm/tools/generate-publish-assets.ts",
    "check:publish-assets": "deno task gen:publish-assets --check",
    "check:scaffold-versions": "deno run .llm/tools/validation/check-scaffold-versions.ts --pretty",
    "check:aspire-version-parity": "deno run --allow-read .llm/tools/validation/check-aspire-version-parity.ts",
    "check:netscript-jsr-specifiers": "deno run --allow-read .llm/tools/validation/check-netscript-jsr-specifiers.ts --pretty",
    "check:aspire-host-ports": "deno run --allow-read .llm/tools/validation/check-aspire-host-ports.ts --pretty",
    "release:preflight": "deno run --allow-read .llm/tools/release/preflight-text-imports.ts",
    "publish:readiness": "deno run --allow-read --allow-run --allow-net=jsr.io,api.jsr.io .llm/tools/release/publish-readiness.ts",
    "release:cut": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net=api.github.com .llm/tools/release/cut.ts",
    "release:canary": "deno run --allow-read --allow-write --allow-run --allow-net=jsr.io .llm/tools/release/canary.ts",
    "release:canary-label": "deno run --allow-env=GH_TOKEN,GITHUB_TOKEN,GITHUB_REPOSITORY --allow-net=api.github.com,jsr.io --allow-run=git .llm/tools/release/canary-label.ts",
    "release:publish": "deno run --allow-net --allow-env --allow-run --allow-read .llm/tools/release/github-release.ts",
    "release:verify-canary-pair": "deno run --allow-net=api.github.com --allow-env=GH_TOKEN --allow-run=git,deno --allow-read .llm/tools/release/verify-canary-pair.ts",
    "surface:diff": "deno run --allow-read --allow-write --allow-run .llm/tools/release/surface-diff.ts",
    "surface:diff:test": "deno test --allow-read .llm/tools/release/surface-diff_test.ts",
    "publish:dry-run": "deno run --allow-read --allow-write --allow-run .llm/tools/release/run-publish-dry-run.ts",
    "doc:lint": "deno run --allow-read --allow-write --allow-run .llm/tools/run-deno-doc-lint.ts",
    "e2e:cli": "deno run --allow-all packages/cli/e2e/cli.ts",
    "e2e:cli:prod": "deno run --allow-all packages/cli/e2e/cli.ts run scaffold.runtime --source jsr --cli packages/cli/bin/netscript.ts",
    "bench:self": "deno run --allow-all packages/bench/cli.ts self",
    "bench:self:fake": "deno run --allow-all packages/bench/cli.ts self --fake",
    "bench:conformance": "deno run --allow-all packages/bench/cli.ts conformance",
    "fmt": "deno run --allow-read --allow-write --allow-run .llm/tools/run-deno-fmt.ts --root packages --root plugins --ext ts,tsx --exclude \"^(packages/(cli)|.*(?:^|/)\\.generated/|.*(?:^|/)node_modules/)\" --write",
    "fmt:check": {
      "command": "deno run --allow-read --allow-write --allow-run .llm/tools/run-deno-fmt.ts --root packages --root plugins --ext ts,tsx --exclude \"^(packages/(cli)|.*(?:^|/)\\.generated/|.*(?:^|/)node_modules/)\" --ignore-line-endings",
      "files": [
        "packages/**/*.ts",
        "packages/**/*.tsx",
        "plugins/**/*.ts",
        "plugins/**/*.tsx",
        "deno.json",
        ".llm/tools/run-deno-fmt.ts"
      ]
    },
    "lint": {
      "command": "deno run --allow-read --allow-write --allow-run .llm/tools/run-deno-lint.ts --root packages --root plugins --ext ts,tsx --exclude \"^(packages/(cli)|.*(?:^|/)\\.generated/|.*(?:^|/)node_modules/)\"",
      "files": [
        "packages/**/*.ts",
        "packages/**/*.tsx",
        "plugins/**/*.ts",
        "plugins/**/*.tsx",
        "deno.json",
        ".llm/tools/run-deno-lint.ts"
      ]
    },
    "docs:readme:check": "deno run --no-lock --allow-read .llm/tools/validation/check-readme-standard.ts --pretty",
    "docs:tagline:check": "deno run --no-lock --allow-read .llm/tools/validation/check-jsr-tagline-length.ts --pretty",
    "arch:check": "deno task deps:check && deno run --allow-read --allow-run .llm/tools/fitness/check-doctrine.ts --all-roots",
    "arch:check:repo": "deno run --allow-read --allow-run .llm/tools/fitness/check-doctrine.ts --all-roots"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "isolatedDeclarations": true,
    "lib": [
      "dom",
      "deno.ns",
      "deno.unstable"
    ]
  },
  "lint": {
    "exclude": [
      ".llm/",
      "tools/",
      "packages/cli/",
      "packages/mcp/tests/fixtures/doctor/"
    ],
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "no-process-global",
        "no-node-globals"
      ]
    }
  },
  "fmt": {
    "include": [
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "plugins/**/*.ts",
      "plugins/**/*.tsx"
    ],
    "exclude": [
      "packages/cli/",
      "packages/mcp/tests/fixtures/doctor/",
      "**/.generated/",
      "**/node_modules/"
    ],
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true
  },
  "publish": false,
  "catalog": {
    "@durable-streams/client": "^0.2.6",
    "@durable-streams/server": "^0.3.7",
    "@durable-streams/state": "^0.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@orpc/client": "^1.15.0",
    "@orpc/contract": "^1.15.0",
    "@orpc/openapi": "^1.15.0",
    "@orpc/otel": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/tanstack-query": "^1.15.0",
    "@orpc/zod": "^1.15.0",
    "@preact/signals": "2.9.2",
    "@prisma/adapter-mssql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/driver-adapter-utils": "^7.8.0",
    "@prisma/instrumentation-contract": "^7.8.0",
    "@workos-inc/node": "^10.4.0",
    "@saga-bus/core": "^0.2.2",
    "@tanstack/db": "^0.6.8",
    "@tanstack/preact-query": "^5.101.0",
    "@tanstack/query-core": "^5.101.0",
    "@tanstack/query-db-collection": "^1.2.1",
    "@tanstack/react-db": "^0.1.95",
    "@tailwindcss/vite": "^4.3.1",
    "amqplib": "^2.0.1",
    "better-auth": "^1.6.20",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "mysql2": "^3.22.5",
    "pg": "^8.21.0",
    "preact": "^10.29.2",
    "preact-render-to-string": "^6.7.0",
    "tailwindcss": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "vite": "7.2.2",
    "zod": "^4.4.3"
  }
}
