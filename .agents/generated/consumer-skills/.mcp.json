{
  "mcpServers": {
    "netscript": {
      "command": "deno",
      "args": [
        "run",
        "--no-lock",
        "--minimum-dependency-age=0",
        "--config",
        "deno.json",
        "-A",
        "jsr:@netscript/cli@0.0.6",
        "agent",
        "mcp",
        "--project-root",
        "."
      ]
    },
    "aspire": {
      "command": "aspire",
      "args": [
        "agent",
        "mcp"
      ]
    }
  }
}
