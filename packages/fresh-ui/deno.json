{
  "name": "@netscript/fresh-ui",
  "version": "0.0.8",
  "description": "Fresh UI registry seams and interactive foundations for NetScript.",
  "license": "Apache-2.0",
  "exclude": [],
  "exports": {
    ".": "./mod.ts",
    "./ai/render-ui": "./src/ai/render-ui.tsx",
    "./desktop": "./desktop.ts",
    "./interactive": "./interactive.ts",
    "./primitives": "./primitives.tsx",
    "./registry": "./registry.ts",
    "./tokens": "./tokens.ts",
    "./token-config": "./token-config.ts",
    "./registry-v2": "./registry-v2.ts"
  },
  "imports": {
    "@netscript/sdk/auto-update": "jsr:@netscript/sdk@0.0.8/auto-update",
    "@netscript/sdk/desktop": "jsr:@netscript/sdk@0.0.8/desktop",
    "@std/assert": "jsr:@std/assert@^1",
    "preact": "npm:preact@^10.29.2"
  },
  "publish": {
    "include": [
      "*.ts",
      "*.tsx",
      "src/**/*.ts",
      "src/**/*.tsx",
      "registry/lib/cn.ts",
      "registry/lib/toast.ts",
      "deno.json",
      "README.md",
      "tokens/README.md",
      "src/registry/README.md",
      "src/registry/schemas/LICENSE"
    ],
    "exclude": [
      "scripts/**",
      "tests/**",
      "**/*_test.ts",
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  },
  "tasks": {
    "check": "deno run --allow-read --allow-write --allow-run ../../.llm/tools/run-deno-check.ts --cwd . --root . --ext ts,tsx --deno-arg --lock=deno.lock --deno-arg --frozen",
    "lock:update": "deno run --allow-read --allow-write --allow-run ../../.llm/tools/run-deno-check.ts --cwd . --root . --ext ts,tsx --deno-arg --lock=deno.lock --deno-arg --frozen=false",
    "lint": "deno run --allow-read --allow-write --allow-run ../../.llm/tools/run-deno-lint.ts --cwd . --root . --ext ts,tsx --config deno.json",
    "test": "deno run --allow-read --allow-write --allow-run ../../.llm/tools/run-deno-test.ts --cwd . -- --allow-read --allow-write --allow-run --allow-env --lock=deno.lock --frozen --unstable-kv \"tests/**/*.ts\" \"tests/**/*.tsx\"",
    "tokens:build": "deno task tokens:embed && deno run --lock=deno.lock --frozen --allow-read=. --allow-write=registry/theme --allow-env --allow-net=registry.npmjs.org scripts/build-tokens.ts && deno task tokens:embed",
    "tokens:check": "deno task tokens:embed:check && deno run --lock=deno.lock --frozen --allow-read=. --allow-env --allow-net=registry.npmjs.org scripts/build-tokens.ts --check",
    "tokens:validate": "deno task tokens:sources:check && deno run --lock=deno.lock --frozen --allow-read=. --allow-env --allow-net=registry.npmjs.org scripts/check-tokens.ts",
    "tokens:sources:check": "deno task tokens:embed:check && deno run --lock=deno.lock --frozen --allow-read=. --allow-env scripts/import-figma-tokens.ts --check && deno run --lock=deno.lock --frozen --allow-read=. --allow-env scripts/validate-token-sources.ts",
    "tokens:report": "deno run --lock=deno.lock --frozen --allow-read=. --allow-env --allow-net=registry.npmjs.org scripts/check-tokens.ts --report",
    "tokens:embed": "deno run --lock=deno.lock --frozen --allow-read=. --allow-write=. --allow-run=deno scripts/embed-token-assets.ts",
    "tokens:embed:check": "deno run --lock=deno.lock --frozen --allow-read=. --allow-run=deno scripts/embed-token-assets.ts --check",
    "registry:embed": "deno run --lock=deno.lock --frozen --allow-read=. --allow-write=src/registry/assets --allow-run=deno scripts/embed-registry-assets.ts",
    "registry:embed:check": "deno run --lock=deno.lock --frozen --allow-read=. --allow-run=deno scripts/embed-registry-assets.ts --check"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ]
  },
  "fmt": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.css",
      "**/*.md"
    ],
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true
  }
}
