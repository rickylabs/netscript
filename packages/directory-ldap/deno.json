{
  "name": "@netscript/directory-ldap",
  "version": "0.0.9",
  "description": "Active Directory and LDAP adapter implementing NetScript's DirectoryPort.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./mod.ts"
  },
  "imports": {
    "@netscript/plugin-directory-core": "jsr:@netscript/plugin-directory-core@0.0.9",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "check": "deno check --unstable-kv ./mod.ts",
    "test": "deno test --allow-read --allow-write --allow-env ./src/ ./tests/",
    "lint": "deno lint",
    "fmt": "deno fmt --check",
    "publish:dry-run": "deno publish --dry-run --allow-dirty"
  },
  "publish": {
    "include": [
      "README.md",
      "CHANGELOG.md",
      "deno.json",
      "mod.ts",
      "src/**/*.ts"
    ],
    "exclude": [
      "tests/",
      "**/*_test.ts",
      "**/*.test.ts"
    ]
  }
}
