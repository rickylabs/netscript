{
  "name": "@netscript/plugin-directory-core",
  "version": "0.0.10-canary.5",
  "description": "Provider-neutral directory port, domain contracts, typed errors, and conformance testing kit for NetScript.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./mod.ts",
    "./domain": "./src/domain/mod.ts",
    "./ports": "./src/ports/mod.ts",
    "./testing": "./src/testing/mod.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "check": "deno check --unstable-kv mod.ts src/domain/mod.ts src/ports/mod.ts src/testing/mod.ts",
    "test": "deno test --unstable-kv --allow-all",
    "publish:dry-run": "deno publish --dry-run --allow-dirty"
  },
  "publish": {
    "include": [
      "README.md",
      "deno.json",
      "mod.ts",
      "src/**/*.ts"
    ],
    "exclude": [
      "**/*_test.ts",
      "**/*.test.ts"
    ]
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true
  }
}
