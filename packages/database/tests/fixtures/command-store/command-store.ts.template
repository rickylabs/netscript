// Consumer-owned bridge. Generate the schema client before checking this fixture.
import type { Prisma, PrismaClient } from './.generated/client.ts';
import type { TransactionClientPort } from '../../../commands.ts';

export type CommandTransactionClient = Omit<
  Prisma.TransactionClient,
  '$transaction' | '$connect' | '$disconnect' | '$on' | '$use' | '$extends'
>;

export function transactionClient(
  root: PrismaClient,
): TransactionClientPort<CommandTransactionClient> {
  return {
    $transaction(work, options) {
      if (options?.isolationLevel === 'Snapshot') throw new TypeError('PostgreSQL isolation unsupported');
      return root.$transaction((tx) => work(tx), { ...options, isolationLevel: options?.isolationLevel });
    },
  };
}
