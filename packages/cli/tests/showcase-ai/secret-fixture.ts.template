/** Own only the per-test workspace and its deterministic private credential file. */
import { join } from 'node:path';
import { provisionShowcaseStreams, SHOWCASE_STREAMS_METADATA } from './showcase/stream-secret.ts';

export async function secretWorkspace() {
  const root = await Deno.makeTempDir({ prefix: 'showcase-private-streams-' });
  await provisionShowcaseStreams(root);
  const metadata = JSON.parse(await Deno.readTextFile(join(root, SHOWCASE_STREAMS_METADATA)));
  if (
    typeof metadata.secretFile !== 'string' ||
    !/^netscript-showcase-[a-f0-9]{64}\.secret$/.test(metadata.secretFile)
  ) throw new Error('Invalid test-owned secret reference');
  const secretPath = join(Deno.env.get('HOME')!, '.secrets', metadata.secretFile);
  return {
    root,
    secretPath,
    async close() {
      await Deno.remove(secretPath);
      await Deno.remove(root, { recursive: true });
    },
  };
}
