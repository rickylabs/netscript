import { assert, assertEquals, assertRejects, assertStringIncludes } from '@std/assert';
import { join } from 'node:path';
import {
  initializeShowcaseStreamSecret,
  provisionShowcaseStreams,
  SHOWCASE_STREAMS_METADATA,
} from './showcase/stream-secret.ts';
import { secretWorkspace } from './secret-fixture.ts';
import { handleShowcaseChat, readShowcaseChat } from './ai/showcase/runtime.ts';
import { implement } from '@orpc/server';
import { RPCHandler } from '@orpc/server/fetch';
import { authContract } from '@netscript/plugin-auth-core/contracts/v1';

Deno.test('setup is idempotent, credentials stay private and workspace metadata contains no secret', async () => {
  const one = await secretWorkspace();
  const two = await secretWorkspace();
  const previous = Deno.env.get('STREAMS_SECRET');
  try {
    const first = await Deno.readTextFile(one.secretPath);
    assert(
      first !== await Deno.readTextFile(two.secretPath),
      'Different workspaces must use different credentials',
    );
    await provisionShowcaseStreams(one.root);
    assert(
      first === await Deno.readTextFile(one.secretPath),
      'Repeated setup must retain the credential',
    );
    const info = await Deno.lstat(one.secretPath);
    assertEquals(info.mode! & 0o777, 0o600);
    assertEquals((await Deno.stat(join(Deno.env.get('HOME')!, '.secrets'))).mode! & 0o777, 0o700);
    const metadata = await Deno.readTextFile(join(one.root, SHOWCASE_STREAMS_METADATA));
    assert(!metadata.includes(first), 'Metadata must contain no credential');
    assertEquals(Object.keys(JSON.parse(metadata)).sort(), ['secretFile', 'version']);
    assert((await Deno.stat(join(one.root, '.data', 'streams'))).isDirectory);
    await initializeShowcaseStreamSecret(one.root);
    assert(
      Deno.env.get('STREAMS_SECRET') === first,
      'The app must initialize the matching framework credential',
    );
  } finally {
    if (previous === undefined) Deno.env.delete('STREAMS_SECRET');
    else Deno.env.set('STREAMS_SECRET', previous);
    await one.close();
    await two.close();
  }
});

Deno.test('runtime refuses missing, permissive, symlinked or cross-workspace secret references', async () => {
  const workspace = await secretWorkspace();
  const other = await secretWorkspace();
  const metadataPath = join(workspace.root, SHOWCASE_STREAMS_METADATA);
  const original = await Deno.readTextFile(metadataPath);
  try {
    await Deno.remove(metadataPath);
    await assertRejects(() => initializeShowcaseStreamSecret(workspace.root));
    await Deno.writeTextFile(
      metadataPath,
      await Deno.readTextFile(join(other.root, SHOWCASE_STREAMS_METADATA)),
    );
    await assertRejects(() => initializeShowcaseStreamSecret(workspace.root));
    await Deno.writeTextFile(metadataPath, original);
    await Deno.remove(metadataPath);
    await Deno.symlink(other.secretPath, metadataPath);
    await assertRejects(() => initializeShowcaseStreamSecret(workspace.root));
    await assertRejects(() => provisionShowcaseStreams(workspace.root));
    await Deno.remove(metadataPath);
    await Deno.writeTextFile(metadataPath, original);
    await Deno.chmod(workspace.secretPath, 0o644);
    await assertRejects(() => initializeShowcaseStreamSecret(workspace.root));
    await Deno.chmod(workspace.secretPath, 0o600);
    await Deno.remove(workspace.secretPath);
    await Deno.symlink(other.secretPath, workspace.secretPath);
    await assertRejects(() => initializeShowcaseStreamSecret(workspace.root));
  } finally {
    await workspace.close();
    await other.close();
  }
});

Deno.test('no model key returns provider state before secret setup, BFF or any service call', async () => {
  const keys = ['ANTHROPIC_API_KEY', 'ANTHROPIC_AUTH_TOKEN', 'ANTHROPIC_OAUTH_TOKEN'];
  const previous = keys.map((key) => Deno.env.get(key));
  const root = await Deno.makeTempDir({ prefix: 'showcase-no-key-' });
  await Deno.remove(root);
  try {
    for (const key of keys) Deno.env.delete(key);
    assertEquals(await readShowcaseChat(root, new Request('https://app.test/ai')), {
      state: 'connect-provider',
    });
    await assertRejects(() => Deno.stat(root));
  } finally {
    keys.forEach((key, index) => {
      if (previous[index] === undefined) Deno.env.delete(key);
      else Deno.env.set(key, previous[index]!);
    });
  }
});

Deno.test('actual generated BFF verifies browser cookie for chat/MCP POST and rejects forged subjects', async () => {
  const workspace = await secretWorkspace();
  const saved = new Map(
    ['services__auth-api__http__0', 'ANTHROPIC_API_KEY', 'DURABLE_STREAMS_URL', 'STREAMS_SECRET']
      .map((key) => [key, Deno.env.get(key)]),
  );
  const rpc = implement(authContract).$context<{ authorization: string | null }>();
  let verifiedCalls = 0;
  const handler = new RPCHandler({
    v1: {
      auth: {
        session: rpc.session.handler(({ context }) => {
          verifiedCalls++;
          if (context.authorization !== 'Bearer fixture-session') return { authenticated: false };
          return {
            authenticated: true,
            session: {
              id: 'fixture-session',
              userId: 'alice',
              subject: 'verified:alice',
              providerId: 'fixture',
              state: 'active' as const,
              scopes: [],
              roles: [],
              claims: {},
              issuedAt: new Date().toISOString(),
              expiresAt: new Date(Date.now() + 3600_000).toISOString(),
            },
          };
        }),
      },
    },
  });
  const auth = Deno.serve({ port: 0, onListen() {} }, async (request) => {
    const result = await handler.handle(request, {
      prefix: '/api/rpc',
      context: { authorization: request.headers.get('authorization') },
    });
    return result.response ?? new Response(null, { status: 404 });
  });
  const streams = Deno.serve({ port: 0, onListen() {} }, () => new Response(null, { status: 401 }));
  try {
    await Deno.mkdir(join(workspace.root, 'auth'));
    await Deno.copyFile('./fixtures/auth-bff.ts', join(workspace.root, 'auth/bff.ts'));
    Deno.env.set('services__auth-api__http__0', `http://127.0.0.1:${auth.addr.port}`);
    Deno.env.set('ANTHROPIC_API_KEY', 'stub-never-sent');
    Deno.env.set('DURABLE_STREAMS_URL', `http://127.0.0.1:${streams.addr.port}`);
    const make = (credential: string) =>
      new Request('https://app.test/api/showcase/chat', {
        method: 'POST',
        headers: {
          origin: 'https://app.test',
          cookie: `__Host-ns_session=${credential}`,
          'x-user-id': 'verified:alice',
          'content-type': 'application/json',
        },
        body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'tools/list' }),
      });
    assertEquals((await handleShowcaseChat(workspace.root, make('forged'), 'mcp')).status, 401);
    assertEquals((await handleShowcaseChat(workspace.root, make('forged'), 'threads')).status, 401);
    const request = make('fixture-session');
    request.headers.set('accept', 'application/json, text/event-stream');
    request.headers.set('mcp-protocol-version', '2025-11-25');
    const response = await handleShowcaseChat(workspace.root, request, 'mcp');
    assertEquals(response.status, 200);
    assertStringIncludes(await response.text(), 'northwind_list_orders');
    assert(verifiedCalls >= 3, 'Production BFF must verify each browser request through auth RPC');
  } finally {
    await auth.shutdown();
    await streams.shutdown();
    for (const [key, value] of saved) {
      if (value === undefined) Deno.env.delete(key);
      else Deno.env.set(key, value);
    }
    await workspace.close();
  }
});

Deno.test('native private streams host protects chat, retains public prefixes and persists across process restart', async () => {
  const workspace = await secretWorkspace();
  try {
    for (const mode of ['write', 'replay']) {
      const child = new Deno.Command(Deno.execPath(), {
        args: [
          'run',
          '--allow-all',
          '--no-lock',
          '--node-modules-dir=none',
          'native-host-probe.ts',
          workspace.root,
          mode,
        ],
        stdout: 'piped',
        stderr: 'piped',
      }).spawn();
      const deadline = setTimeout(() => child.kill('SIGKILL'), 45_000);
      let result;
      try {
        result = await child.output();
      } finally {
        clearTimeout(deadline);
      }
      // Native diagnostics may carry request headers; redact the credential before exposing any failure.
      const credential = await Deno.readTextFile(workspace.secretPath);
      const output = new TextDecoder().decode(result.stdout);
      const errors = new TextDecoder().decode(result.stderr);
      assert(
        !output.includes(credential) && !errors.includes(credential),
        'Native host must never log its credential',
      );
      const diagnostic = errors
        .replaceAll(credential, '<credential>')
        .replace(/[a-f0-9]{64}/g, '<hash>').slice(-5000);
      assertEquals(
        result.code,
        0,
        `Native ${mode} probe failed: ${diagnostic}`,
      );
      assertStringIncludes(output, 'SHOWCASE_NATIVE_PASS');
    }
  } finally {
    await workspace.close();
  }
});
