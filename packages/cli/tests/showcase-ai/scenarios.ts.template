Deno.test('chronological thread access retains more than 50 random-order IDs with a stable tie break', async () => {
  const kv = await Deno.openKv(':memory:');
  try {
    const threads = Array.from({ length: 62 }, (_, index) => ({
      id: `${(99 - index).toString(16).padStart(8, '0')}-0000-4000-8000-000000000000`,
      title: `Conversation ${index}`,
      createdAt: new Date(Date.UTC(2026, 0, 1) + index * 1000).toISOString(),
    }));
    threads.push(...['00000001', '00000002'].map((prefix) => ({
      id: `${prefix}-0000-4000-8000-000000000000`,
      title: 'Latest timestamp tie',
      createdAt: '2026-02-01T00:00:00.000Z',
    })));
    const scope = ['showcase', 'northwind', 'portal', 'chat'];
    for (const thread of threads) {
      await kv.set([...scope, 'owner', 'alice', thread.id], thread);
      await kv.set([...scope, 'thread', thread.id], { owner: 'alice', thread });
    }
    await kv.set([...scope, 'owner', 'bob', 'foreign'], {
      id: 'foreign',
      title: 'Another owner',
      createdAt: '2027-01-01T00:00:00.000Z',
    });
    const store = createThreadStore(kv);
    // Both newest IDs sort below all older IDs; tied timestamps use ascending ID order.
    const expected = [threads[62], threads[63], ...threads.slice(0, 62).reverse()];
    const actual = await store.list('alice');
    assertEquals(actual.length, 64, 'No conversation may disappear because of UUID scan order');
    assertEquals(actual.map((thread) => thread.id), expected.map((thread) => thread.id));
    assertEquals(
      (await store.list('alice')).map((thread) => thread.id),
      actual.map((thread) => thread.id),
    );
    assertEquals((await store.list('bob')).map((thread) => thread.id), ['foreign']);
    assertEquals(await store.list('unknown'), []);
  } finally {
    kv.close();
  }
});

const order = {
  id: 12,
  reference: 'NW-00012',
  name: 'Northwind order',
  ownerName: 'Alfreds',
  ownerEmail: 'orders@example.test',
  status: 'awaiting_payment' as const,
  amount: 12345,
  currency: 'USD',
  createdAt: '2026-01-01',
  updatedAt: '2026-01-01',
};
const calls: Array<{ method: string; input: unknown; signal?: AbortSignal }> = [];
const reader: OrdersReader = {
  list(input, options) {
    calls.push({ method: 'list', input, signal: options?.context?.signal });
    return Promise.resolve({
      data: [order],
      pagination: { page: 1, limit: 10, total: 1, totalPages: 1, hasNext: false, hasPrev: false },
    });
  },
  getById(input, options) {
    calls.push({ method: 'getById', input, signal: options?.context?.signal });
    return Promise.resolve(order);
  },
};
const request = (method: string, body?: unknown, owner = 'alice', origin = 'https://app.test') =>
  new Request('https://app.test/api/showcase/chat', {
    method,
    headers: { origin, 'content-type': 'application/json', cookie: `verified=${owner}` },
    body: body === undefined ? undefined : JSON.stringify(body),
  });
const turn = (text: string) => ({ messages: [], data: { text } });

async function sandbox(configured = true) {
  const streams = new Map<string, unknown[]>();
  let accesses = 0;
  const server = Deno.serve({ hostname: '127.0.0.1', port: 0, onListen() {} }, async (req) => {
    accesses++;
    const path = new URL(req.url).pathname;
    if (!req.headers.has('authorization')) return new Response(null, { status: 401 });
    const chunks = streams.get(path) ?? [];
    if (req.method === 'PUT') {
      streams.set(path, chunks);
      return new Response(null, { status: 201 });
    }
    if (req.method === 'POST') {
      const body: unknown = await req.json();
      chunks.push(...(Array.isArray(body) ? body : [body]));
      streams.set(path, chunks);
      return new Response(null, {
        status: 204,
        headers: { 'Stream-Next-Offset': String(chunks.length) },
      });
    }
    return Response.json(chunks, {
      headers: { 'Stream-Next-Offset': String(chunks.length), 'Stream-Up-To-Date': 'true' },
    });
  });
  const url = `http://127.0.0.1:${server.addr.port}`;
  const oldUrl = Deno.env.get('DURABLE_STREAMS_URL');
  const oldSecret = Deno.env.get('STREAMS_SECRET');
  Deno.env.set('DURABLE_STREAMS_URL', url);
  Deno.env.set('STREAMS_SECRET', 'stub-stream-secret');
  const path = await Deno.makeTempDir({ prefix: 'showcase-chat-state-' });
  let kv = await Deno.openKv(`${path}/chat.kv`);
  const provider = createFakeChatModelProvider('stub', [
    [{
      type: 'tool-call',
      toolCall: { id: 'call-1', name: 'northwind_get_order', arguments: '{"id":12}' },
    }, { type: 'finish', finishReason: 'tool-calls' }],
    [{ type: 'text', delta: 'Order NW-00012 is awaiting payment.' }, {
      type: 'finish',
      finishReason: 'stop',
    }],
    [{ type: 'text', delta: 'The same order totals USD 123.45.' }, {
      type: 'finish',
      finishReason: 'stop',
    }],
  ]);
  let providerCalls = 0;
  function runtime() {
    return createShowcaseChat({
      store: createThreadStore(kv),
      configured: () => configured,
      authenticate: async (req) => req.headers.get('cookie')?.match(/^verified=(alice|bob)$/)?.[1],
      provider: async () => {
        providerCalls++;
        return { provider, model: 'stub-model' };
      },
      tools: (signal) => northwindTools(signal, reader),
      target: (sessionId) => ({ sessionId, baseUrl: url }),
    });
  }
  return {
    runtime,
    provider,
    get kv() {
      return kv;
    },
    streams,
    url,
    get accesses() {
      return accesses;
    },
    get providerCalls() {
      return providerCalls;
    },
    async reopen() {
      kv.close();
      kv = await Deno.openKv(`${path}/chat.kv`);
    },
    async close() {
      kv.close();
      await server.shutdown();
      await Deno.remove(path, { recursive: true });
      for (
        const [key, value] of [['DURABLE_STREAMS_URL', oldUrl], [
          'STREAMS_SECRET',
          oldSecret,
        ]] as const
      ) {
        if (value === undefined) Deno.env.delete(key);
        else Deno.env.set(key, value);
      }
    },
  };
}

