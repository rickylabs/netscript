Deno.test('KV ownership and turn leases survive reopen and reject simultaneous writers', async () => {
  const s = await sandbox();
  try {
    const store = createThreadStore(s.kv);
    const thread = await store.create('alice');
    const claims = await Promise.all([store.claim(thread.id), store.claim(thread.id)]);
    assertEquals(claims.filter(Boolean).length, 1);
    const claim = claims.find((value) => value !== undefined)!;
    await store.release(thread.id, 'wrong-token');
    assertEquals(await store.claim(thread.id), undefined);
    assertEquals((await s.runtime().session(request('POST', turn('hi')), thread.id)).status, 409);
    await s.reopen();
    const reopened = createThreadStore(s.kv);
    assert(await reopened.owns('alice', thread.id));
    assert(!await reopened.owns('bob', thread.id));
    assertEquals((await reopened.list('alice'))[0].id, thread.id);
    await reopened.release(thread.id, claim);
    assert(await reopened.claim(thread.id));
  } finally {
    await s.close();
  }
});

Deno.test('MCP exposes only typed live order reads, validates bounds and propagates cancellation', async () => {
  calls.length = 0;
  const abort = new AbortController();
  const mcp = await northwindTools(abort.signal, reader);
  assertEquals(mcp.registry.list().map((tool) => tool.name), [
    'northwind_list_orders',
    'northwind_get_order',
  ]);
  const result = await mcp.registry.dispatch('northwind_list_orders', {
    status: 'awaiting_payment',
    search: 'Alfreds',
  });
  assertStringIncludes(JSON.stringify(result.output), 'NW-00012');
  assertEquals(calls[0].input, {
    page: 1,
    limit: 10,
    status: 'awaiting_payment',
    search: 'Alfreds',
    sortOrder: 'desc',
    sortBy: 'createdAt',
  });
  assertEquals(calls[0].signal, abort.signal);
  await mcp.registry.dispatch('northwind_get_order', { id: 12 });
  assertEquals(calls[1].input, { id: 12 });
  for (
    const input of [{ limit: 21 }, { page: 0 }, { status: 'imaginary' }, {
      search: 'x'.repeat(201),
    }, { userId: 'bob' }]
  ) await assertRejects(() => mcp.registry.dispatch('northwind_list_orders', input));
  await assertRejects(() => mcp.registry.dispatch('northwind_get_order', { id: -1 }));
  const count = calls.length;
  abort.abort();
  await assertRejects(() => mcp.registry.dispatch('northwind_get_order', { id: 12 }));
  assertEquals(calls.length, count);
});

Deno.test('actual MCP HTTP tools/list and tools/call use the same Northwind implementations', async () => {
  const s = await sandbox();
  try {
    const rpc = (method: string, params?: unknown) => {
      const req = request('POST', { jsonrpc: '2.0', id: 1, method, params });
      req.headers.set('accept', 'application/json, text/event-stream');
      req.headers.set('mcp-protocol-version', '2025-11-25');
      return req;
    };
    const list = await s.runtime().mcp(rpc('tools/list'));
    assertEquals(list.status, 200);
    const listed = await list.text();
    assertStringIncludes(listed, 'northwind_get_order');
    assert(!listed.includes('northwind_delete'));
    const get = await s.runtime().mcp(
      rpc('tools/call', { name: 'northwind_get_order', arguments: { id: 12 } }),
    );
    assertEquals(get.status, 200);
    assertStringIncludes(await get.text(), 'NW-00012');
    const bad = await s.runtime().mcp(
      rpc('tools/call', { name: 'northwind_get_order', arguments: { id: -1 } }),
    );
    assertStringIncludes(await bad.text(), 'error');
  } finally {
    await s.close();
  }
});

Deno.test('configured stub: real durable writer, replay, tool cards, reload and server-owned history', async () => {
  const s = await sandbox();
  calls.length = 0;
  try {
    const response = await s.runtime().threads(request('POST'));
    assertEquals(response.status, 201);
    const { thread } = await response.json();
    const sent = await s.runtime().session(
      request('POST', turn('What is the status of order 12?')),
      thread.id,
    );
    assertEquals(sent.status, 200);
    await sent.body?.cancel();
    const snapshot = await resolveChatSnapshot({
      target: { sessionId: thread.id, baseUrl: s.url },
      streamPath: CHAT_STREAM_PATH,
    });
    assertStringIncludes(JSON.stringify(snapshot.messages), 'Order NW-00012 is awaiting payment.');
    const tool = snapshot.renderParts.find((part) => part.kind === 'tool');
    assert(tool, JSON.stringify(snapshot));
    assertEquals(tool.toolName, 'northwind_get_order');
    assertEquals(tool.toolState, 'complete');
    assertStringIncludes(JSON.stringify(tool.output), 'NW-00012');
    assertEquals(calls[0].method, 'getById');
    const chunks = [...s.streams.values()].flat();
    const live = new StreamProcessor();
    // Replay through the public connection seam's native-message extension is tested by the framework.
    // These ordinary wire chunks plus the native user echo materialize through the same upstream reducer.
    for (const chunk of chunks) live.processChunk(chunk as StreamChunk);
    assertEquals(projectChatSnapshot(live.getMessages()).renderParts, snapshot.renderParts);
    await s.reopen();
    assertEquals((await s.runtime().threads(request('GET'))).status, 200);
    const again = await s.runtime().session(request('POST', turn('What is its total?')), thread.id);
    assertEquals(again.status, 200);
    await again.body?.cancel();
    const history = s.provider.requests.at(-1)!.messages;
    assert(
      history.some((message) =>
        message.role === 'user' && message.content === 'What is the status of order 12?'
      ),
      JSON.stringify(history),
    );
    assert(
      history.some((message) =>
        message.role === 'tool' && typeof message.content === 'string' &&
        message.content.includes('NW-00012')
      ),
      JSON.stringify(history),
    );
    assertEquals(
      history.filter((message) => message.role === 'user').at(-1)!.content,
      'What is its total?',
    );
    assertEquals(
      (await s.runtime().session(request('GET', undefined, 'bob'), thread.id)).status,
      404,
    );
    const proxy = await s.runtime().session(request('GET'), thread.id);
    assertEquals(proxy.status, 200);
    assertStringIncludes(await proxy.text(), 'NW-00012');
  } finally {
    await s.close();
  }
});

Deno.test('provider detection uses existing model config and never accepts an arbitrary test provider', () => {
