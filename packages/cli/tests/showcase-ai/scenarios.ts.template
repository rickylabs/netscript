Deno.test('typed orders client discovers orders and calls the actual v1.orders RPC path', async () => {
  const bound = implement(OrdersContractV1);
  const handler = new RPCHandler({
    v1: {
      orders: {
        list: bound.list.handler(({ input }) => reader.list(input)),
        getById: bound.getById.handler(({ input }) => reader.getById(input)),
      },
    },
  });
  const paths: string[] = [];
  const server = Deno.serve({ port: 0, onListen() {} }, async (req) => {
    paths.push(new URL(req.url).pathname);
    const handled = await handler.handle(req, { prefix: '/api/rpc' });
    return handled.response ?? new Response(null, { status: 404 });
  });
  const key = 'services__orders__http__0';
  const old = Deno.env.get(key);
  Deno.env.set(key, `http://127.0.0.1:${server.addr.port}`);
  try {
    const tools = await northwindTools(new AbortController().signal);
    const one = await tools.registry.dispatch('northwind_get_order', { id: 12 });
    assertStringIncludes(JSON.stringify(one.output), 'NW-00012');
    await tools.registry.dispatch('northwind_list_orders', { limit: 10 });
    assertEquals(paths, ['/api/rpc/v1/orders/getById', '/api/rpc/v1/orders/list']);
  } finally {
    await server.shutdown();
    if (old === undefined) Deno.env.delete(key);
    else Deno.env.set(key, old);
  }
});

