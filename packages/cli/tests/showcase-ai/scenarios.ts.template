Deno.test('native runtime uses verified BFF subject, fails closed for absent/broken auth and ignores user headers', async () => {
  const s = await sandbox();
  const workspace = await secretWorkspace();
  const root = workspace.root;
  const oldKey = Deno.env.get('ANTHROPIC_API_KEY');
  try {
    Deno.env.set('ANTHROPIC_API_KEY', 'stub-never-sent');
    assertEquals(await readShowcaseChat(root, request('GET')), { state: 'sign-in' });
    assertEquals((await handleShowcaseChat(root, request('POST'), 'threads')).status, 401);
    await Deno.mkdir(`${root}/auth`);
    await Deno.writeTextFile(
      `${root}/auth/bff.ts`,
      `export async function handleBrowserAuth(request: Request) {
      const cookie = request.headers.get('cookie');
      if (cookie === 'verified=broken') return new Response(null, { status: 503 });
      return Response.json({ authenticated: cookie === 'verified=alice', subject: cookie === 'verified=alice' ? 'upstream-verified-subject' : undefined });
    }`,
    );
    const forged = request('GET', undefined, '');
    forged.headers.set('x-user-id', 'upstream-verified-subject');
    assertEquals(await readShowcaseChat(root, forged), { state: 'sign-in' });
    assertEquals(await readShowcaseChat(root, request('GET', undefined, 'broken')), {
      state: 'unavailable',
    });
    assertEquals((await readShowcaseChat(root, request('GET'))).state, 'ready');
    const page = await readShowcaseChat(root, request('GET'));
    assert(!JSON.stringify(page).includes('upstream-verified-subject'));
  } finally {
    if (oldKey === undefined) Deno.env.delete('ANTHROPIC_API_KEY');
    else Deno.env.set('ANTHROPIC_API_KEY', oldKey);
    await s.close();
    await workspace.close();
  }
});

