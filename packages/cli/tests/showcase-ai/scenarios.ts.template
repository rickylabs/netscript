Deno.test('CSRF, cross-user IDs and upstream mutation attempts are denied before IO', async () => {
  const s = await sandbox();
  try {
    const thread = await createThreadStore(s.kv).create('alice');
    assertEquals(
      (await s.runtime().threads(request('POST', undefined, 'alice', 'https://evil.test'))).status,
      403,
    );
    for (const method of ['GET', 'POST']) {
      assertEquals(
        (await s.runtime().session(
          request(method, method === 'POST' ? turn('hi') : undefined, 'bob'),
          thread.id,
        )).status,
        404,
      );
    }
    for (const method of ['PUT', 'DELETE', 'PATCH']) {
      assertEquals((await s.runtime().session(request(method), thread.id)).status, 405);
    }
    assertEquals(
      (await s.runtime().mcp(request('POST', {}, 'alice', 'https://evil.test'))).status,
      403,
    );
    assertEquals((await s.runtime().threads(request('GET', undefined, 'bob'))).status, 200);
    assertEquals(s.accesses, 0);
    assertEquals(s.providerCalls, 0);
  } finally {
    await s.close();
  }
});

