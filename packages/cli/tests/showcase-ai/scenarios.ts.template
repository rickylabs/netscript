Deno.test('disconnect cancellation reaches the provider and releases the active turn', async () => {
  const s = await sandbox();
  const started = Promise.withResolvers<void>();
  let providerSignal: AbortSignal | undefined;
  try {
    const runtime = createShowcaseChat({
      store: createThreadStore(s.kv),
      configured: () => true,
      authenticate: async () => 'alice',
      provider: async () => ({
        model: 'stub',
        provider: {
          id: 'stub',
          createChatClient: () => ({
            kind: 'text',
            name: 'stub',
            async *stream(_input, options) {
              providerSignal = options?.signal;
              started.resolve();
              await new Promise<void>((resolve) =>
                providerSignal!.addEventListener('abort', () => resolve(), { once: true })
              );
              yield { type: 'finish' as const };
            },
          }),
        },
      }),
      tools: (signal) => northwindTools(signal, reader),
      target: (sessionId) => ({ sessionId, baseUrl: s.url }),
    });
    const thread = await createThreadStore(s.kv).create('alice');
    const abort = new AbortController();
    const pending = runtime.session(
      new Request(request('POST', turn('Wait for cancellation')), { signal: abort.signal }),
      thread.id,
    );
    await started.promise;
    abort.abort();
    const response = await pending;
    await response.body?.cancel();
    assert(providerSignal?.aborted);
    assert(await createThreadStore(s.kv).claim(thread.id));
  } finally {
    await s.close();
  }
});
