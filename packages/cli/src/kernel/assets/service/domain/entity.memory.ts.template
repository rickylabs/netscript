import type { {{serviceName | pascalCase}}ListInputV1 } from '@{{projectName}}/contracts';

/** Pure {{serviceName}} list and lifecycle policy. */
export type ListInput = {{serviceName | pascalCase}}ListInputV1;

export function listQuery(input: ListInput) {
  return { ...input, search: input.search?.trim().toLowerCase(), sortBy: input.sortBy ?? 'createdAt', sortOrder: input.sortOrder ?? 'desc' };
}

export function listResult<T>(input: ListInput, items: T[], total: number) {
  return { items, total, limit: input.limit, offset: input.offset, hasMore: input.offset + input.limit < total };
}

export function statusSummary(status: NonNullable<ListInput['status']>): string {
  return `Status changed to ${status.replaceAll('_', ' ')} through the typed service.`;
}
