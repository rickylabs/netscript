import { create{{serviceName | pascalCase}}Application } from './{{entityName}}.ts';
import { createMemory{{serviceName | pascalCase}}Repository } from '../adapters/memory-{{entityName}}-repository.ts';

Deno.test('{{serviceName}} use-cases page, search and update instance-owned records', async () => {
  const application = create{{serviceName | pascalCase}}Application(createMemory{{serviceName | pascalCase}}Repository());
  const first = await application.list({ offset: 0, limit: 1, search: ' INTEGRATION ' });
  if (first.items.length !== 1 || first.total !== 5 || !first.hasMore) {
    throw new Error('Unexpected searched page');
  }
  const updated = await application.updateStatus({ id: first.items[0].id, status: 'cancelled' });
  if (!updated || updated.status !== 'cancelled' || first.items[0].status !== 'awaiting_payment') {
    throw new Error('Repository must return snapshots');
  }
  const fresh = create{{serviceName | pascalCase}}Application(createMemory{{serviceName | pascalCase}}Repository());
  const page = await fresh.list({ offset: 0, limit: 1 });
  if (page.items[0].status !== 'paid' || !page.hasMore) throw new Error('Instances must be isolated');
});
