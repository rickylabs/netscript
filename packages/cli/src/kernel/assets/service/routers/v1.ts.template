/** Thin {{serviceName}} contract bindings for v1. */
import { notFound } from '@netscript/contracts';
import type { ServiceHandlerContext } from '@netscript/service';
import { v1 } from '@{{projectName}}/contracts';
import type { {{serviceName | pascalCase}}Application } from '../application/{{entityName}}.ts';

/** Only verified identity claims may name an event actor. */
function actor(context: ServiceHandlerContext) {
  const principal = context.principal;
  if (!principal) return { name: 'Anonymous', kind: 'anonymous' as const };
  return { name: typeof principal.claims.name === 'string' && principal.claims.name.trim() ? principal.claims.name : principal.subject, kind: 'authenticated' as const };
}

export function create{{serviceName | pascalCase}}V1(application: {{serviceName | pascalCase}}Application) {
  return {
    session: v1.{{serviceName | camelCase}}.$context<ServiceHandlerContext>().session
      .handler(({ context }) => ({ authenticated: Boolean(context.principal) })),
    list: v1.{{serviceName | camelCase}}.list.handler(({ input }) => application.list(input)),
    getById: v1.{{serviceName | camelCase}}.getById.handler(async ({ input, errors }) => {
      const record = await application.getById(input.id);
      if (!record) {
        notFound({ errors, resourceId: input.id, message: `{{modelName}} ${input.id} not found` });
      }
      return record;
    }),
    create: v1.{{serviceName | camelCase}}.$context<ServiceHandlerContext>().create.handler(({ input, context }) => application.create(input, actor(context))),
    update: v1.{{serviceName | camelCase}}.$context<ServiceHandlerContext>().update.handler(async ({ input, errors, context }) => {
      const record = await application.update(input.id, input.data, actor(context));
      if (!record) {
        notFound({ errors, resourceId: input.id, message: `{{modelName}} ${input.id} not found` });
      }
      return record;
    }),
    delete: v1.{{serviceName | camelCase}}.delete.handler(async ({ input, errors }) => {
      const record = await application.delete(input.id);
      if (!record) {
        notFound({ errors, resourceId: input.id, message: `{{modelName}} ${input.id} not found` });
      }
      return record;
    }),
  };
}
