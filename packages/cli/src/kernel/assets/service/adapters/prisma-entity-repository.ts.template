/** Prisma implementation of the {{modelName}} repository port. */
import { {{serviceName | pascalCase}}{{modelName}}SchemaV1 as entitySchema } from '../../../../contracts/versions/v1/{{serviceName}}.contract.ts';
import type { PrismaClient } from '@database';
import type { {{serviceName | pascalCase}}Repository } from '../application/{{entityName}}.ts';

type Delegate = PrismaClient['{{modelName | camelCase}}'];
type FindManyArgs = NonNullable<Parameters<Delegate['findMany']>[0]>;

async function missingAsNull<T>(operation: () => Promise<T>): Promise<T | null> {
  try {
    return await operation();
  } catch (error) {
    if (typeof error === 'object' && error !== null && 'code' in error && error.code === 'P2025') {
      return null;
    }
    throw error;
  }
}

export function createPrisma{{serviceName | pascalCase}}Repository(database: PrismaClient): {{serviceName | pascalCase}}Repository {
  const delegate = database.{{modelName | camelCase}};
  return {
    async list(query) {
      const args = query satisfies FindManyArgs;
      const [data, total] = await Promise.all([delegate.findMany(args), delegate.count({ where: query.where })]);
      return { data: data.map((row) => entitySchema.parse(row)), total };
    },
    async getById(id) {
      const row = await delegate.findUnique({ where: { id } });
      return row ? entitySchema.parse(row) : null;
    },
    async create(input) { return entitySchema.parse(await delegate.create({ data: input })); },
    update: (id, input) => missingAsNull(async () => entitySchema.parse(await delegate.update({ where: { id }, data: input }))),
    delete: (id) => missingAsNull(async () => entitySchema.parse(await delegate.delete({ where: { id } }))),
  };
}
