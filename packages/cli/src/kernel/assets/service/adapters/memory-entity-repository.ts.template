/** Instance-owned memory repository populated from the same sample as database seeds. */
import type { {{serviceName | pascalCase}}ListItemV1 } from '@{{projectName}}/contracts';
import type { {{serviceName | pascalCase}}Repository } from '../application/{{entityName}}.ts';
import { createSampleRecords } from './sample-records.ts';

export function createMemory{{serviceName | pascalCase}}Repository(): {{serviceName | pascalCase}}Repository {
  const records: {{serviceName | pascalCase}}ListItemV1[] = createSampleRecords().map((row, index) => ({ ...row, id: index + 1, summary: `Workspace record owned by ${row.ownerName}.` }));
  return {
    list(query) {
      const filtered = records.filter((record) => (!query.search || record.name.toLowerCase().includes(query.search)) && (!query.status || record.status === query.status));
      const direction = query.sortOrder === 'asc' ? 1 : -1;
      filtered.sort((a, b) => {
        const left = a[query.sortBy];
        const right = b[query.sortBy];
        return direction * (left < right ? -1 : left > right ? 1 : a.id - b.id);
      });
      return Promise.resolve({ items: filtered.slice(query.offset, query.offset + query.limit).map((record) => ({ ...record })), total: filtered.length });
    },
    updateStatus(id, status, summary) {
      const record = records.find((entry) => entry.id === id);
      if (!record) return Promise.resolve(null);
      record.status = status;
      record.summary = summary;
      record.updatedAt = new Date().toISOString();
      return Promise.resolve({ ...record });
    },
  };
}
