/** Workspace-owned streams credential. Values exist only in the user's private secret file and server memory. */
import { join } from 'node:path';
import { findWorkspaceRoot } from '@netscript/config';

export const SHOWCASE_STREAMS_METADATA = '.netscript/showcase-streams.json';

async function secretPaths(root: string) {
  if (Deno.build.os === 'windows') {
    throw new Error('Showcase private streams require POSIX secret-file permissions');
  }
  const workspace = await Deno.realPath(root);
  const configuredUserHome = Deno.env.get('HOME');
  if (!configuredUserHome) throw new Error('The server user home directory is unavailable');
  const userHome = await Deno.realPath(configuredUserHome);
  const uid = (await Deno.stat(userHome)).uid;
  const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(workspace));
  const identity = Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0'))
    .join('');
  const secretFile = `netscript-showcase-${identity}.secret`;
  return {
    workspace,
    uid,
    secretFile,
    directory: join(userHome, '.secrets'),
    metadata: join(workspace, SHOWCASE_STREAMS_METADATA),
  };
}

/** Refuse symlinks and foreign ownership before enforcing private-directory permissions. */
async function privateDirectory(path: string, uid: number | null): Promise<void> {
  try {
    await Deno.mkdir(path, { mode: 0o700 });
  } catch (error) {
    if (!(error instanceof Deno.errors.AlreadyExists)) throw error;
  }
  const info = await Deno.lstat(path);
  if (!info.isDirectory || info.isSymlink || info.uid !== uid) {
    throw new Error('Unsafe showcase private directory');
  }
  await Deno.chmod(path, 0o700);
}

async function readSecret(paths: Awaited<ReturnType<typeof secretPaths>>): Promise<string> {
  const directory = await Deno.lstat(paths.directory);
  if (
    !directory.isDirectory || directory.isSymlink || directory.uid !== paths.uid ||
    (directory.mode! & 0o777) !== 0o700
  ) {
    throw new Error('Showcase secrets directory must be private (700)');
  }
  const path = join(paths.directory, paths.secretFile);
  const info = await Deno.lstat(path);
  if (
    !info.isFile || info.isSymlink || info.uid !== paths.uid || info.nlink !== 1 ||
    (info.mode! & 0o777) !== 0o600 || info.size !== 64
  ) {
    throw new Error('Showcase streams secret must be a private regular file (600)');
  }
  const value = await Deno.readTextFile(path);
  if (!/^[a-f0-9]{64}$/.test(value)) throw new Error('Invalid showcase streams credential');
  return value;
}

async function checkMetadataFile(
  paths: Awaited<ReturnType<typeof secretPaths>>,
  optional = false,
): Promise<void> {
  let info: Deno.FileInfo;
  try {
    info = await Deno.lstat(paths.metadata);
  } catch (error) {
    if (optional && error instanceof Deno.errors.NotFound) return;
    throw error;
  }
  if (!info.isFile || info.isSymlink || info.uid !== paths.uid || info.size > 1024) {
    throw new Error('Unsafe showcase streams metadata');
  }
}

/** Setup-only provisioning: never returns or prints the credential and never rotates an existing one. */
export async function provisionShowcaseStreams(root: string): Promise<void> {
  const paths = await secretPaths(root);
  await privateDirectory(paths.directory, paths.uid);
  const secretPath = join(paths.directory, paths.secretFile);
  try {
    const bytes = crypto.getRandomValues(new Uint8Array(32));
    const secret = Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
    await Deno.writeTextFile(secretPath, secret, { createNew: true, mode: 0o600 });
  } catch (error) {
    if (!(error instanceof Deno.errors.AlreadyExists)) throw error;
  }
  await readSecret(paths);
  await Deno.mkdir(join(paths.workspace, '.netscript'), { recursive: true });
  await checkMetadataFile(paths, true);
  const metadata = { version: 1, secretFile: paths.secretFile };
  await Deno.writeTextFile(paths.metadata, JSON.stringify(metadata) + '\n');
  await Deno.mkdir(join(paths.workspace, '.data'), { recursive: true });
  await privateDirectory(join(paths.workspace, '.data', 'streams'), paths.uid);
}

/** Read only setup-provisioned credentials and initialize the framework's server-only auth seam. */
export async function initializeShowcaseStreamSecret(root: string): Promise<void> {
  const paths = await secretPaths(root);
  await checkMetadataFile(paths);
  let metadata: unknown;
  try {
    metadata = JSON.parse(await Deno.readTextFile(paths.metadata));
  } catch {
    throw new Error('Invalid showcase streams metadata; run showcase:setup');
  }
  if (
    !metadata || typeof metadata !== 'object' || !('version' in metadata) ||
    metadata.version !== 1 ||
    !('secretFile' in metadata) || metadata.secretFile !== paths.secretFile
  ) {
    throw new Error('Showcase streams setup does not match this workspace; run showcase:setup');
  }
  const secret = await readSecret(paths);
  Deno.env.set('STREAMS_SECRET', secret);
}

if (import.meta.main) {
  const root = await findWorkspaceRoot(Deno.cwd());
  if (!root) throw new Error('Run showcase streams setup from the generated workspace');
  await provisionShowcaseStreams(root);
}
