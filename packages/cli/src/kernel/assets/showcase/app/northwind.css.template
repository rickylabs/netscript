.northwind-table-scroll { overflow-x: auto; }
.northwind-table { width: 100%; border-collapse: collapse; text-align: left; }
.northwind-table th { padding: .75rem 1rem; font-size: .6875rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--ns-muted-fg); border-bottom: 1px solid var(--ns-border); }
.northwind-table td { padding: 1rem; border-bottom: 1px solid var(--ns-border); vertical-align: middle; font-size: .875rem; }
.northwind-table td:last-child, .northwind-table th:last-child { text-align: right; white-space: nowrap; }
.northwind-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; align-items: center; }
.northwind-actions form { margin: 0; }
[data-northwind-saga] .workspace-timeline time { display: block; margin-top: .375rem; }
.northwind-shipping { margin-top: 1rem; }
.workspace-record-pagination { position: static; }
.northwind-directory .ns-detail-layout { grid-template-columns: minmax(0, 1fr); }
@media (max-width: 640px) {
  .northwind-catalogue, .northwind-line-items { overflow: visible; }
  .northwind-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .northwind-table tbody, .northwind-table tr { display: block; }
  .northwind-table tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; padding-block: 1.25rem; border-bottom: 1px solid var(--ns-border); }
  .northwind-table td { display: flex; flex-direction: column; align-items: flex-start; gap: .375rem; min-width: 0; padding: 0; border: 0; }
  .northwind-table td:first-child { grid-column: 1 / -1; }
  .northwind-table td:first-child strong { font-size: 1rem; }
  .northwind-table td[data-label]::before { content: attr(data-label); font: 10px var(--ns-font-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--ns-muted-fg); }
  .northwind-table td:last-child { align-items: flex-start; text-align: left; }
  .northwind-table .workspace-owner { min-width: 0; }
  .northwind-table .workspace-record-description { overflow-wrap: anywhere; }
  .northwind-line-items .northwind-table tr { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .northwind-line-items .northwind-table td:not(:first-child) { white-space: nowrap; }
  .northwind-line-items .northwind-table td:nth-child(n+3) { align-items: flex-end; text-align: right; }
}
