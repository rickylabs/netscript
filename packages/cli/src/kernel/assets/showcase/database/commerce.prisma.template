
model Customer {
  id Int @id @default(autoincrement())
  email String @unique
  name String
  company String
  country String
  address String
  orders Order[]
}

model Product {
  id Int @id @default(autoincrement())
  sku String @unique
  name String
  category String
  price Int
  stock Int
  lines OrderLine[]
}

model OrderLine {
  id Int @id @default(autoincrement())
  orderId Int
  productId Int
  quantity Int
  unitPrice Int
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@unique([orderId, productId])
}
