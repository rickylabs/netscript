/** State displayed by a capability; installation alone never proves readiness. */
export type CapabilityState = 'absent' | 'installed-unwired' | 'ready' | 'empty' | 'unauthorized' | 'unavailable';

/** Safe capability metadata passed from server loaders to page views. */
export interface ScaffoldCapability {
  readonly id: string;
  readonly label: string;
  readonly items?: readonly { readonly label: string; readonly detail: string; readonly state?: string; readonly progress?: number | null; readonly timestamp?: string }[];
  readonly state: CapabilityState;
  readonly description: string;
  readonly command?: string;
}

/** Stable status labels and semantic tones for sample records. */
export const scaffoldStatuses = {
  pending: { label: 'Pending', tone: 'neutral', badgeVariant: 'muted' },
  awaiting_payment: { label: 'Awaiting payment', tone: 'warning', badgeVariant: 'warning' },
  paid: { label: 'Paid', tone: 'success', badgeVariant: 'success' },
  shipped: { label: 'Shipped', tone: 'info', badgeVariant: 'info' },
  refunded: { label: 'Refunded', tone: 'neutral', badgeVariant: 'muted' },
  cancelled: { label: 'Cancelled', tone: 'danger', badgeVariant: 'destructive' },
} as const;
export type ScaffoldStatus = keyof typeof scaffoldStatuses;

/** A presentation record projected from a typed service result. */
export interface ScaffoldRecord {
  readonly id: string;
  readonly name: string;
  readonly description: string;
  readonly reference: string;
  readonly ownerName: string;
  readonly ownerEmail: string;
  readonly status: ScaffoldStatus;
  /** Signed integer minor units; never add amounts with different currency codes. */
  readonly amount: number;
  readonly currency: string;
  readonly createdAt: string;
  readonly updatedAt: string;
  readonly fields: readonly { readonly label: string; readonly value: string }[];
}

/** A successful empty result is distinct from a failed or missing service. */
export interface ScaffoldRecords {
  readonly state: CapabilityState;
  readonly rows: readonly ScaffoldRecord[];
  readonly total?: number;
  readonly page?: number;
  readonly pageSize?: number;
  readonly hasNext?: boolean;
  /** Serialized list controls, preserved when navigating to another page. */
  readonly query?: Readonly<Record<string, string>>;
  readonly message: string;
  readonly command?: string;
}

/** Commands use the installed CLI's actual grammar. */
export const capabilityCommands = {
  service: 'netscript service add --name {{serviceName}} --with-client',
  auth: 'netscript plugin install auth --name auth',
  workers: 'netscript plugin install workers --name workers',
  streams: 'netscript plugin install streams --name streams',
  ai: 'netscript plugin install ai --name ai',
} as const;

/** A missing detail is distinct from an absent service or an unavailable lookup. */
export interface ScaffoldRecordDetail {
  readonly state: CapabilityState;
  readonly record?: ScaffoldRecord;
  readonly notFound?: boolean;
  readonly message: string;
  readonly command?: string;
}

/** List query vocabulary shared by both generated storage adapters. */
export const scaffoldSortFields = ['id', 'reference', 'name', 'ownerName', 'status', 'amount', 'currency', 'createdAt', 'updatedAt'] as const;

/** Parse supported table controls; invalid values fall back to the stable default sort. */
export function scaffoldRecordQuery(request: Request) {
  const params = new URL(request.url).searchParams;
  const rawPage = Number(params.get('page') ?? 1);
  const sortBy = scaffoldSortFields.find((field) => field === params.get('sortBy')) ?? 'createdAt';
  const status = (Object.keys(scaffoldStatuses) as ScaffoldStatus[]).find((value) => value === params.get('status'));
  const search = (params.get('search') ?? '').trim().slice(0, 200);
  return { ...(search ? { search } : {}), page: Number.isSafeInteger(rawPage) && rawPage > 0 ? rawPage : 1, sortBy, sortOrder: params.get('sortOrder') === 'asc' ? 'asc' as const : 'desc' as const, ...(status ? { status } : {}) };
}

/** Preserve the active server query when navigating the records table. */
export function scaffoldPageHref(base: string, records: ScaffoldRecords, page: number): string {
  return base + '?' + new URLSearchParams({ ...records.query, page: String(page) });
}

/** Negotiate the user's language without trusting malformed Accept-Language input. */
export function scaffoldLocale(request: Request): string | undefined {
  for (const part of (request.headers.get('accept-language') ?? '').split(',')) {
    const language = part.trim().split(';')[0];
    try { if (language && Intl.DateTimeFormat.supportedLocalesOf([language]).length) return language; } catch { /* Ignore invalid language tags. */ }
  }
  return undefined;
}

/** Format signed minor units using the currency's actual decimal precision. */
export function scaffoldAmount(amount: number, currency: string, locale?: string): string {
  const formatter = new Intl.NumberFormat(locale, { style: 'currency', currency });
  return formatter.format(amount / 10 ** (formatter.resolvedOptions().maximumFractionDigits ?? 2));
}

/** Dates are presented in the user's locale; invalid data never crashes a page. */
export function scaffoldDate(value: string, locale?: string, time = false): string {
  const date = new Date(value);
  return Number.isFinite(date.getTime()) ? new Intl.DateTimeFormat(locale, { dateStyle: 'medium', ...(time ? { timeStyle: 'short' as const } : {}), timeZone: 'UTC' }).format(date) : '—';
}

/** Owners without profile photos use their real name's initials. */
export function scaffoldInitials(name: string): string {
  return name.trim().split(/\s+/).filter(Boolean).slice(0, 2).map((part) => [...part][0]).join('').toLocaleUpperCase();
}

/** Counts use the actual singular form for one record. */
export function scaffoldRecordCount(count: number, locale?: string): string {
  return `${new Intl.NumberFormat(locale).format(count)} ${count === 1 ? 'record' : 'records'}`;
}
