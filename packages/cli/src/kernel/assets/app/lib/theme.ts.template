import configured from '@app/assets/theme-preset.json' with { type: 'json' };
import fonts from '@app/assets/fonts.json' with { type: 'json' };

/** Small metadata shared by the app shell and request-local design previews. */
export interface AppTheme {
  readonly id: string;
  readonly preset: {
    readonly language: string;
    readonly density: string;
    readonly flavor: string | null;
  };
  readonly label: string;
  readonly fontImports: readonly string[];
  readonly previewStylesheet?: string;
}

/** Preserve the existing NS One brand while naming generated language presets. */
export function themeLabel(id: string): string {
  return id === 'ns-one'
    ? 'NS One'
    : id.split('-').map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(' ');
}

/** Font requests are small metadata; the complete token catalog belongs to design routes. */
export function themeFontImports(id: string): readonly string[] {
  const imports: Readonly<Record<string, readonly string[]>> = fonts.imports;
  const result = imports[id];
  if (!result) throw new Error('Unknown configured token preset; run netscript tokens build');
  return result;
}

/** Production routes depend only on the configured preset and font requests. */
export function appTheme(): AppTheme {
  return {
    id: configured.id,
    preset: configured,
    label: themeLabel(configured.id),
    fontImports: themeFontImports(configured.id),
  };
}
