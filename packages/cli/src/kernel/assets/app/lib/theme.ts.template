import manifest from '@app/assets/tokens.json' with { type: 'json' };
import configured from '@app/assets/theme-preset.json' with { type: 'json' };
import fonts from '@app/assets/fonts.json' with { type: 'json' };

type PresetId = keyof typeof manifest.presets;

/** Preserve the existing NS One brand while naming generated language presets. */
export function themeLabel(id: string): string {
  return id === 'ns-one'
    ? 'NS One'
    : id.split('-').map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(' ');
}

/** Only development design routes may request a different generated language preset. */
export function appTheme(url: URL) {
  const requested = url.pathname.startsWith('/design/') ? url.searchParams.get('preset') : null;
  const id = requested && Object.hasOwn(manifest.presets, requested)
    ? requested as PresetId
    : configured.id as PresetId;
  const preset = manifest.presets[id];
  if (!preset) throw new Error('Unknown configured token preset; run netscript tokens build');
  return {
    id,
    preset,
    label: themeLabel(id),
    fontImports: fonts.imports[id],
    previewStylesheet: id === configured.id ? undefined : `/presets/${id}.css`,
  };
}
