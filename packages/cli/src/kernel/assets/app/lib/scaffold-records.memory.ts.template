// Server-only typed adapter for the generated memory service.
import { {{serviceName | camelCase}}Contract as contract, {{serviceName | camelCase}}Name as serviceName, {{serviceName | camelCase}}RouterName as routerName } from '{{serviceQueryModule}}';
import { scaffoldStatuses, scaffoldRecordQuery, type ScaffoldRecord, type ScaffoldRecordDetail, type ScaffoldRecords } from './scaffold-contract.ts';
import { scaffoldReadFailure, scaffoldServiceClient } from './scaffold-service-context.ts';

const PAGE_SIZE = 25;
const DETAIL_PAGE_LIMIT = 20;
type Client = Awaited<ReturnType<typeof clientFor>>['client'];
type Row = Awaited<ReturnType<Client['list']>>['items'][number];
const clientFor = (request: Request) => scaffoldServiceClient(contract, serviceName, routerName, request);
function project(row: Row): ScaffoldRecord {
  return { id: String(row.id), name: row.name, description: row.summary, reference: row.reference, ownerName: row.ownerName, ownerEmail: row.ownerEmail, status: row.status, amount: row.amount, currency: row.currency, createdAt: new Date(row.createdAt).toISOString(), updatedAt: new Date(row.updatedAt).toISOString(),
    fields: [{ label: 'Reference', value: row.reference }, { label: 'Name', value: row.name }, { label: 'Owner', value: row.ownerName }, { label: 'Email', value: row.ownerEmail }, { label: 'Status', value: scaffoldStatuses[row.status].label }, { label: 'Amount (minor units)', value: String(row.amount) }, { label: 'Currency', value: row.currency }, { label: 'Created', value: new Date(row.createdAt).toISOString() }, { label: 'Updated', value: new Date(row.updatedAt).toISOString() }] };
}

/** Paginated records come exclusively from the generated typed list procedure. */
export async function loadScaffoldRecords(request: Request): Promise<ScaffoldRecords> {
  try {
    const { client, context } = await clientFor(request);
    const query = scaffoldRecordQuery(request);
    const { page } = query;
    const result = await client.list({ ...query, limit: PAGE_SIZE, offset: (page - 1) * PAGE_SIZE }, { context });
    return { state: result.items.length ? 'ready' : 'empty', rows: result.items.map(project), total: result.total,
      page, pageSize: PAGE_SIZE, query: { ...(query.search ? { search: query.search } : {}), sortBy: query.sortBy, sortOrder: query.sortOrder, ...(query.status ? { status: query.status } : {}) }, hasNext: result.hasMore, message: result.total ? 'Records from {{serviceName}}.' : query.status || query.search ? 'No records match your filters.' : 'Your service has no records yet.' };
  } catch (error) { return scaffoldReadFailure(error); }
}

/** Memory contracts have no getById; bounded pagination never mistakes a budget limit for 404. */
export async function loadScaffoldRecord(request: Request, id: string): Promise<ScaffoldRecordDetail> {
  if (!/^[1-9]\d*$/.test(id)) return { state: 'empty', notFound: true, message: 'Record not found.' };
  try {
    const { client, context } = await clientFor(request);
    for (let page = 0; page < DETAIL_PAGE_LIMIT; page++) {
      const result = await client.list({ limit: PAGE_SIZE, offset: page * PAGE_SIZE }, { context });
      const row = result.items.find((item) => String(item.id) === id);
      if (row) return { state: 'ready', record: project(row), message: 'Record from {{serviceName}}.' };
      if (!result.hasMore) return { state: 'empty', notFound: true, message: 'Record not found.' };
    }
    return { state: 'unavailable', message: 'The detail lookup reached its limit. Use the service page to narrow your search.' };
  } catch (error) { return scaffoldReadFailure(error); }
}
