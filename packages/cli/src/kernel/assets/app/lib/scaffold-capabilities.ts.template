// Server-only: project configuration and filesystem paths never enter island props.
import { findWorkspaceRoot } from '@netscript/config';
import { join } from 'node:path';
import { z } from 'zod';
import { capabilityCommands, type ScaffoldCapability } from './scaffold-contract.ts';

const resourceSchema = z.object({ Enabled: z.boolean().optional() });
const settingsSchema = z.object({ NetScript: z.object({
  Services: z.record(z.string(), resourceSchema).default({}),
  Plugins: z.record(z.string(), resourceSchema).default({}),
}).default({ Services: {}, Plugins: {} }) });

/** Read only the safe topology projection on each request, including post-init installs. */
export async function readScaffoldCapabilities(): Promise<readonly ScaffoldCapability[]> {
  try {
  const root = await findWorkspaceRoot(Deno.cwd());
  const settings = settingsSchema.parse(JSON.parse(await Deno.readTextFile(join(root, 'appsettings.json'))));
  const services = Object.entries(settings.NetScript.Services).filter(([, entry]) => entry.Enabled !== false);
  const service = services.find(([name]) => name === '{{serviceName}}') ?? services[0];
  const capabilities: ScaffoldCapability[] = [{
    id: 'service', label: 'Records', state: service ? 'installed-unwired' : 'absent',
    description: service ? `Connect the ${service[0]} typed client to a resource page.` : 'Add a service to start working with records.',
    command: service
      ? `netscript generate resource ${service[0]} --app {{appName}} --client ${service[0]} --procedure list`
      : capabilityCommands.service,
  }];
  for (const id of ['auth', 'workers', 'streams', 'ai'] as const) {
    const enabled = settings.NetScript.Plugins[id]?.Enabled !== false && settings.NetScript.Plugins[id] !== undefined;
    let authRoute = false;
    if (id === 'auth' && enabled) {
      try { authRoute = (await Deno.stat(join(root, 'apps', '{{appName}}', 'routes/auth/[action].ts'))).isFile; }
      catch (error) { if (!(error instanceof Deno.errors.NotFound)) throw error; }
    }
    capabilities.push({
      id, label: { auth: 'Sign-in', workers: 'Background work', streams: 'Activity', ai: 'AI' }[id],
      state: authRoute ? 'ready' : enabled ? 'installed-unwired' : 'absent',
      description: authRoute ? 'Continue with your configured identity provider.'
        : enabled ? 'Installed. Connect its supported client to this workspace.'
        : { auth: 'Connect an identity provider to sign in.', workers: 'Run jobs outside the request.', streams: 'Follow changes as they happen.', ai: 'Connect models and tools to your workspace.' }[id],
      command: authRoute ? undefined : enabled ? 'netscript plugin doctor' : capabilityCommands[id],
    });
  }
  return capabilities;
  } catch (error) {
    console.error('Workspace capability read failed', error);
    return (['service', 'auth', 'workers', 'streams', 'ai'] as const).map((id) => ({
      id, label: { service: 'Records', auth: 'Sign-in', workers: 'Background work', streams: 'Activity', ai: 'AI' }[id],
      state: 'unavailable', description: 'Workspace configuration is unavailable. Try again after checking the server configuration.',
    }));
  }
}
