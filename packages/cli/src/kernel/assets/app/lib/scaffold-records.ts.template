// Server-only loader. Init selects a typed service adapter when one is generated.
import { readScaffoldCapabilities } from './scaffold-capabilities.ts';
import type { ScaffoldRecords } from './scaffold-contract.ts';

/** Resolve the no-service state without importing a nonexistent contract. */
export async function loadScaffoldRecords(_request: Request): Promise<ScaffoldRecords> {
  const capability = (await readScaffoldCapabilities()).find((item) => item.id === 'service')!;
  return { state: capability.state, rows: [], message: capability.description, command: capability.command };
}
