import { routePatterns, appRoutes } from '@app/router.ts';

/** How a top-bar link decides that it marks the current page. */
export type NavigationMatch = 'exact' | 'prefix';

/** One top-bar link rendered by `routes/_layout.tsx`. */
export interface NavigationItem {
  /** Typed href from `appRoutes`. */
  readonly href: string;
  /** Visible link text. */
  readonly label: string;
  /** `prefix` keeps the link current on nested pages such as `/examples/crud`. */
  readonly match: NavigationMatch;
  /** Development reference routes are excluded from production builds. */
  readonly developmentOnly?: boolean;
}

/**
 * Top-bar links, in display order. Every page renders inside the app chrome; list a page here to
 * link it. `netscript ui:add page <path>` appends top-level pages for you.
 */
export const appNavigation: readonly NavigationItem[] = [
  { href: appRoutes.dashboard.href(), label: 'Overview', match: 'exact' },
  { href: appRoutes.records.href(), label: 'Records', match: 'prefix' },
  { href: appRoutes.settings.href(), label: 'Settings', match: 'exact' },
  { href: appRoutes.signIn.href(), label: 'Sign in', match: 'exact' },
  { href: appRoutes.examples.href(), label: 'Examples', match: 'prefix' },
  { href: appRoutes.health.href(), label: 'Health', match: 'exact' },
  { href: appRoutes.design.href(), label: 'Design', match: 'prefix', developmentOnly: true },
];

/**
 * Route prefixes whose pages render their own chrome instead of the app top bar. `/design` ships
 * its own sidebar shell; add a prefix for a full-screen page such as a sign-in screen.
 */
export const chromelessRoutePrefixes: readonly string[] = [appRoutes.design.href(), appRoutes.signIn.href()];

function isUnderPrefix(pathname: string, prefix: string): boolean {
  return pathname === prefix || pathname.startsWith(`${prefix}/`);
}

/** Whether `item` links to the page at `pathname`. */
export function isCurrentNavigation(item: NavigationItem, pathname: string): boolean {
  return item.match === 'exact' ? pathname === item.href : isUnderPrefix(pathname, item.href);
}

/** Whether the page at `pathname` renders inside the app top bar. */
export function rendersAppChrome(pathname: string): boolean {
  return !chromelessRoutePrefixes.some((prefix) => isUnderPrefix(pathname, prefix));
}

/** Navigation and command results exclude references unavailable in production. */
export function visibleNavigation(): readonly NavigationItem[] {
  return appNavigation.filter((item) => !item.developmentOnly || import.meta.env.MODE === 'development');
}

/** Count actual page patterns, including nested pages, with the same development filter as navigation. */
export function generatedPageCount(): number {
  const walk = (node: object): number => Object.entries(node).reduce((count, [key, value]) => {
    if (key === '$route' && typeof value === 'string') {
      return count + (value.startsWith('/design') && import.meta.env.MODE !== 'development' ? 0 : 1);
    }
    return count + (value && typeof value === 'object' ? walk(value) : 0);
  }, 0);
  return walk(routePatterns);
}
