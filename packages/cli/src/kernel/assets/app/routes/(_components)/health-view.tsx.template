import { Badge, Button, PageHeader, StatsGrid } from '@app/components/ui/mod.ts';
import { appRoutes } from '@app/router.ts';
import type { HealthRouteData } from '../(_shared)/health.ts';

export default function HealthView({ payload }: HealthRouteData) {
  const healthy = payload.resources.filter((item) => item.state === 'healthy').length;
  return (
    <div class='workspace-page'>
      <PageHeader class='workspace-heading'>
        <PageHeader.Layout>
          <PageHeader.Main>
            <PageHeader.Intro>
              <h1>System health</h1>
              <p>Current availability across your workspace.</p>
            </PageHeader.Intro>
          </PageHeader.Main>
          <PageHeader.Actions>
            <Button type='link' href={appRoutes.health.href()} variant='outline'>
              ↻ Check again
            </Button>
          </PageHeader.Actions>
        </PageHeader.Layout>
      </PageHeader>
      <div class='workspace-health-banner' data-state={payload.status}>
        <span class='workspace-health-dot' />
        <div>
          <h2>
            {payload.status === 'healthy'
              ? 'All systems operational'
              : 'Some resources need attention'}
          </h2>
          <p>
            {healthy} of {payload.resources.length} resources responding · checked{' '}
            <time dateTime={payload.timestamp}>
              {new Intl.DateTimeFormat(undefined, {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                timeZone: 'UTC',
              }).format(new Date(payload.timestamp))} UTC
            </time>
          </p>
        </div>
        <Badge variant={payload.status === 'healthy' ? 'success' : 'warning'}>
          {payload.status === 'healthy' ? 'Operational' : 'Degraded'}
        </Badge>
      </div>
      <StatsGrid class='workspace-stats'>
        <StatsGrid.Card label='Responding' value={healthy} detail='Successful health responses' />
        <StatsGrid.Card
          label='Resources'
          value={payload.resources.length}
          detail='Web, services, plugins and background work'
        />
        <StatsGrid.Card
          label='Web uptime'
          value={`${Math.floor(payload.uptime / 60)}m`}
          detail={`${payload.uptime} seconds since start`}
        />
      </StatsGrid>
      <section class='workspace-section'>
        <header class='workspace-section-heading'>
          <div>
            <h2>Resource status</h2>
            <p>
              Response latency at this check. Web time includes dependency checks. Not linked means
              this app has no discovery endpoint.
            </p>
          </div>
        </header>
        <div class='workspace-health-list'>
          {payload.resources.map((resource) => (
            <article class='workspace-health-row' key={resource.kind + resource.name}>
              <span class='workspace-resource-icon' aria-hidden='true'>
                {resource.kind === 'Web' ? '◫' : resource.kind === 'Service' ? '⌘' : '◇'}
              </span>
              <div>
                <h3>{resource.name}</h3>
                <p>{resource.kind}</p>
              </div>
              <span class='workspace-health-latency'>
                {resource.latencyMs === undefined ? '—' : `${resource.latencyMs} ms`}
              </span>
              <Badge
                variant={resource.state === 'healthy'
                  ? 'success'
                  : resource.state === 'disabled'
                  ? 'muted'
                  : resource.state === 'unauthorized' || resource.state === 'unwired'
                  ? 'warning'
                  : 'destructive'}
              >
                {resource.state === 'healthy'
                  ? 'Operational'
                  : resource.state === 'unauthorized'
                  ? 'Access required'
                  : resource.state === 'unwired'
                  ? 'Not linked'
                  : resource.state === 'disabled'
                  ? 'Disabled'
                  : 'Unavailable'}
              </Badge>
            </article>
          ))}
        </div>
      </section>
      <footer class='workspace-reference'>
        <a href={appRoutes.dashboard.href()}>← Overview</a>
        <span>Checks are a point-in-time snapshot.</span>
      </footer>
    </div>
  );
}
