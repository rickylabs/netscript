import { Button, PageHeader, StatsGrid } from '@app/components/ui/mod.ts';
import { appTheme } from '@app/lib/theme.ts';
import type { ScaffoldCapability, ScaffoldRecords } from '@app/lib/scaffold-contract.ts';
import { appRoutes } from '@app/router.ts';
import { generatedPageCount } from '@app/navigation.ts';
import { CapabilityEmpty } from './capability-empty.tsx';
import { RecordTable } from './record-table.tsx';

interface DashboardProps {
  readonly records: ScaffoldRecords;
  readonly capabilities: readonly ScaffoldCapability[];
}

/** Utility overview composed from generated routes and live capability results. */
export default function DashboardView({ records, capabilities }: DashboardProps) {
  const activity = capabilities.find((item) => item.id === 'streams')!;
  return <div class='workspace-page'>
    <PageHeader class='workspace-heading'><PageHeader.Layout><PageHeader.Main><PageHeader.Intro>
      <h1>Overview</h1><p>Your records and activity, in one place.</p>
    </PageHeader.Intro></PageHeader.Main><PageHeader.Actions>
      <Button type='link' href={appRoutes.records.href()}>View records</Button>
    </PageHeader.Actions></PageHeader.Layout></PageHeader>
    <nav class='workspace-tabs' aria-label='Overview sections'>
      <a href={appRoutes.dashboard.href()} aria-current='page'>Overview</a>
      <a href={appRoutes.records.href()}>Records {records.total !== undefined && <span>{records.total}</span>}</a>
      <a href={appRoutes.settings.href()}>Settings</a>
    </nav>
    <StatsGrid class='workspace-stats'>
      <StatsGrid.Card label='Records' value={records.total ?? '—'} detail={records.total === undefined ? 'No connected record count' : 'From your service'} />
      <StatsGrid.Card label='Pages' value={generatedPageCount()} detail='Available in this application' />
      <StatsGrid.Card label='Workspace' value='{{name}}' detail='{{appName}}' class='workspace-stat-text' />
      <StatsGrid.Card label='Theme' value={appTheme().label} detail='Light and dark appearance' class='workspace-stat-text' />
    </StatsGrid>
    <div class='workspace-overview-grid'>
      <section class='workspace-section'><header class='workspace-section-heading'><div><h2>Recent records</h2><p>The latest records from your connected service.</p></div><a href={appRoutes.records.href()}>View all records <span aria-hidden='true'>→</span></a></header>
        <RecordTable records={{ ...records, rows: records.rows.slice(0, 5) }} />
      </section>
      <section class='workspace-section'><header class='workspace-section-heading'><div><h2>Activity</h2><p>Updates from your workspace.</p></div></header><CapabilityEmpty capability={activity} /></section>
    </div>
    <section class='workspace-section'><header class='workspace-section-heading'><div><h2>Workspace capabilities</h2><p>Add what your application needs.</p></div></header><div class='workspace-capabilities'>
      {capabilities.filter((item) => ['workers', 'ai'].includes(item.id)).map((capability) => <CapabilityEmpty key={capability.id} capability={capability} />)}
    </div></section>
    {import.meta.env.MODE === 'development' && <footer class='workspace-reference'><a href={appRoutes.design.href()}>Design reference</a><a href={appRoutes.designComposition.href()}>Composition guide</a></footer>}
  </div>;
}
