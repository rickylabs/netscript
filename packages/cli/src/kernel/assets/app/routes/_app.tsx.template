import { define } from '@app/utils.ts';
import { appTheme } from '@app/lib/theme.ts';

const THEME_INIT_SCRIPT =
  `(function(){var t;try{t=localStorage.getItem('ns-theme')}catch(e){}if(t!=='light'&&t!=='dark'){t=matchMedia('(prefers-color-scheme:light)').matches?'light':'dark'}document.documentElement.setAttribute('data-scheme',t)})()`;

export default define.page(function AppShell({ Component, url }) {
  const { preset, fontImports } = appTheme(url);
  return (
    <html
      lang='en'
      data-theme={preset.language}
      data-scheme='dark'
      data-density={preset.density}
      data-flavor={preset.flavor ?? undefined}
    >
      <head>
        <meta charSet='utf-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <meta
          name='description'
          content='NetScript starter scaffold with Fresh 2, Aspire orchestration, contracts, and enterprise UI primitives.'
        />
        <title>{{name}} — {{appName}}</title>
        <link rel='icon' href='data:,' />
        <link rel='preconnect' href='https://fonts.googleapis.com' />
        <link rel='preconnect' href='https://fonts.gstatic.com' crossOrigin='anonymous' />
        {fontImports.map((href) => <link key={href} href={href} rel='stylesheet' />)}
        <script dangerouslySetInnerHTML={{ __html: THEME_INIT_SCRIPT }} />
      </head>
      <body f-client-nav>
        <a href='#main-content' class='ns-skip-link'>Skip to main content</a>
        <div id='main-content' tabIndex={-1}>
          <Component />
        </div>
      </body>
    </html>
  );
});
