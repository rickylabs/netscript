import { scaffoldLocale } from '@app/lib/scaffold-contract.ts';
import View from './(_components)/dashboard-view.tsx';
import { loadScaffoldOverview } from '@app/lib/scaffold-overview.ts';
import { loadScaffoldRecords } from '@app/lib/scaffold-records.ts';
import { readScaffoldCapabilities } from '@app/lib/scaffold-capabilities.ts';
import { appRoutes } from '@app/router.ts';
import { definePage } from '@app/utils.ts';

export const dashboardPage = definePage().withRoute(appRoutes.dashboard)
  .withMeta(() => ({ title: '{{name}} — Overview' }))
  .withLayer('dashboard', View, { loader: async (ctx) => { const records = await loadScaffoldRecords(ctx.req); return { locale: scaffoldLocale(ctx.req), records, overview: await loadScaffoldOverview(ctx.req), capabilities: await readScaffoldCapabilities(ctx.req, records) }; } })
  .withLayout((slots) => slots.dashboard()).build();
export const { default: page } = dashboardPage;
export { page as default };
