import View from './(_components)/home-view.tsx';
import { loadScaffoldRecords } from '@app/lib/scaffold-records.ts';
import { readScaffoldCapabilities } from '@app/lib/scaffold-capabilities.ts';
import { appRoutes } from '@app/router.ts';
import { definePage } from '@app/utils.ts';

export const homePage = definePage().withRoute(appRoutes.home)
  .withMeta(() => ({ title: '{{name}} — Overview' }))
  .withLayer('home', View, { loader: async (ctx) => ({ records: await loadScaffoldRecords(ctx.req), capabilities: await readScaffoldCapabilities() }) })
  .withLayout((slots) => slots.home()).build();
export const { default: page } = homePage;
export { page as default };
