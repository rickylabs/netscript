import { Partial } from 'fresh/runtime';
import ThemeToggle from '@app/islands/ui/ThemeToggle.tsx';
import SidebarToggle from '@app/islands/ui/SidebarToggle.tsx';
import WorkspaceCommands from '@app/islands/WorkspaceCommands.tsx';
import { Breadcrumb, SidebarShell } from '@app/components/ui/mod.ts';
import { visibleNavigation, isCurrentNavigation, rendersAppChrome } from '@app/navigation.ts';
import { appRoutes } from '@app/router.ts';
import { appTheme } from '@app/lib/theme.ts';
import { define } from '@app/utils.ts';

/** One shared shell for every workspace page; full-screen references and sign-in opt out. */
export default define.layout(function RootLayout({ Component, url }) {
  if (!rendersAppChrome(url.pathname)) return <Partial name='page'><Component /></Partial>;
  const navigation = visibleNavigation();
  const current = navigation.find((item) => isCurrentNavigation(item, url.pathname))?.label ?? 'Overview';
  return <Partial name='page'><SidebarShell pathname={url.pathname} contentId='workspace-content'
    navigation={[
      { label: 'Workspace', items: navigation.slice(0, 4).map((item) => ({ ...item, matchPrefix: item.match === 'prefix', isActive: (pathname: string) => isCurrentNavigation(item, pathname) || (item.label === 'Overview' && pathname === '/') })) },
      { label: 'Resources', items: navigation.slice(4).map((item) => ({ ...item, matchPrefix: item.match === 'prefix' })) },
    ]}
    brand={<a class='workspace-brand' href={appRoutes.home.href()}><span class='workspace-mark' aria-hidden='true'>N</span>{{name}}</a>}
    topbarStart={<><SidebarToggle /><Breadcrumb items={[{ label: '{{name}}', href: appRoutes.home.href() }, { label: current }]} /></>}
    topbarEnd={<><WorkspaceCommands navigation={navigation} /><ThemeToggle /></>}
    footer={<div class='ns-dashboard__sidebar-env'><span>{appTheme().label}</span></div>}
  ><Component /></SidebarShell></Partial>;
});
