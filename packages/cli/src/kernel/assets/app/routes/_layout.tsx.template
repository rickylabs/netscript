import { Partial } from 'fresh/runtime';
import ThemeToggle from '@app/islands/ui/ThemeToggle.tsx';
import { Badge, Button } from '@app/components/ui/mod.ts';
import { appNavigation, isCurrentNavigation, rendersAppChrome } from '@app/navigation.ts';
import { appRoutes } from '@app/router.ts';
import { define } from '@app/utils.ts';

/**
 * App chrome for every page: the top bar with the `appNavigation` links from `navigation.ts`.
 * Pages under `chromelessRoutePrefixes` (such as `/design`, which has its own sidebar shell)
 * render without it. Both branches keep the `page` partial so client navigation swaps the whole
 * frame.
 */
export default define.layout(function RootLayout({ Component, url }) {
  if (!rendersAppChrome(url.pathname)) {
    return (
      <Partial name='page'>
        <Component />
      </Partial>
    );
  }

  return (
    <Partial name='page'>
      <header class='ns-topbar'>
        <div class='ns-cluster ns-cluster--sm'>
          <a href={appRoutes.home.href()} f-client-nav class='ns-topbar__brand'>
            {{name}}
          </a>
          <Badge variant='muted'>{{appName}}</Badge>
        </div>
        <nav class='ns-cluster ns-cluster--sm' aria-label='Primary'>
          {appNavigation.map((item) => (
            <Button
              key={item.href}
              type='link'
              href={item.href}
              variant='ghost'
              size='sm'
              aria-current={isCurrentNavigation(item, url.pathname) ? 'page' : undefined}
            >
              {item.label}
            </Button>
          ))}
          <ThemeToggle />
        </nav>
      </header>
      <Component />
    </Partial>
  );
});
