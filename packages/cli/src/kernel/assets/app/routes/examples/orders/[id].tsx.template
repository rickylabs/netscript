import { appRoutes } from '@app/router.ts';
import { definePage } from '@app/utils.ts';

export const orderPage = definePage()
  .withRoute(appRoutes.order)
  .withMeta((ctx) => ({
    title: `Order ${ctx.path.id}`,
    description: 'Dynamic route binding generated by the NetScript scaffold.',
  }))
  .withLayout((_slots, ctx) => {
    const id: string = ctx.path.id;
    const selfHref = ctx.route.href({ path: { id } });

    return (
      <main class='ns-shell ns-section ns-stack' data-order-id={id}>
        <h1>Order {id}</h1>
        <a href={selfHref}>Current order</a>
      </main>
    );
  })
  .build();

export const { default: page } = orderPage;
export { page as default };
