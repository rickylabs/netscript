import CrudExampleView from './(_components)/crud-view.tsx';
import { appRoutes, routes } from '@app/router.ts';
import { definePage } from '@app/utils.ts';

const HAS_EXAMPLE_SERVICE = {{hasService}};

export const crudExamplePage = definePage()
  .withRoute(routes.examples.crud.$route)
  .withMeta(() => ({
    title: '{{name}} — directory pattern demo',
    description: 'Empty table reference. Open Records for connected service data.',
  }))
  .withLayer('crud', CrudExampleView, () => ({
    records: [] as const,
    serviceHref: HAS_EXAMPLE_SERVICE ? appRoutes.serviceExample.href() : undefined,
    recordsHref: appRoutes.records.href(),
  }))
  .withLayout((slots) => slots.crud())
  .build();

export const { default: page } = crudExamplePage;
export { page as default };
