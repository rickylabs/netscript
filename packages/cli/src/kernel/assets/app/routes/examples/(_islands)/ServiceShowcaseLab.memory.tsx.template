import { useSignal } from '@preact/signals';
import { useRef } from 'preact/hooks';
import type { InferDefinePageLayerLoaderProps } from '@netscript/fresh/builders';
import {
  getIslandQueryClient,
  hydrateFromDehydrated,
  QueryIsland,
  useMutation,
  useQuery,
  useQueryClient,
} from '@netscript/fresh/query';
import { Button, EmptyState, InlineNotice, Skeleton } from '@app/components/ui/mod.ts';
import {
  {{serviceName | camelCase}}ListInvalidation,
  {{serviceName | camelCase}}Name,
  {{serviceName | camelCase}}Queries,
} from '../(_lib)/service-query.ts';
import {
  formatServiceTimestamp,
  loadServiceShowcaseData,
  type ServiceShowcasePreview,
} from '../(_shared)/service-showcase.ts';
import {
  createOptimisticListMutationCallbacks,
  type OptimisticListMutationContext,
} from '../(_lib)/optimistic-list-mutation.ts';

type Props = NonNullable<InferDefinePageLayerLoaderProps<typeof loadServiceShowcaseData>>;
type ServiceListData = NonNullable<Props['initialList']>;
type ServiceRecord = ServiceListData['items'][number];
type UpdateStatusInput = Pick<ServiceRecord, 'id' | 'status'>;

const NEXT_STATUS_BY_STATE = {
  draft: 'active',
  active: 'archived',
  archived: 'draft',
} as const;

function ServiceShowcaseLabInner(props: Props) {
  const islandQueryClient = getIslandQueryClient();
  const hydratedRef = useRef(false);
  const statusMessage = useSignal<string | null>(null);

  if (!hydratedRef.current && props.dehydratedState) {
    hydrateFromDehydrated(islandQueryClient, props.dehydratedState);
    hydratedRef.current = true;
  }

  const queryClient = useQueryClient();
  const currentKey = {{serviceName | camelCase}}Queries.list.clientKey(props.input);
  const {
    data,
    error,
    status,
    isError,
    isLoading,
    refetch,
  } = useQuery({
    ...{{serviceName | camelCase}}Queries.list.queryOptions(props.input),
    initialData: props.initialList,
    initialDataUpdatedAt: props.cachedAt,
    staleTime: 15_000,
  });

  const statusMutation = useMutation<
    ServiceRecord,
    unknown,
    UpdateStatusInput,
    OptimisticListMutationContext<ServiceListData>
  >({
    ...{{serviceName | camelCase}}Queries.updateStatus.mutationOptions(),
    ...createOptimisticListMutationCallbacks<ServiceListData, UpdateStatusInput>({
      queryClient,
      queryKey: currentKey,
      update: (previous, variables) => ({
          ...previous,
          items: previous.items.map((item) =>
            item.id === variables.id ? { ...item, status: variables.status } : item
          ),
      }),
      onOptimisticUpdate: (variables) => {
        statusMessage.value =
          `Optimistically moved record #${variables.id} to ${variables.status}.`;
      },
      onRollback: (variables) => {
        statusMessage.value =
          `Update for record #${variables.id} failed and the cached list rolled back.`;
      },
    }),
    onSuccess: (item) => {
      statusMessage.value = `Server confirmed ${item.name} is now ${item.status}.`;
    },
    onSettled: async () => {
      await queryClient.invalidateQueries({{serviceName | camelCase}}ListInvalidation);
    },
  });

  const items = data?.items ?? props.initialList.items;
  const renderState: ServiceShowcasePreview = props.previewState ??
    (isLoading ? 'loading' : isError ? 'error' : items.length === 0 ? 'empty' : 'success');
  const previewMessage = renderState === 'optimistic'
    ? 'Optimistic update is visible while the service confirms it.'
    : renderState === 'rollback'
    ? 'The service rejected the update and the saved cache snapshot was restored.'
    : renderState === 'confirmed'
    ? 'The service confirmed the mutation and the canonical list was refreshed.'
    : null;
  const visibleMessage = statusMessage.value ?? previewMessage;
  const showList = renderState === 'success' || renderState === 'optimistic' ||
    renderState === 'rollback' || renderState === 'confirmed';

  return (
    <div class='ns-stack ns-stack--md'>
      <div class='grid gap-3 md:grid-cols-4'>
        <StatCard label='Hydration' value={hydratedRef.current ? 'warm cache' : 'pending'} />
        <StatCard label='List state' value={status} />
        <StatCard label='Rows' value={String(items.length)} />
        <StatCard
          label='Cached at'
          value={props.cachedAt ? formatServiceTimestamp(props.cachedAt) : 'server prefetched'}
        />
      </div>

      <div class='flex flex-wrap items-center gap-3'>
        <Button
          type='button'
          variant='outline'
          loading={isLoading}
          onClick={() => void refetch()}
        >
          {isLoading ? 'Refreshing list' : `Refresh ${{{serviceName | camelCase}}Name}`}
        </Button>
        <Button
          type='button'
          variant='secondary'
          onClick={() => void queryClient.invalidateQueries({{serviceName | camelCase}}ListInvalidation)}
        >
          Invalidate list cache
        </Button>
      </div>

      {visibleMessage
        ? (
          <p data-mutation-state={renderState} class='rounded-2xl border border-ns-border bg-ns-surface-raised/20 px-4 py-3 text-sm text-ns-muted-fg'>
            {visibleMessage}
          </p>
        )
        : null}

      {renderState === 'loading'
        ? <Skeleton variant='table' rows={3} columns={2} data-state='loading' />
        : renderState === 'error'
        ? (
          <InlineNotice variant='destructive' title='Resource list unavailable' data-state='error'>
            {error instanceof Error ? error.message : 'Retry the typed query.'}
          </InlineNotice>
        )
        : renderState === 'empty'
        ? (
          <EmptyState heading='No resources yet' data-state='empty'>
            Adjust the typed search or add the first resource through the service contract.
          </EmptyState>
        )
        : null}

      {showList
        ? <ul class='ns-stack ns-stack--sm' data-state={renderState}>
        {items.map((item) => {
          const nextStatus = NEXT_STATUS_BY_STATE[item.status];

          return (
            <li
              key={item.id}
              class='rounded-2xl border border-ns-border bg-ns-surface-raised/20 p-4'
            >
              <div class='flex flex-wrap items-start justify-between gap-4'>
                <div class='ns-stack ns-stack--xs'>
                  <div class='flex flex-wrap items-center gap-2'>
                    <p class='text-sm font-semibold text-ns-fg'>{item.name}</p>
                    <span class='rounded-full border border-ns-border px-2 py-1 text-[0.68rem] uppercase tracking-[0.16em] text-ns-muted-fg'>
                      {item.status}
                    </span>
                  </div>
                  <p class='text-sm text-ns-muted-fg'>{item.summary}</p>
                  <p class='text-xs text-ns-muted-fg'>
                    Created {formatServiceTimestamp(item.createdAt)}
                  </p>
                </div>

                <Button
                  type='button'
                  disabled={statusMutation.isPending}
                  loading={statusMutation.isPending}
                  onClick={() => void statusMutation.mutate({ id: item.id, status: nextStatus })}
                >
                  Advance to {nextStatus}
                </Button>
              </div>
            </li>
          );
        })}
        </ul>
        : null}
    </div>
  );
}

function StatCard({ label, value }: { label: string; value: string }) {
  return (
    <div class='rounded-2xl border border-ns-border bg-ns-surface-raised/20 px-4 py-3'>
      <p class='text-[0.68rem] uppercase tracking-[0.18em] text-ns-muted-fg'>{label}</p>
      <p class='mt-2 text-sm font-semibold text-ns-fg'>{value}</p>
    </div>
  );
}

export default function ServiceShowcaseLab(props: Props) {
  return (
    <QueryIsland>
      <ServiceShowcaseLabInner {...props} />
    </QueryIsland>
  );
}
