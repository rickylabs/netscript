import { Badge, Button, EmptyState, PageHeader } from '@app/components/ui/mod.ts';

interface ExampleCard {
  readonly title: string;
  readonly href: string;
  readonly description: string;
  readonly status: string;
  readonly owner: string;
}

interface ExamplesViewProps {
  readonly canonicalHref?: string;
  readonly examples: readonly ExampleCard[];
}

export default function ExamplesView({ canonicalHref, examples }: ExamplesViewProps) {
  return (
    <div class='workspace-page'>
      <PageHeader class='workspace-heading'>
        <PageHeader.Layout>
          <PageHeader.Main>
            <PageHeader.Intro>
              <h1>Examples</h1>
              <p>Connected workflows and reference routes in your application.</p>
            </PageHeader.Intro>
          </PageHeader.Main>
          <PageHeader.Actions>
            {canonicalHref && <Button type='link' href={canonicalHref}>Open {{serviceName}} flow ↗</Button>}
          </PageHeader.Actions>
        </PageHeader.Layout>
      </PageHeader>
      <section class='workspace-section'>
        <header class='workspace-section-heading'>
          <h2>Example routes <span class='workspace-count'>{examples.length}</span></h2>
          <span class='workspace-muted'>{examples.length === 1 ? '1 route available' : `${examples.length} routes available`}</span>
        </header>
        {examples.length ? <ul class='workspace-example-list'>
          {examples.map((example) => <li key={example.href}>
            <span class='workspace-resource-icon' aria-hidden='true'>◫</span>
            <div class='workspace-example-copy'>
              <a href={example.href}>{example.title}</a>
              <p>{example.description}</p>
              <div class='workspace-example-meta'><span>{example.owner}</span><code>{example.href}</code><Badge variant='muted'>{example.status}</Badge></div>
            </div>
            <Button type='link' href={example.href} variant='ghost' size='sm' aria-label={`Open ${example.title}`}>Open ↗</Button>
          </li>)}
        </ul> : <EmptyState heading='No examples configured'>Add a workflow route to this application.</EmptyState>}
      </section>
    </div>
  );
}
