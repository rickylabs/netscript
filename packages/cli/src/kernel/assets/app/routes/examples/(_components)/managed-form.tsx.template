import type { RuntimeFormState } from '@netscript/fresh/form';
import {
  Button,
  Card,
  FormField,
  getInputProps,
  InlineNotice,
  Input,
} from '@app/components/ui/mod.ts';

interface ServiceNoteValues {
  readonly note: string;
}

export function ServiceManagedForm(state: RuntimeFormState<ServiceNoteValues>) {
  const noteError = state.fieldErrors.note?.[0];

  return (
    <Card>
      <Card.Header>
        <Card.Title>Managed resource form</Card.Title>
        <Card.Description>
          Validation, CSRF state, mutation telemetry, and success state are owned by withForm.
        </Card.Description>
      </Card.Header>
      <Card.Body>
        <form
          {...state.formProps}
          f-client-nav
          data-state={state.hasErrors ? 'invalid' : state.submitted ? 'success' : 'initial'}
        >
          <input {...state.csrfInputProps} />
          <div class='ns-stack ns-stack--md'>
            <FormField
              label='Resource note'
              name={state.fields.note.id}
              required
              error={noteError}
              helpText='Use 3–160 characters. Invalid submissions stay on this managed form.'
            >
              <Input
                {...getInputProps(state.fields.note, { type: 'text' })}
                error={Boolean(noteError)}
              />
            </FormField>

            {state.hasErrors
              ? (
                <InlineNotice variant='destructive' title='Check the form' role='alert'>
                  The note was not saved. Correct the validation error and submit again.
                </InlineNotice>
              )
              : state.submitted
              ? (
                <InlineNotice variant='success' title='Note accepted'>
                  The managed mutation completed successfully.
                </InlineNotice>
              )
              : null}

            <Button type='submit'>Save resource note</Button>
          </div>
        </form>
      </Card.Body>
    </Card>
  );
}
