/**
 * Auth-ready boundary for the canonical resource route.
 *
 * Replace this permissive starter resolver with the authenticated principal and policy supplied by
 * your application. Keeping authorization behind this resource seam avoids coupling page layers
 * and mutations to a particular auth provider.
 */
export interface ServiceExampleViewer {
  readonly authenticated: boolean;
  readonly canMutate: boolean;
  readonly displayName: string;
}

export function resolveServiceExampleViewer(): ServiceExampleViewer {
  return {
    authenticated: false,
    canMutate: true,
    displayName: 'Local developer',
  };
}

export function requireServiceExampleMutation(viewer: ServiceExampleViewer): void {
  if (!viewer.canMutate) {
    throw new Error('This viewer cannot mutate {{serviceName}} resources.');
  }
}
