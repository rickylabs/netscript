import { useEffect, useState } from 'preact/hooks';
import { Alert, Button, EmptyState, FormField, Input, PageHeader, Select } from '@app/components/ui/mod.ts';
import { appRoutes } from '@app/router.ts';
import type { ScaffoldCapability } from '@app/lib/scaffold-contract.ts';

const APPEARANCE_KEY = 'ns-theme';
const appearanceOptions = [{ value: 'system', label: 'Use system setting' }, { value: 'light', label: 'Light' }, { value: 'dark', label: 'Dark' }];

/** Browser preferences are saved locally; project identity is deliberately read-only. */
export default function SettingsForm({ projectName, appName, theme, auth }: { readonly projectName: string; readonly appName: string; readonly theme: string; readonly auth: ScaffoldCapability }) {
  const [appearance, setAppearance] = useState('system');
  const [saved, setSaved] = useState('system');
  const [message, setMessage] = useState('');
  const [error, setError] = useState(false);
  useEffect(() => { try { const value = localStorage.getItem(APPEARANCE_KEY); const next = value === 'light' || value === 'dark' ? value : 'system'; setAppearance(next); setSaved(next); } catch { setError(true); setMessage('Browser storage is unavailable. Your preferences cannot be saved.'); } }, []);
  function save(event: SubmitEvent) {
    event.preventDefault();
    try {
      if (appearance === 'system') localStorage.removeItem(APPEARANCE_KEY); else localStorage.setItem(APPEARANCE_KEY, appearance);
      document.documentElement.setAttribute('data-scheme', appearance === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : appearance);
      setSaved(appearance); setError(false); setMessage('Appearance saved for this browser.');
    } catch { setError(true); setMessage('Browser storage is unavailable. Your preferences were not saved.'); }
  }
  return <form class='workspace-page' onSubmit={save}>
    <PageHeader class='workspace-heading'><PageHeader.Layout><PageHeader.Main><PageHeader.Intro><h1>Settings</h1><p>Workspace details and your browsing preferences.</p></PageHeader.Intro></PageHeader.Main><PageHeader.Actions>
      <Button type='button' variant='outline' onClick={() => { setAppearance(saved); setMessage(''); }}>Discard</Button><Button type='submit'>Save changes</Button>
    </PageHeader.Actions></PageHeader.Layout></PageHeader>
    <div class='workspace-settings-layout'><nav class='workspace-settings-nav' aria-label='Settings sections'><a href='#general'>General</a><a href='#appearance-settings'>Appearance</a><a href='#access'>Access</a></nav>
      <div class='workspace-settings-content'>
        {message && <div role='status'><Alert variant={error ? 'destructive' : 'success'} title={error ? 'Could not save' : 'Settings saved'}>{message}</Alert></div>}
        <div class='workspace-form-columns'><section id='general' class='workspace-form-section'><h2>Workspace details</h2><p>Generated project information.</p>
          <FormField name='project-name' label='Workspace name'><Input id='project-name' value={projectName} readOnly /></FormField>
          <FormField name='app-name' label='Application'><Input id='app-name' value={appName} readOnly /></FormField>
          <FormField name='theme-name' label='Theme'><Input id='theme-name' value={theme} readOnly /></FormField>
        </section><div class='workspace-form-section'><section id='appearance-settings' class='workspace-form-section'><h2>Appearance</h2><p>Choose how this workspace looks on your device.</p>
          <FormField name='appearance' label='Color scheme' helpText='This preference is stored only in this browser.'><Select id='appearance' value={appearance} options={appearanceOptions} onChange={(event) => setAppearance(event.currentTarget.value)} /></FormField>
        </section><section id='access' class='workspace-form-section'><h2>Access</h2><p>Sign in through your configured provider.</p>
          {auth.state === 'ready' ? <Button type='link' href={appRoutes.signIn.href()} variant='outline'>Manage sign-in</Button> : <EmptyState heading='Authentication not connected'><p>{auth.description}</p><code class='workspace-command'>{auth.command}</code></EmptyState>}
        </section></div></div>
      </div>
    </div>
  </form>;
}
