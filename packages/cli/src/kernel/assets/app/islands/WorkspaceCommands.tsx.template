import { useEffect, useRef, useState } from 'preact/hooks';
import { CommandPalette } from '@app/components/ui/command-palette.tsx';
import type { NavigationItem } from '@app/navigation.ts';

/** Global keyboard navigation uses only routes rendered in this application. */
export default function WorkspaceCommands({ navigation }: { readonly navigation: readonly NavigationItem[] }) {
  const [open, setOpen] = useState(false);
  const openState = useRef(false);
  const [shortcut, setShortcut] = useState('Ctrl K');
  const trigger = useRef<HTMLButtonElement>(null);
  useEffect(() => {
    setShortcut(/Mac|iPhone|iPad/.test(navigator.platform) ? '⌘K' : 'Ctrl K');
    const onKey = (event: KeyboardEvent) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); changeOpen(!openState.current); }
      if (event.key === 'Escape' && openState.current) { event.preventDefault(); changeOpen(false); }
    };
    globalThis.addEventListener('keydown', onKey, true);
    return () => globalThis.removeEventListener('keydown', onKey, true);
  }, []);
  function changeOpen(next: boolean) { openState.current = next; setOpen(next); if (!next) trigger.current?.focus(); }
  return <><button ref={trigger} type='button' class='workspace-search' onClick={() => changeOpen(true)} aria-label='Search pages' aria-haspopup='dialog'><span aria-hidden='true'>⌕</span><span>Search pages…</span><kbd>{shortcut}</kbd></button>
    <CommandPalette open={open} onOpenChange={changeOpen} placeholder='Search pages…' groups={[{ id: 'pages', label: 'Pages', items: navigation.map((item) => ({ id: item.label.toLowerCase(), label: item.label, hash: item.href, kind: 'Page', onSelect: () => { globalThis.location.href = item.href; } })) }]} />
  </>;
}
