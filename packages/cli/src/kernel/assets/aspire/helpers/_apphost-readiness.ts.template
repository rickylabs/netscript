    const parsed = JSON.parse(stdout);
    const host = (Array.isArray(parsed) ? parsed[0] : parsed)?.Endpoints?.docker?.Host;
    return typeof host === 'string'
      ? classifyDockerHostUrl(host, ctx ? 'DOCKER_CONTEXT' : 'docker-context')
      : { locality: 'unknown' };
