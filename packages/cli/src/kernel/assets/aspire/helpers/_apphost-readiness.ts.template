async function diagnoseLoopback(
  label: string,
  targetKey: string,
  host: string,
  port: number,
  result: HealthCheckResult,
  options: ForeignDockerOptions,
): Promise<HealthCheckResult> {
  if (!options.containerBacked) return result;
  if (result.status === HealthStatus.Healthy) {
    failureStartByTarget.delete(targetKey);
    return result;
  }
  if (!isLoopbackHost(host)) return result;
  const now = performance.now();
  const firstAt = failureStartByTarget.get(targetKey) ?? now;
  if (!failureStartByTarget.has(targetKey)) failureStartByTarget.set(targetKey, firstAt);
  if (now - firstAt < (options.diagnosticThresholdMs ?? FOREIGN_DOCKER_THRESHOLD_MS)) return result;
  const locality = await (options.probeDockerLocality?.() ?? getCachedDockerLocality());
  if (locality.locality !== 'remote') return result;
  const daemon = locality.daemonHost ?? locality.host ?? 'remote';
  return {
    status: HealthStatus.Unhealthy,
    description: `${label} unreachable on ${host}:${port}: Docker daemon is remote (${daemon}). ` +
      'Aspire publishes container ports on the Docker host, not local loopback. ' +
      'Run `netscript plugin doctor` or switch to a local Docker daemon.',
    data: {
      ...result.data,
      code: 'FOREIGN_DOCKER_LOOPBACK',
      originalCode: result.data?.code ?? 'UNKNOWN',
      daemonHost: daemon,
      ...(locality.source ? { daemonSource: locality.source } : {}),
    },
  };
}

