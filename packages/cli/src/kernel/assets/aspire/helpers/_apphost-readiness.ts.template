  const args = ctx ? ['context', 'inspect', ctx] : ['context', 'inspect'];
  const stdout = await new Promise<string | null>((resolve) =>
    execFile(
      'docker',
      args,
      { encoding: 'utf8', timeout: DOCKER_PROBE_TIMEOUT_MS, killSignal: 'SIGKILL' },
      (err, out) => resolve(err ? null : out),
    )
