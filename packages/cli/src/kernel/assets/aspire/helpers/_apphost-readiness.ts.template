function classifyDockerHostUrl(raw: string, source: string): DockerLocalityProbe {
  const host = raw.trim();
  try {
    const { protocol, hostname } = new URL(host);
    if (protocol === 'unix:' || protocol === 'npipe:') return { locality: 'local', host, source };
    if (!['tcp:', 'http:', 'https:', 'ssh:'].includes(protocol) || !hostname) {
      return { locality: 'unknown', host, source };
    }
    const clean = hostname.replace(/^\[|\]$/g, '');
    return isLoopbackHost(clean)
      ? { locality: 'local', host, source }
      : { locality: 'remote', host, daemonHost: clean, source };
  } catch {
    return { locality: 'unknown', host, source };
  }
}

function isLoopbackHost(hostname: string): boolean {
  const h = hostname.replace(/^\[|\]$/g, '').toLowerCase();
  return h === 'localhost' || h.endsWith('.localhost') || h === '::1' ||
    /^127\.\d{1,3}\.\d{1,3}\.\d{1,3}$/.test(h);
}

