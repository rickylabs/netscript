function escapeRespBytes(bytes: Uint8Array<ArrayBufferLike>): string {
  const cap = bytes.subarray(0, RESP_DIAGNOSTIC_LIMIT_BYTES);
  const out = Array.from(
    cap,
    (b) =>
      b === 13
        ? '\\r'
        : b === 10
        ? '\\n'
        : b === 92
        ? '\\\\'
        : b >= 32 && b <= 126
        ? String.fromCharCode(b)
        : `\\x${b.toString(16).padStart(2, '0').toUpperCase()}`,
  ).join('');
  return bytes.length > cap.length ? `${out}…(+${bytes.length - cap.length} bytes)` : out;
}

const socketErrorCode = (error: Error): string =>
