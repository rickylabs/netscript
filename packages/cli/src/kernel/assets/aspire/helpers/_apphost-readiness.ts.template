      );
      next.set(received);
      next.set(chunk.subarray(0, next.length - received.length), received.length);
      received = next;
      if (received.length > RESP_REPLY_LIMIT_BYTES) return fail('EPROTO');
      const crlf = received.findIndex((b, i) => i > 0 && received[i - 1] === 0x0d && b === 0x0a) -
        1;
      if (crlf < 0) return;
      const reply = new TextDecoder().decode(received.subarray(0, crlf));
      if (reply === '+PONG') {
        return finish({
          status: HealthStatus.Healthy,
          description: `RESP listener ready on ${host}:${port}`,
        });
      }
      fail(reply.startsWith('-NOAUTH') ? 'NOAUTH' : 'EPROTO');
    });
    socket.once('end', () => fail('EPROTO'));
    socket.once('error', (error) => fail(socketErrorCode(error)));
    socket.once('timeout', () => fail('ETIMEDOUT'));
