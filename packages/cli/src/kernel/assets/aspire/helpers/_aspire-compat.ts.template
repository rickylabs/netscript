// ============================================================================
// Listener readiness
// ============================================================================

/** Creates a one-socket TCP listener readiness check for an Aspire resource. */
export function createListenerReadinessCheck(
  options: ListenerReadinessCheckOptions,
): () => Promise<HealthCheckResult> {
  return () =>
    new Promise((resolve) => {
      const startedAt = performance.now();
      const port = normalizeListenerPort(options.port);
      const socket = createConnection({ host: options.host, port });
      let settled = false;

      const finish = (result: HealthCheckResult): void => {
        if (settled) return;
        settled = true;
        socket.destroy();
        resolve(result);
      };

      socket.setTimeout(LISTENER_READINESS_TIMEOUT_MS);
      socket.once('connect', () => {
        finish({
          status: HealthStatus.Healthy,
          description: `${options.kind} listener ready on ${options.host}:${port}`,
        });
      });
      socket.once('error', (error) => {
        finish(
          listenerFailure(options.kind, options.host, port, socketErrorCode(error), startedAt),
        );
      });
      socket.once('timeout', () => {
        finish(listenerFailure(options.kind, options.host, port, 'ETIMEDOUT', startedAt));
      });
    });
}

/** Creates a one-socket Redis-compatible PING readiness check. */
export function createRespPingCheck(
  options: RespPingCheckOptions,
): () => Promise<HealthCheckResult> {
  return () =>
    new Promise((resolve) => {
      const startedAt = performance.now();
      const port = normalizeListenerPort(options.port);
      const socket = createConnection({ host: options.host, port });
      let settled = false;

      const finish = (result: HealthCheckResult): void => {
        if (settled) return;
        settled = true;
        socket.destroy();
        resolve(result);
      };

      socket.setTimeout(LISTENER_READINESS_TIMEOUT_MS);
      socket.once('connect', () => {
        socket.write('PING\r\n');
      });
      socket.once('data', (data) => {
        const reply = data.toString('utf8').trim();
        if (reply.startsWith('+PONG')) {
          finish({
            status: HealthStatus.Healthy,
            description: `RESP listener ready on ${options.host}:${port}`,
          });
          return;
        }
        if (reply.startsWith('-NOAUTH')) {
          finish({
            status: HealthStatus.Degraded,
            description: 'auth required — readiness only',
            data: listenerData('NOAUTH', options.host, port, startedAt),
          });
          return;
        }
        finish(respFailure(options.host, port, 'EPROTO', startedAt));
      });
      socket.once('error', (error) => {
        finish(respFailure(options.host, port, socketErrorCode(error), startedAt));
      });
      socket.once('timeout', () => {
        finish(respFailure(options.host, port, 'ETIMEDOUT', startedAt));
      });
    });
}

function listenerFailure(
  kind: string,
  host: string,
  port: number,
  code: string,
  startedAt: number,
): HealthCheckResult {
  return {
    status: HealthStatus.Unhealthy,
    description: `${kind} listener unreachable: ${code}`,
    data: listenerData(code, host, port, startedAt),
  };
}

function respFailure(
  host: string,
  port: number,
  code: string,
  startedAt: number,
): HealthCheckResult {
  return {
    status: HealthStatus.Unhealthy,
    description: `RESP listener unreachable: ${code}`,
    data: listenerData(code, host, port, startedAt),
  };
}

function listenerData(
  code: string,
  host: string,
  port: number,
  startedAt: number,
): Record<string, string> {
  return {
    code,
    host,
    port: String(port),
    elapsedMs: String(Math.round(performance.now() - startedAt)),
  };
}

function normalizeListenerPort(port: number | string): number {
  return typeof port === 'number' ? port : Number.parseInt(port, 10);
}

function socketErrorCode(error: Error): string {
  const code = Reflect.get(error, 'code');
  return typeof code === 'string' ? code : 'UNKNOWN';
}

