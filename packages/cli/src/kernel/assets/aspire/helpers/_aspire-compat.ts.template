export function resolveWorkspacePath(
  appHostDir: string,
  relativePath: string,
): string {
  return resolve(appHostDir, relativePath);
}

export function resolveDataPath(
  appHostDir: string,
  dataPath: string | undefined,
  resourceName: string,
): string {
  const relativePath = dataPath ?? join('.data', resourceName);
  return resolveWorkspacePath(appHostDir, relativePath);
}

/**
 * Returns one project-scoped database password for the resident AppHost graph.
 */
export function ensureDatabasePassword(appHostDir: string, resourceName: string): string {
  const secretsDir = resolveWorkspacePath(appHostDir, join('.data', 'aspire-secrets'));
  const passwordPath = join(secretsDir, `${resourceName}.password`);
  mkdirSync(secretsDir, { recursive: true, mode: 0o700 });

  if (!existsSync(passwordPath)) {
    const password = crypto.randomUUID().replaceAll('-', '');
    try {
      writeFileSync(passwordPath, password, { encoding: 'utf8', flag: 'wx', mode: 0o600 });
    } catch (error) {
      if (!(error instanceof Error) || !('code' in error) || error.code !== 'EEXIST') throw error;
    }
  }

  const password = readFileSync(passwordPath, 'utf8').trim();
  if (!password) throw new Error(`Database password file is empty: ${passwordPath}`);
  return password;
}

