import { firstFieldError, type RuntimeFormState } from '@netscript/fresh/form';
import {
  Button,
  Card,
  FormField,
  getInputProps,
  Input,
  InlineNotice,
} from '@app/components/ui/mod.ts';
import type { {{resourcePascalCase}}FormValues } from '../(_lib)/{{resource}}-form.ts';

export function {{resourcePascalCase}}Form(
  state: RuntimeFormState<{{resourcePascalCase}}FormValues>,
) {
  const noteError = firstFieldError(state.fieldErrors, 'note');

  return (
    <section id='{{resource}}-form'>
      <Card>
        <Card.Header>
          <Card.Title>Validate a note</Card.Title>
          <Card.Description>Validate a note and receive confirmation. This example does not change a record.</Card.Description>
        </Card.Header>
        <Card.Body>
          <form {...state.formProps} f-client-nav>
            <input {...state.csrfInputProps} />
            <div class='grid gap-4'>
              <FormField
                label='Note'
                name={state.fields.note.id}
                required
                error={noteError}
              >
                <Input
                  {...getInputProps(state.fields.note, { type: 'text' })}
                  error={Boolean(noteError)}
                />
              </FormField>
              {state.submitted && !state.hasErrors && <InlineNotice variant='success' title='Note validated' role='status'>Your note passed validation. No record was changed.</InlineNotice>}
              {state.hasErrors
                ? (
                  <InlineNotice variant='destructive' title='Check the form' role='alert'>
                    Correct the validation error before submitting again.
                  </InlineNotice>
                )
                : null}
              <Button type='submit'>Validate note</Button>
            </div>
          </form>
        </Card.Body>
      </Card>
    </section>
  );
}
