// @netscript/directory-role islands: client hydration only
import type { VNode } from 'preact';
import type { InferDefinePageLayerLoaderProps } from '@netscript/fresh/builders';
import { QueryIsland, useIslandQuery } from '@netscript/fresh/query';
import { {{queryFactoryName}} } from '{{clientModuleSpecifier}}';
import { load{{resourcePascalCase}}Resource } from '../(_shared)/{{resource}}-loaders.ts';

type Props = NonNullable<
  InferDefinePageLayerLoaderProps<typeof load{{resourcePascalCase}}Resource>
>;

function {{resourcePascalCase}}Data(props: Props) {
  const query = useIslandQuery({
    ...{{queryFactory}}.queryOptions(props.input),
    queryKey: {{queryFactory}}.clientKey(props.input),
    initialData: props.initialData,
    initialDataUpdatedAt: props.cachedAt,
  });

  if (query.isLoading) return <p role='status'>Loading {{resource}}…</p>;
  if (query.isError) return <p role='alert'>Unable to load {{resource}}.</p>;

  return <QueryResult value={query.data} />;
}

/** Replace this generic field view with your domain's columns and actions. */
function QueryResult({ value }: { value: unknown }): VNode {
  if (value === null || value === undefined) {
    return <p class='text-ns-muted-fg'>No value</p>;
  }
  if (Array.isArray(value)) {
    if (value.length === 0) return <p role='status'>No records yet.</p>;
    return (
      <ol class='ns-stack ns-stack--md' aria-label='Records'>
        {value.map((item, index) => (
          <li key={index} class='min-w-0 border border-ns-border p-4'>
            <QueryResult value={item} />
          </li>
        ))}
      </ol>
    );
  }
  if (typeof value === 'object') {
    const fields = Object.entries(value);
    if (fields.length === 0) return <p role='status'>No details available.</p>;
    return (
      <dl class='ns-stack ns-stack--sm'>
        {fields.map(([label, field]) => (
          <div key={label} class='min-w-0'>
            <dt class='font-mono text-xs text-ns-muted-fg'>{label}</dt>
            <dd class='m-0 min-w-0 [overflow-wrap:anywhere]'>
              <QueryResult value={field} />
            </dd>
          </div>
        ))}
      </dl>
    );
  }
  return <span>{typeof value === 'boolean' ? (value ? 'Yes' : 'No') : String(value)}</span>;
}

export default function {{resourcePascalCase}}Island(props: Props) {
  return (
    <QueryIsland>
      <{{resourcePascalCase}}Data {...props} />
    </QueryIsland>
  );
}
