{
  "name": "@netscript/service",
  "version": "0.0.7",
  "description": "Service bootstrap builders, health probes, and Hono/oRPC runtime wiring for NetScript applications.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./mod.ts",
    "./auth": "./src/auth/mod.ts",
    "./rpc-path": "./src/primitives/rpc-path.ts",
    "./internal-credential": "./src/auth/internal-credential/mod.ts",
    "./commands": "./commands.ts",
    "./commands/testing": "./commands-testing.ts",
    "./commands/relay": "./commands-relay.ts",
    "./rate-limit": "./src/rate-limit/mod.ts"
  },
  "tasks": {
    "check": "deno check --unstable-kv ./mod.ts commands.ts commands-testing.ts commands-relay.ts ./src/auth/internal-credential/mod.ts ./src/rate-limit/mod.ts",
    "test": "deno test --allow-all ./tests/",
    "lint": "deno lint",
    "fmt": "deno fmt --check",
    "publish:dry-run": "deno publish --dry-run --allow-dirty"
  },
  "imports": {
    "hono": "jsr:@hono/hono@4.13.13",
    "hono/body-limit": "jsr:@hono/hono@4.13.13/body-limit",
    "hono/cors": "jsr:@hono/hono@4.13.13/cors",
    "hono/logger": "jsr:@hono/hono@4.13.13/logger",
    "@orpc/server": "npm:@orpc/server@^1.15.5",
    "@orpc/openapi": "npm:@orpc/openapi@^1.15.5",
    "@orpc/contract": "npm:@orpc/contract@^1.15.5",
    "@orpc/client": "npm:@orpc/client@^1.15.5",
    "@orpc/zod": "npm:@orpc/zod@^1.15.5",
    "@std/assert": "jsr:@std/assert@^1",
    "rou3": "npm:rou3@^0.7.12",
    "zod": "catalog:",
    "@standard-schema/spec": "jsr:@standard-schema/spec@1.1.0",
    "@netscript/database": "jsr:@netscript/database@0.0.7",
    "@netscript/telemetry": "jsr:@netscript/telemetry@0.0.7",
    "@netscript/kv": "jsr:@netscript/kv@0.0.7"
  },
  "publish": {
    "include": [
      "mod.ts",
      "commands.ts",
      "src/**/*.ts",
      "README.md",
      "deno.json",
      "commands-testing.ts",
      "commands-relay.ts"
    ],
    "exclude": [
      "tests/",
      "**/*_test.ts",
      "**/*.test.ts"
    ]
  }
}
