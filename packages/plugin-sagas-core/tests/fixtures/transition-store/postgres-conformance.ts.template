import { PrismaClient, type Prisma } from './.generated/client.ts';
import { PrismaPg } from 'npm:@prisma/adapter-pg@7.8.0';
import { assert, assertEquals, assertRejects } from 'jsr:@std/assert@1';
import { createDurableSagaRuntime, PrismaSagaInstanceProjection } from '@netscript/plugin-sagas/runtime';
import { defineSaga } from '@netscript/plugin-sagas-core';
import { workerJobEffect } from '@netscript/plugin-sagas-core/integration/workers';
import { defineJob } from '@netscript/plugin-workers-core';
import { z } from 'zod';
import { createPrismaSagaTransitionStore } from '@netscript/plugin-sagas-core/stores';
import type { PostgresCommandClient, TransactionClientPort } from '@netscript/database/commands/postgres';
import { assertAtomicTransitionConformance, transitionRequest } from 'REPO_URLpackages/plugin-sagas-core/tests/transition-conformance.ts';

type Tx = Omit<Prisma.TransactionClient, '$transaction'|'$connect'|'$disconnect'|'$on'|'$use'|'$extends'>;
const root = new PrismaClient({ adapter: new PrismaPg({ host: Deno.env.get('COMMAND_POSTGRES_SOCKET'), database: 'postgres', user: Deno.env.get('PGUSER'), port: Number(Deno.env.get('PGPORT')) }) });
let callbacks = 0;
let faultAfter: string | undefined;
let controller: AbortController | undefined;
const observedTxIds: string[] = [];
const bridge: PostgresCommandClient & TransactionClientPort<Tx> = {
  $queryRawUnsafe: root.$queryRawUnsafe.bind(root),
  $executeRawUnsafe: root.$executeRawUnsafe.bind(root),
  $transaction(work, options) {
    if (options?.isolationLevel === 'Snapshot') throw new TypeError('unsupported isolation');
    return root.$transaction(async native => {
      callbacks++;
      const tx = new Proxy(native, {
        get(target, key, receiver) {
          if (typeof key === 'string' && ['$transaction','$connect','$disconnect','$on','$use','$extends'].includes(key)) return undefined;
          if (key === '$queryRawUnsafe' || key === '$executeRawUnsafe') {
            return async (query: string, ...values: unknown[]) => {
              const ids = await target.$queryRawUnsafe<{ identity: string }[]>('SELECT txid_current()::text AS identity');
              observedTxIds.push(ids[0].identity);
              const result = await Reflect.apply(Reflect.get(target, key), target, [query,...values]);
              if (faultAfter && query.includes(faultAfter)) controller?.abort(new Error('fault after actual row write'));
              return result;
            };
          }
          return Reflect.get(target,key,receiver);
        },
      });
      return await work(tx);
    }, { ...options, isolationLevel: options?.isolationLevel });
  },
};
const store = createPrismaSagaTransitionStore(bridge, { transactionTimeoutMs: 5000 });
const tables = ['saga_runtime_command_applied_key','netscript_command_outbox','saga_runtime_transition','saga_runtime_correlation','saga_runtime_state'] as const;
async function reset() {
  for (const table of tables) await root.$executeRawUnsafe(`DELETE FROM ${table}`);
  callbacks=0; observedTxIds.length=0; faultAfter=undefined; controller=undefined;
}
async function counts() {
  const out: number[] = [];
  for (const table of tables) {
    const rows = await root.$queryRawUnsafe<{ count: bigint }[]>(`SELECT count(*) AS count FROM ${table}`);
    out.push(Number(rows[0].count));
  }
  return out;
}
Deno.test('PostgreSQL whole transition rolls back each row seam and retries the same inbound identity', async () => {
  try {
  await reset();
  await assertAtomicTransitionConformance(store);
  assertEquals(await counts(), [2,2,2,1,1]);
  assertEquals((await store.transitions(transitionRequest().correlation.instanceId))[0].transition.message.occurredAt, new Date(0));
  for (const table of tables) {
    await reset();
    controller=new AbortController(); faultAfter=table;
    await assertRejects(() => store.commitTransition(transitionRequest(), controller!.signal));
    assertEquals(await counts(), [0,0,0,0,0], `rollback after ${table}`);
    assertEquals(callbacks, 1);
    assertEquals(new Set(observedTxIds).size, 1);
    faultAfter=undefined;
    assertEquals(await store.commitTransition(transitionRequest()), { committed:true });
    assertEquals(await counts(), [1,1,1,1,1]);
    const history = await store.transitions(transitionRequest().correlation.instanceId);
    assertEquals(history.length,1);
    assertEquals(history[0].transition.occurredAt,new Date(0));
  }
  await reset();
  await assertRejects(() => root.$transaction(async () => {
    const request = transitionRequest();
    await root.$executeRawUnsafe('INSERT INTO saga_runtime_state (instance_id,saga_id,version,envelope,updated_at) VALUES ($1,$2,$3,$4::jsonb,NOW())', request.correlation.instanceId, request.correlation.sagaId, 1, JSON.stringify(request.envelope));
    throw new Error('root negative control');
  }), Error, 'root negative control');
  assertEquals(await counts(), [0,0,0,0,1]);
  await reset();
  } finally { await root.$disconnect(); }
});
Deno.test('PostgreSQL stale saga writers and replay races commit one command set', async () => {
  try {
  await reset();
  const first=transitionRequest();
  const second=transitionRequest(1,'other-command','b'.repeat(64));
  const results=await Promise.allSettled([store.commitTransition(first),store.commitTransition(second)]);
  assertEquals(results.filter(r => r.status==='fulfilled').length,1);
  assertEquals(await counts(),[1,1,1,1,1]);
  assertEquals(callbacks,2);
  const state=await store.load(first.correlation.instanceId);
  assertEquals(state?.metadata.version,1);
  await reset();
  const replay=await Promise.all([store.commitTransition(first),store.commitTransition(first)]);
  assertEquals(replay.filter(r => r.committed).length,1);
  assertEquals(await counts(),[1,1,1,1,1]);
  assertEquals(callbacks,2);
  assert((await store.entries())[0].metadata.createdAt instanceof Date);
  } finally { await root.$disconnect(); }
});

Deno.test('PostgreSQL projected atomic runtime commits once and repairs projection without repeating worker intent', async () => {
  let failProjection = true;
  const projection = new PrismaSagaInstanceProjection(root);
  const job = defineJob('projection-job').payload(z.object({ documentId: z.string() })).entrypoint('job.ts').build();
  const definition = defineSaga('document').durableWorkerCommands().state({ count: 0 }).on('start', saga => {
    saga.state.count++;
    return [workerJobEffect(job, { documentId: 'one' }, { destination: 'workers', topic: 'document' })];
  }).build();
  const request = transitionRequest();
  const message = { type: 'start', payload: {}, correlationKey: request.correlation.correlationKey, idempotencyKey: 'projected-one' };
  const guardedProjection = { async upsert(value: Parameters<typeof projection.upsert>[0]): Promise<void> {
    assertEquals(await counts(), [1,1,1,1,1]);
    assertEquals(new Set(observedTxIds).size, 1);
    if (failProjection) throw new Error('projection unavailable');
    await projection.upsert(value);
  } };
  try {
    await reset();
    await root.$executeRawUnsafe('CREATE TABLE IF NOT EXISTS saga_instances (id varchar(100) NOT NULL, saga_name varchar(100) NOT NULL, correlation_id varchar(100) NOT NULL, version integer NOT NULL, is_completed boolean NOT NULL, state jsonb NOT NULL, created_at timestamp(3) NOT NULL, updated_at timestamp(3) NOT NULL, PRIMARY KEY (saga_name,id))');
    await root.$executeRawUnsafe('DELETE FROM saga_instances');
    const durable = await createDurableSagaRuntime({ store, projection: guardedProjection });
    try {
      await durable.runtime.register([definition]);
      await durable.runtime.start();
      await assertRejects(() => durable.runtime.publish(message), Error, 'projection unavailable');
      assertEquals(callbacks, 1);
      assertEquals(await counts(), [1,1,1,1,1]);
      assertEquals(await root.sagaInstance.count(), 0);
    } finally {
      await durable.runtime.stop();
      await durable.dispose();
    }
    failProjection = false;
    const envelope = await store.load(request.correlation.instanceId);
    assert(envelope);
    const history = await store.transitions(request.correlation.instanceId);
    await projection.upsert({ ...request.correlation, envelope, transition: history[0] });
    const row = await root.sagaInstance.findUniqueOrThrow({ where: { sagaName_id: { sagaName: 'document', id: request.correlation.instanceId } } });
    assertEquals(row.version, 1);
    assertEquals((row.state as { count: number }).count, 1);
    const restarted = await createDurableSagaRuntime({ store, projection: guardedProjection });
    try {
      await restarted.runtime.register([definition]);
      await restarted.runtime.start();
      await restarted.runtime.publish(message);
      assertEquals(await counts(), [1,1,1,1,1]);
      assertEquals(await root.sagaInstance.count(), 1);
    } finally {
      await restarted.runtime.stop();
      await restarted.dispose();
    }
    // A new transition also populates the Prisma projection after its canonical commit.
    const nextRuntime = await createDurableSagaRuntime({ store, projection });
    try {
      await nextRuntime.runtime.register([definition]);
      await nextRuntime.runtime.start();
      await nextRuntime.runtime.publish({ ...message, idempotencyKey: 'projected-two' });
      assertEquals(await counts(), [2,2,2,1,1]);
      const next = await root.sagaInstance.findUniqueOrThrow({ where: { sagaName_id: { sagaName: 'document', id: request.correlation.instanceId } } });
      assertEquals(next.version, 2);
      assertEquals((next.state as { count: number }).count, 2);
    } finally {
      await nextRuntime.runtime.stop();
      await nextRuntime.dispose();
    }
  } finally { await root.$disconnect(); }
});
