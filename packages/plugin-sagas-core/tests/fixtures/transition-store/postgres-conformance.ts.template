import { DenoKvAdapter } from '@netscript/kv';
import { KvSagaAppliedKeyStore, KvSagaIdempotencyStore } from '@netscript/plugin-sagas-core/stores';
import { parseSagaInstanceReadModel, SAGA_INSTANCE_PROJECTION_VERSION } from 'REPO_URLplugins/sagas/src/runtime/saga-instance-projection.ts';
import { SagaRuntimeSupervisor } from 'REPO_URLplugins/sagas/src/runtime/saga-supervisor.ts';
import type { SagaState } from '@netscript/plugin-sagas-core/domain';
import type { SagaRuntime } from '@netscript/plugin-sagas-core/runtime';
import { stderrTail } from 'REPO_URLpackages/plugin-sagas-core/tests/fixtures/transition-store/provider-process.ts';
import { PrismaClient, type Prisma } from './.generated/client.ts';
import { PrismaPg } from '@prisma/adapter-pg';
import { assert, assertEquals, assertRejects } from 'jsr:@std/assert@1';
import { createDurableSagaRuntime, PrismaSagaInstanceProjection } from '@netscript/plugin-sagas/runtime';
import { defineSaga } from '@netscript/plugin-sagas-core';
import { workerJobEffect } from '@netscript/plugin-sagas-core/integration/workers';
import { defineJob } from '@netscript/plugin-workers-core';
import { z } from 'zod';
import { isPrismaSagaStoreClient, type PrismaSagaStoreClient, PrismaSagaStore, createPrismaSagaTransitionStore } from '@netscript/plugin-sagas-core/stores';
import type { PostgresCommandClient, TransactionClientPort } from '@netscript/database/commands/postgres';
import { assertAtomicTransitionConformance, transitionRequest } from 'REPO_URLpackages/plugin-sagas-core/tests/transition-conformance.ts';
import { assertCompensationRetry, COMPENSATION_RETRY_STATUSES, type CompensationFault, type CompensationTestStore } from 'REPO_URLpackages/plugin-sagas-core/tests/fixtures/compensation-retry.ts';

type Tx = Omit<Prisma.TransactionClient, '$transaction'|'$connect'|'$disconnect'|'$on'|'$use'|'$extends'>;
const root = new PrismaClient({ adapter: new PrismaPg({ host: Deno.env.get('COMMAND_POSTGRES_SOCKET'), database: 'postgres', user: Deno.env.get('PGUSER'), port: Number(Deno.env.get('PGPORT')) }) });
if (!isPrismaSagaStoreClient(root)) throw new Error('Generated client lacks required saga delegates');
const ordinaryClient: PrismaSagaStoreClient = root;
let callbacks = 0;
let faultAfter: string | undefined;
let controller: AbortController | undefined;
const observedTxIds: string[] = [];
const bridge: PostgresCommandClient & TransactionClientPort<Tx> = {
  $queryRawUnsafe: root.$queryRawUnsafe.bind(root),
  $executeRawUnsafe: root.$executeRawUnsafe.bind(root),
  $transaction(work, options) {
    if (options?.isolationLevel === 'Snapshot') throw new TypeError('unsupported isolation');
    return root.$transaction(async native => {
      callbacks++;
      const tx = new Proxy(native, {
        get(target, key, receiver) {
          if (typeof key === 'string' && ['$transaction','$connect','$disconnect','$on','$use','$extends'].includes(key)) return undefined;
          if (key === '$queryRawUnsafe' || key === '$executeRawUnsafe') {
            return async (query: string, ...values: unknown[]) => {
              const ids = await target.$queryRawUnsafe<{ identity: string }[]>('SELECT txid_current()::text AS identity');
              observedTxIds.push(ids[0].identity);
              const result = await Reflect.apply(Reflect.get(target, key), target, [query,...values]);
              if (faultAfter && query.includes(faultAfter)) controller?.abort(new Error('fault after actual row write'));
              return result;
            };
          }
          return Reflect.get(target,key,receiver);
        },
      });
      return await work(tx);
    }, { ...options, isolationLevel: options?.isolationLevel });
  },
};
const store = createPrismaSagaTransitionStore(bridge, { transactionTimeoutMs: 5000 });
if (Deno.args[0] === 'atomic-child') { await atomicChild(); Deno.exit(0); }
const tables = ['saga_runtime_command_applied_key','netscript_command_outbox','saga_runtime_transition','saga_runtime_correlation','saga_runtime_state'] as const;
async function reset() {
  for (const table of tables) await root.$executeRawUnsafe(`DELETE FROM ${table}`);
  callbacks=0; observedTxIds.length=0; faultAfter=undefined; controller=undefined;
}
async function counts() {
  const out: number[] = [];
  for (const table of tables) {
    const rows = await root.$queryRawUnsafe<{ count: bigint }[]>(`SELECT count(*) AS count FROM ${table}`);
    out.push(Number(rows[0].count));
  }
  return out;
}
Deno.test('PostgreSQL whole transition rolls back each row seam and retries the same inbound identity', async () => {
  try {
  await reset();
  await assertAtomicTransitionConformance(store);
  assertEquals(await counts(), [2,2,2,1,1]);
  assertEquals((await store.transitions(transitionRequest().correlation.instanceId))[0].transition.message.occurredAt, new Date(0));
  for (const table of tables) {
    await reset();
    controller=new AbortController(); faultAfter=table;
    await assertRejects(() => store.commitTransition(transitionRequest(), controller!.signal));
    assertEquals(await counts(), [0,0,0,0,0], `rollback after ${table}`);
    assertEquals(callbacks, 1);
    assertEquals(new Set(observedTxIds).size, 1);
    faultAfter=undefined;
    assertEquals(await store.commitTransition(transitionRequest()), { committed:true });
    assertEquals(await counts(), [1,1,1,1,1]);
    const history = await store.transitions(transitionRequest().correlation.instanceId);
    assertEquals(history.length,1);
    assertEquals(history[0].transition.occurredAt,new Date(0));
  }
  await reset();
  await assertRejects(() => root.$transaction(async () => {
    const request = transitionRequest();
    await root.$executeRawUnsafe('INSERT INTO saga_runtime_state (instance_id,saga_id,version,envelope,updated_at) VALUES ($1,$2,$3,$4::jsonb,NOW())', request.correlation.instanceId, request.correlation.sagaId, 1, JSON.stringify(request.envelope));
    throw new Error('root negative control');
  }), Error, 'root negative control');
  assertEquals(await counts(), [0,0,0,0,1]);
  await reset();
  } finally { await root.$disconnect(); }
});
Deno.test('PostgreSQL stale saga writers and replay races commit one command set', async () => {
  try {
  await reset();
  const first=transitionRequest();
  const second=transitionRequest(1,'other-command','b'.repeat(64));
  const results=await Promise.allSettled([store.commitTransition(first),store.commitTransition(second)]);
  assertEquals(results.filter(r => r.status==='fulfilled').length,1);
  assertEquals(await counts(),[1,1,1,1,1]);
  assertEquals(callbacks,2);
  const state=await store.load(first.correlation.instanceId);
  assertEquals(state?.metadata.version,1);
  await reset();
  const replay=await Promise.all([store.commitTransition(first),store.commitTransition(first)]);
  assertEquals(replay.filter(r => r.committed).length,1);
  assertEquals(await counts(),[1,1,1,1,1]);
  assertEquals(callbacks,2);
  assert((await store.entries())[0].metadata.createdAt instanceof Date);
  } finally { await root.$disconnect(); }
});

Deno.test('PostgreSQL projected atomic runtime commits once and repairs projection without repeating worker intent', async () => {
  let failProjection = true;
  const projection = new PrismaSagaInstanceProjection(root);
  const job = defineJob('projection-job').payload(z.object({ documentId: z.string() })).entrypoint('job.ts').build();
  const definition = defineSaga('document').durableWorkerCommands().state({ count: 0, status: 'business-pending' }).on('start', saga => {
    saga.state.count++;
    return [workerJobEffect(job, { documentId: 'one' }, { destination: 'workers', topic: 'document' })];
  }).build();
  const request = transitionRequest();
  const message = { type: 'start', payload: {}, correlationKey: request.correlation.correlationKey, idempotencyKey: 'projected-one' };
  const guardedProjection = { async upsert(value: Parameters<typeof projection.upsert>[0]): Promise<void> {
    assertEquals(await counts(), [1,1,1,1,1]);
    assertEquals(new Set(observedTxIds).size, 1);
    if (failProjection) throw new Error('projection unavailable');
    await projection.upsert(value);
  } };
  try {
    await reset();
    await root.$executeRawUnsafe('CREATE TABLE IF NOT EXISTS saga_instances (id varchar(100) NOT NULL, saga_name varchar(100) NOT NULL, correlation_id varchar(100) NOT NULL, version integer NOT NULL, is_completed boolean NOT NULL, state jsonb NOT NULL, created_at timestamp(3) NOT NULL, updated_at timestamp(3) NOT NULL, PRIMARY KEY (saga_name,id))');
    await root.$executeRawUnsafe('DELETE FROM saga_instances');
    const durable = await createDurableSagaRuntime({ store, projection: guardedProjection });
    try {
      await durable.runtime.register([definition]);
      await durable.runtime.start();
      await assertRejects(() => durable.runtime.publish(message), Error, 'projection unavailable');
      assertEquals(callbacks, 1);
      assertEquals(await counts(), [1,1,1,1,1]);
      assertEquals(await root.sagaInstance.count(), 0);
    } finally {
      await durable.runtime.stop();
      await durable.dispose();
    }
    failProjection = false;
    const envelope = await store.load(request.correlation.instanceId);
    assert(envelope);
    const history = await store.transitions(request.correlation.instanceId);
    await projection.upsert({ ...request.correlation, envelope, transition: history[0] });
    const row = await root.sagaInstance.findUniqueOrThrow({ where: { sagaName_id: { sagaName: 'document', id: request.correlation.instanceId } } });
    assertEquals(row.version, 1);
    z.object({ projectionVersion: z.literal(SAGA_INSTANCE_PROJECTION_VERSION) }).parse(row.state);
    const firstProjection = parseSagaInstanceReadModel(row.state);
    assertEquals(firstProjection.state, { count: 1, status: 'business-pending' });
    assertEquals(firstProjection.status, 'running');
    const restarted = await createDurableSagaRuntime({ store, projection: guardedProjection });
    try {
      await restarted.runtime.register([definition]);
      await restarted.runtime.start();
      await restarted.runtime.publish(message);
      assertEquals(await counts(), [1,1,1,1,1]);
      assertEquals(await root.sagaInstance.count(), 1);
    } finally {
      await restarted.runtime.stop();
      await restarted.dispose();
    }
    // A new transition also populates the Prisma projection after its canonical commit.
    const nextRuntime = await createDurableSagaRuntime({ store, projection });
    try {
      await nextRuntime.runtime.register([definition]);
      await nextRuntime.runtime.start();
      await nextRuntime.runtime.publish({ ...message, idempotencyKey: 'projected-two' });
      assertEquals(await counts(), [2,2,2,1,1]);
      const next = await root.sagaInstance.findUniqueOrThrow({ where: { sagaName_id: { sagaName: 'document', id: request.correlation.instanceId } } });
      assertEquals(next.version, 2);
      const nextProjection = parseSagaInstanceReadModel(next.state);
      assertEquals(nextProjection.state, { count: 2, status: 'business-pending' });
      assertEquals(nextProjection.status, 'running');
    } finally {
      await nextRuntime.runtime.stop();
      await nextRuntime.dispose();
    }
  } finally { await root.$disconnect(); }
});

// The real generated client exercises both production PostgreSQL adapters at the process boundary.
async function atomicChild(): Promise<void> {
  const [, adapter, folder, phase] = Deno.args;
  Deno.env.set('NETSCRIPT_SAGA_KV_PATH', folder + '/supervisor.db');
  const kv = new DenoKvAdapter(await Deno.openKv(folder + '/markers.db'));
  const canonical = adapter === 'ordinary' ? new PrismaSagaStore({ prisma: ordinaryClient })
    : store;
  const definition = defineSaga('postgres-crash').state<SagaState>({ count: 0 }).on('start' as string, saga => {
    Deno.writeTextFileSync(folder + '/calls.txt', 'handled\n', { append: true });
    saga.state = { count: Number(saga.state.count) + 1 };
    return [];
  }).build();
  const wrapped = new Proxy(canonical, { get(target, key) {
    const member = Reflect.get(target, key);
    if (phase === 'crash' && (key === 'commitTransition' || key === 'save')) return async () => {
      await Deno.stdout.write(new TextEncoder().encode('PAUSED_AFTER_HANDLER\n'));
      await new Promise(() => setInterval(() => undefined, 60_000));
    };
    return typeof member === 'function' ? member.bind(target) : member;
  } });
  const ready = Promise.withResolvers<SagaRuntime>();
  const waiting = Promise.withResolvers<void>();
  const supervisor = new SagaRuntimeSupervisor({
    definitions: [definition],
    runtimeOptions: { native: { store: wrapped, idempotency: new KvSagaIdempotencyStore({ kv }), engineOptions: { appliedKeys: new KvSagaAppliedKeyStore({ kv }) } } },
    delivery: {
      start(runtime) { ready.resolve(runtime); return Promise.resolve(); },
      stop() { waiting.resolve(); return Promise.resolve(); },
      wait() { return waiting.promise; },
    },
  });
  try {
    await supervisor.start();
    const runtime = await ready.promise;
    const message = { type: 'start', payload: {}, correlationKey: transitionRequest().correlation.correlationKey, idempotencyKey: 'postgres-message' };
    await runtime.publish(message);
    await runtime.publish(message);
    const instanceId = 'postgres-crash:one' as Parameters<typeof canonical.load>[0];
    assertEquals((await canonical.load(instanceId))?.state, { count: 1 });
    assertEquals((await canonical.transitions(instanceId)).length, 1);
    assertEquals((await canonical.load(instanceId))?.metadata.version, 1);
  } finally {
    await supervisor.stop();
    await kv.close();
    await root.$disconnect();
  }
}

for (const adapter of ['ordinary', 'command']) {
  Deno.test(`PostgreSQL ${adapter} production supervisor SIGKILL after handler retries and commits once`, async () => {
    const folder = await Deno.makeTempDir();
    const args = (phase: string) => ['run', '--frozen', '--unstable-kv', '--config', new URL('./deno.json', import.meta.url).pathname, '-A', new URL(import.meta.url).pathname, 'atomic-child', adapter, folder, phase];
    try {
      await reset();
      const child = new Deno.Command(Deno.execPath(), { args: args('crash'), stdin: 'null', stdout: 'piped', stderr: 'piped' }).spawn();
      const errors = stderrTail(child.stderr);
      const reader = child.stdout.pipeThrough(new TextDecoderStream()).getReader();
      let output = '';
      const deadline = setTimeout(() => { try { child.kill('SIGKILL'); } catch {} }, 30_000);
      try {
        while (!output.includes('PAUSED_AFTER_HANDLER')) {
          const part = await reader.read();
          if (part.done) throw new Error('Child exited before commit pause: ' + await errors);
          output += part.value;
        }
        child.kill('SIGKILL');
        assertEquals((await child.status).signal, 'SIGKILL');
      } finally {
        clearTimeout(deadline);
        try { child.kill('SIGKILL'); } catch {}
        await child.status;
        await reader.cancel(); reader.releaseLock(); await errors;
      }
      assertEquals(await counts(), [0,0,0,0,0]);
      const resumed = await new Deno.Command(Deno.execPath(), { args: args('resume'), stdin: 'null', stdout: 'piped', stderr: 'piped', signal: AbortSignal.timeout(30_000) }).output();
      assertEquals(resumed.code, 0, new TextDecoder().decode(resumed.stderr));
      assertEquals(await counts(), [1,0,1,1,1]);
      assertEquals((await Deno.readTextFile(folder + '/calls.txt')).trim().split('\n').length, 2);
    } finally {
      await Deno.remove(folder, { recursive: true });
      await reset();
      await root.$disconnect();
    }
  });
}

Deno.test('ordinary PostgreSQL marker, state, correlation and history roll back together at every write', async () => {
  try {
    for (const step of ['marker', 'state', 'correlation', 'history']) {
      await reset();
      const fault = new AbortController();
      const client = new Proxy(ordinaryClient, { get(target,key) {
        if (key === '$transaction') return <T>(work: (tx: import('@netscript/plugin-sagas-core/stores').PrismaSagaStoreTransaction) => Promise<T>) => target.$transaction(async tx => {
          const observed = new Proxy(tx, { get(native, field) {
            const delegate = Reflect.get(native, field);
            const seam = ({ sagaRuntimeCommandAppliedKey: ['createMany','marker'], sagaRuntimeState: ['create','state'], sagaRuntimeCorrelation: ['upsert','correlation'], sagaRuntimeTransition: ['create','history'] } as Record<string, string[]>)[String(field)];
            if (!seam) return typeof delegate === 'function' ? delegate.bind(native) : delegate;
            return new Proxy(delegate, { get(owner, method) {
              const operation = Reflect.get(owner, method);
              if (method === seam[0]) return async (...args: unknown[]) => {
                const value = await Reflect.apply(operation, owner, args);
                if (step === seam[1]) fault.abort(new Error('actual write fault'));
                return value;
              };
              return typeof operation === 'function' ? operation.bind(owner) : operation;
            } });
          } });
          return await work(observed);
        });
        const member = Reflect.get(target,key);
        return typeof member === 'function' ? member.bind(target) : member;
      } });
      const ordinary = new PrismaSagaStore({ prisma: client });
      const request = { ...transitionRequest(), commands: [] };
      await assertRejects(() => ordinary.commitTransition(request, fault.signal), Error, 'actual write fault');
      assertEquals(await counts(), [0,0,0,0,0]);
      assertEquals(await ordinary.commitTransition(request), { committed: true });
      assertEquals(await ordinary.commitTransition(request), { committed: false });
      assertEquals(await counts(), [1,0,1,1,1]);
    }
  } finally { await reset(); await root.$disconnect(); }
});


// The fault follows the actual replay INSERT inside the interactive transaction. A thrown
// exception must roll it back before state is updated; an acknowledgement fault follows COMMIT.
for (const adapter of ['ordinary', 'command']) {
  for (const fault of ['before-commit', 'after-commit'] as const satisfies readonly CompensationFault[]) {
    for (const status of COMPENSATION_RETRY_STATUSES) {
      Deno.test(`PostgreSQL ${adapter} compensation ${fault} retries the same ${status} outcome`, async () => {
        let armed = false;
        let faults = 0;
        let markerWrites = 0;
        let faultMarker: { instanceId: string; keyHash: string } | undefined;
        const afterMarker = () => {
          markerWrites++;
          if (armed && fault === 'before-commit') {
            armed = false;
            faults++;
            throw new Error('injected compensation persistence failure');
          }
        };
        const client = new Proxy(ordinaryClient, {
          get(target, key) {
            if (key === '$transaction') return <T>(work: (tx: import('@netscript/plugin-sagas-core/stores').PrismaSagaStoreTransaction) => Promise<T>) =>
              target.$transaction(async tx => {
                const delegate = tx.sagaRuntimeCommandAppliedKey;
                return await work({ ...tx, sagaRuntimeCommandAppliedKey: {
                  findUnique: delegate.findUnique.bind(delegate),
                  async createMany(args) {
                    const result = await delegate.createMany(args);
                    if (armed) faultMarker = args.data;
                    afterMarker();
                    return result;
                  },
                } });
              });
            const member = Reflect.get(target, key);
            return typeof member === 'function' ? member.bind(target) : member;
          },
        });
        const commandClient: PostgresCommandClient & TransactionClientPort<Tx> = {
          ...bridge,
          $transaction(work, options) {
            return bridge.$transaction(async tx => {
              const observed = new Proxy(tx, {
                get(target, key) {
                  if (key === '$queryRawUnsafe' || key === '$executeRawUnsafe') {
                    return async (query: string, ...values: unknown[]) => {
                      const result = await Reflect.apply(Reflect.get(target, key), target, [query, ...values]);
                      if (/INSERT INTO saga_runtime_command_applied_key/.test(query)) {
                        if (armed) faultMarker = { instanceId: String(values[0]), keyHash: String(values[1]) };
                        afterMarker();
                      }
                      return result;
                    };
                  }
                  const member = Reflect.get(target, key);
                  return typeof member === 'function' ? member.bind(target) : member;
                },
              });
              return await work(observed);
            }, options);
          },
        };
        const open = (): CompensationTestStore => {
          const canonical = adapter === 'ordinary'
            ? new PrismaSagaStore({ prisma: client })
            : createPrismaSagaTransitionStore(commandClient, { transactionTimeoutMs: 5000 });
          return new Proxy(canonical, {
            get(target, key) {
              if (key === 'commitTransition') return async (...args: Parameters<CompensationTestStore['commitTransition']>) => {
                const result = await target.commitTransition(...args);
                if (armed && fault === 'after-commit') {
                  assertEquals(result.committed, true);
                  armed = false;
                  faults++;
                  throw new Error('injected compensation persistence failure');
                }
                return result;
              };
              const member = Reflect.get(target, key);
              return typeof member === 'function' ? member.bind(target) : member;
            },
          });
        };
        try {
          await reset();
          await assertCompensationRetry({
            store: open(), status, fault,
            armFault() { armed = true; },
            faultCount() { return faults; },
            reopen() { return Promise.resolve(open()); },
          });
          // Inbound has no replay key: only compensation inserts one. Replay attempts use the
          // same identity, and neither a failed transaction nor a retry leaves an extra row.
          assert(markerWrites > 0);
          assert(faultMarker);
          assertEquals(await counts(), [1, 0, 2, 1, 1]);
          const markers = await root.$queryRawUnsafe<{ instance_id: string; key_hash: string }[]>(
            'SELECT instance_id, key_hash FROM saga_runtime_command_applied_key',
          );
          assertEquals(markers, [{ instance_id: faultMarker.instanceId, key_hash: faultMarker.keyHash }]);
        } finally {
          await reset();
          await root.$disconnect();
        }
      });
    }
  }
}
