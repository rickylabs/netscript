{
  "name": "@netscript/mcp",
  "version": "0.0.7-canary.4",
  "description": "Token-bounded MCP tools for NetScript diagnostics, telemetry insights, docs, and CLI actions.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts",
    "./openapi-projection": "./openapi-projection.ts"
  },
  "imports": {
    "@netscript/aspire": "jsr:@netscript/aspire@0.0.7-canary.4",
    "@netscript/telemetry/attributes": "jsr:@netscript/telemetry@0.0.7-canary.4/attributes",
    "@netscript/telemetry/query": "jsr:@netscript/telemetry@0.0.7-canary.4/query",
    "@standard-schema/spec": "jsr:@standard-schema/spec@1.1.0",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "tasks": {
    "check": "deno check mod.ts cli.ts openapi-projection.ts",
    "test": "deno test --allow-env --allow-net --allow-run --allow-read --allow-write tests/",
    "publish:dry-run": "deno run --allow-read --allow-write --allow-run ../../.llm/tools/release/run-publish-dry-run.ts --root ../.. --member packages/mcp"
  },
  "publish": {
    "include": ["**/*.ts", "deno.json", "README.md"],
    "exclude": ["tests/", "**/*_test.ts"]
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  }
}
